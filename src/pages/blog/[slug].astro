---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import posts from '../../data/blog_posts.json';

export async function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Related posts (pick 3 other posts)
const relatedPosts = posts.filter((p) => p.slug !== post.slug).slice(0, 3);

// Format date
const formattedDate = new Date(post.date).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<Layout 
  title={`${post.title} | Jungle Nepal Adventure`}
  description={post.description}
  image={post.featuredImage}
  lang="fr"
>

  <!-- SCHEMA.ORG ARTICLE JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.title,
    "description": post.description,
    "image": [
      post.featuredImage.startsWith('http') ? post.featuredImage : `https://junglenepal.com${post.featuredImage}`
    ],
    "datePublished": post.date,
    "dateModified": post.date,
    "author": [{
      "@type": "Person",
      "name": "Robin Rozier",
      "jobTitle": "Fondateur & Guide Expédition",
      "url": "https://junglenepal.com/a-propos.html"
    }],
    "publisher": {
      "@type": "Organization",
      "name": "Jungle Nepal Adventure",
      "logo": {
        "@type": "ImageObject",
        "url": "https://junglenepal.com/assets/logo_nav_white.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://junglenepal.com/blog/${post.slug}`
    }
  })} />

  <!-- TOP PROMO BAR -->
  <aside aria-label="Bannière d'information" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">-100€</strong> sur votre séjour nov. 2027 avec le code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Fermer">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <Header isTransparent={false} currentPath="/blog" />

  <!-- ARTICLE HERO -->
  <header class="relative bg-slate-950 text-white pt-16 pb-20 px-4 sm:px-6 lg:px-8 border-b border-white/10 overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-80 bg-gradient-to-b from-[#134836]/40 via-transparent to-transparent pointer-events-none blur-3xl"></div>

    <div class="relative max-w-4xl mx-auto space-y-6">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 font-semibold flex-wrap">
        <a href="/" class="hover:text-white transition-colors">Accueil</a>
        <span>›</span>
        <a href="/blog.html" class="hover:text-white transition-colors">Blog</a>
        <span>›</span>
        <span class="text-emerald-400 font-bold truncate max-w-xs sm:max-w-md">{post.title}</span>
      </nav>

      <!-- Category & Read Time -->
      <div class="flex flex-wrap items-center gap-3 text-xs font-bold">
        <span class="px-3 py-1 rounded-full bg-[#134836] text-emerald-300 border border-emerald-500/30 uppercase tracking-wider">
          {post.category}
        </span>
        <span class="text-slate-400">•</span>
        <span class="text-slate-300">⏱ {post.readingTime} de lecture</span>
        <span class="text-slate-400">•</span>
        <time datetime={post.date} class="text-slate-300">Publié le {formattedDate}</time>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
        {post.title}
      </h1>

      <!-- Meta description summary banner -->
      {post.description && (
        <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed border-l-4 border-emerald-500 pl-4 py-1 bg-white/5 rounded-r-2xl">
          {post.description}
        </p>
      )}

      <!-- Author snippet -->
      <div class="pt-2 flex items-center gap-3">
        <img src="/assets/logo_dark.png" alt="Robin Rozier" class="w-10 h-10 rounded-full border border-white/20 object-contain p-1 bg-slate-900" />
        <div>
          <p class="text-xs font-bold text-white">Par Robin Rozier & l'équipe Jungle Nepal</p>
          <p class="text-[11px] text-slate-400">Pisteurs & guides naturalistes natifs</p>
        </div>
      </div>
    </div>
  </header>

  <!-- FEATURED IMAGE (Centered, High-Impact) -->
  {post.featuredImage && (
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative z-10">
      <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-slate-900 aspect-video">
        <img 
          src={post.featuredImage} 
          alt={post.title} 
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  )}

  <!-- MAIN ARTICLE BODY -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
    
    <!-- Rendered HTML Content with Elite Prose Styling -->
    <div class="prose prose-lg prose-slate max-w-none 
      prose-headings:text-slate-950 prose-headings:font-black prose-headings:tracking-tight 
      prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-3 prose-h2:border-b prose-h2:border-slate-200
      prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4
      prose-p:text-slate-700 prose-p:leading-relaxed prose-p:my-4
      prose-li:text-slate-700 prose-li:my-1
      prose-strong:text-slate-950 prose-strong:font-black
      prose-a:text-[#0e8354] prose-a:font-bold hover:prose-a:text-[#0a5e3c] prose-a:underline prose-a:decoration-emerald-400/50 hover:prose-a:decoration-emerald-600
      prose-img:rounded-3xl prose-img:shadow-lg prose-img:border prose-img:border-slate-200 prose-img:my-8
      prose-blockquote:border-l-4 prose-blockquote:border-[#134836] prose-blockquote:bg-emerald-50/60 prose-blockquote:p-4 prose-blockquote:rounded-r-2xl prose-blockquote:italic prose-blockquote:text-slate-800
      prose-table:border prose-table:border-slate-200 prose-table:rounded-2xl prose-table:overflow-hidden
      prose-th:bg-slate-100 prose-th:p-3 prose-th:text-slate-900 prose-th:font-extrabold
      prose-td:p-3 prose-td:border-b prose-td:border-slate-100
    ">
      <div set:html={post.content} />
    </div>

    <!-- CONVERSION CTA CARD (In-Content Conversion Booster) -->
    <section class="my-12 rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-[#032317] via-[#053222] to-[#021810] text-white border-2 border-emerald-500/30 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-64 h-64 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>

      <div class="relative space-y-5">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-emerald-300 font-extrabold text-[11px] uppercase tracking-widest border border-white/10">
          <span>🌿 Safari authentique au Népal</span>
        </span>

        <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight leading-snug">
          Envie d'explorer la jungle du Népal avec une équipe locale passionnée ?
        </h3>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          Jungle Nepal Adventure propose 15 séjours d'immersion sauvage en petits groupes de 4 à 10 personnes, guidés par des pisteurs natifs de Bardia et Chitwan.
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a 
            href="/#prochains-departs" 
            class="px-6 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs sm:text-sm shadow-xl transition-all hover:scale-105 active:scale-95 text-center"
          >
            Découvrir tous nos 15 séjours →
          </a>
          <button 
            onclick="openCustomTourModal()" 
            class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-extrabold text-xs sm:text-sm border border-white/20 transition-all cursor-pointer text-center"
          >
            Demander un devis personnalisé gratuit
          </button>
        </div>
      </div>
    </section>

    <!-- AUTHOR BIO BOX -->
    <div class="p-6 sm:p-8 bg-slate-50 rounded-3xl border border-slate-200 flex flex-col sm:flex-row items-center sm:items-start gap-6">
      <img 
        src="/assets/logo_dark.png" 
        alt="Robin & Pawan - Jungle Nepal Adventure" 
        class="w-20 h-20 rounded-2xl bg-slate-900 border-2 border-emerald-600/30 object-contain p-2 shrink-0 shadow-md"
      />
      <div class="space-y-2 text-center sm:text-left">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
          <h4 class="font-black text-slate-950 text-base sm:text-lg">Robin Rozier & Pawan</h4>
          <span class="text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full border border-emerald-300">Guides & Co-fondateurs</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Passionnés de faune sauvage et de conservation, nous concevons des expéditions immersives et éthiques au Népal pour vous faire observer le tigre du Bengale, les rhinocéros unicornes et les oiseaux rares dans le plus grand respect de leur environnement naturel.
        </p>
      </div>
    </div>

    <!-- RELATED GUIDES / SIMILAR POSTS -->
    <section class="space-y-6 pt-8 border-t border-slate-200">
      <div class="flex items-center justify-between">
        <h3 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Articles & guides recommandés
        </h3>
        <a href="/blog.html" class="text-xs font-bold text-[#0e8354] hover:underline">
          Tous les guides →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map((rel) => (
          <a 
            href={`/blog/${rel.slug}.html`} 
            class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col"
          >
            <div class="h-40 overflow-hidden bg-slate-900 shrink-0">
              <img 
                src={rel.featuredImage} 
                alt={rel.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
            </div>
            <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">
                  {rel.category}
                </span>
                <span class="text-[10px] font-medium text-slate-400">
                  ⏱ {rel.readingTime}
                </span>
              </div>
              <h4 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-700 transition-colors line-clamp-2 leading-snug">
                {rel.title}
              </h4>
              <p class="text-[11px] text-slate-500 line-clamp-2">
                {rel.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

  </article>

  <Footer lang="fr" />

</Layout>
