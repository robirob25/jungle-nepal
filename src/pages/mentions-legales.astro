---
import { getLocalizedPath } from '../i18n/utils';

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<Layout title="Mentions légales, cadre réglementaire & politique de confidentialité" description="Mentions légales de Robin Rozier / Jungle Nepal Adventure, conseiller voyage indépendant membre du Collectif My Way (opérateur MYWAY SAS immatriculé Atout France IM059190009)." lang="fr">

  <!-- TOP ANNOUNCEMENT BANNER -->
  <aside aria-label="Bannière d'information" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">-100€</strong> sur votre séjour nov. 2027 avec le code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Fermer">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <Header isTransparent={false} currentPath="/mentions-legales" />

  <!-- HERO BANNER -->
  <section class="relative bg-slate-950 text-white pt-32 pb-16 px-4 sm:px-6 lg:px-8 border-b border-white/10">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-400 font-semibold mb-2">
        <a href="/" class="hover:text-white transition-colors">Accueil</a>
        <span>›</span>
        <span class="text-amber-100 font-bold">Mentions Légales & Conditions</span>
      </nav>
      <span class="text-xs font-black uppercase tracking-widest text-[#0e8354] bg-[#0e8354]/10 px-3 py-1 rounded-full border border-[#0e8354]/30 inline-block">Transparence & Cadre Réglementaire MyWay</span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
        Mentions légales & cadre réglementaire
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Informations juridiques, statut de conseiller voyage indépendant membre du Collectif My Way, opérateur de voyages officiel, réceptif local au Népal et protection des données personnelles.
      </p>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-10 font-sans text-slate-800">

    <!-- 1. ÉDITEUR DU SITE -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          1
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Éditeur du site
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>Le site internet <strong class="text-slate-950">https://junglenepal.com</strong> est édité par :</p>
        <ul class="space-y-2 pl-4 border-l-2 border-[#0e8354] font-medium text-slate-800">
          <li><strong>Nom commercial :</strong> Jungle Nepal Adventure — Autoentreprise</li>
          <li><strong>Dénomination sociale :</strong> ROZIER ROBIN</li>
          <li><strong>SIRET :</strong> <span class="font-mono">91025797100010</span> · RCS BESANCON</li>
          <li><strong>Adresse :</strong> 4 rue guy moquet, 66310 Estagel, France</li>
          <li><strong>Contact :</strong> <a href="mailto:junglenepaladventure@gmail.com" class="text-[#0e8354] font-bold hover:underline">junglenepaladventure@gmail.com</a> · <a href="tel:+33695413227" class="text-[#0e8354] font-bold hover:underline">+33 6 95 41 32 27</a></li>
          <li><strong>Responsable de la publication :</strong> Robin Rozier</li>
        </ul>
        <div class="mt-4 p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs space-y-1 text-slate-700">
          <p class="font-bold text-slate-900">En partenariat avec l'agence réceptive locale au Népal :</p>
          <p><strong>Jungle Nepal Adventure Pvt. Ltd.</strong> · Société de droit népalais agréée par le Ministère de l'Industrie et l'Office du Tourisme du Népal.</p>
          <p>Immatriculation : <span class="font-mono font-bold">N° 384414/82/83</span> · Numéro fiscal (PAN) : <span class="font-mono font-bold">623537310</span> · Siège : Thakurdwara-09, Parc National de Bardia, Népal · Direction : Pawan Thapa & Kiran Pokhrel.</p>
        </div>
      </div>
    </section>

    <!-- 2. ACTIVITÉ ET CADRE RÉGLEMENTAIRE (MYWAY SAS) -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          2
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Activité et cadre réglementaire
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-4 pt-2">
        <p>
          <strong>Jungle Nepal Adventure</strong> est conseiller voyage indépendant, membre du <strong>Collectif My Way</strong>, et intervient en qualité d'apporteur d'affaires de <strong>MYWAY SAS</strong>. Les voyages présentés sur ce site sont conseillés et accompagnés par Jungle Nepal Adventure, puis organisés et vendus par MYWAY SAS.
        </p>
        
        <div class="p-5 rounded-2xl bg-emerald-50/60 border border-emerald-200/80 space-y-2 text-slate-800">
          <p class="font-black text-slate-950 text-base">Opérateur de voyages officiel (Vendeur) :</p>
          <ul class="space-y-1.5 text-xs sm:text-sm">
            <li><strong>Raison sociale :</strong> MYWAY SAS</li>
            <li><strong>Adresse du siège :</strong> 165 avenue de Bretagne, 59000 LILLE, France</li>
            <li><strong>Immatriculation :</strong> SIRET 85137544400011 · RCS Lille · SAS au capital de 7 500 €</li>
            <li><strong>Licence Atout France :</strong> Opérateur de voyages immatriculé <span class="font-mono font-bold text-slate-950">IM059190009</span></li>
            <li><strong>Garantie financière :</strong> GROUPAMA ASSURANCE-CRÉDIT & CAUTION</li>
            <li><strong>Assurance responsabilité civile professionnelle :</strong> GENERALI IARD</li>
          </ul>
        </div>

        <div class="pt-2">
          <a href="https://v2.welcome.collectifmyway.com/verification/jungle-nepal-adventure" target="_blank" rel="noopener noreferrer" class="inline-block hover:opacity-95 hover:scale-[1.01] transition-all rounded-xl overflow-hidden shadow border border-slate-200" title="Vérification officielle Membre du Collectif MyWay">
            <img src="https://api.collectifmyway.com/v1/api/welcome/members/jungle-nepal-adventure/badge.svg" alt="Membre du Collectif MyWay" width="240" height="56" loading="lazy" class="w-auto h-12 object-contain block" />
          </a>
        </div>

        <p class="text-xs sm:text-sm text-slate-600">
          Le contrat de voyage est conclu avec <strong>MYWAY SAS</strong>, qui en assure l'exécution ; ses conditions générales de vente vous sont remises avant toute réservation et tout paiement.
        </p>
      </div>
    </section>

    <!-- 3. HÉBERGEMENT DU SITE -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          3
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Hébergement
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>Le site est hébergé sur les infrastructures sécurisées de :</p>
        <ul class="space-y-1.5 pl-4 border-l-2 border-[#0e8354] font-medium text-slate-800">
          <li><strong>Hébergeur :</strong> Hostinger International Ltd. / Hostinger Operations UAB</li>
          <li><strong>Adresse :</strong> Švitrigailos str. 34, 03230 Vilnius, Lituanie</li>
          <li><strong>Site Web :</strong> <a href="https://www.hostinger.com" target="_blank" rel="noopener noreferrer" class="text-[#0e8354] font-bold hover:underline">https://www.hostinger.com</a></li>
        </ul>
      </div>
    </section>

    <!-- 4. MODALITÉS DE PAIEMENT & CONTRAT DE VOYAGE -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          4
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Réservations & Modalités de Paiement
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          Les réservations sont opérées dans le respect des garanties financières et légales obligatoires pour le voyageur :
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
          <li><strong>Acompte de confirmation :</strong> Un acompte de <strong>30%</strong> du montant total du séjour est requis pour bloquer définitivement votre place en micro-groupe, réserver les hébergements en éco-lodges/bivouacs et émettre les permis des parcs nationaux.</li>
          <li><strong>Règlement du solde :</strong> Le solde de 70% est payable au plus tard <strong>30 jours</strong> avant la date de début de votre expédition.</li>
          <li><strong>Moyens de paiement acceptés :</strong> Cartes bancaires sécurisées (Visa, Mastercard, American Express), virements bancaires SEPA/SWIFT.</li>
        </ul>
      </div>
    </section>

    <!-- 5. POLITIQUE D'ANNULATION ET DE REMBOURSEMENT -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          5
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Politique d'Annulation & de Remboursement
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>En cas d'annulation de votre fait, le barème de remboursement applicable est le suivant (notification par écrit à junglenepaladventure@gmail.com) :</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border border-slate-200 rounded-xl overflow-hidden mt-2">
            <thead class="bg-slate-900 text-white font-bold">
              <tr>
                <th class="p-3">Délai avant le départ</th>
                <th class="p-3">Conditions de remboursement</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-slate-700">
              <tr class="bg-emerald-50/50">
                <td class="p-3 font-semibold text-slate-900">Plus de 45 jours avant le départ</td>
                <td class="p-3 font-bold text-[#0e8354]">Remboursement de 100% de l'acompte (hors frais bancaires et permis nominatifs non remboursables émis)</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900">Entre 44 et 30 jours avant le départ</td>
                <td class="p-3">Conservation de l'acompte de 30% (possibilité de report sur accord)</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900">Entre 29 et 15 jours avant le départ</td>
                <td class="p-3">Remboursement de 50% du montant total du séjour</td>
              </tr>
              <tr class="bg-slate-50">
                <td class="p-3 font-semibold text-slate-900">Moins de 14 jours ou non-présentation (No-Show)</td>
                <td class="p-3 text-slate-600">Aucun remboursement (frais logistiques et d'encadrement déjà engagés à 100%)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 6. ASSURANCE VOYAGE OBLIGATOIRE & SÉCURITÉ -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          6
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Assurance Voyage & Sécurité Terrain
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          En raison de la nature immersive des safaris à pied et expéditions en jungle/montagne au Népal, chaque voyageur doit obligatoirement souscrire avant son départ une <strong>assurance individuelle multirisque</strong> couvrant :
        </p>
        <ul class="list-disc pl-5 space-y-1 text-xs sm:text-sm">
          <li>Les frais médicaux et d'hospitalisation d'urgence au Népal.</li>
          <li>Le rapatriement sanitaire d'urgence et le secours/évacuation par hélicoptère.</li>
          <li>L'assurance annulation et la perte/vol de bagages et matériel photo.</li>
        </ul>
        <p class="pt-1 text-xs text-slate-600">
          Sur le terrain, nos maîtres pisteurs et chefs d'expédition sont seuls habilités à adapter l'itinéraire pour des motifs stricts de sécurité face à la faune ou aux conditions météo.
        </p>
      </div>
    </section>

    <!-- 7. PROPRIÉTÉ INTELLECTUELLE -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          7
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Propriété intellectuelle
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          L'ensemble des photographies animalières, visuels, textes descriptifs des circuits, logos et structure du site sont protégés par le droit de la propriété intellectuelle. Toute reproduction ou diffusion sans autorisation préalable écrite est strictement interdite.
        </p>
      </div>
    </section>

    <!-- 8. DONNÉES PERSONNELLES -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          8
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Données personnelles
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          Les informations que vous transmettez via ce site sont traitées par Jungle Nepal Adventure pour répondre à vos demandes et préparer votre projet de voyage. Les données nécessaires à la réservation sont transmises à MYWAY SAS, vendeur du voyage.
        </p>
        <p>
          Vous disposez d'un droit d'accès, de rectification, d'effacement et d'opposition sur vos données, à exercer par email : <a href="mailto:junglenepaladventure@gmail.com" class="text-[#0e8354] font-bold hover:underline">junglenepaladventure@gmail.com</a>. Vous pouvez également introduire une réclamation auprès de la CNIL (Commission Nationale de l'Informatique et des Libertés — <a href="https://www.cnil.fr" target="_blank" rel="noopener noreferrer" class="text-[#0e8354] underline">cnil.fr</a>).
        </p>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <Footer lang="fr" />

</Layout>
