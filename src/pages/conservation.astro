---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Conservation à Bardia : Association des Guides NAGA & Tigres"
  description="Initiative de conservation communautaire à Bardia avec la Nature Guide Association (NAGA) : sécurité des pisteurs Tharu, protection du tigre et villages."
  image="/assets/naga/naga_guides_tronc_riviere.webp"
  lang="fr"
>

  <!-- 2. NAVBAR DU SITE (FOND CLAIR STANDARD) -->
  <Header lang="fr" currentPath="/conservation" />

  <!-- WRAPPER GLOBAL FOND CLAIR ORGANIQUE (STYLE DOSSIER INSTITUTIONNEL / REVUE EDITORIALE) -->
  <div class="bg-[#faf8f5] text-slate-900 font-sans min-h-screen selection:bg-[#0e8354] selection:text-white">

    <!-- 3. HERO INSTITUTIONNEL AVEC PHOTO DE FOND (SOLIDARITÉ EN JUNGLE) -->
    <section class="relative py-12 sm:py-20 lg:py-24 border-b border-[#e7e2d8] overflow-hidden">
      <!-- Image de fond authentique de solidarité des guides nettement visible -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/naga/naga_solidarite_portage_tronc_riviere.webp" 
          alt="Solidarité des guides de jungle à Bardia" 
          class="w-full h-full object-cover object-center filter brightness-95 contrast-105"
          fetchpriority="high"
        />
        <!-- Voile blanc équilibré : photo nettement visible tout en assurant une parfaite lisibilité du texte -->
        <div class="absolute inset-0 bg-white/50"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-white/60 via-white/40 to-[#faf8f5]"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 sm:space-y-8">
        
        <!-- BLOC OFFICIEL CO-BRANDING : JUNGLE NEPAL ADVENTURE × NAGA -->
        <div class="inline-flex items-center justify-center gap-3.5 sm:gap-8 px-4 py-2.5 sm:p-5 rounded-2xl sm:rounded-3xl bg-white/95 backdrop-blur-md border border-[#e4ded3] shadow-md">
          <!-- Logo Jungle Nepal Adventure -->
          <div class="flex items-center justify-center">
            <img 
              src="/assets/logo_header_dark.png" 
              alt="Logo Jungle Nepal Adventure" 
              class="h-9 sm:h-14 w-auto object-contain"
              loading="eager"
            />
          </div>
          
          <!-- Symbole d'Alliance -->
          <div class="flex flex-col items-center justify-center">
            <span class="text-slate-400 font-light text-lg sm:text-2xl leading-none">×</span>
            <span class="text-[8px] sm:text-[9px] font-black uppercase tracking-widest text-[#0e8354] mt-0.5">Alliance</span>
          </div>

          <!-- Logo NAGA Sceau Officiel -->
          <div class="flex items-center justify-center">
            <img 
              src="/assets/naga/naga_logo_transparent.webp" 
              alt="Sceau officiel Nature Guide Association Bardiya NAGA 2054" 
              class="h-10 sm:h-16 w-auto object-contain"
              loading="eager"
            />
          </div>
        </div>

        <!-- Titrage Institutionnel -->
        <div class="space-y-3 sm:space-y-4 max-w-4xl mx-auto">
          <h1 class="text-2xl xs:text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-[1.18] sm:leading-[1.12]">
            Protéger ceux qui protègent la nature.
          </h1>

          <p class="text-[10px] sm:text-xs font-bold uppercase tracking-wider sm:tracking-widest text-[#0e8354]">
            Protecting Guides • Empowering Communities • Conserving Wildlife
          </p>

          <p class="text-sm sm:text-lg lg:text-xl text-slate-800 max-w-3xl mx-auto font-medium leading-relaxed pt-1 sm:pt-2">
            À Bardia, l'agence locale <strong>Jungle Nepal Adventure</strong> et la <strong>Nature Guide Association (NAGA)</strong> s'unissent sans intermédiaire pour sécuriser les guides de jungle, pérenniser les savoirs ancestraux du pistage et apaiser la coexistence entre prédateurs et villages riverains.
          </p>

          <!-- CTA Hero : Découvrir nos actions sur le terrain -->
          <div class="pt-2 sm:pt-4 flex justify-center">
            <a 
              href="#missions" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 sm:px-7 sm:py-3.5 rounded-full bg-[#0e8354] hover:bg-[#0c6d46] text-white font-bold text-xs sm:text-sm shadow-sm hover:scale-105 active:scale-95 transition-all"
            >
              <span>Découvrir nos actions sur le terrain</span>
              <span class="text-xs">↓</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- 4. SECTION 1 : PRÉSENTATION DE LA NATURE GUIDE ASSOCIATION (NAGA) -->
    <section id="naga" class="py-12 sm:py-20 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-[#e7e2d8]">
      
      <!-- Grille 2 Colonnes : Bloc Texte à Gauche & Photobloc Porte du Parc à Droite -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center mb-10 sm:mb-16">
        
        <!-- Bloc Texte à Gauche -->
        <div class="lg:col-span-6 space-y-4 sm:space-y-5">
          <span class="text-[10px] sm:text-xs font-black uppercase tracking-wider sm:tracking-widest text-[#0e8354]">
            Association Historique • Fondée en 1998 (2054 BS) à Bardia
          </span>
          <h2 class="text-xl sm:text-3xl lg:text-4xl font-black text-slate-950 tracking-tight leading-tight">
            La Nature Guide Association (NAGA) de Bardia
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Fondée en 1998 (2054 BS) à Thakurdwara, la <strong>Nature Guide Association (NAGA)</strong> regroupe et représente l'ensemble des guides naturalistes et pisteurs professionnels agréés par le Département des Parcs Nationaux à Bardia.
          </p>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Présidée par <strong>Krisna Saha</strong>, elle structure la vie de la jungle, forme les jeunes recrues, encadre les règles de sécurité des voyageurs lors des safaris à pied et assure une passerelle permanente de médiation avec les villages riverains du parc.
          </p>
        </div>

        <!-- Photobloc à Droite : Guides devant la porte du Parc National de Bardia -->
        <div class="lg:col-span-6">
          <div class="bg-white p-2.5 sm:p-4 rounded-2xl sm:rounded-3xl border border-[#e5dfd3] shadow-sm">
            <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] sm:aspect-[4/3] max-h-[320px] sm:max-h-[440px]">
              <img 
                src="/assets/naga/naga_porte_bardiya_national_park.webp" 
                alt="Guides naturalistes NAGA devant la porte d'entrée officielle du Parc National de Bardia" 
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="pt-2 sm:pt-3 px-1 sm:px-2 text-[11px] sm:text-xs text-slate-500 font-medium">
              <strong class="text-slate-900">Porte officielle du Parc National de Bardia</strong> — Guides et pisteurs naturalistes certifiés NAGA rassemblés avant les départs de patrouille en jungle.
            </p>
          </div>
        </div>

      </div>

      <!-- Le Fond de notre Collaboration : Jungle Nepal Adventure × NAGA -->
      <div class="my-10 sm:my-16 p-5 sm:p-8 lg:p-12 rounded-2xl sm:rounded-3xl bg-white border border-[#e4ded3] shadow-2xs space-y-6 sm:space-y-10">
        
        <div class="max-w-3xl space-y-2 sm:space-y-3">
          <span class="text-[10px] sm:text-xs font-mono uppercase tracking-wider sm:tracking-widest text-[#0e8354] font-semibold block">
            Notre Alliance de Terrain • Objectif 2027
          </span>
          <h3 class="text-xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-tight leading-tight">
            Le fond de notre collaboration : des drames réels à l'assurance de tous les guides
          </h3>
          <p class="text-slate-600 text-xs sm:text-sm md:text-base leading-relaxed">
            Jungle Nepal Adventure n'est pas née dans un bureau d'agence lointain, mais dans la terre et l'intimité de la jungle de Bardia, aux côtés de Pawan Thapa, Krisna Saha et des pisteurs historiques de la région. Notre engagement est né d'épreuves bien réelles, vécues dans notre propre chair.
          </p>
        </div>

        <!-- Le Storytelling des drames réels & la genèse de l'assurance -->
        <div class="space-y-3 sm:space-y-4 text-slate-600 text-xs sm:text-sm md:text-base leading-relaxed pt-2 border-t border-stone-200/70">
          <p>
            Dans la jungle de Bardia, le danger n'est pas une métaphore de brochure : <strong>Krisna Saha</strong>, l'actuel président de la NAGA, a lui-même survécu à une violente attaque de tigre du Bengale lors d'une patrouille en forêt. <strong>Pawan Thapa</strong>, co-fondateur de Jungle Nepal Adventure, a fait une chute grave depuis la cime d'un arbre lors d'un repérage en jungle. Plus douloureux encore, un de nos amis et guides proches a tragiquement perdu la vie, tué sous la charge brutale d'un rhinocéros unicorne.
          </p>
          <p>
            Ces drames successifs ont été un électrochoc. Face aux charges d'animaux sauvages et aux accidents en pleine nature, les guides de Bardia ne disposaient historiquement d'aucun filet de sécurité ni de prise en charge médicale, laissant les familles seules face aux dettes d'hospitalisation. C'est avec ces expériences douloureuses que nous avons compris qu'un système d'assurance était vital : <strong>notre première étape prioritaire est d'offrir une véritable assurance privée à tous les guides de l'association</strong>.
          </p>
        </div>

        <!-- Les 3 Piliers Concrets de notre engagement -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 sm:gap-8 pt-4 sm:pt-6 border-t border-stone-200/70 text-xs text-slate-600">
          <div class="p-3.5 sm:p-0 rounded-xl bg-stone-50/70 sm:bg-transparent border border-stone-200/60 sm:border-0 space-y-1 sm:space-y-2">
            <span class="text-slate-900 font-bold text-xs sm:text-sm block">1. Don fixe par voyageur</span>
            <p class="leading-relaxed">
              Jungle Nepal Adventure s'est engagée à reverser un <strong>montant fixe sous forme de don pour chaque participant</strong> à nos circuits. Chaque voyageur contribue directement, sans surcoût, au fonds de protection des guides.
            </p>
          </div>
          <div class="p-3.5 sm:p-0 rounded-xl bg-stone-50/70 sm:bg-transparent border border-stone-200/60 sm:border-0 space-y-1 sm:space-y-2">
            <span class="text-slate-900 font-bold text-xs sm:text-sm block">2. Assurance privée totale d'ici 2027</span>
            <p class="leading-relaxed">
              L'objectif central de ce fonds est de <strong>fournir une couverture d'assurance privée intégrale à l'ensemble des guides de l'association NAGA</strong>. Nous devrions atteindre cet objectif d'ici 2027.
            </p>
          </div>
          <div class="p-3.5 sm:p-0 rounded-xl bg-stone-50/70 sm:bg-transparent border border-stone-200/60 sm:border-0 space-y-1 sm:space-y-2">
            <span class="text-slate-900 font-bold text-xs sm:text-sm block">3. Soutien de terrain immédiat</span>
            <p class="leading-relaxed">
              En parallèle, nous finançons l'achat de trousses médicales traumatologiques (garrots, pansements hémostatiques) et épaulons les familles des pisteurs lors des périodes d'inactivité ou d'urgence.
            </p>
          </div>
        </div>

        <!-- Passerelle Voyage & Impact Direct (Point 2) -->
        <div class="p-4 sm:p-6 lg:p-8 rounded-xl sm:rounded-2xl bg-[#faf8f5] border border-stone-200/80 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 sm:gap-6">
          <div class="space-y-1 sm:space-y-1.5 max-w-2xl">
            <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-[#0e8354] font-semibold block">Participer en voyageant • Horizon 2027</span>
            <h4 class="font-bold text-slate-950 text-sm sm:text-base lg:text-lg leading-snug">
              Chaque voyageur finance l'assurance privée des guides de jungle
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              En partant en safari à pied avec Jungle Nepal Adventure, une part fixe de votre séjour est directement allouée à la souscription d'une assurance privée pour chaque guide membre de la NAGA. Notre but commun : 100% des guides couverts dès 2027.
            </p>
          </div>
          <div class="shrink-0 pt-1 md:pt-0">
            <a 
              href="/destinations/bardia/" 
              class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm transition-colors shadow-2xs whitespace-nowrap"
            >
              <span>Découvrir nos safaris à Bardia</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- La Réalité du Terrain : Conflit Hommes-Faune & Rôle Clé des Guides (2 Blocs Côte à Côte avec Photo de Tigre) -->
      <div class="my-10 sm:my-16 p-5 sm:p-8 lg:p-12 rounded-2xl sm:rounded-3xl bg-white border border-[#e4ded3] shadow-2xs">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 lg:gap-14 items-center">
          
          <!-- Bloc 1 : Texte Pur Épuré sans bulles ni points (lg:col-span-7) -->
          <div class="lg:col-span-7 space-y-3 sm:space-y-4">
            <span class="text-[10px] sm:text-xs font-mono uppercase tracking-wider sm:tracking-widest text-[#0e8354] font-semibold block">
              Cohabitation & Terrain • Conflit Hommes-Faune
            </span>
            <h3 class="text-xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-tight leading-tight">
              Vivre aux portes des prédateurs : la réalité crue des conflits
            </h3>
            
            <div class="space-y-3 sm:space-y-4 text-slate-600 text-xs sm:text-sm md:text-base leading-relaxed pt-1 sm:pt-2">
              <p>
                À Bardia, la conservation ne se résume pas à des statistiques réjouissantes : avec plus de 125 tigres du Bengale et d'importantes populations de rhinocéros unicornes et d'éléphants sauvages, la cohabitation quotidienne avec les villages riverains de la zone tampon est sous haute tension.
              </p>
              <p>
                La nuit, des hardes d'éléphants traversent les rivières pour piller les récoltes de riz et démolir les maisons en terre afin d'atteindre les réserves de grain. En lisière de forêt, les incursions de tigres et de léopards provoquent des attaques tragiques sur les villageois qui ramassent du bois de chauffe ou gardent le bétail. Récemment encore, une charge mortelle de rhinocéros a coûté la vie à un guide professionnel en pleine jungle : le danger est une réalité de chaque instant.
              </p>
              <p>
                Face à cette urgence, les discours politiques lointains ou les passages éclairs d'ONG ne peuvent suffire. Nous avons l'intime conviction que <strong>les guides de jungle sont les acteurs numéro 1 et les mieux placés</strong> pour trouver des solutions viables : issus de ces mêmes communautés, ils partagent les épreuves des familles et possèdent la maîtrise intime des comportements animaux pour intervenir sans panique.
              </p>
              <p>
                Leur travail repose avant tout sur <strong>la communication et la sensibilisation permanente auprès des habitants</strong> : désamorcer la colère après des ravages pour empêcher les empoisonnements de représailles, transmettre les bons réflexes d'évitement et éduquer les enfants dans les écoles pour bâtir une coexistence apaisée et durable.
              </p>
            </div>
          </div>

          <!-- Bloc 2 : Photobloc Tigre du Bengale (lg:col-span-5) -->
          <div class="lg:col-span-5">
            <div class="bg-white p-2.5 sm:p-4 rounded-2xl sm:rounded-3xl border border-[#e5dfd3] shadow-sm">
              <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] sm:aspect-[4/3] max-h-[300px] sm:max-h-[460px]">
                <img 
                  src="/assets/curated_gallery/tigre_bengale_penombre_sal.webp" 
                  alt="Tigre du Bengale dans la forêt de Sal au Parc National de Bardia" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <p class="pt-2 sm:pt-3 px-1 sm:px-2 text-[11px] sm:text-xs text-slate-500 font-medium">
                <strong class="text-slate-900">Tigre du Bengale dans la forêt de Sal</strong> — À Bardia, les guides de jungle sont en première ligne pour protéger les prédateurs tout en sécurisant les villages riverains.
              </p>
            </div>
          </div>

        </div>
      </div>

      <!-- Ce que fait la NAGA au quotidien : Les 6 Missions Statutaires -->
      <div id="missions" class="space-y-6 pt-6 sm:pt-8 border-t border-[#e7e2d8]">
        <div class="max-w-2xl space-y-2">
          <span class="text-xs font-black uppercase tracking-widest text-[#0e8354]">Missions de Terrain</span>
          <h3 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-950">
            Ce que fait la NAGA au quotidien : 6 missions d'action
          </h3>
          <p class="text-xs sm:text-sm text-slate-600">
            Les six champs d'action statutaires conduits par l'association au service du parc national et des communautés riveraines :
          </p>
        </div>

        <!-- Les 6 Cartes Missions Aérées en 2 Colonnes avec Photos -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
          
          <!-- MISSION 01 -->
          <div class="p-4 sm:p-6 lg:p-7 rounded-2xl sm:rounded-3xl bg-[#faf8f5] border border-[#e4ded3] flex flex-col justify-between space-y-4 sm:space-y-6 shadow-2xs hover:shadow-md transition-shadow">
            <div class="space-y-3.5 sm:space-y-4">
              <div class="flex items-center justify-between border-b border-stone-200/60 pb-2">
                <span class="text-xs font-mono text-stone-400">MISSION 01</span>
                <span class="text-xs font-mono uppercase tracking-wider text-stone-600 font-medium">
                  Communauté
                </span>
              </div>

              <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] border border-slate-200">
                <img 
                  src="/assets/naga/naga_sensibilisation_ecole_journee_tigre.webp" 
                  alt="Sensibilisation communautaire à Bardia" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <h4 class="font-bold text-base sm:text-lg text-slate-950 leading-snug">
                Sensibilisation communautaire
              </h4>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Organisation de programmes d'information réguliers dans les villages riverains sur la conservation de la faune, la biodiversité et l'importance cruciale de préserver le parc national.
              </p>

              <ul class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-200/60">
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Ateliers réguliers de sensibilisation dans les écoles et villages riverains.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Sensibilisation aux consignes de sécurité face aux prédateurs et éléphants.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- MISSION 02 -->
          <div class="p-4 sm:p-6 lg:p-7 rounded-2xl sm:rounded-3xl bg-[#faf8f5] border border-[#e4ded3] flex flex-col justify-between space-y-4 sm:space-y-6 shadow-2xs hover:shadow-md transition-shadow">
            <div class="space-y-3.5 sm:space-y-4">
              <div class="flex items-center justify-between border-b border-stone-200/60 pb-2">
                <span class="text-xs font-mono text-stone-400">MISSION 02</span>
                <span class="text-xs font-mono uppercase tracking-wider text-stone-600 font-medium">
                  Salubrité
                </span>
              </div>

              <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] border border-slate-200">
                <img 
                  src="/assets/naga/naga_herbes_hautes_savane.webp" 
                  alt="Propreté et assainissement à Bardia" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <h4 class="font-bold text-base sm:text-lg text-slate-950 leading-snug">
                Propreté et assainissement
              </h4>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Organisation de campagnes régulières de nettoyage et de ramassage des déchets autour du parc national, le long des sentiers pédestres, sur les berges des rivières et dans les villages voisins.
              </p>

              <ul class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-200/60">
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Ramassage systématique des plastiques le long des cours d'eau et pistes.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Préservation active des berges de la Karnali et des corridors écologiques.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- MISSION 03 -->
          <div class="p-4 sm:p-6 lg:p-7 rounded-2xl sm:rounded-3xl bg-[#faf8f5] border border-[#e4ded3] flex flex-col justify-between space-y-4 sm:space-y-6 shadow-2xs hover:shadow-md transition-shadow">
            <div class="space-y-3.5 sm:space-y-4">
              <div class="flex items-center justify-between border-b border-stone-200/60 pb-2">
                <span class="text-xs font-mono text-stone-400">MISSION 03</span>
                <span class="text-xs font-mono uppercase tracking-wider text-stone-600 font-medium">
                  Formation
                </span>
              </div>

              <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] border border-slate-200">
                <img 
                  src="/assets/naga/naga_traversee_gue_riviere.webp" 
                  alt="Formation initiale des guides naturalistes" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <h4 class="font-bold text-base sm:text-lg text-slate-950 leading-snug">
                Formation initiale des guides
              </h4>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Formation de base dispensée aux jeunes locaux souhaitant devenir guides naturalistes : identification des espèces, comportement animal, ornithologie, sécurité en jungle et gestion des visiteurs.
              </p>

              <ul class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-200/60">
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Transmission du pistage traditionnel et lecture d'empreintes par les aînés.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Protocoles stricts de sécurité, gestion des charges et gestes de premiers secours.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- MISSION 04 -->
          <div class="p-4 sm:p-6 lg:p-7 rounded-2xl sm:rounded-3xl bg-[#faf8f5] border border-[#e4ded3] flex flex-col justify-between space-y-4 sm:space-y-6 shadow-2xs hover:shadow-md transition-shadow">
