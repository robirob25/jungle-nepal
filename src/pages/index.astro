import Footer from '../components/Footer.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<Layout title="Jungle Nepal Adventure | Agence locale au Népal : Safaris & Treks" lang="fr" description="Agence locale francophone au Népal. Safaris éthiques en jungle (Bardia, Chitwan), treks hors des sentiers battus et immersions en micro-groupe de 4 à 10 pers.">


