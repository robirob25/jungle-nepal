        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none z-0 transition-opacity duration-700"
      />
      <!-- Autoplay looping muted HTML5 video without play button overlay -->
      <video
        id="hero-desktop-video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none z-10 transition-opacity duration-500 opacity-0"
      >
        <source src="/assets/hero/hero_desktop_v2.mp4" type="video/mp4" />
      </video>

      <script is:inline>
        (function() {
          var v = document.getElementById('hero-desktop-video');
          var p = document.getElementById('hero-desktop-poster');
          if (!v) return;

          function onPlaying() {
            v.classList.remove('opacity-0');
            v.classList.add('opacity-100');
            if (p) p.classList.add('opacity-0');
          }

          v.addEventListener('playing', onPlaying, { once: true });
          v.addEventListener('timeupdate', function onTime() {
            if (v.currentTime > 0.05) {
              onPlaying();
              v.removeEventListener('timeupdate', onTime);
            }
          });

          function playHeroVideo() {
            if (!v.paused && v.currentTime > 0) {
              onPlaying();
              return;
            }
            var promise = v.play();
            if (promise && typeof promise.then === 'function') {
              promise.then(onPlaying).catch(function() {
                var events = ['click', 'scroll', 'pointerdown'];
                var handler = function() {
                  v.play().then(onPlaying);
                  events.forEach(function(e) { window.removeEventListener(e, handler); });
                };
                events.forEach(function(e) { window.addEventListener(e, handler, { passive: true, once: true }); });
              });
            }
          }

          if (v.readyState >= 2) {
            playHeroVideo();
          } else {
            v.addEventListener('loadeddata', playHeroVideo, { once: true });
            v.addEventListener('canplay', playHeroVideo, { once: true });
          }

          document.addEventListener('visibilitychange', function() {
