  </div>


  <!-- ========================================================================= -->
  <!-- 3. HERO SECTION (WeRoad Layout épuré avec la charte Verte & Or) -->
  <!-- ========================================================================= -->
  <section class="relative min-h-[92vh] sm:min-h-screen flex flex-col justify-start sm:justify-between items-center pt-36 sm:pt-40 lg:pt-44 pb-6 sm:pb-8 px-4 sm:px-6 lg:px-8 overflow-hidden bg-slate-950">
    
    <!-- MOBILE VIDEO HERO BACKGROUND (< md: 768px) -->
    <div class="block md:hidden absolute inset-0 z-0 overflow-hidden pointer-events-none bg-slate-950">
      <!-- Background Poster (Rendered directly, NO video poster attribute so WebKit NEVER shows a play button icon!) -->
      <img
        id="hero-mobile-poster"
        src="/assets/hero/hero_mobile_v2_poster.webp"
        alt="Safari Népal"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none z-0 transition-opacity duration-700"
      />
      <video
        id="hero-mobile-video"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        x5-playsinline
        disablepictureinpicture
        disableremoteplayback
        preload="metadata"
        class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none z-10 opacity-0 transition-opacity duration-500"
      >
        <source src="/assets/hero/hero_mobile_v2.mp4" type="video/mp4" />
        <source src="/assets/hero/hero_mobile_v2.webm" type="video/webm" />
      </video>
      <script is:inline>
        (function() {
          var v = document.getElementById('hero-mobile-video');
          var poster = document.getElementById('hero-mobile-poster');
          if (!v) return;
          v.muted = true;
          v.defaultMuted = true;
          
          function onPlaying() {
            v.classList.remove('opacity-0');
            v.classList.add('opacity-100');
            if (poster) {
              setTimeout(function() { poster.style.opacity = '0'; }, 300);
            }
          }

          v.addEventListener('playing', onPlaying, { once: true });
          v.addEventListener('timeupdate', function firstFrame() {
            if (v.currentTime > 0.1) {
              onPlaying();
              v.removeEventListener('timeupdate', firstFrame);
            }
          });

          function playHeroVideo() {
            if (!v.paused) {
              onPlaying();
              return;
            }
            var p = v.play();
            if (p && typeof p.then === 'function') {
              p.then(onPlaying).catch(function() {
                var events = ['touchstart', 'touchend', 'click', 'scroll', 'pointerdown'];
                var handler = function() {
                  v.play().then(onPlaying);
                  events.forEach(function(e) { window.removeEventListener(e, handler); });
                };
                events.forEach(function(e) { window.addEventListener(e, handler, { passive: true, once: true }); });
              });
            }
          }

          if (v.readyState >= 2) {
            playHeroVideo();
          } else {
            v.addEventListener('loadeddata', playHeroVideo, { once: true });
            v.addEventListener('canplay', playHeroVideo, { once: true });
          }

          document.addEventListener('visibilitychange', function() {
            if (!document.hidden) playHeroVideo();
          });
          window.addEventListener('pageshow', playHeroVideo);
        })();
      </script>
      <style is:global>
        #hero-mobile-video::-webkit-media-controls,
        #hero-mobile-video::-webkit-media-controls-start-playback-button,
        #hero-mobile-video::-webkit-media-controls-play-button,
        #hero-mobile-video::-webkit-media-controls-overlay-play-button,
        #hero-mobile-video::-webkit-media-controls-panel {
          display: none !important;
          -webkit-appearance: none !important;
          opacity: 0 !important;
          visibility: hidden !important;
          width: 0 !important;
          height: 0 !important;
          pointer-events: none !important;
        }
      </style>
    </div>

    <!-- DESKTOP CINEMA HERO VIDEO (>= md: 768px) -->
    <div class="hidden md:block absolute inset-0 z-0 overflow-hidden pointer-events-none bg-slate-950" id="hero-desktop-container">
      <!-- High-res desktop poster image -->
      <img
        id="hero-desktop-poster"
        src="/assets/hero/hero_desktop_v2_poster.webp"
