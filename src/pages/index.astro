  <script is:inline>
    if (typeof lucide !== 'undefined' && lucide && lucide.createIcons) { lucide.createIcons(); }
    function toggleMobileMenu() {
      document.getElementById('mobile-menu').classList.toggle('hidden');
    }

    
    function scrollCategories(amount) {
      const el = document.getElementById('categories-scroll-container');
      if (el) {
        el.scrollBy({ left: amount, behavior: 'smooth' });
      }
    }

        function filterTrips(filterKey, shouldScroll) {
      const cards = document.querySelectorAll('#trips-grid .trip-card');
      const pills = document.querySelectorAll('.category-pill');
      let visibleCount = 0;

      if (shouldScroll) {
        const toursSection = document.getElementById('prochains-departs');
        if (toursSection) {
          const headerHeight = 70;
          const rect = toursSection.getBoundingClientRect();
          const targetScrollTop = rect.top + window.pageYOffset - headerHeight;
          window.scrollTo({
            top: Math.max(0, targetScrollTop),
            behavior: 'smooth'
          });
        }
      }

      const keyLower = (filterKey || 'all').toLowerCase().trim();

      pills.forEach(pill => {
        const filterVal = (pill.getAttribute('data-filter') || '').toLowerCase().trim();
        if (filterVal === keyLower) {
          pill.className = 'category-pill active flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-950 text-white font-extrabold text-xs sm:text-sm whitespace-nowrap shadow-md border border-slate-900 transition-all duration-200 cursor-pointer shrink-0';
        } else {
          pill.className = 'category-pill flex items-center gap-2 px-5 py-2.5 rounded-full bg-white hover:bg-slate-100 text-slate-900 font-bold text-xs sm:text-sm whitespace-nowrap border border-slate-200/90 shadow-sm hover:shadow hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer shrink-0';
        }
      });

      cards.forEach(card => {
        const rawCats = card.getAttribute('data-category') || '';
        const cardCats = rawCats.toLowerCase().split(/\s+/);
        const rawLocs = card.getAttribute('data-location') || '';
        const cardLocs = rawLocs.toLowerCase().split(/\s+/);
        
        let match = false;
        if (keyLower === 'all') {
          match = true;
        } else if (keyLower === 'safari') {
          match = cardCats.includes('safari');
        } else if (keyLower === 'combine' || keyLower === 'grand-tour' || keyLower === 'jungle-montagne') {
          match = cardCats.includes('combine') || cardCats.includes('grand-tour');
        } else if (keyLower === 'culture') {
          match = cardCats.includes('culture');
        } else if (keyLower === 'courts' || keyLower === 'sejours-courts' || keyLower === 'short-stays') {
          match = cardCats.includes('courts') || cardCats.includes('sejours-courts') || cardCats.includes('court');
        } else if (cardLocs.includes(keyLower)) {
          match = true;
        } else {
          match = cardCats.includes(keyLower);
        }

        if (match) {
          card.classList.remove('hidden');
          card.style.removeProperty('display');
          visibleCount++;
        } else {
          card.classList.add('hidden');
          card.style.display = 'none';
        }
      });
    }

    function handleSearch(e) {
      e.preventDefault();
      const dest = document.getElementById('search-dest').value;
      filterTrips(dest, true);
    }

    function openCustomTripModal() {
      document.getElementById('custom-trip-modal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeCustomTripModal() {
      document.getElementById('custom-trip-modal').classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    function handleCustomTripSubmit(e) {
      e.preventDefault();
      alert('🙏 Namasté ! Votre demande a été transmise directement à Robin et Pawan.');
      closeCustomTripModal();
    }
  </script>

  


