  <script is:inline>
  function toggleMobileMenu() {
    const menu = document.getElementById("mobile-menu");
    if (menu) menu.classList.toggle("hidden");
  }
  function toggleAllDays() {
    const detailsList = document.querySelectorAll("#programme details");
    if (!detailsList.length) return;
    const anyClosed = Array.from(detailsList).some(d => !d.open);
    detailsList.forEach(d => d.open = anyClosed);
  }
  function handleShareTour() {
    const menu = document.getElementById('share-menu');
    if (menu) {
      const isHidden = menu.classList.contains('pointer-events-none');
      if (isHidden) {
        menu.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        menu.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        const url = window.location.href;
        const text = encodeURIComponent("Découvrez ce circuit exclusif au Népal : Spécial festival de Dashain ! " + url);
        const wa = document.getElementById('share-whatsapp');
        if (wa) wa.href = `https://wa.me/?text=${text}`;
        const mail = document.getElementById('share-email');
        if (mail) mail.href = `mailto:?subject=${encodeURIComponent("Circuit Népal : Spécial Festival de Dashain")}&body=${text}`;
      } else {
        menu.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
        menu.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      }
    }
  }
  function copyTourLink() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      alert("Lien du séjour copié dans le presse-papier !");
    });
  }
  </script>

