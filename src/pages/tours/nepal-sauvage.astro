          'Accept': 'application/json'
        },
        body: JSON.stringify({
          _subject: '📥 Nouveau téléchargement Carnet PDF : ' + tourSlug,
          _template: 'table',
          _captcha: 'false',
          prenom: prenom,
          email: email,
          circuit: tourSlug,
          page_url: window.location.href,
          date_demande: new Date().toLocaleString('fr-FR')
        })
      });
    } catch (err) {
