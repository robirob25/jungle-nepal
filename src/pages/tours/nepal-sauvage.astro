        <span>À propos</span>
      </a>

      <!-- Blog (safarinepal.fr) -->
      <a href="https://safarinepal.fr" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 text-slate-200 hover:text-white transition-colors">
