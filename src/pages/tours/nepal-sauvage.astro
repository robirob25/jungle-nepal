---
import Layout from '../../layouts/Layout.astro';
---

  <!-- SCHEMA.ORG TOURIST TRIP JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TouristTrip",
    "name": "Népal sauvage – de la jungle aux montagnes sacrées",
    "description": "Ce voyage n’est pas un simple circuit. C’est un passage à travers trois Népal . La jungle de Bardia , les temples perchés dans les collines, les villages himalayens où l’accueil est franc et immédiat, puis l’ énergie brute de Katmandou. Vous suivrez les traces du tigre, rencontrerez des locaux, traverserez des rizières centenaires et passerez la nu",
    "image": "https://junglenepal.com/assets/original_site/himalayas_sunrise_peaks.webp",
    "touristType": ["Amoureux de nature", "Photographes animaliers", "Aventuriers"],
    "offers": {
      "@type": "Offer",
      "price": "2,300",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-08-01",
      "url": "https://junglenepal.com/tours/nepal-sauvage.html"
    },
    "provider": {
      "@type": "TravelAgency",
      "name": "Jungle Nepal Adventure",
      "url": "https://junglenepal.com"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "38",
      "bestRating": "5"
    }
  }
  </script>

<Layout title="Népal sauvage – de la jungle aux montagnes sacrées | Jungle Nepal Adventure" lang="fr">


