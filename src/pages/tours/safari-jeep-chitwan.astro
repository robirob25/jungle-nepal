---
import { getLocalizedPath } from '../../i18n/utils';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import DayTourBookingWidget from '../../components/DayTourBookingWidget.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
import Header from '../../components/Header.astro';
---

  <!-- SCHEMA.ORG TOURIST TRIP & FAQ JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": [
    "TouristTrip",
    "Product"
  ],
  "name": "Safari en Jeep privatisée à Chitwan",
  "description": "Journée complète d'exploration motorisée en jeep 4x4 privatisée au cœur du parc national de Chitwan. Traque des rhinocéros unicornes, tigres du Bengale, éléphants et ours lippus avec chauffeur, guide naturaliste senior et pisteur d'élite.",
  "image": "https://junglenepal.com/assets/tours_thumbs/safari_jeep_chauffeur_chitwan.webp",
  "touristType": [
    "Amoureux de nature",
    "Photographes animaliers",
    "Aventuriers",
    "Familles"
  ],
  "offers": {
    "@type": "Offer",
    "price": "190",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-08-01",
    "url": "https://junglenepal.com/tours/safari-jeep-chitwan",
    "priceValidUntil": "2027-12-31",
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "FR",
      "returnPolicyCountry": "FR",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnFees": "https://schema.org/FreeReturn",
      "merchantReturnLink": "https://junglenepal.com/mentions-legales/"
    }
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Jungle Nepal Adventure",
    "url": "https://junglenepal.com",
    "logo": "https://junglenepal.com/assets/logo_nav_white.png",
    "email": "contact@junglenepal.com",
    "telephone": "+33695413227",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bardia & Katmandou",
      "addressCountry": "NP"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "22",
    "bestRating": "5"
  },
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": 1,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "TouristAttraction",
          "name": "Jour 1 – Exploration complète 4x4 des plaines et forêts de Sal de Chitwan",
          "description": "Départ à 06h00 en jeep privatisée depuis Sauraha. Traversée de la Rapti, inspection des pistes sablonneuses de Sal, marécages aux rhinocéros, déjeuner pique-nique en mirador et affûts fluviaux. Retour vers 18h00."
        }
      }
    ]
  },
  "brand": {
    "@type": "Brand",
    "name": "Jungle Nepal Adventure"
  }
}
  </script>

  <!-- SCHEMA.ORG FAQPAGE (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Le véhicule est-il totalement privatisé ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, le véhicule tout-terrain 4x4 est entièrement privatisé pour votre groupe ou vous seul. Vous ne partagez jamais la voiture avec d'autres touristes inconnus, ce qui permet de s'arrêter aussi longtemps que vous le désirez lors des observations de faune."
      }
    },
    {
      "@type": "Question",
      "name": "Quelle est la différence entre le safari en Jeep et le safari à pied à Chitwan ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La Jeep permet de parcourir de très grandes distances (jusqu'à 60-80 km au cours de la journée), de traverser différentes zones géographiques du parc et de pénétrer dans les forêts profondes sans fatigue. Le safari à pied offre une immersion silencieuse au ras du sol. Beaucoup de nos voyageurs combinent une journée en Jeep et une journée à pied pour une expérience complète."
      }
    },
    {
      "@type": "Question",
      "name": "Les droits d'entrée et permis sont-ils inclus ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolument. Le tarif de 190 € comprend l'intégralité des coûts gouvernementaux : votre permis d'entrée personnel officiel du parc national de Chitwan, ainsi que la taxe d'entrée et le permis spécifique du véhicule 4x4."
      }
    },
    {
      "@type": "Question",
      "name": "Comment rejoindre Sauraha / Chitwan depuis Katmandou ou Pokhara ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sauraha est accessible quotidiennement par bus touristique confortable (environ 5 à 6 heures de route depuis Katmandou ou Pokhara), par véhicule privé avec chauffeur, ou par un vol court de 20 minutes vers l'aéroport de Bharatpur suivi de 30 minutes de taxi. Nous pouvons également organiser vos transferts si besoin."
      }
    }
  ]
}
  </script>

  <!-- SCHEMA.ORG FAQPAGE (RICH SNIPPETS GOOGLE) -->

<Layout 
  title="Safari Jeep Chitwan privatisé (190€) : grand tour faune 4x4"
  description="Safari 4x4 privatisé à Chitwan pour 190€ la journée complète. Pénétrez au cœur des savanes et forêts primaires pour observer rhinocéros et faune sauvage."
  lang="fr"
>

  <!-- TOP BAR PROMO -->
  <aside class="bg-[#05281a] text-white text-[11px] sm:text-xs py-1.5 px-4 relative z-50 text-center border-b border-emerald-800/20" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex-1 flex items-center justify-center gap-2 overflow-hidden whitespace-nowrap text-ellipsis">
        <span><strong class="text-amber-300">Exploration 4x4 privatisée</strong> à Chitwan • Accès aux secteurs calmes & traque des rhinocéros</span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/70 hover:text-white text-xs px-1 cursor-pointer">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <Header lang="fr" isTransparent={false} currentPath={Astro.url.pathname} />

  <!-- MAIN TOUR CONTENT -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 font-sans">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-semibold mb-3 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-slate-900 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span>Accueil</span>
      </a>
      <span>›</span>
      <a href="/#prochains-departs" class="hover:text-slate-900">Nos séjours</a>
      <span>›</span>
      <span class="text-slate-900 font-bold truncate">Safari en Jeep au parc national de Chitwan</span>
    </nav>

    <!-- Header Title & Badges Row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6">
      <div>
        <h1 class="font-black text-2xl sm:text-4xl lg:text-5xl text-slate-950 tracking-tight leading-tight">
          Safari en Jeep privatisée au parc national de Chitwan
        </h1>
        <p class="text-base sm:text-xl font-bold text-[#0e8354] mt-1.5">
          Explorez les plaines et jungles de Chitwan en Jeep safari privatisée
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-xs sm:text-sm">
          <span class="inline-flex items-center gap-1.5 font-bold text-slate-700 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">
            <svg class="w-4 h-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
            <span>1 journée (06h00 – 18h00)</span>
          </span>
          <div class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-900 font-bold px-3 py-1 rounded-full border border-emerald-200">
            <svg class="w-4 h-4 text-amber-400 fill-amber-400 shrink-0" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <span>5.0 (22 avis vérifiés)</span>
          </div>
          <span class="text-xs font-bold bg-slate-900 text-amber-100 px-3 py-1 rounded-full border border-amber-300/30">
            Jeep 4x4 privatisée + chauffeur
          </span>
          <span class="text-xs font-bold bg-emerald-950 text-emerald-300 px-3 py-1 rounded-full border border-emerald-700/40">
            1 guide senior + 1 pisteur d’élite
          </span>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex items-center gap-2 shrink-0">
        <div class="relative">
          <button 
            type="button" 
            onclick="handleShareTour()" 
            class="flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200/80 transition-all cursor-pointer select-none active:scale-95"
            aria-label="Partager ce séjour"
          >
            <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
            <span>Partager cette activité</span>
          </button>
          <div id="share-menu" class="absolute right-0 top-full mt-2 w-48 bg-white border border-slate-200 rounded-2xl p-2 shadow-xl space-y-1 text-xs font-semibold text-slate-700 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 z-50">
            <button onclick="copyTourLink()" class="w-full text-left px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors flex items-center gap-2">
              <span>📋</span> <span>Copier le lien</span>
            </button>
            <a href="https://wa.me/?text=Découvre%20le%20Safari%20en%20Jeep%20à%20Chitwan%20sur%20Jungle%20Nepal%20Adventure%20:%20https://junglenepaladventure.com/tours/safari-jeep-chitwan" target="_blank" rel="nofollow noopener noreferrer" class="w-full text-left px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors flex items-center gap-2 block">
               <span>Partager sur WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- PHOTO MOSAIC GALLERY (5 PHOTOS) -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-2.5 sm:gap-3 rounded-2xl sm:rounded-3xl overflow-hidden h-[280px] sm:h-[380px] md:h-[480px] mb-8 relative shadow-lg">
      <div class="md:col-span-2 h-full overflow-hidden">
        <img loading="eager" decoding="sync" src="/assets/tours_thumbs/safari_jeep_chauffeur_chitwan.webp" alt="Chauffeur en Jeep 4x4 safari ouverte dans le parc national de Chitwan" class="w-full h-full object-cover object-center transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(0)"/>
      </div>
      <div class="hidden md:block md:col-span-1 h-full overflow-hidden">
        <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_jeep_rhino_eau_chitwan.webp" alt="Rhinocéros unicorne dans un point d'eau à Chitwan" class="w-full h-full object-cover transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(1)"/>
      </div>
      <div class="hidden md:flex flex-col gap-3 h-full">
        <div class="h-1/2 overflow-hidden rounded-tr-2xl">
          <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_jeep_elephant_foret_chitwan.webp" alt="Éléphant d'Asie dans la forêt luxuriante de Chitwan" class="w-full h-full object-cover transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(2)"/>
        </div>
        <div class="h-1/2 overflow-hidden rounded-br-2xl relative">
          <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_jeep_gavial_riviere_chitwan.webp" alt="Crocodile gavial du Gange au bord de l'eau à Chitwan" class="w-full h-full object-cover object-center transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(3)"/>
        </div>
      </div>

      <button onclick="openLightbox(0)" class="absolute bottom-4 right-4 bg-white/95 backdrop-blur-md hover:bg-white text-slate-900 font-bold text-xs sm:text-sm px-4 py-2 rounded-xl shadow-lg border border-slate-200 flex items-center gap-2 transition-all hover:scale-105 cursor-pointer">
        <svg class="w-4 h-4 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
        <span>Voir les 5 photos</span>
      </button>
    </div>

    <!-- STICKY SUB-NAV BAR -->
    <nav class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-md py-2.5 sm:py-3 transition-all -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 mb-8 sm:mb-10" aria-label="Navigation du séjour">
      <div class="flex items-center justify-between gap-4">
        <div class="hidden sm:flex items-center gap-2.5 shrink-0 min-w-0">
          <div class="min-w-0">
            <p class="font-extrabold text-xs text-slate-900 truncate max-w-[240px]">Safari en Jeep — Chitwan</p>
            <p class="text-[11px] font-bold text-[#0e8354]"><span id="subnav-price-display">190€</span> <span class="text-slate-400 font-normal">/ pers.</span></p>
          </div>
        </div>

        <div class="flex items-center gap-4 sm:gap-6 lg:gap-8 overflow-x-auto no-scrollbar text-xs sm:text-sm font-bold text-slate-600 py-1">
          <a href="#apercu" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Aperçu</a>
          <a href="#deroulement" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Organisation</a>
          <a href="#inclusions" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Inclusions</a>
          <a href="#avis-voyageurs" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Avis (22)</a>
          <a href="#faq" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">FAQ</a>
        </div>

        <button 
          onclick="openTourBookingModal()" 
          class="shrink-0 px-4 sm:px-5 py-2 rounded-full bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs shadow-md transition-all cursor-pointer whitespace-nowrap"
        >
          <span>Réserver (190€)</span>
        </button>
      </div>
    </nav>

    <!-- 2-COLUMNS GRID LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- LEFT COLUMN: TOUR DETAILS -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- SECTION 1: APERÇU / INTRODUCTION -->
        <section id="apercu" class="scroll-mt-28 space-y-6">
          <div class="prose prose-slate max-w-none text-sm sm:text-base leading-relaxed text-slate-700">
            <h2 class="font-black text-2xl sm:text-3xl text-slate-950 tracking-tight not-prose mb-4">
              Explorez les plaines et jungles de Chitwan en Jeep safari privatisée
            </h2>
            <p class="text-base sm:text-lg text-slate-800 leading-relaxed font-normal not-prose">
              Privatisée pour votre groupe (jusqu'à 6 personnes) au tarif de <strong>190 € la journée complète</strong>, cette excursion en 4x4 tout-terrain s'enfonce profondément dans la zone cœur classée UNESCO du <strong>parc national de Chitwan</strong> (secteurs préservés de Kasara et Sukhibhar). Guidée par un chauffeur chevronné et un guide naturaliste senior, la formule inclut tous les permis du parc et le déjeuner en brousse pour maximiser l'observation des rhinocéros unicornes, ours lippus, gavials et tigres du Bengale.
            </p>
            <p>
              Plongez au cœur du plus ancien et célèbre parc national du Népal pour une journée complète d’exploration motorisée en totale immersion. Inscrit au patrimoine mondial de l'UNESCO, le parc national de Chitwan offre une mosaïque d'habitats exceptionnelle : vastes forêts de Sal, prairies alluviales géantes et méandres fluviaux propices à une remarquable densité de faune.
            </p>
            <p>
              À bord d’un véhicule 4x4 privatisé et ouvert, vous êtes accompagné par un chauffeur chevronné, un guide naturaliste senior spécialiste du Terai et un pisteur d’élite. L'itinérance en jeep permet de s'éloigner des circuits courts touristiques pour s'enfoncer dans les secteurs calmes du parc, franchir les cours d'eau et guetter les passages d'animaux le long des corridors de forêt primaire.
            </p>
            <p>
              Le déjeuner pique-nique est partagé en pleine jungle, à l’abri d’un mirador sécurisé dominant un point d’eau ou une boucle fluviale. Formule 100 % clé en main : tous les permis d'entrée et taxes gouvernementales sont intégralement inclus.
            </p>
          </div>

          <!-- Avertissement éthique & nature sauvage -->
          <div class="p-5 sm:p-6 rounded-3xl bg-amber-500/10 border border-amber-500/30 text-amber-950 space-y-2">
            <div class="flex items-center gap-2 font-black text-sm text-amber-900 uppercase tracking-wider">
              <span>⚠️</span>
              <span>Engagement d’éthique et nature 100 % sauvage</span>
            </div>
            <p class="text-xs sm:text-sm text-amber-900/90 leading-relaxed">
              Les animaux évoluent en liberté totale dans un écosystème naturel protégé de plus de 930 km². Leurs déplacements sont libres et aucune observation particulière ne peut être garantie à l'avance. La jeep progresse à allure modérée, moteur éteint dès l'approche des zones d'observation afin de préserver la tranquillité des animaux et d'assurer une expérience respectueuse.
            </p>
          </div>

          <!-- Points forts en grille bento -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200">
                🚙
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm">4x4 Intégralement Privatisé</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Véhicule tout-terrain ouvert réservé exclusivement pour vous. Chauffeur professionnel, carburant et permis 4x4 inclus.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200">
                🦏
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm">Royaume du Rhinocéros & du Tigre</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                La plus forte densité de rhinocéros unicornes d'Asie au Népal, ainsi qu'ours lippus, gavials et prédateurs de la forêt de Sal.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200">
                👥
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm">Équipe Complète de Terrain</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                1 chauffeur expérimenté + 1 guide naturaliste senior natif de Chitwan + 1 pisteur d'élite pour une détection optimale.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200">
                🥪
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm">Pause Déjeuner en Pleine Jungle</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Pique-nique partagé à l'abri d'un mirador sauvage (Machan) surplombant les points d'eau et les plaines inondables.
              </p>
            </div>
          </div>
        </section>

        <!-- SECTION 2: DÉROULEMENT / ORGANISATION -->
        <section id="deroulement" class="scroll-mt-28 pt-8 border-t border-slate-200 space-y-6">
          <div>
            <span class="text-xs font-black uppercase tracking-widest text-[#0e8354]">Organisation et déroulement</span>
            <h2 class="font-black text-2xl sm:text-3xl text-slate-950 tracking-tight mt-1">
              Votre journée type de Jeep safari à Chitwan
            </h2>
          </div>

          <div class="space-y-4">
            <!-- Etape 1 -->
            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0e8354] font-black text-sm flex items-center justify-center shrink-0 border border-emerald-200">
                06h00
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-base">Départ matinal & embarquement 4x4</h3>
                <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
