          <a href="/index.html#concept" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Nos guides</a>
          <a href="/index.html#galerie-faune" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Galerie</a>
