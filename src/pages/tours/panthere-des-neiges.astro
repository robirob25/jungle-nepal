      console.log('Lead submitted:', err);
    }

    alert('Merci ' + prenom + ' ! Votre carnet de route détaillé a été transmis à ' + email + ' et notre équipe a été notifiée.');
    if (btn) {
      btn.innerHTML = 'Télécharger mon carnet (PDF) →';
      btn.disabled = false;
    }
    closePdfModal();
  }
  </script>
