        Explorer les 15 séjours et départs →
      </a>
    </div>

  </div>

  <!-- MAIN TOUR CONTENT -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 font-sans">
    
