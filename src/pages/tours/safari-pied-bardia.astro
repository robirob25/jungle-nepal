  <script is:inline>
    // Gallery & Lightbox (5 Photos)
    window.mainGalleryImages = [
      "/assets/tours_thumbs/safari_pied_guide_jungle_bardia.webp",
      "/assets/tours_thumbs/tigre_jungle_marche.webp",
      "/assets/tours_thumbs/rhino_vegetation_bardia.webp",
      "/assets/tours_thumbs/elephant_sal_foret_bardia.webp",
      "/assets/tours_thumbs/guide_jumelles_arbre_bardia.webp"
    ];
    window.roomImages = [
      "/assets/tours_thumbs/chambre_pawan_bardia.webp",
      "/assets/tours_thumbs/salle_de_bain_pawan_bardia.webp"
    ];
    window.galleryImages = window.mainGalleryImages;
    window.currentImageIndex = 0;

    window.openLightbox = function(index) {
      window.galleryImages = window.mainGalleryImages;
      window.currentImageIndex = typeof index === 'number' ? index : 0;
      window.updateLightboxContent();
      var modal = document.getElementById('lightbox-modal');
      if (modal) {
        modal.classList.remove('hidden');
        setTimeout(function() {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
        }, 10);
      }
      document.body.style.overflow = 'hidden';
    };

    window.openRoomLightbox = function(index) {
      window.galleryImages = window.roomImages;
      window.currentImageIndex = typeof index === 'number' ? index : 0;
      window.updateLightboxContent();
      var modal = document.getElementById('lightbox-modal');
      if (modal) {
        modal.classList.remove('hidden');
        setTimeout(function() {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
        }, 10);
      }
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function() {
      var modal = document.getElementById('lightbox-modal');
      if (modal) {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        setTimeout(function() {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
          window.galleryImages = window.mainGalleryImages;
        }, 300);
      }
    };

    window.updateLightboxContent = function() {
      var img = document.getElementById('lightbox-image');
      var counter = document.getElementById('lightbox-counter');
      if (img && window.galleryImages && window.galleryImages[window.currentImageIndex]) {
        img.src = window.galleryImages[window.currentImageIndex];
      }
      if (counter && window.galleryImages) {
        counter.textContent = (window.currentImageIndex + 1) + ' / ' + window.galleryImages.length;
      }
    };

    window.prevLightboxImage = function(e) {
      if (e && e.stopPropagation) e.stopPropagation();
      if (!window.galleryImages || !window.galleryImages.length) return;
      window.currentImageIndex = (window.currentImageIndex - 1 + window.galleryImages.length) % window.galleryImages.length;
      window.updateLightboxContent();
    };

    window.nextLightboxImage = function(e) {
      if (e && e.stopPropagation) e.stopPropagation();
      if (!window.galleryImages || !window.galleryImages.length) return;
      window.currentImageIndex = (window.currentImageIndex + 1) % window.galleryImages.length;
      window.updateLightboxContent();
    };

    document.addEventListener('keydown', function(e) {
      var modal = document.getElementById('lightbox-modal');
      if (modal && !modal.classList.contains('hidden')) {
        if (e.key === 'Escape') window.closeLightbox();
        if (e.key === 'ArrowLeft') window.prevLightboxImage();
        if (e.key === 'ArrowRight') window.nextLightboxImage();
      }
    });

    // Mobile Menu
    function toggleMobileMenu() {
      var menu = document.getElementById("mobile-menu");
      if (menu) menu.classList.toggle("hidden");
    }

    // Interactive Guide Room Option (+12€) Controller
    window.isGuideOptionSelected = false;

    window.toggleGuideOption = function(forceState) {
      if (typeof forceState === 'boolean') {
        window.isGuideOptionSelected = forceState;
      } else {
        window.isGuideOptionSelected = !window.isGuideOptionSelected;
      }
      
      window.isCampingSelected = window.isGuideOptionSelected;

      var basePrice = 50;
      var optionPrice = 12;
      var currentPrice = window.isGuideOptionSelected ? (basePrice + optionPrice) : basePrice;

      var priceDisplay = document.getElementById('tour-price-display');
      if (priceDisplay) priceDisplay.textContent = currentPrice + '€';

      var subnavPrice = document.getElementById('subnav-price-display');
      if (subnavPrice) subnavPrice.textContent = currentPrice + '€';

      var mobileBottomPrice = document.getElementById('mobile-bottom-price');
      if (mobileBottomPrice) mobileBottomPrice.textContent = currentPrice + '€';

      var checkbox = document.getElementById('sidebar-guide-room-checkbox');
      if (checkbox) checkbox.checked = window.isGuideOptionSelected;

      var btnText = document.getElementById('guide-room-btn-text');
      var btnIcon = document.getElementById('guide-room-btn-icon');
      var toggleBtn = document.getElementById('toggle-guide-room-btn');
      var ctaBtnText = document.getElementById('cta-button-text');

      if (window.isGuideOptionSelected) {
        if (btnText) btnText.textContent = "Option sélectionnée (62€)";
        if (btnIcon) btnIcon.textContent = "✓";
        if (toggleBtn) {
          toggleBtn.classList.remove('bg-[#0e8354]', 'hover:bg-[#0c6d46]');
          toggleBtn.classList.add('bg-amber-400', 'hover:bg-amber-500', 'text-slate-950');
        }
        if (ctaBtnText) ctaBtnText.textContent = "Réserver avec nuit chez Pawan (62 €) →";
      } else {
        if (btnText) btnText.textContent = "Ajouter l'option (+12€)";
        if (btnIcon) btnIcon.textContent = "＋";
        if (toggleBtn) {
          toggleBtn.classList.add('bg-[#0e8354]', 'hover:bg-[#0c6d46]');
          toggleBtn.classList.remove('bg-amber-400', 'hover:bg-amber-500', 'text-slate-950');
        }
        if (ctaBtnText) ctaBtnText.textContent = "Réserver ce safari (50 €) →";
      }

      var tourTitle = encodeURIComponent(window.isGuideOptionSelected ? "Safari à pied Bardia + Nuit chez Pawan (62€)" : "Safari à pied 1 jour à Bardia (50€)");
      var waUrl = "https://wa.me/33695413227?text=" + encodeURIComponent("Bonjour Robin, je souhaite réserver le tour : ") + tourTitle;
      var waBtn = document.getElementById('sidebar-whatsapp-btn');
      if (waBtn) waBtn.href = waUrl;
      var waMobile = document.getElementById('mobile-bottom-whatsapp');
      if (waMobile) waMobile.href = waUrl;
    };

    window.handleShareTour = function() {
      var shareMenu = document.getElementById('share-menu');
      if (shareMenu) {
        var isHidden = shareMenu.classList.contains('opacity-0');
        if (isHidden) {
          shareMenu.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
          shareMenu.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        } else {
          shareMenu.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
          shareMenu.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        }
      }
    };

    window.copyTourLink = function() {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(window.location.href).then(function() {
          alert('Lien copié dans le presse-papier !');
        });
      }
    };
  </script>

</Layout>
