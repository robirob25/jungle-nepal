---
import { getLocalizedPath } from '../../i18n/utils';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

  <!-- SCHEMA.ORG TOURIST TRIP & FAQ JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Safari à pied au parc national de Bardia",
  "description": "Une journée entière au cœur de la jungle de Bardia. Safari pédestre guidé par un maître pisteur et un assistant à la recherche du tigre du Bengale, rhinocéros unicorne et éléphants sauvages.",
  "image": "https://junglenepal.com/assets/tours_thumbs/safari_pied_guide_jungle_bardia.webp",
  "touristType": [
    "Amoureux de nature",
    "Photographes animaliers",
    "Aventuriers",
    "Randonneurs"
  ],
  "offers": {
    "@type": "Offer",
    "price": "50",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-08-01",
    "url": "https://junglenepal.com/tours/safari-pied-bardia"
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Jungle Nepal Adventure",
    "url": "https://junglenepal.com",
    "logo": "https://junglenepal.com/assets/logo_nav_white.png",
    "email": "contact@junglenepal.com",
    "telephone": "+33695413227",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bardia & Katmandou",
      "addressCountry": "NP"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "24",
    "bestRating": "5"
  },
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": 1,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "TouristAttraction",
          "name": "Jour 1 – Safari à pied journée complète à Bardia",
          "description": "Départ à 6h30 pour une journée complète d'observation et de traque à pied dans la jungle de Bardia. Déjeuner pique-nique inclus sous la canopée. Retour vers 18h00."
        }
      }
    ]
  }
}
  </script>


<Layout title="Safari à pied Bardia (50€) : réserver avec un guide local" lang="fr">

  <!-- TOP BAR PROMO -->
  <aside class="bg-[#05281a] text-white text-[11px] sm:text-xs py-1.5 px-4 relative z-50 text-center border-b border-emerald-800/20" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex-1 flex items-center justify-center gap-2 overflow-hidden whitespace-nowrap text-ellipsis">
        <span><strong class="text-amber-300">Immersion 100% sauvage</strong> à Bardia • Guides natifs certifiés & traque à pied</span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/70 hover:text-white text-xs px-1 cursor-pointer">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <header class="relative z-40 bg-white border-b border-slate-200 py-2.5 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between gap-4 h-14 sm:h-16">
        <div class="flex items-center shrink-0">
          <a href="/" class="flex items-center gap-2 group">
            <img 
              src="/assets/logo_header_dark.png" 
              alt="Jungle Nepal Adventure" 
              width="168" 
              height="48" 
              loading="eager" 
              decoding="sync" 
              class="h-11 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform duration-200" 
            />
          </a>
        </div>

        <nav class="hidden lg:flex items-center justify-center gap-5 xl:gap-7 text-[13px] xl:text-[14px] font-semibold text-slate-700">
          <a href="/#prochains-departs" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Circuits & voyages</a>

          <div class="relative group py-2">
            <a href="/destinations" class="hover:text-[#0e8354] transition-colors flex items-center gap-1 cursor-pointer whitespace-nowrap">
              <span>Destinations</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
