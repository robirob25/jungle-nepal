---
import { getLocalizedPath } from '../../i18n/utils';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

  <!-- SCHEMA.ORG TOURIST TRIP & FAQ JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Safari en Jeep privatisée à Bardia",
  "description": "Journée complète d'exploration motorisée en jeep privatisée au cœur des secteurs les plus profonds du parc national de Bardia. Traque du tigre du Bengale, éléphants et rhinocéros avec chauffeur, guide senior et pisteur d'élite.",
  "image": "https://junglenepal.com/assets/tours_thumbs/safari_jeep_groupe_bardia.webp",
  "touristType": [
    "Amoureux de nature",
    "Photographes animaliers",
    "Aventuriers",
    "Familles"
  ],
  "offers": {
    "@type": "Offer",
    "price": "190",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-08-01",
    "url": "https://junglenepal.com/tours/safari-jeep-bardia"
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Jungle Nepal Adventure",
    "url": "https://junglenepal.com",
    "logo": "https://junglenepal.com/assets/logo_nav_white.png",
    "email": "contact@junglenepal.com",
    "telephone": "+33695413227",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bardia & Katmandou",
      "addressCountry": "NP"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "19",
    "bestRating": "5"
  },
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": 1,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "TouristAttraction",
          "name": "Jour 1 – Exploration complète 4x4 des secteurs profonds de Bardia",
          "description": "Départ à 06h00 en jeep privatisée. Traque matinale des empreintes en forêt de Sal, corridors d'éléphants, pique-nique en mirador et affûts le long de la Geruwa. Retour vers 18h00."
        }
      }
    ]
  }
}
  </script>

  <!-- SCHEMA.ORG FAQPAGE (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Le véhicule est-il privatisé ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, le véhicule tout-terrain 4x4 est intégralement privatisé pour vous (que vous soyez seul, en couple ou en petit groupe). Vous n'êtes jamais mélangé à d'autres voyageurs inconnus."
      }
    },
    {
      "@type": "Question",
      "name": "Quelle est la différence entre le safari en Jeep et le safari à pied ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La jeep permet de couvrir une superficie beaucoup plus vaste (40 à 70 km de pistes) et d'atteindre des corridors de faune très reculés tout en ménageant la fatigue physique. Le safari à pied offre quant à lui une immersion silencieuse et sensorielle au ras du sol. Combiner les deux est idéal si vous restez plusieurs jours."
      }
    },
    {
      "@type": "Question",
      "name": "Comment fonctionne l'option nuit chez Pawan (+12 €) ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'option comprend une nuitée en chambre privée climatisée avec salle de bain et douche privatives chez Pawan à Thakurdwara, le dîner traditionnel maison le soir et le petit-déjeuner copieux le lendemain matin."
      }
    },
    {
      "@type": "Question",
      "name": "Les permis d'entrée sont-ils inclus ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui ! Contrairement à d'autres formules, le tarif de base de 190 € comprend l'intégralité des taxes et permis officiels : votre permis d'entrée personnel au parc national de Bardia ainsi que le droit d'entrée gouvernemental du véhicule 4x4."
      }
    }
  ]
}
  </script>

