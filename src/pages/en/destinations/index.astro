      <img src="/assets/original_site/tigre_bardia.webp" alt="Tigre de Bardia" class="w-full h-full object-cover opacity-75 filter brightness-85 contrast-105"/>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-slate-950/60"></div>
