            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div id="mobile-dest-sub" class="hidden px-2 pb-2.5 space-y-1 border-t border-white/5 pt-2">
          <a href="/en/destinations/bardia" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            
            <div>
              <p class="font-bold text-white">Bardia National Park</p>
              <p class="text-[10px] text-slate-400">Bengal Tigers & Walking Safaris</p>
            </div>
          </a>
          <a href="/en/destinations/chitwan" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            
            <div>
              <p class="font-bold text-white">Chitwan National Park</p>
              <p class="text-[10px] text-slate-400">One-Horned Rhinos & River Canoes</p>
