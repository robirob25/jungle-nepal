---
import { getLocalizedPath } from '../../../i18n/utils';

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<Layout title="Destinations in Nepal | Jungle Nepal Adventure – Wild Sanctuaries & Himalayas" lang="en">


  <Header lang="en" currentPath="/en/destinations" />

  <!-- HERO HUB (ASSOMBRI POUR CONTRASTE OPTIMAL + SANS BADGE) -->
  <section class="relative min-h-[50vh] sm:min-h-[60vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 z-0">
      <img loading="lazy" decoding="async" src="/assets/original_site/tigre_bardia.webp" alt="Tigre de Bardia" class="w-full h-full object-cover opacity-75 filter brightness-85 contrast-105"/>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-slate-950/60"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center">
      <h1 class="font-black text-4xl sm:text-6xl md:text-7xl text-white tracking-tight leading-[1.08] drop-shadow-[0_4px_20px_rgba(0,0,0,0.9)]">
        Our Destinations
      </h1>
      <p class="mt-6 text-base sm:text-xl text-slate-200 max-w-2xl font-medium leading-relaxed drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
        From the pristine sanctuaries of the Terai to Himalayan summits, discover the 5 wild territories explored alongside our native master trackers.
      </p>
    </div>
  </section>

  <!-- GRILLE DES 5 DESTINATIONS -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <article class="group bg-white rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
      <a href="/en/destinations/bardia" class="relative aspect-[4/3] overflow-hidden block">
        <img decoding="async" src="/assets/original_site/tigre_bardia.webp" alt="Bardia National Park" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
        <span class="absolute top-4 left-4 bg-slate-950/80 backdrop-blur-md text-amber-100 text-xs font-black px-3.5 py-1.5 rounded-full border border-white/10 shadow">
          Bengal Tiger Sanctuary
        </span>
      </a>

      <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
        <div>
          <h2 class="font-black text-2xl text-slate-950 group-hover:text-[#0e8354] transition-colors tracking-tight leading-snug">
            <a href="/en/destinations/bardia">Bardia National Park</a>
          </h2>
          <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed font-normal mt-3">
            Prior to its official establishment in 1988, Bardia National Park was a royal hunting reserve. Its transformation into a protected sanctuary preserved one of Asia's wildest and most pristine ecosystems, renowned for tracking Bengal tigers on foot.
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100">
          <a href="/en/destinations/bardia" class="w-full py-3 px-4 rounded-2xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md shadow-emerald-950/20 active:scale-98 transition-all text-center">
            <span>Discover Destination</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </article>

        <article class="group bg-white rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
      <a href="/en/destinations/chitwan" class="relative aspect-[4/3] overflow-hidden block">
        <img decoding="async" src="/assets/original_site/chitwan_rhino.webp" alt="Chitwan National Park" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
        <span class="absolute top-4 left-4 bg-slate-950/80 backdrop-blur-md text-amber-100 text-xs font-black px-3.5 py-1.5 rounded-full border border-white/10 shadow">
          UNESCO World Heritage Site
        </span>
      </a>

      <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
        <div>
          <h2 class="font-black text-2xl text-slate-950 group-hover:text-[#0e8354] transition-colors tracking-tight leading-snug">
            <a href="/en/destinations/chitwan">Chitwan National Park</a>
          </h2>
          <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed font-normal mt-3">
            Inscribed as a UNESCO World Heritage site in 1984, Chitwan National Park hosts one of the most vibrant biodiversities in Asia, famous for its greater one-horned rhinos, marsh muggers, and peaceful river canoe safaris.
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100">
          <a href="/en/destinations/chitwan" class="w-full py-3 px-4 rounded-2xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md shadow-emerald-950/20 active:scale-98 transition-all text-center">
            <span>Discover Destination</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </article>

        <article class="group bg-white rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
      <a href="/en/destinations/suklaphanta" class="relative aspect-[4/3] overflow-hidden block">
        <img decoding="async" src="/assets/original_site/suklaphanta.webp" alt="Suklaphanta National Park" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
        <span class="absolute top-4 left-4 bg-slate-950/80 backdrop-blur-md text-amber-100 text-xs font-black px-3.5 py-1.5 rounded-full border border-white/10 shadow">
          The Untamed Wild West
        </span>
      </a>

      <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
        <div>
          <h2 class="font-black text-2xl text-slate-950 group-hover:text-[#0e8354] transition-colors tracking-tight leading-snug">
            <a href="/en/destinations/suklaphanta">Suklaphanta National Park</a>
          </h2>
          <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed font-normal mt-3">
            Located in far-western Nepal on the border of India, Suklaphanta National Park is one of the wildest, most untouched, and secluded wildernesses in the Himalayas, home to massive herds of swamp deer and elusive tigers.
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100">
          <a href="/en/destinations/suklaphanta" class="w-full py-3 px-4 rounded-2xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md shadow-emerald-950/20 active:scale-98 transition-all text-center">
            <span>Discover Destination</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </article>

        <article class="group bg-white rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
      <a href="/en/destinations/annapurna" class="relative aspect-[4/3] overflow-hidden block">
        <img decoding="async" src="/assets/original_site/machapuchare.webp" alt="Annapurna & Pokhara" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
        <span class="absolute top-4 left-4 bg-slate-950/80 backdrop-blur-md text-amber-100 text-xs font-black px-3.5 py-1.5 rounded-full border border-white/10 shadow">
          Sacred Peaks & Treks
        </span>
      </a>

      <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
        <div>
          <h2 class="font-black text-2xl text-slate-950 group-hover:text-[#0e8354] transition-colors tracking-tight leading-snug">
            <a href="/en/destinations/annapurna">Annapurna & Pokhara</a>
          </h2>
          <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed font-normal mt-3">
            The Annapurna region delivers astonishing geographic and cultural contrasts: from lush subtropical valleys to sheer glacial walls rising towards 8,000 meters, staying in welcoming Gurung mountain villages.
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100">
          <a href="/en/destinations/annapurna" class="w-full py-3 px-4 rounded-2xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md shadow-emerald-950/20 active:scale-98 transition-all text-center">
            <span>Discover Destination</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </article>

        <article class="group bg-white rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
      <a href="/en/destinations/katmandou" class="relative aspect-[4/3] overflow-hidden block">
        <img decoding="async" src="/assets/drive_photos/adrien_bhaktapur1.webp" alt="Kathmandu & la Vallée des Rois" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
        <span class="absolute top-4 left-4 bg-slate-950/80 backdrop-blur-md text-amber-100 text-xs font-black px-3.5 py-1.5 rounded-full border border-white/10 shadow">
          Ancient Valley & Temples
        </span>
      </a>

      <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
        <div>
          <h2 class="font-black text-2xl text-slate-950 group-hover:text-[#0e8354] transition-colors tracking-tight leading-snug">
            <a href="/en/destinations/katmandou">Kathmandu & Valley of Kings</a>
          </h2>
          <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed font-normal mt-3">
            At first glance, Kathmandu can seem bustling and intense. But give it a few hours, and it will enchant you with its ancient courtyards, spiritual fervor, and timeless sacred temples.
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100">
          <a href="/en/destinations/katmandou" class="w-full py-3 px-4 rounded-2xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md shadow-emerald-950/20 active:scale-98 transition-all text-center">
            <span>Discover Destination</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </article>
    </div>
  </main>

  <!-- FOOTER -->
    <!-- =========================================================================
       FOOTER COMPLET AVEC TOUT LE MENU DU SITE
       ========================================================================= -->
    <!-- =========================================================================
       FOOTER COMPLET AVEC TOUT LE MENU DU SITE
       ========================================================================= -->
  <Footer lang="en" />

  <!-- BOUTON RETOUR EN HAUT ÉLÉGANT & GRAPHIQUE -->
  <button id="back-to-top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" class="fixed bottom-6 right-6 z-40 bg-gradient-to-tr from-[#0e8354] to-[#10b981] hover:from-[#0c6d46] hover:to-[#059669] text-white p-3.5 sm:p-4 rounded-2xl shadow-[0_10px_30px_rgba(16,185,129,0.4)] hover:shadow-[0_14px_40px_rgba(16,185,129,0.6)] hover:-translate-y-1 active:translate-y-0 active:scale-90 transition-all duration-300 flex items-center justify-center cursor-pointer select-none group" aria-label="Retour en haut">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white group-hover:-translate-y-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>
  <script is:inline>
    if (typeof lucide !== 'undefined' && lucide && lucide.createIcons) { lucide.createIcons(); }
    window.addEventListener('scroll', () => {
      const btn = document.getElementById('back-to-top');
      if (!btn) return;
      if (window.scrollY > 300) {
        btn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        btn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
      } else {
        btn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      }
    });
  </script>
  <script is:inline defer src="/assets/js/translator.js"></script>

  <!-- MODAL AGRÉMENTS LÉGAUX ET LICENCES OFFICIELLES DU NÉPAL -->
  <div id="legal-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/85 backdrop-blur-md p-4 transition-opacity duration-300">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-slate-200 text-slate-900 relative max-h-[90vh] overflow-y-auto">
      <button onclick="closeLegalModal()" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 hover:text-slate-800 font-bold transition-colors cursor-pointer">✕</button>
      
      <div class="text-center space-y-2 pb-4 border-b border-slate-100">
        
        <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#0e8354] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">Government of Nepal</span>
        <h3 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">Jungle Nepal Adventure Pvt. Ltd.</h3>
        <p class="text-xs text-slate-500 font-medium">Officially registered and licensed ecotourism & expedition company in Nepal</p>
      </div>

      <div class="py-5 space-y-3.5 text-xs text-slate-700">
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-slate-500 uppercase text-[10px]">Certificate of Incorporation</span>
            <span class="font-black text-[#0e8354] bg-emerald-100/60 px-2 py-0.5 rounded text-[10px]">Official</span>
          </div>
          <p class="text-slate-900 font-black text-sm">Office of the Company Registrar, Nepal</p>
          <p class="font-mono text-xs font-bold text-slate-700">Registration No.: 384414/82/83</p>
          <p class="text-[11px] text-slate-500">Pursuant to Sub-Section (1) of Section 5 of the Companies Act, 2006 of Nepal.</p>
        </div>

        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-slate-500 uppercase text-[10px]">Tax & VAT Registration</span>
            <span class="font-black text-[#0e8354] bg-emerald-100/60 px-2 py-0.5 rounded text-[10px]">Verified</span>
          </div>
          <p class="text-slate-900 font-black text-sm">Inland Revenue Department of Nepal</p>
          <p class="font-mono text-xs font-bold text-slate-700">PAN Tax ID: 623537310</p>
          <p class="text-[11px] text-slate-500">Jurisdiction: Inland Revenue Office Nepalgunj.</p>
        </div>

        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
          <span class="font-bold text-slate-500 uppercase text-[10px] block">Registered Office & Operations</span>
          <p class="font-bold text-slate-900 text-xs">Thakurdwara Ward No. 9, Thakurbaba Municipality, Bardia District, Lumbini Province, Nepal</p>
          <p class="text-[11px] text-slate-500">Founder & Director: Pawan Kumar Thapa (Native Bardia Master Tracker)</p>
        </div>

        <div class="p-4 rounded-2xl bg-emerald-50/80 border border-emerald-200 text-slate-800 space-y-1.5 font-medium">
          <p class="font-bold text-[#0e8354] text-xs">State-Licensed Operating Activities:</p>
          <p class="text-[11px] leading-relaxed text-slate-700">Licensed organization of wildlife safaris, walking tracking of Bengal tigers, wild river expeditions (Karnali Rafting), wilderness bush camps, and certified ecotourism.</p>
        </div>
      </div>

      <div class="pt-2">
        <button onclick="closeLegalModal()" class="w-full py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition-colors cursor-pointer">
          Close Legal Notice
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
  function openLegalModal() {
    const m = document.getElementById('legal-modal');
    if (m) m.classList.remove('hidden');
  }
  function closeLegalModal() {
    const m = document.getElementById('legal-modal');
    if (m) m.classList.add('hidden');
  }
  </script>
</Layout>
