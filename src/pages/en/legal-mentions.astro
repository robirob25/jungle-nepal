---
import { getLocalizedPath } from '../../i18n/utils';

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<Layout 
  title="Legal Notice, Regulatory Framework & Privacy Policy | Jungle Nepal Adventure" 
  description="Legal notice for Robin Rozier / Jungle Nepal Adventure, independent travel advisor member of Collectif My Way (tour operator MYWAY SAS, Atout France IM059190009)." 
  lang="en"
>

  <!-- TOP ANNOUNCEMENT BANNER -->
  <aside aria-label="Information banner" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">€100 OFF</strong> your Nov. 2027 expedition with code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Close">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <Header isTransparent={false} currentPath="/en/legal-mentions" lang="en" />

  <!-- HERO BANNER -->
  <section class="relative bg-slate-950 text-white pt-32 pb-16 px-4 sm:px-6 lg:px-8 border-b border-white/10">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-400 font-semibold mb-2">
        <a href="/en/" class="hover:text-white transition-colors">Home</a>
        <span>›</span>
        <span class="text-amber-100 font-bold">Legal Notice & Terms</span>
      </nav>
      <span class="text-xs font-black uppercase tracking-widest text-[#0e8354] bg-[#0e8354]/10 px-3 py-1 rounded-full border border-[#0e8354]/30 inline-block">Transparency & Regulatory Framework</span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
        Legal Notice & Regulatory Framework
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Legal corporate disclosures, independent travel advisor status within Collectif My Way, licensed tour operator credentials, local DMC partner in Nepal, and personal data protection.
      </p>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-10 font-sans text-slate-800">

    <!-- 1. WEBSITE PUBLISHER -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          1
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Website Publisher
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>The website <strong class="text-slate-950">https://junglenepal.com</strong> is published and operated by:</p>
        <ul class="space-y-2 pl-4 border-l-2 border-[#0e8354] font-medium text-slate-800">
          <li><strong>Trade Name:</strong> Jungle Nepal Adventure — Sole Proprietorship (Autoentreprise)</li>
          <li><strong>Legal Entity:</strong> ROZIER ROBIN</li>
          <li><strong>Company Registration (SIRET):</strong> <span class="font-mono">91025797100010</span> · RCS BESANCON (France)</li>
          <li><strong>Registered Address:</strong> 4 rue guy moquet, 66310 Estagel, France</li>
          <li><strong>Contact:</strong> <a href="mailto:junglenepaladventure@gmail.com" class="text-[#0e8354] font-bold hover:underline">junglenepaladventure@gmail.com</a> · <a href="tel:+33695413227" class="text-[#0e8354] font-bold hover:underline">+33 6 95 41 32 27</a></li>
          <li><strong>Publication Director:</strong> Robin Rozier</li>
        </ul>
        <div class="mt-4 p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs space-y-1 text-slate-700">
          <p class="font-bold text-slate-900">In direct partnership with our local Destination Management Company (DMC) in Nepal:</p>
          <p><strong>Jungle Nepal Adventure Pvt. Ltd.</strong> · Registered tour operator licensed by the Ministry of Industry, Commerce and Supplies and Nepal Tourism Board.</p>
          <p>Company Registration: <span class="font-mono font-bold">No. 384414/82/83</span> · Tax Identification (PAN): <span class="font-mono font-bold">623537310</span> · Base: Thakurdwara-09, Bardia National Park, Nepal · Managing Team: Pawan Thapa & Kiran Pokhrel.</p>
        </div>
      </div>
    </section>

    <!-- 2. REGULATORY FRAMEWORK & COLLECTIF MY WAY -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          2
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Business Activity & Regulatory Framework
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-4 pt-2">
        <p>
          <strong>Jungle Nepal Adventure</strong> is an independent travel advisor, member of <strong>Collectif My Way</strong>, acting as a business introducer for <strong>MYWAY SAS</strong>. The expeditions featured on this website are designed and guided by Jungle Nepal Adventure, and organized and sold by MYWAY SAS.
        </p>
        
        <div class="p-5 rounded-2xl bg-emerald-50/60 border border-emerald-200/80 space-y-2 text-slate-800">
          <p class="font-black text-slate-950 text-base">Official Licensed Tour Operator (Seller):</p>
          <ul class="space-y-1.5 text-xs sm:text-sm">
            <li><strong>Corporate Name:</strong> MYWAY SAS</li>
            <li><strong>Headquarters:</strong> 165 avenue de Bretagne, 59000 LILLE, France</li>
            <li><strong>Company Registration:</strong> SIRET 85137544400011 · RCS Lille · SAS with a share capital of €7,500</li>
            <li><strong>Atout France Tour Operator License:</strong> <span class="font-mono font-bold text-slate-950">IM059190009</span></li>
            <li><strong>Financial Guarantee:</strong> GROUPAMA ASSURANCE-CRÉDIT & CAUTION</li>
            <li><strong>Professional Civil Liability Insurance:</strong> GENERALI IARD</li>
          </ul>
        </div>

        <p class="text-xs sm:text-sm text-slate-600">
          The travel contract is concluded with <strong>MYWAY SAS</strong>, which ensures its legal execution; general terms of sale are provided prior to booking and payment.
        </p>
      </div>
    </section>

    <!-- 3. HOSTING -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          3
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Website Hosting
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>This website is hosted on high-availability cloud infrastructure provided by:</p>
        <ul class="space-y-1.5 pl-4 border-l-2 border-[#0e8354] font-medium text-slate-800">
          <li><strong>Host:</strong> Hostinger International Ltd. / Hostinger Operations UAB</li>
          <li><strong>Address:</strong> Švitrigailos str. 34, 03230 Vilnius, Lithuania</li>
          <li><strong>Website:</strong> <a href="https://www.hostinger.com" target="_blank" rel="noopener noreferrer" class="text-[#0e8354] font-bold hover:underline">https://www.hostinger.com</a></li>
        </ul>
      </div>
    </section>

    <!-- 4. BOOKING & PAYMENT TERMS -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          4
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Booking & Payment Terms
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          Bookings are handled in full compliance with European consumer travel guarantees:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
          <li><strong>Confirmation Deposit:</strong> A deposit of <strong>30%</strong> of the total expedition cost is required to secure your spot in small groups, reserve lodge/bivouac accommodations, and issue official national park permits.</li>
          <li><strong>Balance Settlement:</strong> The remaining 70% balance is due no later than <strong>30 days</strong> before your departure date.</li>
          <li><strong>Accepted Payment Methods:</strong> Secure credit cards (Visa, Mastercard, American Express), SEPA/SWIFT wire transfers.</li>
        </ul>
      </div>
    </section>

    <!-- 5. CANCELLATION & REFUND POLICY -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          5
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Cancellation & Refund Policy
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>In case of cancellation on your end, the following refund terms apply (written notice must be sent to junglenepaladventure@gmail.com):</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border border-slate-200 rounded-xl overflow-hidden mt-2">
            <thead class="bg-slate-900 text-white font-bold">
              <tr>
                <th class="p-3">Notice Prior to Departure</th>
                <th class="p-3">Refund Terms</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-slate-700">
              <tr class="bg-emerald-50/50">
                <td class="p-3 font-semibold text-slate-900">More than 45 days before departure</td>
                <td class="p-3 font-bold text-[#0e8354]">100% refund of deposit (excluding banking fees and non-refundable nominal park permits issued)</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900">Between 44 and 30 days before departure</td>
                <td class="p-3">Deposit of 30% retained (option to postpone upon mutual agreement)</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900">Between 29 and 15 days before departure</td>
                <td class="p-3">50% refund of the total trip cost</td>
              </tr>
              <tr class="bg-slate-50">
                <td class="p-3 font-semibold text-slate-900">Less than 14 days or No-Show</td>
                <td class="p-3 text-slate-600">Non-refundable (full logistics and tracker fees already committed)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 6. TRAVEL INSURANCE & FIELD SAFETY -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          6
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Mandatory Travel Insurance & Safety
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          Given the immersive nature of walking safaris and wilderness expeditions in Nepal, each traveler must hold an individual <strong>multi-risk travel insurance policy</strong> covering:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-xs sm:text-sm">
          <li>Emergency medical treatment and hospitalization costs in Nepal.</li>
          <li>Emergency medical evacuation and helicopter rescue.</li>
          <li>Trip cancellation, trip interruption, and baggage/camera equipment loss.</li>
        </ul>
        <p class="pt-1 text-xs text-slate-600">
          On the ground, certified master trackers and expedition leaders hold absolute authority to adjust itineraries for wildlife safety or weather contingencies.
        </p>
      </div>
    </section>

    <!-- 7. INTELLECTUAL PROPERTY -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          7
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Intellectual Property
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          All wildlife photography, visual content, itinerary narratives, logos, and website code are protected by intellectual property rights. Any unauthorized reproduction, modification, or commercial distribution without prior written consent is strictly prohibited.
        </p>
      </div>
    </section>

    <!-- 8. PERSONAL DATA PROTECTION (GDPR) -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          8
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Personal Data Protection (GDPR)
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          Information submitted through this website is processed by Jungle Nepal Adventure to answer your inquiries and prepare your trip itinerary. Data required for official booking is transferred to MYWAY SAS, the legal tour operator selling the trip.
        </p>
        <p>
          You have the right to access, rectify, delete, and object to the processing of your personal data by emailing: <a href="mailto:junglenepaladventure@gmail.com" class="text-[#0e8354] font-bold hover:underline">junglenepaladventure@gmail.com</a>. You may also lodge a complaint with the French Data Protection Authority (CNIL — <a href="https://www.cnil.fr" target="_blank" rel="noopener noreferrer" class="text-[#0e8354] underline">cnil.fr</a>).
        </p>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <Footer lang="en" />

</Layout>
