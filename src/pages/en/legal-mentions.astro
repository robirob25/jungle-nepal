---
import { getLocalizedPath } from '../../i18n/utils';

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<Layout 
  title="Legal Mentions, Terms of Service & Privacy Policy | Jungle Nepal Adventure" 
  description="Legal notice, official local tour operator licensing, booking terms, cancellation policies, and WeTravel payment security." 
  lang="en"
>

  <!-- TOP ANNOUNCEMENT BANNER -->
  <aside aria-label="Information banner" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">€100 OFF</strong> your Nov. 2027 expedition with code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Close">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <Header isTransparent={false} currentPath="/en/legal-mentions" lang="en" />

  <!-- HERO BANNER -->
  <section class="relative bg-slate-950 text-white pt-32 pb-16 px-4 sm:px-6 lg:px-8 border-b border-white/10">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-400 font-semibold mb-2">
        <a href="/en/" class="hover:text-white transition-colors">Home</a>
        <span>›</span>
        <span class="text-amber-100 font-bold">Legal Notice & Terms</span>
      </nav>
      <span class="text-xs font-black uppercase tracking-widest text-[#0e8354] bg-[#0e8354]/10 px-3 py-1 rounded-full border border-[#0e8354]/30 inline-block">Transparency & WeTravel Compliance</span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
        Legal Notice & General Terms of Service
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Official corporate licensing in Nepal, booking conditions, cancellation terms, and comprehensive privacy policy.
      </p>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-10 font-sans text-slate-800">

    <!-- 1. IDENTITÉ DE L'ÉDITEUR & LICENCES -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          1
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Company Identity & Official Licensing
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>The website <strong class="text-slate-950">https://junglenepal.com</strong> is owned and operated by the licensed Nepalese tour operator:</p>
        <ul class="space-y-1.5 pl-4 border-l-2 border-[#0e8354] font-medium text-slate-800">
          <li><strong>Legal Corporate Name:</strong> Jungle Nepal Adventure Pvt. Ltd.</li>
          <li><strong>Legal Status:</strong> Private Limited Company registered under the Laws of Nepal, authorized by the Ministry of Industry, Commerce and Supplies and the Nepal Tourism Board.</li>
          <li><strong>Company Registration No.:</strong> <span class="font-mono">384414/82/83</span></li>
          <li><strong>Tax Identification (PAN No.):</strong> <span class="font-mono">623537310</span></li>
          <li><strong>Field Operations Base:</strong> Thakurdwara-09, Bardia National Park, Lumbini Province, Nepal</li>
          <li><strong>Logistics & Coordination Office:</strong> Thamel, Kathmandu, Nepal</li>
          <li><strong>Managing Director:</strong> Pawan Thapa</li>
          <li><strong>Operations Manager & Co-Founder:</strong> Kiran Pokhrel</li>
          <li><strong>Traveler Relations & International Expeditions:</strong> Robin Rozier</li>
          <li><strong>Official Email:</strong> <a href="mailto:contact@junglenepal.com" class="text-[#0e8354] font-bold hover:underline">contact@junglenepal.com</a></li>
          <li><strong>Direct WhatsApp:</strong> <a href="https://wa.me/33695413227" target="_blank" rel="noopener noreferrer" class="text-[#0e8354] font-bold hover:underline">+33 6 95 41 32 27</a></li>
        </ul>
      </div>
    </section>

    <!-- 2. HÉBERGEMENT -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          2
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Website Hosting
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>This website is hosted on high-availability cloud infrastructure provided by:</p>
        <ul class="space-y-1.5 pl-4 border-l-2 border-[#0e8354] font-medium text-slate-800">
          <li><strong>Host:</strong> Hostinger International Ltd. / Hostinger Operations UAB</li>
          <li><strong>Address:</strong> Švitrigailos str. 34, 03230 Vilnius, Lithuania</li>
          <li><strong>Website:</strong> <a href="https://www.hostinger.com" target="_blank" rel="noopener noreferrer" class="text-[#0e8354] font-bold hover:underline">https://www.hostinger.com</a></li>
        </ul>
      </div>
    </section>

    <!-- 3. MODALITÉS DE PAIEMENT & PLATEFORME SECURISEE WETRAVEL -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          3
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Booking & Payment Methods (WeTravel Security)
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          To guarantee the highest level of financial safety for international travelers, bookings and transactions can be processed via the certified travel payment platform <strong>WeTravel</strong> (PCI-DSS Level 1 compliant with 256-bit SSL encryption).
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Confirmation Deposit:</strong> A deposit of <strong>30%</strong> of the total expedition amount is required to secure your spot in small groups, book private jungle lodges/bivouac equipment, and issue official national park permits.</li>
          <li><strong>Balance Settlement:</strong> The remaining 70% balance is due no later than <strong>30 days</strong> before your departure date (or upon arrival as specified in your custom itinerary quote).</li>
          <li><strong>Accepted Currencies:</strong> Euros (€ - EUR) and US Dollars ($ - USD). Any bank conversion fees are the responsibility of the traveler.</li>
          <li><strong>Accepted Payment Methods:</strong> Credit cards (Visa, Mastercard, American Express), and international bank transfers (SEPA / SWIFT wire).</li>
        </ul>
      </div>
    </section>

    <!-- 4. POLITIQUE D'ANNULATION ET DE REMBOURSEMENT -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          4
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Cancellation & Refund Policy
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>In case of cancellation on your end, the following refund schedule applies (written notice must be submitted to contact@junglenepal.com):</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border border-slate-200 rounded-xl overflow-hidden mt-2">
            <thead class="bg-slate-900 text-white font-bold">
              <tr>
                <th class="p-3">Notice Prior to Departure</th>
                <th class="p-3">Refund Terms</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-slate-700">
              <tr class="bg-emerald-50/50">
                <td class="p-3 font-semibold text-slate-900">More than 45 days before departure</td>
                <td class="p-3 font-bold text-[#0e8354]">100% refund of deposit (excluding non-refundable park permits and banking fees)</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900">Between 44 and 30 days before departure</td>
                <td class="p-3">Deposit of 30% retained (option to postpone to a later departure upon mutual agreement)</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900">Between 29 and 15 days before departure</td>
                <td class="p-3">50% refund of the total trip cost</td>
              </tr>
              <tr class="bg-slate-50">
                <td class="p-3 font-semibold text-slate-900">Less than 14 days or No-Show</td>
                <td class="p-3 text-slate-600">Non-refundable (full logistics and guide fees already committed)</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-slate-500 italic mt-2">
          * Cancellation initiated by the agency (e.g. extreme security conditions, force majeure): Full 100% refund of all funds paid or provision of an alternative trip of equivalent value.
        </p>
      </div>
    </section>

    <!-- 5. ASSURANCE VOYAGE OBLIGATOIRE -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          5
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Mandatory Travel Insurance & Safety
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          Given the remote nature of walking safaris and wilderness expeditions in Nepal, each traveler must hold an individual <strong>multi-risk travel insurance policy</strong> covering:
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Emergency medical treatment and hospitalization costs in Nepal.</li>
          <li>Emergency medical evacuation and helicopter rescue (covering the specific elevation of the itinerary).</li>
          <li>Trip cancellation, trip interruption, baggage loss, and camera gear coverage.</li>
        </ul>
        <p class="pt-1">
          The agency disclaims liability in case the traveler fails to secure adequate insurance. On the ground, certified master trackers and expedition leaders reserve absolute authority to alter routes for wildlife safety or flood contingencies.
        </p>
      </div>
    </section>

    <!-- 6. PROPRIÉTÉ INTELLECTUELLE -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          6
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Intellectual Property & Photographic Rights
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          All wildlife photography, visual content, itinerary narratives, logos, and structural website elements are the exclusive intellectual property of <strong>Jungle Nepal Adventure Pvt. Ltd.</strong> or accredited partners.
        </p>
        <p>
          Any unauthorized reproduction, modification, or commercial distribution without prior written consent is strictly prohibited and subject to legal prosecution.
        </p>
      </div>
    </section>

    <!-- 7. PROTECTION DES DONNÉES -->
    <section class="space-y-4 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200 shrink-0">
          7
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Personal Data Protection (GDPR Compliance)
        </h2>
      </div>
      <div class="text-sm sm:text-base text-slate-700 leading-relaxed space-y-3 pt-2">
        <p>
          Information collected during booking inquiries is used strictly for organizing your expeditions in Nepal (hotel reservations, permits issued by government national park authorities).
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li><strong>Confidentiality Guarantee:</strong> Your contact information is never sold or shared with commercial third parties.</li>
          <li><strong>Right to Deletion:</strong> You can request the removal or correction of your personal data at any time by contacting <strong class="text-slate-950">contact@junglenepal.com</strong>.</li>
        </ul>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <Footer lang="en" />

</Layout>
