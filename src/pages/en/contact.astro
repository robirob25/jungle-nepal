---
import { getLocalizedPath } from '../../i18n/utils';

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<Layout title="Contact Us | Jungle Nepal Adventure – Local & International Team" lang="en">

  <Header isTransparent={false} currentPath="/en/contact" lang="en" />

  <!-- 3. HERO EN-TÊTE DE LA PAGE CONTACT (PHOTO DRIVE HORIZONTALE EFFET WAHOU) -->
  <section class="relative min-h-[440px] sm:min-h-[500px] flex items-center bg-slate-950 text-white overflow-hidden py-20 sm:py-28 border-b border-white/10">
    <!-- Photo Drive Horizontale Authentique (Bardia Sunset River Horizon) -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/drive_photos/adrien_bardia_sunset.webp" 
        alt="Royal Bengal tiger in the lush forest of Bardia, Nepal" 
        class="w-full h-full object-cover object-[center_bottom] opacity-65 scale-100 filter brightness-90 contrast-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/60 to-transparent"></div>
      
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-200 mb-4" aria-label="Breadcrumb">
        <a href="/en/" class="hover:underline opacity-80">Home</a>
        <span class="opacity-50">/</span>
        <span class="text-white">Contact</span>
      </nav>

      <div class="max-w-2xl space-y-3">
        <h1 class="font-black text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white tracking-tight leading-tight drop-shadow-[0_4px_20px_rgba(0,0,0,0.9)]">
          Let's Plan Your Next Adventure in Nepal.
        </h1>
        <p class="text-slate-200 text-sm sm:text-base md:text-lg leading-relaxed font-normal drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)] pt-2">
          Whether you have questions about an itinerary, want a private customized expedition, or need insider tracker advice, Robin and our local team reply within 48 hours.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. CONTENU PRINCIPAL (2 COLONNES : CARTES CONTACT & FORMULAIRE) -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      
      <!-- COLONNE GAUCHE (5 COLS) : INFOS DIRECTES & PISTEURS -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- CARD 1: ÉCHANGE DIRECT WHATSAPP & EMAIL -->
        <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200 shadow-xl space-y-5">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-white/10 text-[#0e8354] flex items-center justify-center text-2xl font-bold">
              💬
            </div>
            <div>
              <h3 class="font-black text-lg text-slate-950 tracking-tight">Direct Personal Contact</h3>
              <p class="text-xs text-slate-500 font-medium">Continuous support in English & French</p>
            </div>
          </div>

          <div class="space-y-3 pt-2 text-xs sm:text-sm">
            <a href="https://wa.me/33695413227" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3.5 rounded-2xl bg-emerald-50 hover:bg-emerald-100 text-[#0e8354] font-bold border border-emerald-200/80 transition-all hover:scale-[1.01] cursor-pointer">
              <span class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-[#0e8354]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                <span>WhatsApp : +33 6 95 41 32 27</span>
              </span>
              <span class="text-xs">↗</span>
            </a>

            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1">
              <p class="text-[11px] font-extrabold uppercase text-slate-400 tracking-wider">General inquiries & quotes</p>
              <p class="font-black text-slate-900 text-sm">junglenepaladventure@gmail.com</p>
              <p class="text-slate-500 text-xs">or contact@junglenepal.com</p>
            </div>
          </div>
        </div>

        <!-- CARD 2: LES MAÎTRES PISTEURS PAWAN & KIRAN -->
        <div class="bg-slate-950 text-white rounded-3xl p-6 sm:p-7 border border-white/10 shadow-xl space-y-4 relative overflow-hidden">
          <div class="flex items-center gap-3">
            
            <div>
              <h3 class="font-black text-lg text-white tracking-tight">Pawan & Kiran</h3>
              <p class="text-xs text-slate-200 font-semibold">Native Master Trackers (BBC Wildlife Consultants)</p>
            </div>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">
            Over 20 years of daily field immersion in Bardia National Park. Our local team prepares the lodges, logistics, and park permits as soon as you contact us.
          </p>
          <div class="flex items-center gap-2 text-[11px] text-amber-100 font-bold pt-1">
            
            <span>100% Ethical small group departures (4 to 10 max)</span>
          </div>
        </div>

        <!-- CARD 3: NOS ENGAGEMENTS -->
        <div class="bg-emerald-50/80 rounded-3xl p-5 border border-emerald-200/80 text-slate-800 space-y-2.5 text-xs font-semibold">
          <div class="flex items-center gap-2">
            <span class="text-[#0e8354]">✓</span>
            <span>Guaranteed personal response within 48 hours</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#0e8354]">✓</span>
            <span>Expert advice on peak tiger seasons and weather</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#0e8354]">✓</span>
            <span>Transparent quote with zero hidden fees</span>
          </div>
        </div>

      </div>

      <!-- COLONNE DROITE (7 COLS) : FORMULAIRE DE CONTACT PROPRE -->
      <div id="formulaire-contact" class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-2xl space-y-6 scroll-mt-28 sm:scroll-mt-32 lg:scroll-mt-36">
        
        <div>
          <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#0e8354]">Inquiry Form</span>
          <h2 class="font-black text-2xl sm:text-3xl text-slate-950 tracking-tight mt-1">
            Send Us Your Message
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-1.5 font-medium">
            Fill out this quick form and receive a personalized itinerary and quote directly in your inbox.
          </p>
        </div>

        <!-- Success Alert Notification (High-end 2026 UI) -->
        <div id="contact-success-notification" class="hidden p-5 rounded-2xl bg-emerald-900/10 border-2 border-emerald-800/40 text-emerald-950 shadow-xl transition-all duration-300 animate-in fade-in zoom-in-95">
          <div class="flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-xl shrink-0 shadow-md">
              ✓
            </div>
            <div class="flex-1">
              <h3 class="font-black text-base text-emerald-950">Message Sent Successfully!</h3>
              <p class="text-xs text-emerald-800 mt-1 font-medium leading-relaxed">
                Thank you for your inquiry! Robin and our local expedition team have received your message and will respond personally within 48 hours.
              </p>
            </div>
          </div>
        </div>

        <!-- Error Alert Notification (High-end 2026 UI) -->
        <div id="contact-error-notification" class="hidden p-5 rounded-2xl bg-rose-500/10 border-2 border-rose-500/40 text-rose-950 shadow-xl transition-all duration-300 animate-in fade-in zoom-in-95">
          <div class="flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center text-xl shrink-0 shadow-md">
              ✕
            </div>
            <div class="flex-1">
              <h3 class="font-black text-base text-rose-950">An error occurred while sending</h3>
              <p class="text-xs text-rose-800 mt-1 font-medium leading-relaxed" id="contact-error-text">
                Your message could not be sent automatically. You can message us directly on WhatsApp at <a href="https://wa.me/33695413227" target="_blank" class="underline font-bold">+33 6 95 41 32 27</a> or via email at <strong class="underline">junglenepaladventure@gmail.com</strong>.
              </p>
            </div>
          </div>
        </div>

        <form id="contact-form" onsubmit="handleContactSubmit(event)" class="space-y-4 sm:space-y-5 text-sm">
          
          <!-- Sujet de la demande -->
          <div>
            <label for="contact-subject" class="block font-bold text-xs uppercase tracking-wider text-slate-700 mb-1.5">
              Subject of Your Message <span class="text-[#0e8354]">*</span>
            </label>
            <select id="contact-subject" required class="w-full p-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 font-semibold text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#0e8354] focus:outline-none transition-all cursor-pointer">
              <option value="" disabled selected>Select the purpose of your trip...</option>
              <option value="Existing Expedition Inquiry">Inquiry about an existing expedition (Bardia, Chitwan, Babai...)</option>
              <option value="Tailor-Made or Private Expedition">Tailor-made or private expedition (Solo, Couple, Family)</option>
              <option value="Dates de départ & disponibilités 2026/2027">Departure dates & availability for season 2026 / 2027</option>
              <option value="Fitness, Safety, or Safari Inquiries">Questions regarding fitness level, safety, or walking safaris</option>
              <option value="Expédition photo ou tournage">Wildlife photography, documentary filming, or special project</option>
              <option value="Autre demande">Other inquiry or partnership</option>
            </select>
          </div>

          <!-- Last Name & First Name -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-firstname" class="block font-bold text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                First Name <span class="text-[#0e8354]">*</span>
              </label>
              <input type="text" id="contact-firstname" placeholder="Your first name" required class="w-full p-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 font-medium text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#0e8354] focus:outline-none transition-all">
            </div>
            <div>
              <label for="contact-lastname" class="block font-bold text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Last Name <span class="text-[#0e8354]">*</span>
              </label>
              <input type="text" id="contact-lastname" placeholder="Your last name" required class="w-full p-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 font-medium text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#0e8354] focus:outline-none transition-all">
            </div>
          </div>

          <!-- Email & Téléphone/WhatsApp -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-email" class="block font-bold text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Email Address <span class="text-[#0e8354]">*</span>
              </label>
              <input type="email" id="contact-email" placeholder="nom@email.com" required class="w-full p-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 font-medium text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#0e8354] focus:outline-none transition-all">
            </div>
            <div>
              <label for="contact-phone" class="block font-bold text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Phone / WhatsApp <span class="text-[#0e8354]">*</span>
              </label>
              <input type="tel" id="contact-phone" placeholder="+33 6 12 34 56 78" required class="w-full p-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 font-medium text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#0e8354] focus:outline-none transition-all">
            </div>
          </div>

          <!-- Voyageurs & Période -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-travelers" class="block font-bold text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Number of Travelers
              </label>
              <select id="contact-travelers" class="w-full p-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 font-medium text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#0e8354] focus:outline-none transition-all cursor-pointer">
                <option value="1">1 Traveler (Solo)</option>
                <option value="2" selected>2 Travelers (Couple / Duo)</option>
                <option value="3-5">3 to 5 Travelers (Family / Friends)</option>
                <option value="6+">6+ Travelers (Private Group)</option>
              </select>
            </div>
            <div>
              <label for="contact-period" class="block font-bold text-xs uppercase tracking-wider text-slate-700 mb-1.5">
                Estimated Travel Period
              </label>
              <select id="contact-period" class="w-full p-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 font-medium text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#0e8354] focus:outline-none transition-all cursor-pointer">
                <option value="Autumn 2026">Autumn 2026 (October - December)</option>
                <option value="Winter 2026/2027">Winter 2026/2027 (January - February)</option>
                <option value="Spring 2027">Spring 2027 (March - May • Peak Tiger Season)</option>
                <option value="Autumn 2027">Autumn 2027</option>
                <option value="Flexible dates">Flexible / Not decided yet</option>
              </select>
            </div>
          </div>

          <!-- Message -->
          <div>
            <label for="contact-message" class="block font-bold text-xs uppercase tracking-wider text-slate-700 mb-1.5">
              Your Message / Expedition Details <span class="text-[#0e8354]">*</span>
            </label>
            <textarea id="contact-message" rows="4" placeholder="Tell us about your expectations, preferred wildlife sightings, fitness level, or approximate travel dates..." required class="w-full p-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 font-medium text-slate-900 focus:bg-white focus:ring-2 focus:ring-[#0e8354] focus:outline-none transition-all"></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button type="submit" id="contact-submit-btn" class="w-full py-4 rounded-2xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-black text-base shadow-lg shadow-[#0e8354]/30 hover:shadow-xl hover:shadow-[#0e8354]/45 hover:-translate-y-0.5 active:translate-y-0 active:scale-95 transition-all duration-200 text-center cursor-pointer select-none">
              Send My Inquiry →
            </button>
            <p class="text-[11px] text-center text-slate-400 mt-2 font-medium">
              🔒 Your details remain strictly private and confidential.
            </p>
          </div>

        </form>

      </div>

    </div>
  </main>

  <Footer lang="en" />
<script is:inline>
  // Contact form submission to junglenepaladventure@gmail.com
  async function handleContactSubmit(e) {
    if (e && e.preventDefault) e.preventDefault();
    
    const btn = document.getElementById('contact-submit-btn');
    const successBox = document.getElementById('contact-success-notification');
    const errorBox = document.getElementById('contact-error-notification');
    const form = document.getElementById('contact-form');

    // Hide alerts
    if (successBox) successBox.classList.add('hidden');
    if (errorBox) errorBox.classList.add('hidden');

    const prenom = (document.getElementById('contact-firstname')?.value || '').trim();
    const nom = (document.getElementById('contact-lastname')?.value || '').trim();
    const email = (document.getElementById('contact-email')?.value || '').trim();
    const phone = (document.getElementById('contact-phone')?.value || '').trim();
    const subject = (document.getElementById('contact-subject')?.value || '').trim();
    const travelers = (document.getElementById('contact-travelers')?.value || '').trim();
    const period = (document.getElementById('contact-period')?.value || '').trim();
    const message = (document.getElementById('contact-message')?.value || '').trim();

    if (!prenom || !nom || !email || !phone || !message) {
      if (errorBox) {
        document.getElementById('contact-error-text').textContent = 'Please fill in all required fields marked with *.';
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return false;
    }

    if (btn) {
      btn.innerHTML = '<span class="inline-flex items-center justify-center gap-2"><span>Sending inquiry...</span> <svg class="animate-spin w-4 h-4 text-white" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg></span>';
      btn.disabled = true;
    }

    const payload = {
      _subject: 'New contact message: ' + (subject || 'Inquiry') + ' (' + prenom + ' ' + nom + ')',
      _template: 'table',
      _captcha: 'false',
      _replyto: email,
      prenom: prenom,
      nom: nom,
      email: email,
      telephone_whatsapp: phone,
      sujet: subject,
      nombre_voyageurs: travelers,
      periode_envisagee: period,
      message_client: message,
      date_envoi: new Date().toLocaleString('en-US')
    };

    let sent = false;

    // 1. Try AJAX to FormSubmit
    try {
      const res = await fetch('https://formsubmit.co/ajax/junglenepaladventure@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok || data.success === "true" || data.success === true) {
        sent = true;
      }
    } catch (err) {
      console.warn('FormSubmit AJAX attempt error:', err);
    }

    // 2. Fallback using FormSubmit standard post or mailto/webhook if needed
    if (!sent) {
      try {
        const res2 = await fetch('https://formsubmit.co/junglenepaladventure@gmail.com', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });
        if (res2.ok) {
          sent = true;
        }
      } catch (err2) {
        console.warn('Fallback error:', err2);
      }
    }

    // Always notify the user clearly
    if (sent) {
      if (form) form.reset();
      if (successBox) {
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      if (btn) {
        btn.innerHTML = '✓ Inquiry sent successfully!';
        btn.classList.remove('from-[#0e8354]', 'to-[#109363]');
        btn.classList.add('bg-emerald-700');
        setTimeout(() => {
          btn.innerHTML = 'Send My Inquiry →';
          btn.classList.remove('bg-emerald-700');
          btn.classList.add('from-[#0e8354]', 'to-[#109363]');
          btn.disabled = false;
        }, 5000);
      }
    } else {
      if (errorBox) {
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      if (btn) {
        btn.innerHTML = 'Retry Sending →';
        btn.disabled = false;
      }
    }
    return false;
  }

    // Header and UI scripts
  function toggleMobileMenu() {
    const m = document.getElementById('mobile-menu');
    if (m) m.classList.toggle('hidden');
  }
  function toggleMobileDestinations() {
    const d = document.getElementById('mobile-destinations-menu');
    const chevron = document.getElementById('mobile-dest-chevron');
    if (d) d.classList.toggle('hidden');
    if (chevron) chevron.classList.toggle('rotate-180');
  }
  function toggleLangMenu(btn) {
    const box = btn.closest('.group\\/lang')?.querySelector('.lang-dropdown-box');
    if (box) {
      box.classList.toggle('opacity-0');
      box.classList.toggle('translate-y-2');
      box.classList.toggle('pointer-events-none');
    }
  }
  function changeLanguage(lang) {
    const select = document.querySelector('.goog-te-combo');
    if (select) {
      select.value = lang;
      select.dispatchEvent(new Event('change'));
    }
  }
  window.addEventListener('scroll', () => {
    const btn = document.getElementById('back-to-top');
    if (btn) {
      if (window.scrollY > 300) {
        btn.classList.remove('opacity-0', 'pointer-events-none');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none');
      }
    }
  });
  </script>
<script is:inline>
  function openLegalModal() {
    const m = document.getElementById('legal-modal');
    if (m) m.classList.remove('hidden');
  }
  function closeLegalModal() {
    const m = document.getElementById('legal-modal');
    if (m) m.classList.add('hidden');
  }
  </script>
</Layout>