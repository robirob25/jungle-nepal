---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="Conservation & Communities in Bardia: NAGA & Jungle Nepal Project"
  description="Grassroots conservation initiative in Bardia developed by Jungle Nepal Adventure and the Nature Guide Association (NAGA): wildlife tracker safety, knowledge transmission, and tiger-community coexistence."
  image="/assets/naga/naga_guides_tronc_riviere.webp"
  lang="en"
>

  <!-- 2. SITE NAVBAR (LIGHT MODE STANDARD) -->
  <Header lang="en" currentPath="/en/conservation" />

  <!-- GLOBAL WARM LIGHT WRAPPER (INSTITUTIONAL MONOGRAPH / EDITORIAL DOSSIER) -->
  <div class="bg-[#faf8f5] text-slate-900 font-sans min-h-screen selection:bg-[#0e8354] selection:text-white">

    <!-- 3. INSTITUTIONAL HERO WITH BACKGROUND PHOTO (FIELD SOLIDARITY) -->
    <section class="relative py-12 sm:py-20 lg:py-24 border-b border-[#e7e2d8] overflow-hidden">
      <!-- Authentic guide solidarity background photo clearly visible -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/naga/naga_solidarite_portage_tronc_riviere.webp" 
          alt="Field solidarity in Bardia" 
          class="w-full h-full object-cover object-center filter brightness-95 contrast-105"
          fetchpriority="high"
        />
        <!-- Balanced white veil: photo clearly visible while ensuring perfect text legibility -->
        <div class="absolute inset-0 bg-white/50"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-white/60 via-white/40 to-[#faf8f5]"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 sm:space-y-8">
        
        <!-- OFFICIAL CO-BRANDING BLOCK: JUNGLE NEPAL ADVENTURE × NAGA -->
        <div class="inline-flex items-center justify-center gap-3 sm:gap-6 px-4 py-2.5 sm:p-5 rounded-2xl sm:rounded-3xl bg-white/95 backdrop-blur-md border border-[#e4ded3] shadow-md max-w-full">
          <!-- Jungle Nepal Adventure Logo -->
          <div class="flex items-center justify-center shrink-0">
            <img 
              src="/assets/logo_header_dark.png" 
              alt="Jungle Nepal Adventure Logo" 
              class="h-9 sm:h-14 w-auto object-contain"
              loading="eager"
            />
          </div>
          
          <!-- Alliance Cross -->
          <div class="flex flex-col items-center justify-center shrink-0">
            <span class="text-slate-400 font-light text-xl sm:text-2xl leading-none">×</span>
            <span class="text-[8px] sm:text-[9px] font-black uppercase tracking-widest text-[#0e8354]">Alliance</span>
          </div>

          <!-- Official NAGA Crest -->
          <div class="flex items-center justify-center shrink-0">
            <img 
              src="/assets/naga/naga_logo_transparent.webp" 
              alt="Official NAGA Crest Bardiya 2054" 
              class="h-10 sm:h-16 w-auto object-contain"
              loading="eager"
            />
          </div>
        </div>

        <!-- Institutional Titles -->
        <div class="space-y-3 sm:space-y-4 max-w-4xl mx-auto">
          <h1 class="text-2xl xs:text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-[1.12]">
            Protecting those who protect the wild.
          </h1>

          <p class="text-xs sm:text-sm font-black uppercase tracking-widest text-[#0e8354]">
            Protecting Guides • Empowering Communities • Conserving Wildlife
          </p>

          <p class="text-sm sm:text-lg lg:text-xl text-slate-800 max-w-3xl mx-auto font-medium leading-relaxed pt-1 sm:pt-2">
            In Bardia, independent local operator <strong>Jungle Nepal Adventure</strong> and the <strong>Nature Guide Association (NAGA)</strong> unite directly to provide occupational safety for jungle guides, preserve ancestral tracking skills, and foster lasting peace between apex predators and buffer-zone villages.
          </p>

          <!-- Hero CTA: Discover our field actions -->
          <div class="pt-3 sm:pt-4 flex justify-center">
            <a 
              href="#missions" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-full bg-[#0e8354] hover:bg-[#0c6d46] text-white font-bold text-xs sm:text-sm shadow-sm hover:scale-105 active:scale-95 transition-all"
            >
              <span>Discover our field actions</span>
              <span class="text-xs">↓</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- 4. SECTION 1: PRESENTATION OF THE NATURE GUIDE ASSOCIATION (NAGA) -->
    <section id="naga" class="py-10 sm:py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-[#e7e2d8]">
      
      <!-- 2-Column Grid: Text on Left & Bardia Gate Photo on Right -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 lg:gap-14 items-center mb-8 sm:mb-14 lg:mb-16">
        
        <!-- Text Block Left -->
        <div class="lg:col-span-6 space-y-3.5 sm:space-y-5">
          <span class="text-xs font-black uppercase tracking-widest text-[#0e8354]">
            Historic Association • Founded in 1998 (2054 BS) in Bardia
          </span>
          <h2 class="text-xl sm:text-3xl lg:text-4xl font-black text-slate-950 tracking-tight leading-tight">
            The Nature Guide Association (NAGA) of Bardia
          </h2>
          <p class="text-slate-600 text-xs sm:text-base leading-relaxed">
            Founded in 1998 (2054 BS) in Thakurdwara, the <strong>Nature Guide Association (NAGA)</strong> unites and represents all certified naturalist guides and professional trackers officially licensed by Nepal's Department of National Parks and Wildlife Conservation in Bardia.
          </p>
          <p class="text-slate-600 text-xs sm:text-base leading-relaxed">
            Chaired by <strong>Krisna Saha</strong>, it structures daily jungle walking safaris, mentors young local recruits, enforces wildlife safety rules in tiger habitat, and maintains an ongoing mediation bridge with buffer-zone communities.
          </p>
        </div>

        <!-- Photo Block Right: Guides in front of Bardia National Park Gate -->
        <div class="lg:col-span-6">
          <div class="bg-white p-2.5 sm:p-4 rounded-2xl sm:rounded-3xl border border-[#e5dfd3] shadow-sm">
            <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] sm:aspect-[4/3] max-h-[320px] sm:max-h-[440px]">
              <img 
                src="/assets/naga/naga_porte_bardiya_national_park.webp" 
                alt="NAGA certified nature guides gathered in front of Bardia National Park Gate" 
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="pt-2 sm:pt-3 px-1 sm:px-2 text-[11px] sm:text-xs text-slate-500 font-medium">
              <strong class="text-slate-900">Official Bardia National Park Gate</strong> — Certified NAGA trackers and guides assembled before daily walking patrols in the forest.
            </p>
          </div>
        </div>

      </div>

      <!-- The Core of Our Collaboration: Jungle Nepal Adventure × NAGA -->
      <div class="my-8 sm:my-14 lg:my-16 p-5 sm:p-8 lg:p-12 rounded-2xl sm:rounded-3xl bg-white border border-[#e4ded3] shadow-2xs space-y-6 sm:space-y-10">
        
        <div class="max-w-3xl space-y-2.5 sm:space-y-3">
          <span class="text-xs font-mono uppercase tracking-widest text-[#0e8354] font-semibold block">
            Our Field Alliance • 2027 Objective
          </span>
          <h3 class="text-xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-tight leading-tight">
            The foundation of our alliance: from real tragedies to private insurance for every guide
          </h3>
          <p class="text-slate-600 text-xs sm:text-base leading-relaxed">
            Jungle Nepal Adventure was not founded in a remote corporate office, but directly on the soil of Bardia's wilderness alongside Pawan Thapa, Krisna Saha, and veteran local trackers. Our mission stems from firsthand hardships experienced in our own flesh.
          </p>
        </div>

        <!-- Real Accidental Experience Storytelling -->
        <div class="space-y-3 sm:space-y-4 text-slate-600 text-xs sm:text-base leading-relaxed pt-2 border-t border-stone-200/70">
          <p>
            In the deep jungle of Bardia, danger is not an abstract concept: <strong>Krisna Saha</strong>, current President of NAGA, survived a terrifying Bengal tiger attack during a forest patrol. <strong>Pawan Thapa</strong>, co-founder of Jungle Nepal Adventure, survived a severe fall from a tall tree while scouting wildlife. Most painful of all, a close friend and dedicated fellow guide was tragically killed by a violent one-horned rhinoceros charge.
          </p>
          <p>
            These devastating experiences became an unforgettable turning point. Historically, when confronting animal charges or wilderness accidents, Bardia's nature guides had no safety net, no hospital coverage, and families were left alone burdened by medical debt. From this shared grief emerged an absolute necessity: <strong>the first, non-negotiable step is to build a full private insurance system protecting every guide in the association</strong>.
          </p>
        </div>

        <!-- The 3 Concrete Pillars of Our Commitment -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 pt-5 sm:pt-6 border-t border-stone-200/70 text-xs text-slate-600">
          <div class="p-3.5 sm:p-0 rounded-xl bg-stone-50/70 sm:bg-transparent border border-stone-200/60 sm:border-0 space-y-1.5 sm:space-y-2">
            <span class="text-slate-900 font-bold text-xs sm:text-sm block">1. Fixed Donation per Traveller</span>
            <p class="leading-relaxed">
              Jungle Nepal Adventure has made a formal commitment to donate a <strong>fixed contribution for every traveller</strong> joining our tours. Every guest contributes directly to the guides' protection fund with zero surcharge.
            </p>
          </div>
          <div class="p-3.5 sm:p-0 rounded-xl bg-stone-50/70 sm:bg-transparent border border-stone-200/60 sm:border-0 space-y-1.5 sm:space-y-2">
            <span class="text-slate-900 font-bold text-xs sm:text-sm block">2. Full Private Insurance by 2027</span>
            <p class="leading-relaxed">
              All contributions are channeled toward a clear, measurable goal: <strong>providing comprehensive private health & accident insurance to 100% of NAGA member guides</strong>. We aim to achieve this target by 2027.
            </p>
          </div>
          <div class="p-3.5 sm:p-0 rounded-xl bg-stone-50/70 sm:bg-transparent border border-stone-200/60 sm:border-0 space-y-1.5 sm:space-y-2">
            <span class="text-slate-900 font-bold text-xs sm:text-sm block">3. Immediate Field Support</span>
            <p class="leading-relaxed">
              In parallel, we supply emergency trauma kits (tactical tourniquets, haemostatic dressings) and provide emergency financial relief for guides' families during critical injuries or offseason hardships.
            </p>
          </div>
        </div>

        <!-- Travel & Direct Impact Bridge (Point 2) -->
        <div class="p-4 sm:p-6 lg:p-8 rounded-xl sm:rounded-2xl bg-[#faf8f5] border border-stone-200/80 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 sm:gap-6">
          <div class="space-y-1.5 max-w-2xl">
            <span class="text-[11px] font-mono uppercase tracking-wider text-[#0e8354] font-semibold block">Participate by Traveling • Horizon 2027</span>
            <h4 class="font-bold text-slate-950 text-base sm:text-lg">
              Every traveller directly finances private insurance for jungle guides
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              By joining a walking safari with Jungle Nepal Adventure, a fixed portion of your trip directly finances private insurance coverage for NAGA member guides. Our shared commitment: zero guides left unprotected in Bardia by 2027.
            </p>
          </div>
          <div class="shrink-0 w-full sm:w-auto">
            <a 
              href="/en/destinations/bardia/" 
              class="w-full sm:w-auto text-center justify-center inline-flex items-center gap-2 px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm transition-colors shadow-2xs whitespace-nowrap"
            >
              <span>Explore our Bardia safaris</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Field Reality: Human-Wildlife Conflict & The Key Role of Guides (2 Blocks Side-by-Side with Tiger Photo) -->
      <div class="my-8 sm:my-14 lg:my-16 p-5 sm:p-8 lg:p-12 rounded-2xl sm:rounded-3xl bg-white border border-[#e4ded3] shadow-2xs">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 lg:gap-14 items-center">
          
          <!-- Block 1: Pure Editorial Text without dots or bubbles (lg:col-span-7) -->
          <div class="lg:col-span-7 space-y-3.5 sm:space-y-4">
            <span class="text-xs font-mono uppercase tracking-widest text-[#0e8354] font-semibold block">
              Coexistence & Field Reality • Human-Wildlife Conflict
            </span>
            <h3 class="text-xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-tight leading-tight">
              Living alongside apex predators: the unvarnished reality of coexistence
            </h3>
            
            <div class="space-y-3 sm:space-y-4 text-slate-600 text-xs sm:text-base leading-relaxed pt-2">
              <p>
                In Bardia, conservation goes far beyond celebration figures: with over 125 Royal Bengal tigers and thriving populations of one-horned rhinos and wild Asian elephants, daily coexistence for buffer-zone villages is under severe, unrelenting tension.
              </p>
              <p>
                At night, wild elephant herds cross river channels to raid paddy fields and demolish mud homes to feed on grain reserves. Near forest boundaries, tiger and leopard incursions trigger tragic human losses among villagers collecting firewood or tending livestock. Recently, a fatal charge by a one-horned rhino claimed the life of a certified jungle guide on duty inside the park: real danger is an everyday constant.
              </p>
              <p>
                Confronting this urgency, distant political speeches in Kathmandu or brief visits by NGO delegations cannot solve the struggle. We firmly believe that <strong>local jungle guides are the #1 actors and the best positioned</strong> to forge viable solutions: born in these buffer-zone communities, they share the families' grief while possessing the intimate understanding of wildlife behaviour needed to step in without panic.
              </p>
              <p>
                Their core mission relies on <strong>continuous communication and grassroots sensitization</strong>: defusing anger after crop destruction to prevent retaliatory poisonings, teaching avoidance reflexes, and educating children in village schools to build lasting, peaceful coexistence.
              </p>
            </div>
          </div>

          <!-- Block 2: Bengal Tiger Photo Block (lg:col-span-5) -->
          <div class="lg:col-span-5">
            <div class="bg-white p-2.5 sm:p-4 rounded-2xl sm:rounded-3xl border border-[#e5dfd3] shadow-sm">
              <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] sm:aspect-[4/3] max-h-[300px] sm:max-h-[460px]">
                <img 
                  src="/assets/curated_gallery/tigre_bengale_penombre_sal.webp" 
                  alt="Bengal Tiger in the Sal forest of Bardia National Park" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <p class="pt-2 sm:pt-3 px-1 sm:px-2 text-[11px] sm:text-xs text-slate-500 font-medium">
                <strong class="text-slate-900">Royal Bengal Tiger in the Sal forest</strong> — In Bardia, jungle guides stand on the frontline to protect predators while safeguarding bordering villages.
              </p>
            </div>
          </div>

        </div>
      </div>

      <!-- What NAGA does daily: 6 Core Field Missions -->
      <div id="missions" class="space-y-6 pt-6 sm:pt-8 border-t border-[#e7e2d8]">
        <div class="max-w-2xl space-y-2">
          <span class="text-xs font-black uppercase tracking-widest text-[#0e8354]">Field Missions</span>
          <h3 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-950">
            What NAGA does daily: 6 core field missions
          </h3>
          <p class="text-xs sm:text-sm text-slate-600">
            The six statutory fields of action carried out by the association to support the national park and buffer-zone communities:
          </p>
        </div>

        <!-- The 6 Mission Cards with Photos in 2 Columns -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
          
          <!-- MISSION 01 -->
          <div class="p-4 sm:p-6 lg:p-7 rounded-2xl sm:rounded-3xl bg-[#faf8f5] border border-[#e4ded3] flex flex-col justify-between space-y-4 sm:space-y-6 shadow-2xs hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-stone-200/60 pb-2">
                <span class="text-xs font-mono text-stone-400">MISSION 01</span>
                <span class="text-xs font-mono uppercase tracking-wider text-stone-600 font-medium">
                  Community
                </span>
              </div>

              <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] border border-slate-200">
                <img 
                  src="/assets/naga/naga_sensibilisation_ecole_journee_tigre.webp" 
                  alt="Community awareness in Bardia" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <h4 class="font-bold text-base sm:text-lg text-slate-950 leading-snug">
                Community Awareness Programs
              </h4>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Organize regular awareness programs in surrounding buffer-zone villages about wildlife conservation, biodiversity, environmental protection, and the importance of preserving the national park.
              </p>

              <ul class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-200/60">
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Regular conservation workshops in local villages and buffer-zone settlements.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>School education programs fostering pride and safety awareness among youth.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- MISSION 02 -->
          <div class="p-4 sm:p-6 lg:p-7 rounded-2xl sm:rounded-3xl bg-[#faf8f5] border border-[#e4ded3] flex flex-col justify-between space-y-4 sm:space-y-6 shadow-2xs hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-stone-200/60 pb-2">
                <span class="text-xs font-mono text-stone-400">MISSION 02</span>
                <span class="text-xs font-mono uppercase tracking-wider text-stone-600 font-medium">
                  Cleanliness
                </span>
              </div>

              <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] border border-slate-200">
                <img 
                  src="/assets/naga/naga_herbes_hautes_savane.webp" 
                  alt="Sanitation and cleanliness in Bardia" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <h4 class="font-bold text-base sm:text-lg text-slate-950 leading-snug">
                Sanitation & Cleanliness Programs
              </h4>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Organize regular cleaning campaigns around the national park, along walking trails, riverbanks, and in surrounding communities.
              </p>

              <ul class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-200/60">
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Systematic plastic waste collection along forest trails and riverbanks.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Active environmental stewardship preserving the Karnali and Geruwa river corridors.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- MISSION 03 -->
          <div class="p-4 sm:p-6 lg:p-7 rounded-2xl sm:rounded-3xl bg-[#faf8f5] border border-[#e4ded3] flex flex-col justify-between space-y-4 sm:space-y-6 shadow-2xs hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-stone-200/60 pb-2">
                <span class="text-xs font-mono text-stone-400">MISSION 03</span>
                <span class="text-xs font-mono uppercase tracking-wider text-stone-600 font-medium">
                  Training
                </span>
              </div>

              <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] border border-slate-200">
                <img 
                  src="/assets/naga/naga_traversee_gue_riviere.webp" 
                  alt="Beginner nature guide training" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <h4 class="font-bold text-base sm:text-lg text-slate-950 leading-snug">
                Beginner Nature Guide Training
              </h4>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Provide basic training for young and interested local people who want to become nature guides, including wildlife identification, animal behaviour, birdwatching, guiding skills, safety, and visitor management.
              </p>

              <ul class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-200/60">
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Traditional tracking skills and animal behaviour mentorship from elder Tharu trackers.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Rigorous jungle safety drills, river crossings, and emergency first-aid protocols.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- MISSION 04 -->
          <div class="p-4 sm:p-6 lg:p-7 rounded-2xl sm:rounded-3xl bg-[#faf8f5] border border-[#e4ded3] flex flex-col justify-between space-y-4 sm:space-y-6 shadow-2xs hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-stone-200/60 pb-2">
                <span class="text-xs font-mono text-stone-400">MISSION 04</span>
                <span class="text-xs font-mono uppercase tracking-wider text-stone-600 font-medium">
                  Trails
                </span>
              </div>

              <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] border border-slate-200">
                <img 
                  src="/assets/naga/naga_solidarite_portage_tronc_riviere.webp" 
                  alt="Trail development inside Bardia National Park" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <h4 class="font-bold text-base sm:text-lg text-slate-950 leading-snug">
                Trail Development
              </h4>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Work together with the national park administration to identify, develop, and maintain safe walking trails inside the park for nature lovers and tourists.
              </p>

              <ul class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-200/60">
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Discreet trail marking and footpath maintenance coordinated with park rangers.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-stone-400 font-semibold select-none">—</span>
                  <span>Clearing fallen timber and maintaining safe riverbed crossings across the floodplain.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- MISSION 05 -->
          <div class="p-4 sm:p-6 lg:p-7 rounded-2xl sm:rounded-3xl bg-[#faf8f5] border border-[#e4ded3] flex flex-col justify-between space-y-4 sm:space-y-6 shadow-2xs hover:shadow-md transition-shadow">
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-stone-200/60 pb-2">
                <span class="text-xs font-mono text-stone-400">MISSION 05</span>
                <span class="text-xs font-mono uppercase tracking-wider text-stone-600 font-medium">
                  Mediation
                </span>
              </div>

              <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-[16/10] border border-slate-200">
                <img 
                  src="/assets/naga/naga_statue_tigre_communaute.webp" 
                  alt="Bridge between community and national park" 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <h4 class="font-bold text-base sm:text-lg text-slate-950 leading-snug">
                Bridge Between Community & Park
              </h4>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
