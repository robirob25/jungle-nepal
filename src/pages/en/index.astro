---
import { getLocalizedPath } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import SafariQuiz from '../../components/SafariQuiz.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<Layout title="Jungle Nepal Adventure – Wild Safaris, Bengal Tigers & Expeditions in Nepal" lang="en">


  <!-- ========================================================================= -->
  <!-- 1. TOP ANNOUNCEMENT BANNER (Luxe Emerald & Gold Identity) -->
  <!-- ========================================================================= -->
  <aside aria-label="Information banner" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">-€100</strong> on your Nov. 2027 expedition <span class="hidden sm:inline">with code</span> <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Close">✕</button>
    </div>
  </aside>

  <!-- ========================================================================= -->
  <!-- 2. HEADER TRANSPARENT WEROAD AVEC VOTRE VRAI LOGO -->
  <!-- ========================================================================= -->
  <header class="absolute top-[42px] left-0 right-0 z-40 py-4 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between relative">
    
    <!-- Left: Votre Logo Intégré (Tigre & Montagnes) -->
    <a href="#" class="flex items-center gap-3 group shrink-0">
      <img 
        src="/assets/logo.webp" 
        alt="Jungle Nepal Adventure Logo" 
        width="240"
        height="64"
        fetchpriority="high"
        loading="eager"
        decoding="sync"
        class="h-14 sm:h-16 w-auto object-contain filter drop-shadow-[0_4px_10px_rgba(0,0,0,0.5)] group-hover:scale-100 transition-transform"
      />
    </a>

    <!-- Center: Navigation épurée blanche -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-[13.5px] font-bold text-white/90 drop-shadow absolute left-1/2 -translate-x-1/2 whitespace-nowrap">
      <a href="#prochains-departs" class="hover:text-amber-100 transition-colors">All 16 Expeditions</a>
      <div class="relative group py-2">
          <a href="/en/destinations" class="hover:text-[#0e8354] transition-colors flex items-center gap-1.5 cursor-pointer font-bold">
            <span>Destinations</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Menu Déroulant 100% OPAQUE & LISIBLE -->
          <div class="absolute top-full left-0 pt-2 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 z-50">
            <div style="background-color: #041d13 !important; color: #ffffff !important;" class="rounded-3xl p-3 shadow-[0_25px_60px_rgba(0,0,0,0.8)] border border-white/10 space-y-1">
              
              <a href="/en/destinations/bardia" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Bardia National Park</p>
                  <p class="text-[10px] text-slate-400">Bengal Tigers & Walking Safaris</p>
                </div>
              </a>

              <a href="/en/destinations/chitwan" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Chitwan National Park</p>
                  <p class="text-[10px] text-slate-400">One-Horned Rhinos & River Canoes</p>
                </div>
              </a>

              <a href="/en/destinations/suklaphanta" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Suklaphanta National Park</p>
                  <p class="text-[10px] text-slate-400">Swamp Deer & Untamed Wild West</p>
                </div>
              </a>

              <a href="/en/destinations/annapurna" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Annapurna & Pokhara</p>
                  <p class="text-[10px] text-slate-400">Sacred Peaks & Alpine Balconies</p>
                </div>
              </a>

              <a href="/en/destinations/katmandou" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Kathmandu</p>
                  <p class="text-[10px] text-slate-400">Valley of Kings & Sacred Temples</p>
                </div>
              </a>

              <div class="pt-2 border-t border-white/10 mt-1">
                <a href="/en/destinations" class="block w-full text-center py-2 rounded-xl bg-[#0e8354] hover:bg-[#0c6d46] text-white font-black text-xs transition-colors shadow">
                  View All Destinations →
                </a>
              </div>

            </div>
          </div>
        </div>
      <a href="#pisteurs" class="hover:text-amber-100 transition-colors">Our Guides</a>
      <a href="#galerie-faune" class="hover:text-amber-100 transition-colors">Gallery</a>
      <a href="/en/about" class="hover:text-amber-100 transition-colors font-extrabold">About Us</a>
      <a href="/en/blog" class="hover:text-amber-100 transition-colors">Blog</a>
      <a href="/en/contact" class="hover:text-amber-100 transition-colors">Contact</a>
    </nav>

    <!-- Right: Globe + WhatsApp Button Blanc -->
    <div class="flex items-center gap-4">
                              <!-- LANGUAGE SWITCHER (GLOBE) -->
      <div class="relative group/lang py-1">
        <button onclick="toggleLangMenu(this)" class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/10 hover:bg-white/20 border-white/20 text-white border backdrop-blur-md flex items-center justify-center transition-all duration-200 hover:scale-100 active:scale-95 cursor-pointer" aria-label="Change language">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </button>
        <div class="lang-dropdown-box absolute right-0 top-full mt-1.5 w-44 opacity-0 translate-y-2 pointer-events-none group-hover/lang:opacity-100 group-hover/lang:translate-y-0 group-hover/lang:pointer-events-auto transition-all duration-200 z-50">
          <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-1.5 shadow-[0_20px_50px_rgba(0,0,0,0.8)] space-y-0.5 text-xs font-bold text-white">
            <a href={frTargetUrl} class={`w-full flex items-center justify-between px-3 py-2 rounded-xl ${Astro.url.pathname.startsWith("/en") ? "text-slate-300 hover:bg-white/10 hover:text-white" : "bg-white/20 text-white font-extrabold"} transition-colors text-left cursor-pointer`}>
              <span class="flex items-center gap-2"><span>🇫🇷</span><span>Français</span></span>
            </a>
            <a href={enTargetUrl} class={`w-full flex items-center justify-between px-3 py-2 rounded-xl ${Astro.url.pathname.startsWith("/en") ? "bg-white/20 text-white font-extrabold" : "text-slate-300 hover:bg-white/10 hover:text-white"} transition-colors text-left cursor-pointer`}>
              <span class="flex items-center gap-2"><span>🇬🇧</span><span>English</span></span>
            </a>
          </div>
        </div>
      </div>

      <a href="https://wa.me/33695413227" target="_blank"  target="_blank" class="hidden sm:flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-slate-950 font-extrabold text-xs sm:text-[13px] shadow-lg hover:bg-slate-100 hover:scale-100 active:scale-95 transition-all" whitespace-nowrap"><svg class="w-4 h-4 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg><span class="whitespace-nowrap">WhatsApp</span></a>

      <button onclick="toggleMobileMenu()" class="lg:hidden w-10 h-10 rounded-2xl bg-white/15 hover:bg-white/25 text-white border border-white/30 backdrop-blur-md flex flex-col items-center justify-center gap-1.5 transition-all duration-200 hover:scale-100 active:scale-95 cursor-pointer shadow-lg p-2" aria-label="Main menu">
        <span class="w-5 h-[2.5px] bg-white rounded-full block"></span>
        <span class="w-5 h-[2.5px] bg-white rounded-full block"></span>
        <span class="w-5 h-[2.5px] bg-white rounded-full block"></span>
      </button>
    </div>

    </div>
  </header>

          <!-- MOBILE NAVIGATION DRAWER (OPAQUE, NO EMOJIS, CLEAN) -->
  <div id="mobile-menu" style="background-color: #041d13 !important;" class="hidden lg:hidden fixed inset-x-3 top-20 z-50 max-h-[85vh] overflow-y-auto bg-[#041d13] border border-white/15 rounded-3xl p-5 text-white shadow-[0_25px_60px_rgba(0,0,0,0.95)] space-y-4 font-sans">
    
    <!-- Top Bar with Close Button -->
    <div class="flex items-center justify-end pb-2 border-b border-white/10">
      <button onclick="toggleMobileMenu()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-sm font-bold transition-colors cursor-pointer" aria-label="Close menu">
        ✕
      </button>
    </div>

    <!-- Main Navigation Links -->
    <nav class="flex flex-col space-y-1.5 font-bold text-sm">
      
      <!-- 1. All Expeditions -->
      <a href="/en/#prochains-departs" onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl bg-white/5 hover:bg-white/10 flex items-center justify-between text-white transition-colors">
        <span>All 16 Expeditions</span>
        <span class="bg-[#0e8354] text-white text-[11px] px-2.5 py-0.5 rounded-full font-black">15</span>
      </a>

      <!-- 2. Destinations Dropdown Accordion -->
      <div class="rounded-2xl bg-white/5 overflow-hidden">
        <button onclick="document.getElementById('mobile-dest-sub').classList.toggle('hidden'); document.getElementById('mobile-dest-arrow').classList.toggle('rotate-180');" class="w-full px-3.5 py-2.5 flex items-center justify-between text-white hover:bg-white/10 transition-colors text-left cursor-pointer">
          <span>Destinations</span>
          <svg id="mobile-dest-arrow" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div id="mobile-dest-sub" class="hidden px-2 pb-2.5 space-y-1 border-t border-white/5 pt-2">
          <a href="/en/destinations/bardia" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Bardia National Park</p>
              <p class="text-[10px] text-slate-400">Bengal Tigers &amp; Walking Safaris</p>
            </div>
          </a>
          <a href="/en/destinations/chitwan" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Chitwan National Park</p>
              <p class="text-[10px] text-slate-400">One-Horned Rhinos &amp; River Canoes</p>
            </div>
          </a>
          <a href="/en/destinations/suklaphanta" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Suklaphanta National Park</p>
              <p class="text-[10px] text-slate-400">Swamp Deer &amp; Untamed Wild West</p>
            </div>
          </a>
          <a href="/en/destinations/annapurna" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Annapurna &amp; Pokhara</p>
              <p class="text-[10px] text-slate-400">Sacred Peaks &amp; Alpine Balconies</p>
            </div>
          </a>
          <a href="/en/destinations/katmandou" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Kathmandu</p>
              <p class="text-[10px] text-slate-400">Valley of Kings &amp; Sacred Temples</p>
            </div>
          </a>
          <a href="/en/destinations" onclick="toggleMobileMenu()" class="block w-full text-center py-2 rounded-xl bg-[#0e8354] hover:bg-[#0c6d46] text-white font-black text-xs transition-colors shadow mt-1">
            View All Destinations →
          </a>
        </div>
      </div>

      <!-- 3. Our Guides -->
      <a href="/en/#pisteurs" onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
        <span>Our Guides</span>
      </a>

      <!-- 4. Galerie -->
      <a href="/en/#galerie-faune" onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
        <span>Gallery</span>
      </a>

      <!-- 5. À propos -->
      <a href="/en/about" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
        <span>About Us</span>
      </a>

      <!-- Blog -->
      <a href="/en/blog" onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
        <span>Blog</span>
      </a>

      <!-- 6. Contact -->
      <a href="/en/contact" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
        <span>Contact</span>
      </a>

    </nav>

    <!-- Language Selector Buttons -->
    <div class="pt-3 border-t border-white/10 space-y-2">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Language</span>
      <div class="grid grid-cols-4 gap-1.5">
        <a href={frTargetUrl} class="py-2 px-3 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer"><span>🇫🇷</span> <span>FR</span></a>
        <a href={enTargetUrl} class="py-2 px-3 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer"><span>🇬🇧</span> <span>EN</span></a>
        <button onclick="changeLanguage('de')" data-lang-btn="de" class="py-2 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1 bg-white/10 text-white hover:bg-white/20 transition-all cursor-pointer">
          <span>🇩🇪</span> <span>DE</span>
        </button>
        <button onclick="changeLanguage('es')" data-lang-btn="es" class="py-2 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1 bg-white/10 text-white hover:bg-white/20 transition-all cursor-pointer">
          <span>🇪🇸</span> <span>ES</span>
        </button>
      </div>
    </div>

    <!-- CTA Buttons -->
    <div class="pt-3 border-t border-white/10 flex flex-col gap-2">
      <a href="https://wa.me/33695413227" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center gap-2 py-3.5 px-4 rounded-2xl bg-white text-slate-950 flex items-center justify-center text-center font-black text-xs shadow hover:bg-slate-100 transition-all">
        <svg class="w-4 h-4 text-[#0e8354]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span>WhatsApp (+33 6 95 41 32 27)</span>
      </a>

      <a href="/en/#prochains-departs" onclick="toggleMobileMenu()" class="w-full text-center py-3.5 px-4 rounded-2xl bg-[#0e5c3e] flex items-center justify-center text-center hover:bg-[#0c6d46] text-white font-black text-xs shadow transition-all">
        Explore All 16 Expeditions →
      </a>
    </div>

  </div>


  <!-- ========================================================================= -->
  <!-- 3. HERO SECTION (WeRoad Layout épuré avec la charte Verte & Or) -->
  <!-- ========================================================================= -->
  <section class="relative min-h-[92vh] sm:min-h-screen flex flex-col justify-between items-center pt-36 sm:pt-40 lg:pt-44 pb-6 sm:pb-8 px-4 sm:px-6 lg:px-8 overflow-hidden bg-slate-950">
    
        <!-- 10-PHOTO CINEMA HERO AUTO-SLIDER (ZERO BLACK/EMPTY SLIDES GUARANTEED) -->
        <!-- 10-PHOTO CINEMA HERO AUTO-SLIDER (ZERO BLACK/EMPTY SLIDES GUARANTEED) -->
    <div class="absolute inset-0 z-0 overflow-hidden" id="hero-slider-container">
      
      <!-- Slide 0: Tigre royal au bord de l'eau (LCP Element - Priority High) -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-400 ease-out opacity-100 scale-100" data-slide="0">
        <picture class="w-full h-full block">
          <source media="(max-width: 768px)" srcset="/assets/hero/hero_1_tiger_water_mobile.webp" type="image/webp">
          <source media="(min-width: 769px)" srcset="/assets/hero/hero_1_tiger_water.webp" type="image/webp">
          <img 
            src="/assets/hero/hero_1_tiger_water.webp" 
            alt="Royal Bengal tiger at the waterhole in Bardia" 
            width="1600"
            height="900"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover object-[75%_30%] filter brightness-90 contrast-105"
          />
        </picture>
      </div>

      <!-- Slide 1: Rhinocéros unicorne dans la brume -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-out opacity-0 pointer-events-none" data-slide="1">
        <img 
          src="/assets/hero/hero_2_rhino_mist.webp" 
          alt="One-horned rhino at sunrise in the morning mist" 
          class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Slide 2: Tigre royal en approche -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-out opacity-0 pointer-events-none" data-slide="2">
        <img 
          src="/assets/hero/hero_7_tiger_stalk.webp" 
          alt="Royal Bengal tiger stalking in tall grass" 
          class="w-full h-full object-cover object-[50%_25%] filter brightness-90 contrast-105"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Slide 3: Cerfs des marais dans les plaines -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-out opacity-0 pointer-events-none" data-slide="3">
        <img 
          src="/assets/hero/hero_4_deer_plain.webp" 
          alt="Swamp deer and wildlife of the Terai" 
          class="w-full h-full object-cover object-[50%_10%] filter brightness-90 contrast-105"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Slide 4: Crocodile avec reflet dans l'eau -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-out opacity-0 pointer-events-none" data-slide="4">
        <img 
          src="/assets/hero/hero_8_croco_water.webp" 
          alt="Marsh mugger crocodile in calm waters" 
          class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Slide 5: Tigre en marche dans la jungle -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-out opacity-0 pointer-events-none" data-slide="5">
        <img 
          src="/assets/hero/hero_3_tiger_jungle.webp" 
          alt="Royal Bengal tiger walking through Bardia jungle" 
          class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Slide 6: Grand Calao bicorne -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-out opacity-0 pointer-events-none" data-slide="6">
        <img 
          src="/assets/hero/hero_9_calao_hornbill.webp" 
          alt="Great hornbill perched on a canopy branch" 
          class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Slide 7: Nilgauts / antilopes sauvages -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-out opacity-0 pointer-events-none" data-slide="7">
        <img 
          src="/assets/hero/hero_5_nilgai_forest.webp" 
          alt="Nilgai antelopes at the forest edge" 
          class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Slide 8: Marabout en plein vol -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-out opacity-0 pointer-events-none" data-slide="8">
        <img 
          src="/assets/wildlife_gallery/wildlife_marabout_flight.webp" 
          alt="Lesser adjutant stork in flight at dawn" 
          class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
          loading="eager"
          decoding="async"
        />
      </div>

