<script is:inline>
  // CINEMATIC SEAMLESS HERO SLIDER (ZERO BLACK FLASH / ZERO GAP CROSS-FADE)
  (function() {
    var currentHeroSlide = 0;
    var heroInterval = null;
    var isTransitioning = false;

    // Preload & pre-decode all hero images on load
    window.addEventListener('DOMContentLoaded', function() {
      var slides = document.querySelectorAll('.hero-slide');
      slides.forEach(function(s) {
        var img = s.querySelector('img');
        if (img && img.src) {
          var pre = new Image();
          pre.src = img.src;
          if (pre.decode) pre.decode().catch(function() {});
        }
      });
    });

    function showHeroSlide(index) {
      var slides = document.querySelectorAll('.hero-slide');
      if (!slides.length || isTransitioning) return;
      var total = slides.length;
      var next = (index + total) % total;
      if (next === currentHeroSlide) return;

      isTransitioning = true;
      var prevSlide = slides[currentHeroSlide];
      var nextSlide = slides[next];

      // Keep previous slide visible on layer 1
      prevSlide.style.zIndex = '1';
      prevSlide.style.transition = 'none';
      prevSlide.classList.remove('opacity-0', 'pointer-events-none');
      prevSlide.classList.add('opacity-100');

      // Place incoming slide on layer 2 with opacity 0 initially
      nextSlide.style.zIndex = '2';
      nextSlide.style.transition = 'opacity 750ms cubic-bezier(0.4, 0, 0.2, 1)';
      nextSlide.classList.remove('pointer-events-none');
      nextSlide.classList.remove('opacity-100');
      nextSlide.classList.add('opacity-0');

      // Trigger smooth fade in on top
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          nextSlide.classList.remove('opacity-0');
          nextSlide.classList.add('opacity-100');

          setTimeout(function() {
            // Once new slide is 100% opaque, silently hide previous slide underneath
            prevSlide.classList.remove('opacity-100');
            prevSlide.classList.add('opacity-0', 'pointer-events-none');
            prevSlide.style.zIndex = '0';
            nextSlide.style.zIndex = '1';
            currentHeroSlide = next;
            isTransitioning = false;
          }, 760);
        });
      });
    }

    function nextHeroSlide() {
      var slides = document.querySelectorAll('.hero-slide');
      if (!slides.length) return;
      showHeroSlide(currentHeroSlide + 1);
    }

    window.setHeroSlide = function(index) {
      showHeroSlide(index);
      startHeroSlider();
    };

    function startHeroSlider() {
      if (heroInterval) clearInterval(heroInterval);
      heroInterval = setInterval(nextHeroSlide, 4500);
    }

    startHeroSlider();
  })();
</script>
