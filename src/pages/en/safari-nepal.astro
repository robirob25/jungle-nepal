---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import toursData from '../../data/tours.en.json';

// Filter core wildlife safari tours
const safariTourSlugs = [
  "bardia-explorateur",
  "chitwan-bardia-complete",
  "babai-special",
  "nepal-sauvage",
  "bardia-babai-camping",
  "safari-pied-bardia"
];

const safariTours = toursData.filter(t => safariTourSlugs.includes(t.slug));

// FAQ Data for Schema.org & visible Accordion
const faqs = [
  {
    question: "How much does a wildlife safari in Nepal cost?",
    answer: "The price of a Nepal safari depends on your trip duration and lodging preference. A full-day walking safari in Bardia with two certified native trackers costs around €50 per person (plus national park entrance fee of 2,000 NPR, approx. €14). A comprehensive 5-day lodge-based safari package including private airport transfers, meals, permits, and daily game walks (Bardia Explorer) costs around €490 per person. An all-inclusive 11 to 12-day grand expedition combining Chitwan and Bardia is priced at €1,990 per person."
  },
  {
    question: "Is walking on foot with Bengal tigers and rhinos dangerous?",
    answer: "Nepal is the only country in Asia where walking safaris to track tigers and rhinos are officially permitted inside national parks. Guided by two native Tharu wildlife naturalists armed with traditional bamboo lathis (staffs), safety is strictly enforced. Core protocols include walking single-file in complete silence, monitoring wind direction, never running under any circumstance, and immediately following guide instructions. Wild predators instinctively avoid humans when not startled or cornered."
  },
  {
    question: "Which park should I choose: Bardia or Chitwan?",
    answer: "It depends on your wildlife priorities and crowd tolerance. Chitwan is located 5 hours by road from Kathmandu and guarantees a 98% sighting probability for greater one-horned rhinos, but forest trails can feel crowded with jeeps. Bardia, located in Nepal's untamed far west (a 50-minute domestic flight to Nepalgunj plus a 2-hour private drive), shelters 125 Bengal tigers across 968 km² of pristine wilderness. Bardia is the undisputed sanctuary for on-foot tiger tracking and peaceful, off-the-beaten-track nature immersion."
  },
  {
    question: "What is the best time of year to see tigers in Nepal?",
    answer: "The prime season for tiger sightings runs from March to May (the Himalayan spring). As temperatures rise to 32–38°C (90–100°F), tall elephant grass is burnt or withered, water levels recede, and predators congregate around permanent river pools and waterholes. Sighting probability reaches 75% to 85% during a 4 to 5-day safari in Bardia."
  },
  {
    question: "Do I need malaria medication for a jungle safari in Nepal?",
    answer: "In the Terai lowlands (Bardia and Chitwan), the risk of malaria is classified as very low by the WHO during the dry travel season (October through May). Most travelers do not take heavy antimalarials such as Malarone, opting instead for reliable mosquito bite prevention (long lightweight clothing and DEET insect repellent). Consult your travel doctor or clinic before departure for personalized advice."
  },
  {
    question: "Do you offer elephant-back safari rides?",
    answer: "No. Jungle Nepal Adventure strictly rejects all elephant-back riding. The traditional training methods (khatti) and heavy metal saddles cause severe spinal and psychological harm. Instead, we advocate 100% ethical wildlife encounters: walking safaris, private open 4x4 jeeps, and silent river rafting."
  }
];
---

<Layout 
  title="Nepal Wildlife Safari: Bengal Tiger Tracking & National Parks"
  description="Local tour operator specializing in authentic Nepal wildlife safaris. On-foot Bengal tiger tracking in Bardia, one-horned rhinos in Chitwan & ethical small groups."
  image="/assets/drive_wildlife/2026-05-08_-_0000273923_-_Sur_les_traces_du_Tigre.webp"
  lang="en"
  isDarkHeader={true}
>
  <SchemaOrg
    slot="head"
    type="TouristDestination"
    headline="Nepal Wildlife Safari: National Parks, Tiger Tracking & Expeditions"
    description="Comprehensive wildlife safari guide and expeditions in Nepal with Jungle Nepal Adventure. Foot tracking in Bardia, rhinos in Chitwan, ethical small groups."
    image="/assets/drive_wildlife/2026-05-08_-_0000273923_-_Sur_les_traces_du_Tigre.webp"
    url="https://junglenepal.com/en/safari-nepal"
    lang="en"
    about={["Nepal Safari", "Bengal Tiger", "Bardia National Park", "Chitwan National Park", "Local Tour Operator Nepal"]}
    faqs={faqs}
    breadcrumbs={[
      { name: "Home", url: "/en" },
      { name: "Nepal Wildlife Safari", url: "/en/safari-nepal" }
    ]}
  />

  <!-- TOP PROMO BAR -->
  <aside aria-label="Information banner" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">-100€</strong> on your Nov. 2027 safari with code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Close">✕</button>
    </div>
  </aside>

  <!-- HEADER NAVIGATION -->
  <Header lang="en" currentPath="/en/safari-nepal" />

  <!-- 1. HERO SECTION -->
  <section class="relative min-h-[75vh] lg:min-h-[82vh] flex items-center justify-center pt-32 pb-20 px-4 bg-slate-950 text-white overflow-hidden">
    <!-- Background Image with Ambient Overlay -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/drive_wildlife/2026-05-08_-_0000273923_-_Sur_les_traces_du_Tigre.webp" 
        alt="Walking safari tracking wild Bengal tigers on foot in Bardia National Park Nepal" 
        class="w-full h-full object-cover opacity-45 scale-105 filter brightness-85 contrast-105"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-transparent to-slate-950/80"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto text-center space-y-6">
      
      <!-- Breadcrumb navigation -->
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-300 font-semibold mb-2">
        <a href="/en" class="hover:text-white transition-colors">Home</a>
        <span>›</span>
        <span class="text-emerald-400 font-bold">Nepal Safari</span>
      </nav>

      <!-- Badge sur-titre -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 text-xs font-bold uppercase tracking-widest backdrop-blur-sm">
        <span>Direct Local Wildlife Specialist & DMC</span>
      </div>

      <!-- H1 -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.15] max-w-4xl mx-auto">
        Nepal Wildlife Safari: Bengal Tiger Tracking & Untamed National Parks
      </h1>

      <!-- Intro Subtitle -->
      <p class="text-base sm:text-lg lg:text-xl text-slate-200 max-w-3xl mx-auto font-normal leading-relaxed drop-shadow">
        Far from crowded trekking paths, venture into the subtropical Terai lowlands on foot, by canoe, and in private 4x4 jeeps with native Tharu trackers. An authentic small-group wildlife immersion in the heart of big cat country.
      </p>

      <!-- 4 Instant Trust Badges -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto pt-4 text-left">
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-4">
          <p class="text-amber-300 font-black text-2xl lg:text-3xl">78%</p>
          <p class="text-xs text-slate-200 font-medium mt-1 leading-snug">Tiger Sighting Rate in Bardia (March–May)</p>
        </div>
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-4">
          <p class="text-emerald-400 font-black text-2xl lg:text-3xl">100%</p>
          <p class="text-xs text-slate-200 font-medium mt-1 leading-snug">On Foot & Jeep (Zero Elephant Riding)</p>
        </div>
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-4">
          <p class="text-white font-black text-2xl lg:text-3xl">Tharu</p>
          <p class="text-xs text-slate-200 font-medium mt-1 leading-snug">Native Master Trackers Born on the Reserve Border</p>
        </div>
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-4">
          <p class="text-amber-300 font-black text-2xl lg:text-3xl">4 to 10</p>
          <p class="text-xs text-slate-200 font-medium mt-1 leading-snug">Max Travelers per Small Group or Private</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3.5">
        <a href="#circuits-safari" class="px-7 py-3.5 rounded-full bg-[#0e5c3e] hover:bg-[#09422b] text-white font-black text-xs sm:text-sm shadow-xl shadow-emerald-950/50 hover:scale-105 active:scale-95 transition-all duration-300 flex items-center gap-2">
          <span>Explore Safari Tours</span>
          <span>↓</span>
        </a>
        <a href="https://wa.me/33695413227" target="_blank" rel="nofollow noopener noreferrer" class="px-6 py-3.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-bold text-xs sm:text-sm border border-white/20 backdrop-blur-md transition-all flex items-center gap-2">
          <span>Chat on WhatsApp With Robin</span>
        </a>
      </div>

    </div>
  </section>

  <!-- 2. WHY NEPAL SAFARI IS UNIQUE -->
  <section class="py-16 sm:py-20 bg-slate-900 text-white border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">Field Insights</span>
        <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mt-2 leading-tight">
          Why a Wildlife Safari in Nepal Has No Equal in Asia
        </h2>
        <p class="mt-4 text-slate-300 text-base sm:text-lg leading-relaxed">
          When people picture Nepal, snowy Himalayan peaks inevitably come to mind. Yet extending along Nepal's southern border lies the Terai: an expansive subtropical lowland fed by glacial Himalayan rivers, harboring one of the highest concentrations of endangered megafauna in Asia.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-slate-950/70 border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-900/40 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-black text-xl">
            01
          </div>
          <h3 class="text-lg font-bold text-white">The Only Country Permitting Walking Safaris</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Unlike Indian tiger reserves where visitors are strictly confined to jeeps on designated tourist tracks, Nepal legally authorizes on-foot walking safaris in Bardia. Without engine rumble or exhaust fumes, you tune your ears to the jungle, follow fresh pugmarks in sandbars, and experience predators eye-to-eye.
          </p>
        </div>

        <div class="bg-slate-950/70 border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-amber-900/40 border border-amber-500/30 flex items-center justify-center text-amber-300 font-black text-xl">
            02
          </div>
          <h3 class="text-lg font-bold text-white">A Global Conservation Triumph</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Nepal became the first country on Earth to nearly triple its wild Bengal tiger population since 2010. Official censuses count over 355 tigers nationwide, with 125 residing in Bardia National Park alone. This extraordinary density makes Bardia a premier global destination to witness tigers in undisturbed habitats.
          </p>
        </div>

        <div class="bg-slate-950/70 border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-cyan-900/40 border border-cyan-500/30 flex items-center justify-center text-cyan-300 font-black text-xl">
            03
          </div>
          <h3 class="text-lg font-bold text-white">Zero Altitude Sickness, Accessible to All</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            The Terai sits between 100 and 300 meters above sea level. No extreme mountain passes, no acute mountain sickness (AMS) risks. Whether you are a wildlife photographer, a couple, or a traveling family, a jungle safari offers pure adventure with genuine comfort and accessibility.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. FEATURED SAFARI EXPEDITIONS -->
  <section id="circuits-safari" class="py-16 sm:py-24 bg-slate-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">Signature Expeditions</span>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mt-1">
            Featured Nepal Wildlife Safari Itineraries
          </h2>
          <p class="text-sm sm:text-base text-slate-300 mt-2 max-w-2xl">
            Designed, guided, and managed directly by our local ground team with zero middlemen. Guaranteed micro-groups (4–10 guests) or bespoke private departures.
          </p>
        </div>
        <a href="/en/tours" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 flex items-center gap-1 shrink-0">
          <span>View All 18 Tours</span>
          <span>→</span>
        </a>
      </div>

      <!-- Tours Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {safariTours.map((tour) => (
          <article class="bg-slate-900 border border-white/10 rounded-3xl overflow-hidden hover:border-emerald-500/50 transition-all duration-300 flex flex-col justify-between group shadow-xl">
            <div>
              <div class="relative h-60 overflow-hidden bg-slate-950">
                <img 
                  src={tour.image} 
                  alt={tour.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy"
                />
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#0e5c3e] text-white shadow-md">
                    {tour.duration}
                  </span>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-950/80 text-amber-300 border border-amber-400/30">
                    {tour.difficulty || "All Levels"}
                  </span>
                </div>
                <div class="absolute bottom-3 right-3 bg-slate-950/90 text-white font-black text-sm px-3 py-1 rounded-xl border border-white/10">
                  From {tour.price}
                </div>
              </div>

              <div class="p-6 space-y-3">
                <h3 class="font-extrabold text-lg text-white group-hover:text-emerald-300 transition-colors leading-snug">
                  {tour.title}
                </h3>
                <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
                  {tour.description}
                </p>
                
                {tour.highlights && (
                  <ul class="text-[11px] text-slate-300 space-y-1 pt-2 border-t border-white/5">
                    {tour.highlights.slice(0, 2).map((h: string) => (
                      <li class="flex items-center gap-2">
                        <span class="text-emerald-400 font-bold">✓</span>
                        <span class="truncate">{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>

            <div class="p-6 pt-0">
              <a 
                href={`/en/tour/${tour.slug}`} 
                class="w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wide flex items-center justify-center gap-2 transition-all shadow-md group-hover:shadow-emerald-900/30"
              >
                <span>View Full Itinerary</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. INTERACTIVE MAP OF NEPAL WILDLIFE SANCTUARIES -->
  <section id="carte-nepal" class="py-16 sm:py-20 bg-slate-950 text-white border-t border-white/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">Wildlife Geography</span>
        <h2 class="font-black text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight leading-tight mt-1">
          Wild Sanctuaries of the Nepal Terai
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-300 font-normal leading-relaxed max-w-2xl mx-auto">
          From legendary Bardia in the remote west to the riverbanks of Chitwan, locate the protected habitats where Nepal's apex predators roam.
        </p>
      </div>

      <!-- Map Canvas -->
      <div class="max-w-4xl mx-auto">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/10">
          <div class="relative overflow-hidden bg-[#f0ebd9]">
            <img
              src="/nepal-map-illustrated.png"
              alt="Illustrated map of Nepal National Parks for wildlife safaris - Bardia, Chitwan, Suklaphanta"
              class="w-full h-auto object-contain"
              loading="lazy"
            />

            <!-- Hotspot 1: Bardia -->
            <a href="/en/destinations/bardia" class="absolute top-[38%] left-[24%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer" aria-label="Bardia National Park">
              <span class="relative flex h-6 w-6 sm:h-8 sm:w-8 items-center justify-center">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-60"></span>
                <span class="relative inline-flex rounded-full h-4 w-4 sm:h-5 sm:w-5 bg-amber-500 text-slate-950 font-black text-[9px] sm:text-[10px] items-center justify-center shadow-lg border sm:border-2 border-white"></span>
              </span>
              <div class="hidden sm:block absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-950/95 text-amber-100 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full whitespace-nowrap shadow-xl border border-amber-400/30">
                Bardia (Bengal Tigers)
              </div>
            </a>

            <!-- Hotspot 2: Chitwan -->
            <a href="/en/destinations/chitwan" class="absolute top-[65%] left-[50%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer" aria-label="Chitwan National Park">
              <span class="relative flex h-6 w-6 sm:h-8 sm:w-8 items-center justify-center">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
                <span class="relative inline-flex rounded-full h-4 w-4 sm:h-5 sm:w-5 bg-emerald-500 text-white font-black text-[9px] sm:text-[10px] items-center justify-center shadow-lg border sm:border-2 border-white"></span>
              </span>
              <div class="hidden sm:block absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-950/95 text-slate-200 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full whitespace-nowrap shadow-xl border border-emerald-400/30">
                Chitwan (One-Horned Rhinos)
              </div>
            </a>

            <!-- Hotspot 3: Suklaphanta -->
            <a href="/en/destinations/suklaphanta" class="absolute top-[32%] left-[12%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer" aria-label="Suklaphanta National Park">
              <span class="relative flex h-5 w-5 sm:h-7 sm:w-7 items-center justify-center">
                <span class="relative inline-flex rounded-full h-3 w-3 sm:h-4 sm:w-4 bg-cyan-500 text-white font-black text-[8px] items-center justify-center shadow border sm:border-2 border-white"></span>
              </span>
              <div class="hidden sm:block absolute -top-7 left-1/2 -translate-x-1/2 bg-slate-950/90 text-cyan-200 text-[9px] font-extrabold px-2 py-0.5 rounded-full whitespace-nowrap shadow border border-cyan-400/20">
                Suklaphanta
              </div>
            </a>

            <!-- Hotspot 4: Kathmandu -->
            <a href="/en/destinations/katmandou" class="absolute top-[58%] left-[62%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer" aria-label="Kathmandu">
              <span class="relative flex h-5 w-5 sm:h-7 sm:w-7 items-center justify-center">
                <span class="relative inline-flex rounded-full h-3 w-3 sm:h-4 sm:w-4 bg-orange-500 text-white font-black text-[8px] items-center justify-center shadow border sm:border-2 border-white"></span>
              </span>
              <div class="hidden sm:block absolute -top-7 left-1/2 -translate-x-1/2 bg-slate-950/90 text-orange-200 text-[9px] font-extrabold px-2 py-0.5 rounded-full whitespace-nowrap shadow border border-orange-400/20">
                Kathmandu (Arrival Hub)
              </div>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 5. WHICH PARK TO CHOOSE -->
  <section class="py-16 sm:py-20 bg-slate-900 text-white border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">Head-to-Head Comparison</span>
        <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mt-1">
          Choosing the Right National Park for Your Nepal Safari
        </h2>
        <p class="text-sm sm:text-base text-slate-300 mt-2">
          Nepal's protected areas offer contrasting atmospheres and wildlife densities. Here is our candid field breakdown.
        </p>
      </div>

      <!-- Comparative Table Container -->
      <div class="overflow-x-auto rounded-3xl border border-white/10 shadow-2xl bg-slate-950">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-900 border-b border-white/10 text-white font-bold">
            <tr>
              <th class="p-4 sm:p-5">Feature</th>
              <th class="p-4 sm:p-5 text-amber-300">Bardia National Park</th>
              <th class="p-4 sm:p-5 text-emerald-400">Chitwan National Park</th>
              <th class="p-4 sm:p-5 text-cyan-300">Suklaphanta National Park</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300">
            <tr>
              <td class="p-4 sm:p-5 font-bold text-white">Iconic Wildlife</td>
              <td class="p-4 sm:p-5 font-bold text-amber-200">Bengal Tiger (125 individuals)</td>
              <td class="p-4 sm:p-5 font-bold text-emerald-200">One-Horned Rhino (694 individuals)</td>
              <td class="p-4 sm:p-5">Swamp Deer (2,000+ strong herds)</td>
            </tr>
            <tr>
              <td class="p-4 sm:p-5 font-bold text-white">Tiger Sighting Chances</td>
              <td class="p-4 sm:p-5 text-amber-300 font-bold">Very High (75–85% in March–May)</td>
              <td class="p-4 sm:p-5">Moderate (20–30%)</td>
              <td class="p-4 sm:p-5">Moderate (30–45%)</td>
            </tr>
            <tr>
              <td class="p-4 sm:p-5 font-bold text-white">Rhino Sighting Chances</td>
              <td class="p-4 sm:p-5">Good (60–70%)</td>
              <td class="p-4 sm:p-5 text-emerald-300 font-bold">Virtually Guaranteed (95–98%)</td>
              <td class="p-4 sm:p-5">Low (Reintroduced population)</td>
            </tr>
            <tr>
