---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import toursData from '../../data/tours.en.json';

// Core safari tours with verified image fallbacks
const safariTourSlugs = [
  "bardia-explorateur",
  "chitwan-bardia-complete",
  "jungle-extreme",
  "babai-special",
  "bardia-babai-camping",
  "safari-chitwan-3-jours",
  "nepal-sauvage",
  "panthere-des-neiges",
  "rara-lake-bardia"
];

const safariTours = safariTourSlugs
  .map(slug => toursData.find(t => t.slug === slug))
  .filter((t): t is typeof toursData[0] => Boolean(t));

// 1-Day Safari Activities (Excursions courtes à la journée)
const dayActivities = [
  {
    title: "Bardia National Park Walking Safari",
    slug: "bardia-walking-safari",
    url: "/en/tours/bardia-walking-safari",
    image: "/assets/tours_thumbs/safari_pied_guide_jungle_bardia.webp",
    alt: "Walking safari in Bardia National Park jungle",
    tag: "Wild Bardia • On-foot Tracking",
    badge: "From 1 person",
    duration: "1 day",
    price: "50€",
    priceLabel: "Price per person",
    extra: "Overnight option +12€",
    rating: "5.0 (24)",
    description: "A full day of deep immersion in Bardia's untamed jungle. Walk silently on foot with a senior naturalist guide and native tracker tracking Bengal tigers, rhinos, and wild elephants."
  },
  {
    title: "Bardia National Park Private Jeep Safari",
    slug: "bardia-jeep-safari",
    url: "/en/tours/bardia-jeep-safari",
    image: "/assets/tours_thumbs/safari_jeep_groupe_bardia.webp",
    alt: "Private 4x4 jeep safari in Bardia National Park",
    tag: "Wild Bardia • Private 4x4",
    badge: "Private Jeep",
    duration: "1 day",
    price: "190€",
    priceLabel: "All-inclusive price",
    extra: "Overnight option +12€",
    rating: "5.0 (19)",
    description: "Explore the most remote corners of Bardia in a private 4x4 with driver, senior naturalist, and elite tracker. Cross river fords to maximize chances of spotting Bengal tigers."
  },
  {
    title: "Chitwan National Park Walking Safari",
    slug: "chitwan-walking-safari",
    url: "/en/tours/chitwan-walking-safari",
    image: "/assets/tours_thumbs/safari_pied_chitwan_guide_sourire.webp",
    alt: "Walking safari in Chitwan National Park",
    tag: "Wild Chitwan • On-foot Tracking",
    badge: "From 1 person",
    duration: "1 day",
    price: "70€",
    priceLabel: "Price per person",
    extra: "Lunch included",
    rating: "5.0 (21)",
    description: "Experience Chitwan on foot away from crowded jeep trails. A full-day tracking expedition with a certified jungle guide and tracker seeking one-horned rhinos, tigers, and sloth bears."
  },
  {
    title: "Chitwan National Park Private Jeep Safari",
    slug: "chitwan-jeep-safari",
    url: "/en/tours/chitwan-jeep-safari",
    image: "/assets/tours_thumbs/safari_jeep_chauffeur_chitwan.webp",
    alt: "Private jeep safari in Chitwan National Park",
    tag: "Wild Chitwan • Private 4x4",
    badge: "Private Jeep",
    duration: "1 day",
    price: "190€",
    priceLabel: "All-inclusive price",
    extra: "Lunch included",
    rating: "5.0 (22)",
    description: "Roam through Chitwan's open grasslands and sal forests in a dedicated private 4x4 with driver and senior naturalist guide for close encounters with rhinos, tigers, and spotted deer."
  },
  {
    title: "Bardia National Park Rafting Safari",
    slug: "bardia-rafting-safari",
    url: "/en/tours/bardia-rafting-safari",
    image: "/assets/tours_thumbs/rafting_karnali_descente_guide_voyageur.webp",
    alt: "Drifting safari on the Karnali River in Bardia",
    tag: "Wild Bardia • River Safari",
    badge: "Private Raft",
    duration: "1 day",
    price: "190€",
    priceLabel: "All-inclusive price",
    extra: "Picnic included",
    rating: "5.0 (18)",
    description: "Drift silently down the wild Karnali River on a private raft with professional river crew, naturalist guide, and tracker to observe Gangetic river dolphins, marsh muggers, gharials, and big cats."
  }
];

// FAQ Data for Schema.org & visible Accordion
const faqs = [
  {
    question: "How much does a wildlife safari in Nepal cost?",
    answer: "The price of a Nepal safari depends on your trip duration and lodging preference. A full-day walking safari in Bardia with two certified native trackers costs around €50 per person (plus national park entrance fee of 2,000 NPR, approx. €14). A comprehensive 5-day lodge-based safari package including private airport transfers, meals, permits, and daily game walks (Bardia Explorer) costs around €490 per person. An all-inclusive 11 to 12-day grand expedition combining Chitwan and Bardia is priced at €1,990 per person."
  },
  {
    question: "Is walking on foot with Bengal tigers and rhinos dangerous?",
    answer: "Nepal is the only country in Asia where walking safaris to track tigers and rhinos are officially permitted inside national parks. Guided by two native Tharu wildlife naturalists armed with traditional bamboo lathis (staffs), safety is strictly enforced. Core protocols include walking single-file in complete silence, monitoring wind direction, never running under any circumstance, and immediately following guide instructions. Wild predators instinctively avoid humans when not startled or cornered."
  },
  {
    question: "Which park should I choose: Bardia or Chitwan?",
    answer: "It depends on your wildlife priorities and crowd tolerance. Chitwan is located 5 hours by road from Kathmandu and guarantees a 98% sighting probability for greater one-horned rhinos, but forest trails can feel crowded with jeeps. Bardia, located in Nepal's untamed far west (a 50-minute domestic flight to Nepalgunj plus a 2-hour private drive), shelters 125 Bengal tigers across 968 km² of pristine wilderness. Bardia is the undisputed sanctuary for on-foot tiger tracking and peaceful, off-the-beaten-track nature immersion."
  },
  {
    question: "What is the best time of year to see tigers in Nepal?",
    answer: "The prime season for tiger sightings runs from March to May (the Himalayan spring). As temperatures rise to 32–38°C (90–100°F), tall elephant grass is burnt or withered, water levels recede, and predators congregate around permanent river pools and waterholes. Sighting probability reaches 75% to 85% during a 4 to 5-day safari in Bardia."
  },
  {
    question: "Do I need malaria medication for a jungle safari in Nepal?",
    answer: "In the Terai lowlands (Bardia and Chitwan), the risk of malaria is classified as very low by the WHO during the dry travel season (October through May). Most travelers do not take heavy antimalarials such as Malarone, opting instead for reliable mosquito bite prevention (long lightweight clothing and DEET insect repellent). Consult your travel doctor or clinic before departure for personalized advice."
  },
  {
    question: "Do you offer elephant-back safari rides?",
    answer: "No. Jungle Nepal Adventure strictly rejects all elephant-back riding. The traditional training methods (khatti) and heavy metal saddles cause severe spinal and psychological harm. Instead, we advocate 100% ethical wildlife encounters: walking safaris, private open 4x4 jeeps, and silent river rafting."
  }
];
---

<Layout 
  title="Nepal Wildlife Safari: Bengal Tiger Tracking with a Local Specialist"
  description="Nepal wildlife safaris: walking safaris in Bardia National Park to track Bengal tigers, rhinos in Chitwan, jeep tours, and small-group wildlife expeditions."
  image="/assets/drive_wildlife/hero_safari_nepal.webp"
  lang="en"
  isDarkHeader={true}
>
  <SchemaOrg
    slot="head"
    type="TouristDestination"
    headline="Nepal Wildlife Safari: National Parks, Tiger Tracking & Expeditions"
    description="Comprehensive wildlife safari guide and expeditions in Nepal. Walking safaris in Bardia, rhinos in Chitwan, and ethical small groups."
    image="/assets/drive_wildlife/hero_safari_nepal.webp"
    url="https://junglenepal.com/en/safari-nepal"
    lang="en"
    about={["Nepal Safari", "Bengal Tiger", "Bardia National Park", "Chitwan National Park", "Local Tour Operator Nepal"]}
    faqs={faqs}
    breadcrumbs={[
      { name: "Home", url: "/en" },
      { name: "Nepal Wildlife Safari", url: "/en/safari-nepal" }
    ]}
  />

  <!-- TOP PROMO BAR -->
  <aside aria-label="Information banner" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">-100€</strong> on your Nov. 2027 safari with code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Close">✕</button>
    </div>
  </aside>

  <!-- HEADER NAVIGATION -->
  <Header lang="en" currentPath="/en/safari-nepal" />

  <!-- 1. HERO SECTION -->
  <section class="relative min-h-[68vh] lg:min-h-[74vh] flex items-center justify-center pt-32 pb-20 px-4 bg-slate-950 text-white overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/drive_wildlife/hero_safari_nepal.webp" 
        alt="Wildlife safari in Bardia National Park Nepal with Jungle Nepal Adventure" 
        class="w-full h-full object-cover opacity-75 scale-105 filter brightness-95 contrast-105"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-black/25"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center space-y-5">
      
      <!-- Breadcrumb navigation -->
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-300 font-medium">
        <a href="/en/" class="hover:text-white transition-colors">Home</a>
        <span>›</span>
        <span class="text-amber-300 font-semibold">Nepal Wildlife Safari</span>
      </nav>

      <!-- H1 -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.15] max-w-3xl mx-auto drop-shadow-lg">
        Nepal Wildlife Safari: Bengal Tiger Tracking with a Local Specialist
      </h1>

      <!-- Intro Subtitle optimisé SEO & longue traîne client -->
      <p class="text-base sm:text-lg text-slate-200 max-w-3xl mx-auto font-normal leading-relaxed drop-shadow">
        Walking safaris in Bardia National Park to track Bengal tigers, jeep safaris and canoe excursions in Chitwan for one-horned rhinos, and small-group wildlife tours led by expert native Tharu naturalist guides.
      </p>

      <!-- Action Button -->
      <div class="pt-3 flex items-center justify-center">
        <a href="#circuits-safari" class="px-8 py-3.5 rounded-full bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs sm:text-sm shadow-lg shadow-emerald-950/40 hover:scale-105 active:scale-95 transition-all duration-300 flex items-center gap-2">
          <span>Explore Safari Tours</span>
          <span>↓</span>
        </a>
      </div>

    </div>
  </section>

  <!-- 2. WHY NEPAL SAFARI HAS NO EQUAL IN THE WORLD (WHITE BACKGROUND, 3 CARDS WITH ANIMAL PHOTOS) -->
  <section class="py-16 sm:py-24 bg-white text-slate-900 border-b border-slate-200 relative overflow-hidden">
    <!-- Subtle Sketch Pattern Background Overlay -->
    <div class="absolute inset-0 bg-[url('/assets/patterns/nepal_sketch_pattern.webp')] bg-repeat bg-[length:420px_auto] opacity-[0.045] pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 relative z-10">
      
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0e8354]">Field Insights</span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-950 tracking-tight mt-1.5 leading-tight">
          Why a Wildlife Safari in Nepal Has No Equal in the World
        </h2>
        <p class="mt-3 text-slate-600 text-base sm:text-lg leading-relaxed">
          Far from noisy convoys and rigid tracks of Africa or India, southern Nepal offers an intimate, raw encounter with wildlife: here, the jungle is explored on foot in pin-drop silence, attuned to indigenous knowledge and predator habits.
        </p>
      </div>

      <!-- 3 Cards with real animal photos at the top -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Card 1: Tiger Tracking on Foot -->
        <div class="bg-white border border-slate-200/90 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="h-56 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/drive_wildlife/tigre1.webp" 
                alt="Bengal tiger in the lush foliage of Bardia National Park Nepal" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
              <span class="absolute top-3 left-3 bg-[#0e5c3e] text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-sm">
                Bardia National Park
              </span>
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-lg font-bold text-slate-950 leading-snug">
                The Only Place on Earth to Track Tigers on Foot
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Nepal is the only country on the planet legally permitting on-foot tracking of wild Bengal tigers inside national reserves. Guided by two native Tharu naturalists equipped with traditional bamboo staffs, you move silently, following fresh pugmarks in sandbars and decoding alarm barks of spotted deer.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-bold text-[#0e8354]">
            Tiger Sighting Rate: 75% to 85% (March–May)
          </div>
        </div>

        <!-- Card 2: Rhino Conservation -->
        <div class="bg-white border border-slate-200/90 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="h-56 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/tours_thumbs/chitwan_rhino.webp" 
                alt="Greater one-horned rhino grazing in Chitwan National Park" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
              <span class="absolute top-3 left-3 bg-[#0e5c3e] text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-sm">
                Chitwan National Park
              </span>
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-lg font-bold text-slate-950 leading-snug">
                A Global Sanctuary for the One-Horned Rhino
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Nepal shelters the world's second largest population of greater one-horned rhinos. Across Chitwan and Bardia, these two-ton prehistoric giants roam completely wild. You can view them at respectful close distances on guided game walks or while silently paddling traditional dugout canoes downriver.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-bold text-[#0e8354]">
            98% Guaranteed Rhino Sighting in Chitwan
          </div>
        </div>

        <!-- Card 3: Elephants & 450+ Species -->
        <div class="bg-white border border-slate-200/90 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="h-56 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/curated_gallery/elephant_asie_male_jungle.webp" 
                alt="Wild Asian bull elephant in Bardia sal forests" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
              <span class="absolute top-3 left-3 bg-[#0e5c3e] text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-sm">
                Wild Terai
              </span>
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-lg font-bold text-slate-950 leading-snug">
                Vast Biodiversity and Over 450 Bird Species
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Beyond apex cats, the Terai protects solitary wild bull elephants, shaggy sloth bears, vast herds of swamp deer, elusive leopards, freshwater Ganges dolphins, and slender gharial crocodiles. A rich low-altitude habitat (200m) free from mountain fatigue.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-bold text-[#0e8354]">
            Gentle tropical climate, suitable for all
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3. FEATURED SAFARI EXPEDITIONS -->
  <section id="circuits-safari" class="py-16 sm:py-24 bg-slate-50 text-slate-900 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#0e8354]">Signature Expeditions</span>
          <h2 class="text-2xl sm:text-4xl font-black text-slate-950 tracking-tight mt-1">
            Featured Nepal Wildlife Safari Itineraries
          </h2>
          <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-2xl">
            Designed, guided, and managed directly by our local team with zero intermediaries. Guaranteed small groups (4–10 guests) or bespoke private departures.
          </p>
        </div>
        <a href="/en/#prochains-departs" class="text-xs font-bold text-[#0e8354] hover:underline flex items-center gap-1 shrink-0">
          <span>View All 18 Expeditions</span>
          <span>→</span>
        </a>
      </div>

      <!-- Tours Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {safariTours.map((tour) => (
          <article class="bg-white border border-slate-200 rounded-3xl overflow-hidden hover:border-[#0e8354] transition-all duration-300 flex flex-col justify-between group shadow-sm hover:shadow-xl">
            <div>
              <div class="relative h-60 overflow-hidden bg-slate-100">
                <img 
                  src={tour.image || '/assets/tours_thumbs/safari_pied_guide_jungle_bardia.webp'} 
                  alt={tour.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy"
                />
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#0e5c3e] text-white shadow-sm">
                    {tour.duration}
                  </span>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-white/90 text-slate-800 border border-slate-200">
                    {tour.slug === 'panthere-des-neiges' ? 'Adventurer' : (tour.difficulty_en || tour.difficulty || "Adventure")}
                  </span>
                </div>
                <div class="absolute bottom-3 right-3 bg-slate-950/90 text-white font-extrabold text-xs px-3 py-1 rounded-xl shadow-sm">
                  From €{String(tour.price).replace(/€/g, '').trim()}
                </div>
              </div>

              <div class="p-6 space-y-3">
                <h3 class="font-bold text-base sm:text-lg text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                  {tour.title}
                </h3>
                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                  {tour.description}
                </p>
                
                {tour.highlights && (
                  <ul class="text-[11px] text-slate-700 space-y-1 pt-2 border-t border-slate-100">
                    {tour.highlights.slice(0, 2).map((h: string) => (
                      <li class="flex items-center gap-2">
                        <span class="text-[#0e8354] font-bold">✓</span>
                        <span class="truncate">{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>

            <div class="p-6 pt-0">
              <a 
                href={`/en/tours/${tour.enSlug || tour.slug}`} 
                class="w-full py-3 px-4 rounded-xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-bold text-xs uppercase tracking-wide flex items-center justify-center gap-2 transition-all shadow-sm"
              >
                <span>View Full Itinerary</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. 1-DAY SAFARI ACTIVITIES (SHORT EXCURSIONS) -->
  <section id="activites-safari" class="py-16 sm:py-24 bg-white text-slate-900 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#0e8354]">Short Trips & Day Excursions</span>
          <h2 class="text-2xl sm:text-4xl font-black text-slate-950 tracking-tight mt-1 leading-tight">
            Our 1-Day Safari Activities
          </h2>
          <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-2xl leading-relaxed">
            Already in Bardia, Chitwan, or traveling across Nepal? Experience a thrilling full day of authentic wildlife tracking guided by certified native trackers.
          </p>
        </div>
      </div>

      <!-- Grid of 5 Activities -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {dayActivities.map((act) => (
          <article class="group bg-white rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-emerald-500/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="relative h-64 overflow-hidden bg-slate-100">
                <a href={act.url} class="block w-full h-full">
                  <img 
                    src={act.image} 
                    alt={act.alt} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#0e5c3e] text-white shadow-sm">
                    {act.duration}
                  </span>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-white/95 text-slate-800 border border-slate-200 shadow-xs">
                    {act.badge}
                  </span>
                </div>
                <div class="absolute bottom-3 right-3 bg-slate-950/90 text-amber-400 font-black text-xs px-2.5 py-1 rounded-xl shadow-sm flex items-center gap-1">
                  <span>★</span>
                  <span class="text-white font-bold">{act.rating}</span>
                </div>
              </div>

              <div class="p-6 space-y-3">
                <div class="text-[11px] font-extrabold uppercase tracking-widest text-[#0e8354] flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#0e8354]"></span>
                  <span>{act.tag}</span>
                </div>
                <h3 class="font-bold text-base sm:text-lg text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                  <a href={act.url}>{act.title}</a>
                </h3>
                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed font-normal">
                  {act.description}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-slate-100 mt-2">
              <div class="flex items-center justify-between gap-2 pt-3 pb-3">
                <div>
                  <p class="text-[10px] uppercase tracking-wider font-extrabold text-slate-400">{act.priceLabel}</p>
                  <span class="font-black text-2xl text-slate-950 tracking-tight leading-none">{act.price}</span>
                </div>
                <div class="text-right">
