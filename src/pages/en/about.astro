---
import { getLocalizedPath } from '../../i18n/utils';

import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import toursData from '../../data/tours.json';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<Layout title="About Us | Jungle Nepal Adventure – Our Story & Trackers" lang="en">

  <!-- 1. TOP ANNOUNCEMENT BANNER -->
  <aside aria-label="Information banner" class="bg-[#05281a] text-white text-[11px] sm:text-xs py-1.5 px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      
      <div class="flex-1 flex items-center justify-center gap-2 overflow-hidden whitespace-nowrap text-ellipsis">
        <span><strong class="text-amber-300">€100 OFF</strong> your Nov. 2027 trip with code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/70 hover:text-white text-xs leading-none px-1 cursor-pointer" aria-label="Close">✕</button>
    </div>
  </aside>

  <!-- 2. NAVBAR TRANSPARENTE AVEC FOND SOMBRE -->
  <header class="absolute top-[38px] left-0 right-0 z-40 px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between text-white max-w-7xl mx-auto">
    
    <!-- LEFT: LOGO BLANC TRANSPARENT -->
    <a href="/en/" class="flex items-center gap-2 group shrink-0">
      <img decoding="async" 
        src="/assets/logo_nav_white.webp" 
        alt="Jungle Nepal Adventure Logo" 
        class="h-11 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-md"
      />
    </a>

    <!-- CENTER: NAVIGATION LINKS -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-7 text-[13px] xl:text-[14px] font-semibold text-white/90 drop-shadow">
      <a href="/en/#prochains-departs" class="hover:text-amber-100 transition-colors whitespace-nowrap">All 16 Expeditions</a>

      <!-- Destinations Dropdown -->
      <div class="relative group py-2">
        <a href="/en/destinations" class="hover:text-amber-100 transition-colors flex items-center gap-1 cursor-pointer whitespace-nowrap">
          <span>Destinations</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-3 shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-1 text-white">
            <a href="/en/destinations/bardia" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
              
              <div class="flex-1">
                <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Bardia National Park</p>
                <p class="text-[10px] text-slate-400">Bengal Tigers & Walking Safaris</p>
              </div>
            </a>
            <a href="/en/destinations/chitwan" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
              
              <div class="flex-1">
                <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Chitwan National Park</p>
                <p class="text-[10px] text-slate-400">One-Horned Rhinos & Canoes</p>
              </div>
            </a>
            <a href="/en/destinations/suklaphanta" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
              
              <div class="flex-1">
                <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Suklaphanta National Park</p>
                <p class="text-[10px] text-slate-400">Swamp Deer & Untamed Wild West</p>
              </div>
            </a>
            <a href="/en/destinations/annapurna" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
              
              <div class="flex-1">
                <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Annapurna & Pokhara</p>
                <p class="text-[10px] text-slate-400">Sacred Peaks & Alpine Balconies</p>
              </div>
            </a>
            <a href="/en/destinations/katmandou" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
              
              <div class="flex-1">
                <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Kathmandu</p>
                <p class="text-[10px] text-slate-400">Valley of Kings & Sacred Temples</p>
              </div>
            </a>
            <div class="pt-2 border-t border-white/10 mt-1">
              <a href="/en/destinations" class="block w-full text-center py-2 rounded-xl bg-[#0e8354] hover:bg-[#0c6d46] text-white font-black text-xs transition-colors shadow">
                View All Destinations →
              </a>
            </div>
          </div>
        </div>
      </div>

      <a href="/en/#concept" class="hover:text-amber-100 transition-colors whitespace-nowrap">Our Guides</a>
      <a href="/en/#galerie-faune" class="hover:text-amber-100 transition-colors whitespace-nowrap">Gallery</a>
      <a href="/en/about" class="text-amber-100 font-black border-b-2 border-amber-300 pb-0.5 whitespace-nowrap">About Us</a>
      <a href="/en/blog" class="hover:text-amber-100 transition-colors whitespace-nowrap">Blog</a>
      <a href="/en/contact" class="hover:text-amber-100 transition-colors whitespace-nowrap">Contact</a>
    </nav>

    <!-- RIGHT: ACTIONS -->
    <div class="flex items-center gap-3">
      <a href="https://wa.me/33695413227" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full bg-white text-slate-950 font-black text-xs sm:text-[13px] shadow-lg hover:bg-slate-100 hover:scale-105 active:scale-95 transition-all whitespace-nowrap cursor-pointer">
        <svg class="w-4 h-4 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span class="whitespace-nowrap">WhatsApp</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button onclick="toggleMobileMenu()" class="lg:hidden w-10 h-10 rounded-2xl bg-white/15 hover:bg-white/25 text-white border border-white/30 backdrop-blur-md flex flex-col items-center justify-center gap-1.5 transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer shadow-lg p-2" aria-label="Menu principal">
        <span class="w-5 h-[2.5px] bg-white rounded-full block"></span>
        <span class="w-5 h-[2.5px] bg-white rounded-full block"></span>
        <span class="w-5 h-[2.5px] bg-white rounded-full block"></span>
      </button>
    </div>
  </header>

  <!-- MOBILE NAVIGATION DRAWER -->
  <div id="mobile-menu" style="background-color: #041d13 !important;" class="hidden lg:hidden fixed inset-x-3 top-20 z-50 max-h-[85vh] overflow-y-auto bg-[#041d13] border border-white/15 rounded-3xl p-5 text-white shadow-[0_25px_60px_rgba(0,0,0,0.95)] space-y-4 font-sans">
    <div class="flex items-center justify-between pb-3 border-b border-white/10">
      <span class="text-xs font-black uppercase tracking-widest text-slate-200">Navigation</span>
      <button onclick="toggleMobileMenu()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-sm font-bold transition-colors cursor-pointer" aria-label="Close Menu">✕</button>
    </div>

    <nav class="space-y-1 text-sm font-bold">
      <a href="/en/#prochains-departs" onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center justify-between text-white transition-colors">
        <span class="flex items-center gap-2.5"><span>All 16 Expeditions</span></span>
        <span class="text-[10px] bg-white/10 text-slate-200 px-2 py-0.5 rounded-full font-extrabold border border-white/10">15 circuits</span>
      </a>

      <div class="pt-1">
        <button onclick="toggleMobileDestinations()" class="w-full px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center justify-between text-slate-200 hover:text-white transition-colors cursor-pointer text-left">
          <span class="flex items-center gap-2.5"><span>Destinations</span></span>
          <svg id="mobile-dest-chevron" class="w-4 h-4 text-slate-400 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="mobile-destinations-menu" class="hidden pl-6 pr-2 pt-1 pb-2 space-y-1">
          <a href="/en/destinations/bardia" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            
            <div><p class="font-bold text-white">Bardia National Park</p><p class="text-[10px] text-slate-400">Bengal Tigers & Walking Safaris</p></div>
          </a>
          <a href="/en/destinations/chitwan" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            
            <div><p class="font-bold text-white">Chitwan National Park</p><p class="text-[10px] text-slate-400">One-Horned Rhinos & Canoes</p></div>
          </a>
          <a href="/en/destinations/suklaphanta" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            
            <div><p class="font-bold text-white">Suklaphanta National Park</p><p class="text-[10px] text-slate-400">Swamp Deer & Untamed Wild West</p></div>
          </a>
          <a href="/en/destinations/annapurna" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            
            <div><p class="font-bold text-white">Annapurna & Pokhara</p><p class="text-[10px] text-slate-400">Sacred Peaks & Alpine Balconies</p></div>
          </a>
          <a href="/en/destinations/katmandou" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            
            <div><p class="font-bold text-white">Kathmandu</p><p class="text-[10px] text-slate-400">Valley of Kings & Sacred Temples</p></div>
          </a>
          <a href="/en/destinations" onclick="toggleMobileMenu()" class="block w-full text-center py-2 rounded-xl bg-[#0e8354] hover:bg-[#0c6d46] text-white font-black text-xs transition-colors shadow mt-1">
            View All Destinations →
          </a>
        </div>
      </div>

      <a href="/en/#concept" onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 text-slate-200 hover:text-white transition-colors">
        <span>The Safari Spirit</span>
      </a>
      <a href="/en/#concept" class="hover:text-amber-100 transition-colors whitespace-nowrap">Our Guides</a>
      <a href="/en/#galerie-faune" onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 text-slate-200 hover:text-white transition-colors">
        <span>Gallery</span>
      </a>
      <a href="/en/about" class="px-3.5 py-2.5 rounded-2xl bg-white/15 flex items-center gap-2.5 text-white font-black">
        <span>About Us</span>
      </a>
      <a href="/en/blog" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 text-slate-200 hover:text-white transition-colors">
        <span>📝</span><span>Blog</span><span class="text-[10px] bg-white/10 text-slate-300 px-1.5 py-0.5 rounded font-mono ml-auto">↗</span>
      </a>
      <a href="/en/blog" class="hover:text-amber-100 transition-colors">Blog</a>
      <a href="/en/contact" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 text-slate-200 hover:text-white transition-colors">
        <span>Contact</span>
      </a>
    </nav>
  </div>

    <!-- 3. HERO IMMERSIF (PHOTO AUTHENTIQUE DRIVE : SAFARI À PIED EN JUNGLE) -->
  <section class="relative min-h-[580px] sm:min-h-[640px] flex items-center justify-center bg-slate-950 text-white overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
    <!-- Image de fond authentique du Drive -->
    <div class="absolute inset-0 z-0">
      <img loading="lazy" decoding="async" 
        src="/assets/drive_photos/julien_safari_a_pied.webp" 
        alt="Walking tracking in the jungle of Bardia Nepal" 
        class="w-full h-full object-cover opacity-55 scale-105 transform filter brightness-80 contrast-105"
      />
      
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center px-4 sm:px-6">

      <h1 class="font-black text-4xl sm:text-6xl md:text-7xl text-white tracking-tight leading-[1.08] drop-shadow-[0_4px_20px_rgba(0,0,0,0.9)]">
        Authentic Exploration of Nepal.
      </h1>

      <p class="mt-6 text-base sm:text-xl text-slate-100 max-w-3xl font-medium leading-relaxed drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
        From the wild sanctuaries of the Terai to the sacred Himalayan balconies, through ancient villages and living cultural festivals: we craft immersive human, cultural, and wildlife expeditions in small groups.
      </p>
    </div>
  </section>

  <!-- 4. NOTRE MANIFESTE -->
  <section class="py-20 sm:py-28 bg-white border-b border-slate-200/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <p class="text-xs font-black tracking-widest uppercase text-[#0e8354] mb-2">
            Our Manifesto
          </p>
          
          <h2 class="font-black text-3xl sm:text-4xl text-slate-950 tracking-tight leading-tight">
            Authentic Nepal is Not Found in Tour Buses.
          </h2>
          
          <p class="text-slate-600 text-base leading-relaxed font-normal">
            Nepal is far more than a postcard of snowy peaks or standardized tour circuits. It is a land of profound contrasts: from dense Terai jungles where tigers and rhinos roam, to ancient royal cities like Kathmandu and Bhaktapur, up to the secluded valleys of Mustang and untouched Himalayan trails.
          </p>
          
          <p class="text-slate-600 text-base leading-relaxed font-normal">
            We founded <strong>Jungle Nepal Adventure</strong> to provide an intimate and respectful alternative: walking wildlife safaris, authentic indigenous homestays, mindful retreats beneath towering peaks, and exclusive high-altitude expeditions (such as our snow leopard quest), led by native guides and master trackers.
          </p>

          <div class="pt-4 grid grid-cols-2 gap-4 border-t border-slate-100 text-xs">
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
              <p class="font-black text-xl text-slate-900">20+ Years</p>
              <p class="text-slate-500 font-medium mt-0.5">Field tracking & expedition expertise</p>
            </div>
            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80">
              <p class="font-black text-xl text-[#0e8354]">100% Local</p>
              <p class="text-slate-500 font-medium mt-0.5">Direct economic impact for local villages</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200">
            <img loading="lazy" decoding="async" 
              src="/assets/drive_photos/julien_tigre_bengale2.webp" 
              alt="Bardia Bengal Tiger" 
              class="w-full h-[460px] object-cover -scale-x-100 transform"
            />
            <div class="absolute bottom-6 left-6 right-6 p-5 rounded-2xl bg-slate-950/80 backdrop-blur-md border border-white/20 text-white text-xs">
              <p class="font-bold text-amber-100">"Observing a tiger on foot in absolute silence forever transforms how you see the wild."</p>
              <p class="text-slate-400 mt-1">— Pawan, Lead Master Tracker in Bardia</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

    <!-- 4.1. NOS 4 UNIVERS D'EXPLORATION (DESIGN LUXE AVEC PHOTO PANORAMIQUE EN BACKGROUND & GLASSMORPHISM) -->
  <section class="relative py-24 sm:py-32 bg-slate-950 text-white overflow-hidden border-y border-white/10">
    <!-- Photo Panoramique Horizontale de l'Himalaya & du Népal Sauvage -->
    <div class="absolute inset-0 z-0">
      <img decoding="async" 
        src="/assets/original_site/himalayas_sunrise_peaks.webp" 
        alt="Chaîne himalayenne et sommets sacrés au lever du soleil" 
        class="w-full h-full object-cover opacity-55 scale-105 filter brightness-95 contrast-100"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/40 to-slate-950/70"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- En-tête de section -->
      <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
        <p class="text-xs font-black tracking-widest uppercase text-slate-400 mb-3">
          Diverse Experiences
        </p>
        <h2 class="font-black text-3xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight">
          Four Ways to Experience Nepal
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-300 font-normal leading-relaxed max-w-2xl mx-auto">
          Every traveler moves at their own rhythm. Our expeditions are structured around four great exploration pillars.
        </p>
      </div>

      <!-- Grille 4 Cartes avec Photos Immersives en Arrière-Plan & Typographie Sobre -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        
        <!-- 1. Jungle & Faune Sauvage -->
        <div class="group relative rounded-3xl overflow-hidden min-h-[380px] sm:min-h-[420px] p-7 flex flex-col justify-between shadow-2xl border border-white/15 bg-slate-950 transition-all duration-300 hover:border-white/30 hover:-translate-y-1">
          <div class="absolute inset-0 z-0">
            <img decoding="async" 
              src="/assets/drive_photos/julien_tigre_bengale3.webp" 
              alt="Tiger safari in the jungle" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-75 filter brightness-95 contrast-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/50 to-slate-950/20"></div>
          </div>

          <div class="relative z-10 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md border border-white/15 text-white flex items-center justify-center font-mono font-extrabold text-xs">
              01
            </div>
            <h3 class="font-black text-xl text-white group-hover:text-amber-100 transition-colors leading-snug">
              Safaris & Big Cats
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-200 leading-relaxed font-normal">
              Silent tracking on foot of Bengal tigers, greater one-horned rhinos, and wild elephants across Bardia, Chitwan, and Suklaphanta.
            </p>
          </div>

          <div class="relative z-10 pt-4 border-t border-white/15">
            <a href="/en/destinations/bardia" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-100 group-hover:text-white group-hover:translate-x-1 transition-all">
              <span>Explore the Jungle</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- 2. Montagnes & Hauts Sommets -->
        <div class="group relative rounded-3xl overflow-hidden min-h-[380px] sm:min-h-[420px] p-7 flex flex-col justify-between shadow-2xl border border-white/15 bg-slate-950 transition-all duration-300 hover:border-white/30 hover:-translate-y-1">
          <div class="absolute inset-0 z-0">
            <img decoding="async" 
              src="/assets/original_site/machapuchare.webp" 
              alt="Sacred peaks of the Annapurnas" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-75 filter brightness-95 contrast-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/50 to-slate-950/20"></div>
          </div>

          <div class="relative z-10 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md border border-white/15 text-white flex items-center justify-center font-mono font-extrabold text-xs">
              02
            </div>
            <h3 class="font-black text-xl text-white group-hover:text-amber-100 transition-colors leading-snug">
              High Mountains & Treks
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-200 leading-relaxed font-normal">
              Alpine balconies of the Annapurnas, snow leopard expeditions in Upper Manang (3,600m), and remote high passes far from crowds.
            </p>
          </div>

          <div class="relative z-10 pt-4 border-t border-white/15">
            <a href="/en/destinations/annapurna" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-100 group-hover:text-white group-hover:translate-x-1 transition-all">
              <span>Discover Treks</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- 3. Culture & Vie de Village -->
        <div class="group relative rounded-3xl overflow-hidden min-h-[380px] sm:min-h-[420px] p-7 flex flex-col justify-between shadow-2xl border border-white/15 bg-slate-950 transition-all duration-300 hover:border-white/30 hover:-translate-y-1">
          <div class="absolute inset-0 z-0">
            <img decoding="async" 
              src="/assets/drive_photos/adrien_bhaktapur1.webp" 
              alt="Sacred temples and local culture" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-75 filter brightness-95 contrast-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/50 to-slate-950/20"></div>
          </div>

          <div class="relative z-10 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md border border-white/15 text-white flex items-center justify-center font-mono font-extrabold text-xs">
              03
            </div>
            <h3 class="font-black text-xl text-white group-hover:text-amber-100 transition-colors leading-snug">
