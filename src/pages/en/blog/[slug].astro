---
import { getLocalizedPath } from '../../../i18n/utils';

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import posts from '../../../data/blog_posts.en.json';

export async function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Related posts (pick 3 other posts)
const relatedPosts = posts.filter((p) => p.slug !== post.slug).slice(0, 3);

// Format date
const formattedDate = new Date(post.date).toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
// Schema.org FAQ Extractor
const faqs: { question: string; answer: string }[] = [];
const h3Regex = /<h3[^>]*>(?:<strong[^>]*>)?(.*?)(?:<\/strong>)?<\/h3>[\s\S]*?<p[^>]*>(.*?)<\/p>/gi;
let match;
const contentToSearch = post.content || '';
while ((match = h3Regex.exec(contentToSearch)) !== null) {
  const q = match[1].replace(/<[^>]+>/g, '').trim();
  const a = match[2].replace(/<[^>]+>/g, '').trim();
  if ((q.includes('?') || q.toLowerCase().startsWith('comment') || q.toLowerCase().startsWith('quel') || q.toLowerCase().startsWith('combien') || q.toLowerCase().startsWith('est-il') || q.toLowerCase().startsWith('quelle') || q.toLowerCase().startsWith('where') || q.toLowerCase().startsWith('what') || q.toLowerCase().startsWith('how') || q.toLowerCase().startsWith('can') || q.toLowerCase().startsWith('why')) && a.length > 20) {
    faqs.push({ question: q, answer: a });
  }
}
---

<Layout 
  title={`${post.title} | Jungle Nepal Adventure`}
  description={post.description}
  image={post.featuredImage}
  lang="en"
>

  <!-- SCHEMA.ORG ARTICLE JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.title,
    "description": post.description,
    "image": [
      post.featuredImage.startsWith('http') ? post.featuredImage : `https://junglenepaladventure.com${post.featuredImage}`
    ],
    "datePublished": post.date,
    "dateModified": post.date,
    "author": [{
      "@type": "Person",
      "name": "Robin Rozier",
      "jobTitle": "Naturalist Guide & Expedition Photographer",
      "url": "https://junglenepaladventure.com/en/about"
    }],
    "publisher": {
      "@type": "Organization",
      "name": "Jungle Nepal Adventure",
      "logo": {
        "@type": "ImageObject",
        "url": "https://junglenepaladventure.com/assets/logo_nav_white.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://junglenepaladventure.com/en/blog/${post.slug}`
    }
  })} />

  <!-- SCHEMA.ORG BREADCRUMB LIST -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://junglenepaladventure.com/en"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://junglenepaladventure.com/en/blog"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": post.title,
        "item": `https://junglenepaladventure.com/en/blog/${post.slug}`
      }
    ]
  })} />

  <!-- SCHEMA.ORG FAQ PAGE JSON-LD (IF FAQS PRESENT) -->
  {faqs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    })} />
  )}

  <!-- TOP PROMO BAR -->
  <aside aria-label="Information banner" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">-100€</strong> on your Nov. 2027 trip with code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Close">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <Header isTransparent={false} currentPath="/en/blog" lang="en" />

  <!-- ARTICLE HERO -->
  <header class="relative bg-slate-950 text-white pt-16 pb-20 px-4 sm:px-6 lg:px-8 border-b border-white/10 overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-80 bg-gradient-to-b from-[#134836]/40 via-transparent to-transparent pointer-events-none blur-3xl"></div>

    <div class="relative max-w-4xl mx-auto space-y-6">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 font-semibold flex-wrap">
        <a href="/en/" class="hover:text-white transition-colors">Home</a>
        <span>›</span>
        <a href="/en/blog" class="hover:text-white transition-colors">Blog</a>
        <span>›</span>
        <span class="text-emerald-400 font-bold truncate max-w-xs sm:max-w-md">{post.title}</span>
      </nav>

      <!-- Category & Read Time -->
      <div class="flex flex-wrap items-center gap-3 text-xs font-bold">
        <span class="px-3 py-1 rounded-full bg-[#134836] text-emerald-300 border border-emerald-500/30 uppercase tracking-wider">
          {post.category}
        </span>
        <span class="text-slate-400">•</span>
        <span class="text-slate-300">⏱ {post.readingTime} read</span>
        <span class="text-slate-400">•</span>
        <time datetime={post.date} class="text-slate-300">Published on {formattedDate}</time>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
        {post.title}
      </h1>

      <!-- Meta description summary banner -->
      {post.description && (
        <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed border-l-4 border-emerald-500 pl-4 py-1 bg-white/5 rounded-r-2xl">
          {post.description}
        </p>
      )}

      <!-- Author snippet -->
      <div class="pt-2 flex items-center gap-3">
        <img loading="lazy" decoding="async" alt="Wildlife observation and jungle safari (img 3) in Bardia National Park, Terai, Nepal" src="/assets/img_3.webp" class="w-10 h-10 rounded-full border-2 border-emerald-500/50 object-cover shadow-md" />
        <div>
          <p class="text-xs sm:text-sm font-bold text-white">Written by Robin</p>
        </div>
      </div>
    </div>
  </header>

  <!-- FEATURED IMAGE (Centered, High-Impact) -->
  {post.featuredImage && (
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative z-10">
      <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-slate-900 aspect-video">
        <img decoding="async" 
          src={post.featuredImage} 
          alt={post.title} 
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  )}

  <!-- MAIN ARTICLE BODY -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
    
    <!-- Rendered HTML Content with Elite Article Styling -->
    <div class="article-content-body max-w-none">
      <div set:html={post.content} />
    </div>

    <!-- AUTHOR BIO BOX -->
    <div class="p-6 sm:p-8 bg-safari-50 rounded-3xl border border-slate-200/90 flex flex-col sm:flex-row items-center sm:items-start gap-6 shadow-sm">
      <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden shrink-0 border-2 border-[#0e8354] shadow-md">
        <img loading="lazy" decoding="async" alt="Wildlife observation and jungle safari (img 3) in Bardia National Park, Terai, Nepal" 
          src="/assets/img_3.webp" 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="space-y-1.5 text-center sm:text-left">
        <h4 class="font-black text-slate-950 text-base sm:text-lg">Written by Robin</h4>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          Wildlife enthusiast and lover of Nepal's pristine forests, Robin shares his field insights and hands-on experience to help you prepare your jungle safari in Nepal.
        </p>
      </div>
    </div>

    <!-- RELATED GUIDES / SIMILAR POSTS -->
    <section class="space-y-6 pt-8 border-t border-slate-200">
      <div class="flex items-center justify-between">
        <h3 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
          Recommended Guides & Articles
        </h3>
        <a href="/en/blog" class="text-xs font-bold text-[#0e8354] hover:underline">
          All Guides →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map((rel) => (
          <a 
            href={`/en/blog/${rel.slug}`} 
            class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col"
          >
            <div class="h-40 overflow-hidden bg-slate-900 shrink-0">
              <img decoding="async" 
                src={rel.featuredImage} 
                alt={rel.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
            </div>
            <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">
                  {rel.category}
                </span>
                <span class="text-[10px] font-medium text-slate-400">
                  ⏱ {rel.readingTime}
                </span>
              </div>
              <h4 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-700 transition-colors line-clamp-2 leading-snug">
                {rel.title}
              </h4>
              <p class="text-[11px] text-slate-500 line-clamp-2">
                {rel.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

  </article>

  <Footer lang="en" />

  <!-- Instagram Embed Script Support -->
  <script is:inline async src="https://www.instagram.com/embed.js"></script>
  <script is:inline>
    function initInstagramEmbeds() {
      if (window.instgrm && window.instgrm.Embeds) {
        window.instgrm.Embeds.process();
      }
    }
    if (document.readyState === 'complete') {
      initInstagramEmbeds();
    } else {
      window.addEventListener('load', initInstagramEmbeds);
    }
  </script>

</Layout>

<style is:global>
  /* Base article typography & reset */
  .article-content-body {
    color: #334155;
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  /* Headings H2 */
  .article-content-body h2,
  .article-content-body h2 strong,
  .article-content-body .wp-block-heading:is(h2) {
    font-size: 1.75rem !important;
    line-height: 1.3 !important;
    font-weight: 900 !important;
    color: #041d13 !important;
    letter-spacing: -0.025em !important;
    margin-top: 3rem !important;
    margin-bottom: 1rem !important;
    display: block !important;
  }

  @media (min-width: 640px) {
    .article-content-body h2,
    .article-content-body h2 strong,
    .article-content-body .wp-block-heading:is(h2) {
      font-size: 2.125rem !important;
    }
  }

  /* Headings H3 */
  .article-content-body h3,
  .article-content-body h3 strong,
  .article-content-body .wp-block-heading:is(h3) {
    font-size: 1.35rem !important;
    line-height: 1.35 !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    letter-spacing: -0.015em !important;
    margin-top: 2.5rem !important;
    margin-bottom: 0.85rem !important;
    display: block !important;
  }

  @media (min-width: 640px) {
    .article-content-body h3,
    .article-content-body h3 strong,
    .article-content-body .wp-block-heading:is(h3) {
      font-size: 1.55rem !important;
    }
  }

  /* Headings H4 */
  .article-content-body h4,
  .article-content-body h4 strong {
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    margin-top: 2rem !important;
    margin-bottom: 0.5rem !important;
    display: block !important;
  }

  /* Paragraphs */
  .article-content-body p,
  .article-content-body .wp-block-paragraph {
    margin-top: 1.35rem !important;
    margin-bottom: 1.35rem !important;
    color: #334155 !important;
    line-height: 1.85 !important;
  }

  /* Links */
  .article-content-body a {
    color: #0e8354 !important;
    font-weight: 700 !important;
    text-decoration: underline !important;
    text-decoration-color: #0e8354 !important;
    text-underline-offset: 3px !important;
    transition: color 0.15s ease, text-decoration-color 0.15s ease !important;
  }

  .article-content-body a:hover {
    color: #083c27 !important;
    text-decoration-color: #083c27 !important;
  }

  /* Strong */
  .article-content-body strong,
  .article-content-body b {
    color: #0f172a !important;
    font-weight: 800 !important;
  }

  /* Lists */
  .article-content-body ul,
  .article-content-body .wp-block-list {
    list-style-type: disc !important;
    padding-left: 1.75rem !important;
    margin-top: 1.5rem !important;
    margin-bottom: 1.5rem !important;
  }

  .article-content-body ol {
    list-style-type: decimal !important;
    padding-left: 1.75rem !important;
    margin-top: 1.5rem !important;
    margin-bottom: 1.5rem !important;
  }

  .article-content-body li {
    margin-top: 0.6rem !important;
    margin-bottom: 0.6rem !important;
    color: #334155 !important;
    line-height: 1.75 !important;
  }

  /* Images & Figures */
  .article-content-body figure,
  .article-content-body .wp-block-image {
    margin-top: 2.75rem !important;
    margin-bottom: 2.75rem !important;
  }

  .article-content-body img {
    border-radius: 1.5rem !important;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.12), 0 8px 12px -6px rgba(0, 0, 0, 0.08) !important;
    border: 1px solid #e2e8f0 !important;
    width: 100% !important;
    height: auto !important;
    display: block !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .article-content-body figcaption,
  .article-content-body .wp-element-caption {
    text-align: center !important;
    font-size: 0.8125rem !important;
    color: #64748b !important;
    font-style: italic !important;
    margin-top: 0.75rem !important;
  }

  /* Blockquotes */
  .article-content-body blockquote {
    border-left: 4px solid #109363 !important;
    background: rgba(16, 147, 99, 0.06) !important;
    border-radius: 0 1rem 1rem 0 !important;
    padding: 1.25rem 1.75rem !important;
    margin: 2.25rem 0 !important;
    font-style: italic !important;
    color: #1e293b !important;
  }

  /* Tables */
  .article-content-body table {
    width: 100% !important;
    border-collapse: collapse !important;
    margin: 2.25rem 0 !important;
    border-radius: 1rem !important;
    overflow: hidden !important;
    border: 1px solid #e2e8f0 !important;
  }

  .article-content-body th {
    background: #f8fafc !important;
    color: #0f172a !important;
    font-weight: 800 !important;
    padding: 0.85rem 1.15rem !important;
    text-align: left !important;
    border-bottom: 2px solid #cbd5e1 !important;
  }

  .article-content-body td {
    padding: 0.85rem 1.15rem !important;
    border-bottom: 1px solid #f1f5f9 !important;
    color: #334155 !important;
  }

  /* Clean Minimalist CTA Block */
  .article-content-body .blog-cta-card {
    background-color: #042014 !important;
    border: 1px solid rgba(16, 185, 129, 0.25) !important;
    border-radius: 1rem !important;
    padding: 1.5rem 1.75rem !important;
    margin: 2.5rem 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 1.25rem !important;
    text-align: left !important;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.08) !important;
  }

  @media (min-width: 640px) {
    .article-content-body .blog-cta-card {
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
    }
  }

  .article-content-body .blog-cta-card h3 {
    color: #ffffff !important;
    font-size: 1.2rem !important;
    font-weight: 800 !important;
    margin: 0 !important;
    line-height: 1.35 !important;
    letter-spacing: -0.015em !important;
    text-shadow: none !important;
  }

  .article-content-body .blog-cta-card p {
    color: #cbd5e1 !important;
    font-size: 0.875rem !important;
    line-height: 1.5 !important;
    margin: 0.35rem 0 0 0 !important;
    max-width: 34rem !important;
  }

  .article-content-body .blog-cta-card a.cta-btn {
    background-color: #10b981 !important;
    background-image: none !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    font-size: 0.875rem !important;
    padding: 0.75rem 1.35rem !important;
    border-radius: 0.625rem !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
    transition: background-color 0.2s ease, transform 0.15s ease !important;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25) !important;
    border: none !important;
  }

  .article-content-body .blog-cta-card a.cta-btn:hover {
    background-color: #059669 !important;
    color: #ffffff !important;
    transform: translateY(-1px) !important;
    text-decoration: none !important;
  }
</style>
