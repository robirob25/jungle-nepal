---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import posts from '../../../data/blog_posts.json';

// Sort posts by date descending
const sortedPosts = [...posts].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const featuredPost = sortedPosts[0];
const otherPosts = sortedPosts.slice(1);
---

<Layout 
  title="Blog & Guides Safari au Népal | Conseils d'experts & Récits de Jungle" 
  description="Guides complets, conseils d'experts et récits d'expéditions sauvages au Népal : pister le tigre du Bengale, observer la faune à Bardia et Chitwan, préparer votre safari." 
  image={featuredPost?.featuredImage || "/assets/original_site/tigre_bardia.webp"}
  lang="en"
>

  <!-- TOP PROMO BAR -->
  <aside aria-label="Bannière d'information" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">-100€</strong> sur votre séjour nov. 2027 avec le code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Fermer">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <Header isTransparent={false} currentPath="/blog" />

  <!-- HERO BANNER -->
  <section class="relative bg-slate-950 text-white pt-20 pb-16 px-4 sm:px-6 lg:px-8 border-b border-white/10 overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-[#134836]/40 via-transparent to-transparent pointer-events-none blur-3xl"></div>
    
    <div class="relative max-w-5xl mx-auto text-center space-y-5">
      <nav class="flex items-center justify-center gap-2 text-xs text-slate-400 font-semibold mb-2">
        <a href="/en/" class="hover:text-white transition-colors">Accueil</a>
        <span>›</span>
        <span class="text-emerald-400 font-bold">Le Blog Sauvage</span>
      </nav>
      
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#134836]/60 text-emerald-300 text-xs font-black uppercase tracking-widest border border-emerald-500/30">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>26 Guides & Articles d'Experts</span>
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.15]">
        Carnets de Jungle & <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-200 bg-clip-text text-transparent">Guides Safari au Népal</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed">
        Conseils d'experts locaux, fiches espèces, repérages des pistes de Bardia et Chitwan, et récits immersifs pour réussir votre voyage au cœur de la faune népalaise.
      </p>

      <!-- SEARCH BAR -->
      <div class="pt-4 max-w-xl mx-auto">
        <div class="relative">
          <input 
            type="text" 
            id="blog-search-input"
            placeholder="Rechercher un guide (tigre, bardia, budget, matériel, oiseaux...)..." 
            class="w-full px-5 py-4 pl-12 rounded-2xl bg-white/10 border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:bg-slate-900/90 text-sm transition-all backdrop-blur-md"
          />
          <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN BLOG CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <!-- FEATURED POST -->
    {featuredPost && (
      <section id="featured-article-box" class="group relative rounded-3xl overflow-hidden bg-white border border-slate-200/90 shadow-xl hover:shadow-2xl transition-all duration-300">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
          
          <!-- Image -->
          <div class="lg:col-span-7 relative h-72 sm:h-96 lg:h-full min-h-[340px] overflow-hidden bg-slate-950">
            <img 
              src={featuredPost.featuredImage} 
              alt={featuredPost.title} 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent lg:hidden"></div>
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 rounded-full bg-[#134836] text-white font-extrabold text-xs uppercase tracking-wider shadow-lg border border-white/20">
                ★ À la une
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="lg:col-span-5 p-6 sm:p-10 flex flex-col justify-between space-y-6 bg-gradient-to-br from-white via-slate-50/50 to-white">
            <div class="space-y-4">
              <div class="flex items-center gap-3 text-xs font-bold text-slate-500">
                <span class="text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200">
                  {featuredPost.category}
                </span>
                <span>•</span>
                <span>{featuredPost.readingTime}</span>
                <span>•</span>
                <time datetime={featuredPost.date}>{new Date(featuredPost.date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
              </div>

              <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight leading-tight group-hover:text-emerald-700 transition-colors">
                <a href={`/blog/${featuredPost.slug}.html`} class="hover:underline">
                  {featuredPost.title}
                </a>
              </h2>

              <p class="text-slate-600 text-sm sm:text-base leading-relaxed line-clamp-3 font-normal">
                {featuredPost.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <img src="/assets/logo_dark.png" alt="Jungle Nepal Team" class="w-9 h-9 rounded-full border border-slate-200 object-contain p-0.5 bg-slate-900" />
                <div>
                  <p class="text-xs font-bold text-slate-900">Jungle Nepal Adventure</p>
                  <p class="text-[11px] text-slate-500">Pisteurs & Guides Experts</p>
                </div>
              </div>

              <a 
                href={`/blog/${featuredPost.slug}.html`} 
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#134836] hover:bg-[#0c3225] text-white font-black text-xs shadow-md transition-all group-hover:translate-x-1"
              >
                <span>Lire le guide</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </div>
      </section>
    )}

    <!-- ARTICLE GRID SECTION -->
    <section class="space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
          <h2 class="text-2xl font-black text-slate-950 tracking-tight">
            Tous les articles & guides pratiques
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 font-medium">
            Explorez notre bibliothèque complète de ressources pour votre safari au Népal.
          </p>
        </div>
        <span id="posts-count-badge" class="text-xs font-bold text-slate-600 bg-slate-100 px-3 py-1.5 rounded-full self-start sm:self-auto border border-slate-200">
          {posts.length} articles
        </span>
      </div>

      <!-- GRID -->
      <div id="blog-posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {otherPosts.map((post) => (
          <article 
            class="blog-card group flex flex-col bg-white rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
            data-title={post.title.toLowerCase()}
            data-desc={post.description.toLowerCase()}
          >
            <!-- Card Thumbnail -->
            <a href={`/blog/${post.slug}.html`} class="relative block h-52 overflow-hidden bg-slate-900 shrink-0">
              <img 
                src={post.featuredImage} 
                alt={post.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
              <div class="absolute top-3 left-3">
                <span class="px-2.5 py-1 rounded-lg bg-slate-950/80 backdrop-blur-md text-emerald-300 font-bold text-[11px] border border-white/10">
                  {post.category}
                </span>
              </div>
              <div class="absolute bottom-3 right-3">
                <span class="px-2 py-0.5 rounded-md bg-white/90 text-slate-900 font-bold text-[11px] shadow">
                  ⏱ {post.readingTime}
                </span>
              </div>
            </a>

            <!-- Card Body -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2.5">
                <div class="text-[11px] font-bold text-slate-400">
                  <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
                </div>

                <h3 class="font-black text-lg text-slate-950 group-hover:text-emerald-700 transition-colors leading-snug">
                  <a href={`/blog/${post.slug}.html`}>
                    {post.title}
                  </a>
                </h3>

                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed font-medium">
                  {post.description}
                </p>
              </div>

              <!-- Card Action -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <a href={`/blog/${post.slug}.html`} class="text-xs font-bold text-emerald-700 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  <span>Lire le guide complet</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- No search results empty state -->
      <div id="no-results" class="hidden text-center py-16 bg-slate-50 rounded-3xl border border-dashed border-slate-300 space-y-3">
        <div class="w-12 h-12 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center mx-auto text-xl font-bold">🔍</div>
        <h4 class="text-base font-bold text-slate-800">Aucun guide ne correspond à votre recherche</h4>
        <p class="text-xs text-slate-500">Essayez un autre mot-clé comme « tigre », « bardia », « budget » ou « équipement ».</p>
        <button onclick="document.getElementById('blog-search-input').value=''; filterPosts('');" class="px-4 py-2 rounded-xl bg-[#134836] text-white text-xs font-bold cursor-pointer hover:bg-emerald-800 transition-colors">
          Réinitialiser la recherche
        </button>
      </div>
    </section>

    <!-- NEWSLETTER & CUSTOM QUOTE CTA -->
    <section class="rounded-3xl p-8 sm:p-12 bg-gradient-to-br from-[#032317] via-[#053222] to-[#021810] text-white border border-emerald-500/20 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-16 -bottom-16 w-80 h-80 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>
      
      <div class="relative max-w-3xl space-y-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 text-emerald-300 font-extrabold text-[11px] uppercase tracking-widest border border-white/10">
          <span>Préparez votre départ</span>
        </span>
        <h3 class="text-2xl sm:text-4xl font-black tracking-tight text-white leading-tight">
          Envie de vivre ces safaris sur le terrain avec nos pisteurs ?
        </h3>
        <p class="text-sm sm:text-base text-slate-300 font-normal leading-relaxed">
          Nos 15 sédays d'immersion sauvage se déroulent en micro-groupes (4 à 10 voyageurs) ou en formule sur-mesure 100% privatisée. Contactez Robin pour concevoir votre projet.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a href="/en/#prochains-departs" class="px-6 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs sm:text-sm shadow-xl transition-all hover:scale-105 active:scale-95">
            Découvrir tous les 15 sédays →
          </a>
          <button onclick="openCustomTourModal()" class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-extrabold text-xs sm:text-sm border border-white/20 transition-all cursor-pointer">
            Demander un devis personnalisé
          </button>
        </div>
      </div>
    </section>

  </main>

  <!-- SEARCH SCRIPT -->
  <script is:inline>
    const searchInput = document.getElementById('blog-search-input');
    const cards = document.querySelectorAll('.blog-card');
    const noResults = document.getElementById('no-results');
    const countBadge = document.getElementById('posts-count-badge');

    function filterPosts(query) {
      const q = query.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        if (!q || title.includes(q) || desc.includes(q)) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
      if (countBadge) {
        countBadge.textContent = `${visibleCount} article${visibleCount > 1 ? 's' : ''}`;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        filterPosts(e.target.value);
      });
    }
  </script>

  <Footer lang="en" />

</Layout>
