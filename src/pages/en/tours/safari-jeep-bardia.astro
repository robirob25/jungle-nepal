<!-- SCHEMA.ORG TOURIST TRIP JSON-LD (RICH SNIPPETS GOOGLE) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Bardia: Private 4x4 Jeep Safari in Bardia National Park – Full Day Wildlife Quest",
  "description": "Full day private 4x4 Jeep safari exploration deep into Bardia National Park. Track royal Bengal tigers, wild elephants, and one-horned rhinos with private driver, senior naturalist guide, and expert tracker.",
  "image": "https://junglenepal.com/assets/tours_thumbs/safari_jeep_chauffeur_bardia.webp",
  "touristType": ["Nature Lovers", "Wildlife Photographers", "Adventurers", "Families"],
  "offers": {
    "@type": "Offer",
    "price": "190",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-08-01",
    "url": "https://junglenepal.com/en/tours/safari-jeep-bardia"
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Jungle Nepal Adventure",
    "url": "https://junglenepal.com/en/"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "19",
    "bestRating": "5"
  }
}
</script>

