      <div class="hidden md:block md:col-span-1 h-full overflow-hidden">
        <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_jeep_tigre_bengale_bardia.webp" alt="Royal Bengal Tiger in lush jungle vegetation" class="w-full h-full object-cover transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(1)"/>
      </div>
      <div class="hidden md:flex flex-col gap-3 h-full">
        <div class="h-1/2 overflow-hidden rounded-tr-2xl">
          <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_jeep_elephants_sauvages_bardia.webp" alt="Wild Asian elephants in the grasslands" class="w-full h-full object-cover transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(2)"/>
