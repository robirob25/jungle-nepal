---
import { getLocalizedPath } from '../../../i18n/utils';
import Footer from '../../../components/Footer.astro';
import Layout from '../../../layouts/Layout.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

  <!-- SCHEMA.ORG TOURIST TRIP & FAQ JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Chitwan: Walking Safari in Chitwan – Full Day in the Wild Nepal Jungle",
  "description": "Discover Chitwan National Park on foot. A full day immersive walking safari with 1 naturalist guide and 1 tracker to encounter Bengal tigers, one-horned rhinos, sloth bears, and wildlife.",
  "image": "https://junglenepal.com/assets/tours_thumbs/safari_pied_chitwan_guide_sourire.webp",
  "touristType": [
    "Nature Lovers",
    "Wildlife Photographers",
    "Hikers",
    "Adventurers"
  ],
  "offers": {
    "@type": "Offer",
    "price": "70",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-08-01",
    "url": "https://junglenepal.com/en/tours/safari-pied-chitwan"
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Jungle Nepal Adventure",
    "url": "https://junglenepal.com",
    "logo": "https://junglenepal.com/assets/logo_nav_white.png",
    "email": "contact@junglenepal.com",
    "telephone": "+33695413227",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bardia & Katmandou",
      "addressCountry": "NP"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "21",
    "bestRating": "5"
  },
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": 1,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "TouristAttraction",
          "name": "Day 1 – Full Day Walking Safari in Chitwan",
          "description": "Departure at 6:30 AM with dugout wooden canoe crossing of Rapti river. Tracking in forests and grasslands. Bush picnic lunch included. Return around 6:00 PM."
        }
      }
    ]
  }
}
  </script>


<Layout title="Chitwan: Walking Safari in Chitwan – Full Day in the Wild Nepal Jungle | Jungle Nepal Adventure" lang="en">

  <!-- TOP BAR PROMO -->
  <aside class="bg-[#05281a] text-white text-[11px] sm:text-xs py-1.5 px-4 relative z-50 text-center border-b border-emerald-800/20" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex-1 flex items-center justify-center gap-2 overflow-hidden whitespace-nowrap text-ellipsis">
        <span><strong class="text-amber-300">100% Wild Foot Tracking</strong> in Chitwan • Certified Native Naturalist Guides</span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/70 hover:text-white text-xs px-1 cursor-pointer">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <header class="relative z-40 bg-white border-b border-slate-200 py-2.5 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between gap-4 h-14 sm:h-16">
        <div class="flex items-center shrink-0">
          <a href="/en" class="flex items-center gap-2 group">
            <img 
              src="/assets/logo_header_dark.png" 
              alt="Jungle Nepal Adventure" 
              width="168" 
              height="48" 
              loading="eager" 
              decoding="sync" 
              class="h-11 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform duration-200" 
            />
          </a>
        </div>

        <nav class="hidden lg:flex items-center justify-center gap-5 xl:gap-7 text-[13px] xl:text-[14px] font-semibold text-slate-700">
          <a href="/en#prochains-departs" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">All 17 tours</a>

          <div class="relative group py-2">
            <a href="/en/destinations" class="hover:text-[#0e8354] transition-colors flex items-center gap-1 cursor-pointer whitespace-nowrap">
              <span>Destinations</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>

            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-3 shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-1 text-white">
                <a href="/en/destinations/bardia" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Bardia National Park</p>
                    <p class="text-[10px] text-slate-400">Bengal tigers & foot safaris</p>
                  </div>
                </a>
                <a href="/en/destinations/chitwan" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Chitwan National Park</p>
                    <p class="text-[10px] text-slate-400">Rhinos & Rapti river canoes</p>
                  </div>
                </a>
                <a href="/en/destinations/suklaphanta" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Suklaphanta National Park</p>
                    <p class="text-[10px] text-slate-400">Swamp deer & wild grasslands</p>
                  </div>
                </a>
                <a href="/en/destinations/annapurna" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Annapurna & Pokhara</p>
                    <p class="text-[10px] text-slate-400">High altitude treks & lake valley</p>
                  </div>
                </a>
                <a href="/en/destinations/katmandou" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Kathmandu & Valley</p>
                    <p class="text-[10px] text-slate-400">UNESCO heritage & temples</p>
                  </div>
                </a>
              </div>
            </div>
          </div>

          <a href="/en#concept" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Our guides</a>
          <a href="/en#galerie-faune" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Gallery</a>
          <a href="/en/about" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">About us</a>
          <a href="/en/blog" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Blog</a>
          <a href="/en/contact" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Contact</a>
        </nav>

        <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
          <!-- LANGUAGE SWITCHER (GLOBE DROPDOWN) -->
          <div class="relative group/lang py-1">
            <button onclick="toggleLangMenu(this)" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-slate-100 hover:bg-slate-200 border-slate-200 text-slate-700 border backdrop-blur-md flex items-center justify-center transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer" aria-label="Change language">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </button>
            <div class="lang-dropdown-box absolute right-0 top-full mt-1.5 w-32 opacity-0 translate-y-2 pointer-events-none group-hover/lang:opacity-100 group-hover/lang:translate-y-0 group-hover/lang:pointer-events-auto transition-all duration-200 z-50">
              <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-1.5 shadow-[0_20px_50px_rgba(0,0,0,0.8)] space-y-1 text-xs font-bold text-white">
                <a href={frTargetUrl} class="py-2 px-3 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer"><span>🇫🇷</span> <span>FR</span></a>
                <a href={enTargetUrl} class="py-2 px-3 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer"><span>🇬🇧</span> <span>EN</span></a>
              </div>
            </div>
          </div>

          <button onclick="openTourBookingModal()" class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-full bg-[#0e5c3e] hover:bg-[#09422b] text-white text-xs font-bold transition-all shadow-sm cursor-pointer whitespace-nowrap">
            <span>Book now (70€)</span>
          </button>

          <button onclick="toggleMobileMenu()" class="lg:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100 cursor-pointer" aria-label="Mobile menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- MOBILE NAVIGATION DRAWER -->
  <div id="mobile-menu" class="hidden lg:hidden fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-xl p-6 text-white overflow-y-auto">
    <div class="flex items-center justify-between pb-6 border-b border-white/10">
      <img src="/assets/logo_nav_white.webp" alt="Jungle Nepal Adventure" class="h-10 w-auto"/>
      <button onclick="toggleMobileMenu()" class="p-2 text-white/80 hover:text-white text-xl">✕</button>
    </div>
    <div class="py-6 space-y-4 text-base font-semibold">
      <a href="/en#prochains-departs" onclick="toggleMobileMenu()" class="block py-2 hover:text-[#0e8354]">All tours</a>
      <a href="/en/destinations/bardia" onclick="toggleMobileMenu()" class="block py-2 text-slate-300 hover:text-white">Bardia National Park</a>
      <a href="/en/destinations/chitwan" onclick="toggleMobileMenu()" class="block py-2 text-slate-300 hover:text-white">Chitwan National Park</a>
      <a href="/en/destinations/suklaphanta" onclick="toggleMobileMenu()" class="block py-2 text-slate-300 hover:text-white">Suklaphanta National Park</a>
      <a href="/en#concept" onclick="toggleMobileMenu()" class="block py-2 hover:text-[#0e8354]">Our guides</a>
      <a href="/en#galerie-faune" onclick="toggleMobileMenu()" class="block py-2 hover:text-[#0e8354]">Wildlife gallery</a>
      <a href="/en/about" onclick="toggleMobileMenu()" class="block py-2 hover:text-[#0e8354]">About us</a>
      <a href="/en/blog" onclick="toggleMobileMenu()" class="block py-2 hover:text-[#0e8354]">Blog</a>
      <a href="/en/contact" onclick="toggleMobileMenu()" class="block py-2 hover:text-[#0e8354]">Contact & quote</a>
    </div>
  </div>

  <!-- MAIN TOUR CONTENT -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 font-sans">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-semibold mb-3 overflow-x-auto whitespace-nowrap">
      <a href="/en" class="hover:text-slate-900 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span>Home</span>
      </a>
      <span>›</span>
      <a href="/en#prochains-departs" class="hover:text-slate-900">Our tours</a>
      <span>›</span>
      <span class="text-slate-900 font-bold truncate">Walking safari in Chitwan National Park</span>
    </nav>

    <!-- Header Title & Badges Row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6">
      <div>
        <h1 class="font-black text-2xl sm:text-4xl lg:text-5xl text-slate-950 tracking-tight leading-tight">
          Walking safari in Chitwan National Park
        </h1>
        <p class="text-base sm:text-xl font-bold text-[#0e8354] mt-1.5">
          Discover Chitwan differently: on foot
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-xs sm:text-sm">
          <span class="inline-flex items-center gap-1.5 font-bold text-slate-700 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">
            <svg class="w-4 h-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
            <span>1 full day (6:30 AM – 6:00 PM)</span>
          </span>
          <div class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-900 font-bold px-3 py-1 rounded-full border border-emerald-200">
            <svg class="w-4 h-4 text-amber-400 fill-amber-400 shrink-0" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <span>5.0 (21 verified reviews)</span>
          </div>
          <span class="text-xs font-bold bg-slate-900 text-amber-100 px-3 py-1 rounded-full border border-amber-300/30">
            1 jungle guide + 1 tracker
          </span>
          <span class="text-xs font-bold bg-emerald-950 text-emerald-300 px-3 py-1 rounded-full border border-emerald-700/40">
            Bush picnic lunch included
          </span>
        </div>
      </div>

      <!-- SHARE BUTTON -->
      <div class="relative shrink-0">
        <button id="share-btn" onclick="handleShareTour()" class="flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 bg-white text-xs font-extrabold text-slate-800 hover:text-[#0e8354] hover:border-[#0e8354] shadow-sm hover:shadow transition-all group cursor-pointer">
          <svg class="w-4 h-4 text-slate-500 group-hover:text-[#0e8354] transition-colors shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>
          <span>Share this tour</span>
        </button>

        <div id="share-menu" class="absolute right-0 top-full mt-2 w-64 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 z-50">
          <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-2 shadow-[0_20px_50px_rgba(0,0,0,0.8)] space-y-1 text-white">
            <button onclick="copyTourLink()" class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-bold text-white hover:bg-white/10 transition-colors text-left cursor-pointer group/item">
              <span class="w-7 h-7 rounded-lg bg-white/10 text-slate-200 flex items-center justify-center shrink-0">🔗</span>
              <span class="group-hover/item:text-amber-100 transition-colors">Copy direct link</span>
            </button>
            <a id="share-whatsapp" href="#" target="_blank" class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-bold text-white hover:bg-white/10 transition-colors text-left cursor-pointer group/item">
              <div class="w-7 h-7 rounded-lg bg-white/10 text-[#25D366] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <span class="group-hover/item:text-amber-100 transition-colors">Send via WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- PHOTO MOSAIC GALLERY (5 PHOTOS) -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-2.5 sm:gap-3 rounded-2xl sm:rounded-3xl overflow-hidden h-[280px] sm:h-[380px] md:h-[480px] mb-8 relative shadow-lg">
      <div class="md:col-span-2 h-full overflow-hidden">
        <img loading="eager" decoding="sync" src="/assets/tours_thumbs/safari_pied_chitwan_guide_sourire.webp" alt="Naturalist guide in Chitwan jungle" class="w-full h-full object-cover object-center transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(0)"/>
      </div>
      <div class="hidden md:block md:col-span-1 h-full overflow-hidden">
        <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_pied_chitwan_ours_lippu.webp" alt="Wild sloth bear encounter on the jungle path" class="w-full h-full object-cover transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(1)"/>
      </div>
      <div class="hidden md:flex flex-col gap-3 h-full">
        <div class="h-1/2 overflow-hidden rounded-tr-2xl">
          <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_pied_chitwan_rhino_hautes_herbes.webp" alt="Greater one-horned rhino in tall grass" class="w-full h-full object-cover transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(2)"/>
        </div>
        <div class="h-1/2 overflow-hidden rounded-br-2xl relative">
          <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_pied_chitwan_crocodile_marais_v2.webp" alt="Mugger crocodile emerging from calm river waters" class="w-full h-full object-cover transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(3)"/>
        </div>
      </div>

      <button onclick="openLightbox(0)" class="absolute bottom-4 right-4 bg-white/95 backdrop-blur-md hover:bg-white text-slate-900 font-bold text-xs sm:text-sm px-4 py-2 rounded-xl shadow-lg border border-slate-200 flex items-center gap-2 transition-all hover:scale-105 cursor-pointer">
        <svg class="w-4 h-4 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
        <span>View all 5 photos</span>
      </button>
    </div>

    <!-- STICKY SUB-NAV BAR -->
    <nav class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-md py-2.5 sm:py-3 transition-all -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 mb-8 sm:mb-10" aria-label="Tour navigation">
      <div class="flex items-center justify-between gap-4">
        <div class="hidden sm:flex items-center gap-2.5 shrink-0 min-w-0">
          <div class="min-w-0">
            <p class="font-extrabold text-xs text-slate-900 truncate max-w-[240px]">Walking safari — Chitwan</p>
            <p class="text-[11px] font-bold text-[#0e8354]">70€ <span class="text-slate-400 font-normal">/ pers.</span></p>
          </div>
        </div>

        <div class="flex items-center gap-4 sm:gap-6 lg:gap-8 overflow-x-auto no-scrollbar text-xs sm:text-sm font-bold text-slate-600 py-1">
          <a href="#apercu" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Overview</a>
          <a href="#apres-trek" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Ideal after a trek</a>
          <a href="#deroulement" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Itinerary</a>
          <a href="#inclusions" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Inclusions</a>
          <a href="#avis-voyageurs" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Reviews</a>
          <a href="#faq" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">FAQ</a>
        </div>

        <button onclick="openTourBookingModal()" class="hidden md:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs shadow transition-all cursor-pointer">
          <span>Book now (70€)</span>
          <span>→</span>
        </button>
      </div>
    </nav>

    <!-- 2-COLUMN MAIN CONTENT GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- LEFT COLUMN -->
      <div class="lg:col-span-8 space-y-12 lg:space-y-14">
        
        <!-- SECTION 1: OVERVIEW -->
        <section id="apercu" class="space-y-6">
          <div class="space-y-4">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
              Discover Chitwan differently: on foot
            </h2>
            <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
              Far from standard Jeep convoys, this full day allows you to <strong>explore Chitwan National Park completely on foot</strong>, guided by a certified naturalist guide and an experienced tracker.
            </p>
