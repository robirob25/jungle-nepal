  function closePdfModal() {
    const modal = document.getElementById('pdf-modal');
    if (modal) modal.classList.add('hidden');
  }
  async function handlePdfSubmit(e, tourSlug) {
    e.preventDefault();
    const btn = document.getElementById('pdf-submit-btn');
    const prenom = document.getElementById('lead_prenom')?.value || '';
    const email = document.getElementById('lead_email')?.value || '';

    if (btn) {
      btn.innerHTML = 'Sending... ⏳';
      btn.disabled = true;
    }

    try {
      await fetch('https://formsubmit.co/ajax/junglenepaladventure@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          _subject: '📥 New PDF Dossier Download: ' + tourSlug,
          _template: 'table',
          _captcha: 'false',
          prenom: prenom,
          email: email,
          circuit: tourSlug,
          page_url: window.location.href,
          date_demande: new Date().toLocaleString('fr-FR')
        })
      });
    } catch (err) {
      console.log('Lead submitted:', err);
    }

    alert('Thank you ' + prenom + '! Your detailed expedition dossier has been sent to ' + email + ' and our team has been notified.');
    if (btn) {
      btn.innerHTML = 'Download Expedition Dossier (PDF) →';
      btn.disabled = false;
    }
    closePdfModal();
  }
  </script>
