---
import { getLocalizedPath } from '../../../i18n/utils';
import Layout from '../../../layouts/Layout.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

  <!-- SCHEMA.ORG TOURIST TRIP JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TouristTrip",
    "name": "Cultural Immersion and Adventure in Nepal: Dashain Festival Special",
    "description": "An exclusive 15-day journey into Nepalese traditions and wild nature, hosted by visual creators Adrien & Samantha. Authentic Dashain festival immersion in a Tharu village in Bardia, Annapurna balcony views, and Royal Bengal tiger tracking.",
    "image": "https://junglenepal.com/assets/tours/dashain/dashain_trio_swing_sonu_adrien_samantha.webp",
    "touristType": ["Mindful Travelers", "Culture & Wildlife Enthusiasts", "Photographers"],
    "offers": {
      "@type": "Offer",
      "price": "2,490",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-08-01",
      "url": "https://junglenepal.com/en/tours/dashain-immersion-culturelle"
    },
    "provider": {
      "@type": "TravelAgency",
      "name": "Jungle Nepal Adventure",
      "url": "https://junglenepal.com"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": "18",
      "bestRating": "5"
    }
  }
  </script>

<Layout 
  title="Cultural Immersion & Adventure in Nepal: Dashain Festival Special (15d) | Jungle Nepal Adventure" 
  description="Exclusive 15-day journey in Nepal for Dashain Festival guided by Adrien & Samantha. Kathmandu, Annapurna balconies, Gurung heritage and Bardia tiger safaris."
  image="/assets/tours/dashain/dashain_trio_swing_sonu_adrien_samantha.webp"
  lang="en"
>

  <!-- TOP BAR PROMO -->
  <aside class="bg-[#05281a] text-white text-[11px] sm:text-xs py-1.5 px-4 relative z-50 text-center border-b border-emerald-800/20" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex-1 flex items-center justify-center gap-2 overflow-hidden whitespace-nowrap text-ellipsis">
        <span>🎉 <strong>Special Dashain 2027 Departure</strong>: September 30 – October 14, 2027 • <span class="text-amber-300 font-bold">Intimate group limited to 10 travelers</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/70 hover:text-white text-xs px-1 cursor-pointer" aria-label="Close announcement">✕</button>
    </div>
  </aside>

  <!-- HEADER STICKY -->
  <header class="relative z-40 bg-white border-b border-slate-200 py-2.5 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between gap-4 h-14 sm:h-16">
      
        <!-- LEFT: LOGO -->
        <div class="flex items-center shrink-0">
          <a href="/en/" class="flex items-center gap-2 group">
            <img 
              src="/assets/logo_nav_dark.webp" alt="Jungle Nepal Adventure" class="h-11 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform" 
            />
          </a>
        </div>

        <!-- CENTER: STREAMLINED NAVIGATION -->
        <nav class="hidden lg:flex items-center justify-center gap-5 xl:gap-7 text-[13px] xl:text-[14px] font-semibold text-slate-700">
          <a href="/en/#prochains-departs" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">All 15 Expeditions</a>

          <!-- Destinations Dropdown -->
          <div class="relative group py-2">
            <a href="/en/destinations" class="hover:text-[#0e8354] transition-colors flex items-center gap-1 cursor-pointer whitespace-nowrap">
              <span>Destinations</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>

            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-3 shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-1 text-white">
                <a href="/en/destinations/bardia" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Bardia National Park</p>
                    <p class="text-[10px] text-slate-400">Bengal Tigers & Walking Safaris</p>
                  </div>
                </a>
                <a href="/en/destinations/chitwan" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Chitwan National Park</p>
                    <p class="text-[10px] text-slate-400">One-Horned Rhinos & River Canoes</p>
                  </div>
                </a>
                <a href="/en/destinations/suklaphanta" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Suklaphanta National Park</p>
                    <p class="text-[10px] text-slate-400">Swamp Deer & Untamed Grasslands</p>
                  </div>
                </a>
                <a href="/en/destinations/annapurna" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Annapurna & Pokhara</p>
                    <p class="text-[10px] text-slate-400">Himalayan Peaks & Alpine Balconies</p>
                  </div>
                </a>
                <a href="/en/destinations/katmandou" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                  <div class="flex-1">
                    <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">Kathmandu Valley</p>
                    <p class="text-[10px] text-slate-400">Sacred Temples & World Heritage</p>
                  </div>
                </a>
                <div class="pt-2 border-t border-white/10 mt-1">
                  <a href="/en/destinations" class="block w-full text-center py-2 rounded-xl bg-[#0e8354] hover:bg-[#0c6d46] text-white font-black text-xs transition-colors shadow">
                    View all destinations →
                  </a>
                </div>
              </div>
            </div>
          </div>

          <a href="/en/#concept" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Our Guides</a>
          <a href="/en/#galerie-faune" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Gallery</a>
          <a href="/en/a-propos" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">About Us</a>
          <a href="/blog" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Blog</a>
          <a href="/en/contact" class="hover:text-[#0e8354] transition-colors whitespace-nowrap">Contact</a>
        </nav>

        <!-- RIGHT: ACTIONS -->
        <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
          <!-- LANGUAGE SWITCHER -->
          <div class="relative group/lang py-1">
            <button onclick="toggleLangMenu(this)" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-slate-100 hover:bg-slate-200 border-slate-200 text-slate-700 border backdrop-blur-md flex items-center justify-center transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer" aria-label="Change language">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </button>
            <div class="lang-dropdown-box absolute right-0 top-full mt-1.5 w-48 opacity-0 translate-y-2 pointer-events-none group-hover/lang:opacity-100 group-hover/lang:translate-y-0 group-hover/lang:pointer-events-auto transition-all duration-200 z-50">
              <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-1.5 shadow-[0_20px_50px_rgba(0,0,0,0.8)] space-y-0.5 text-xs font-bold text-white">
                <a href={frTargetUrl} class="py-2 px-3 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer"><span>🇫🇷</span> <span>FR</span></a>
                <a href={enTargetUrl} class="py-2 px-3 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer"><span>🇬🇧</span> <span>EN</span></a>
                <button onclick="changeLanguage('de')" data-lang-btn="de" class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-slate-300 hover:bg-white/10 hover:text-white transition-colors text-left cursor-pointer">
                  <span class="flex items-center gap-2"><span>🇩🇪</span><span>Deutsch</span></span>
                </button>
                <button onclick="changeLanguage('es')" data-lang-btn="es" class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-slate-300 hover:bg-white/10 hover:text-white transition-colors text-left cursor-pointer">
                  <span class="flex items-center gap-2"><span>🇪🇸</span><span>Español</span></span>
                </button>
              </div>
            </div>
          </div>

          <!-- Mobile Hamburger Button -->
          <button onclick="toggleMobileMenu()" class="lg:hidden w-9 h-9 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-900 border border-slate-300 backdrop-blur-md flex flex-col items-center justify-center gap-1 transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer shadow-sm p-1.5" aria-label="Menu">
            <span class="w-4 h-[2px] bg-slate-900 rounded-full block"></span>
            <span class="w-4 h-[2px] bg-slate-900 rounded-full block"></span>
            <span class="w-4 h-[2px] bg-slate-900 rounded-full block"></span>
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- MOBILE NAVIGATION DRAWER -->
  <div id="mobile-menu" style="background-color: #041d13 !important;" class="hidden lg:hidden fixed inset-x-3 top-20 z-50 max-h-[85vh] overflow-y-auto bg-[#041d13] border border-white/15 rounded-3xl p-5 text-white shadow-[0_25px_60px_rgba(0,0,0,0.95)] space-y-4 font-sans">
    <div class="flex items-center justify-between pb-3 border-b border-white/10">
      <span class="text-xs font-black uppercase tracking-widest text-slate-200">Navigation</span>
      <button onclick="toggleMobileMenu()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-sm font-bold transition-colors cursor-pointer" aria-label="Close menu">
        ✕
      </button>
    </div>

    <nav class="flex flex-col space-y-1.5 font-bold text-sm">
      <a href="/en/#prochains-departs" onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl bg-white/5 hover:bg-white/10 flex items-center justify-between text-white transition-colors">
        <span>All 15 Expeditions</span>
        <span class="bg-[#0e8354] text-white text-[11px] px-2.5 py-0.5 rounded-full font-black">15</span>
      </a>

      <div class="rounded-2xl bg-white/5 overflow-hidden">
        <button onclick="document.getElementById('mobile-dest-sub').classList.toggle('hidden'); document.getElementById('mobile-dest-arrow').classList.toggle('rotate-180');" class="w-full px-3.5 py-2.5 flex items-center justify-between text-white hover:bg-white/10 transition-colors text-left cursor-pointer">
          <span class="flex items-center gap-2.5">
            <span>🗺️</span>
            <span>Destinations</span>
          </span>
          <svg id="mobile-dest-arrow" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div id="mobile-dest-sub" class="hidden px-2 pb-2.5 space-y-1 border-t border-white/5 pt-2">
          <a href="/en/destinations/bardia" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Bardia National Park</p>
              <p class="text-[10px] text-slate-400">Bengal Tigers & Walking Safaris</p>
            </div>
          </a>
          <a href="/en/destinations/chitwan" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Chitwan National Park</p>
              <p class="text-[10px] text-slate-400">One-Horned Rhinos & River Canoes</p>
            </div>
          </a>
          <a href="/en/destinations/suklaphanta" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Suklaphanta National Park</p>
              <p class="text-[10px] text-slate-400">Swamp Deer & Untamed Grasslands</p>
            </div>
          </a>
          <a href="/en/destinations/annapurna" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Annapurna & Pokhara</p>
              <p class="text-[10px] text-slate-400">Himalayan Peaks & Alpine Balconies</p>
            </div>
          </a>
          <a href="/en/destinations/katmandou" onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
            <div>
              <p class="font-bold text-white">Kathmandu Valley</p>
              <p class="text-[10px] text-slate-400">Sacred Temples & World Heritage</p>
            </div>
          </a>
          <a href="/en/destinations" onclick="toggleMobileMenu()" class="block w-full text-center py-2 rounded-xl bg-[#0e8354] hover:bg-[#0c6d46] text-white font-black text-xs transition-colors shadow mt-1">
            View all destinations →
          </a>
        </div>
      </div>

      <a href="/en/#concept" class="hover:text-amber-100 transition-colors whitespace-nowrap">Our Guides</a>
      <a href="/en/#galerie-faune" onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 text-slate-200 hover:text-white transition-colors">
        <span>Gallery</span>
      </a>
      <a href="/en/a-propos" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 text-slate-200 hover:text-white transition-colors">
        <span>About Us</span>
      </a>
      <a href="/blog" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 text-slate-200 hover:text-white transition-colors">
        <span>Blog</span>
      </a>
      <a href="/en/contact" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center gap-2.5 text-slate-200 hover:text-white transition-colors">
        <span>Contact</span>
      </a>
    </nav>

    <div class="pt-3 border-t border-white/10 space-y-2">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Langue / Language</span>
      <div class="grid grid-cols-4 gap-1.5">
        <a href={frTargetUrl} class="py-2 px-3 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer"><span>🇫🇷</span> <span>FR</span></a>
        <a href={enTargetUrl} class="py-2 px-3 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer"><span>🇬🇧</span> <span>EN</span></a>
        <button onclick="changeLanguage('de')" data-lang-btn="de" class="py-2 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1 bg-white/10 text-white hover:bg-white/20 transition-all cursor-pointer">
          <span>🇩🇪</span> <span>DE</span>
        </button>
        <button onclick="changeLanguage('es')" data-lang-btn="es" class="py-2 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1 bg-white/10 text-white hover:bg-white/20 transition-all cursor-pointer">
          <span>🇪🇸</span> <span>ES</span>
        </button>
      </div>
    </div>

    <div class="pt-3 border-t border-white/10 flex flex-col gap-2">
      <a href="https://wa.me/33695413227" target="_blank" class="w-full flex items-center justify-center gap-2 py-3.5 px-4 rounded-2xl bg-white text-slate-950 font-black text-xs shadow hover:bg-slate-100 transition-all">
        <svg class="w-4 h-4 text-[#0e8354]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span>WhatsApp (+33 6 95 41 32 27)</span>
      </a>
      <a href="/en/#prochains-departs" onclick="toggleMobileMenu()" class="w-full text-center py-3.5 px-4 rounded-2xl bg-[#0e5c3e] hover:bg-[#0c6d46] text-white font-black text-xs shadow transition-all">
        Explore all 15 journeys →
      </a>
    </div>
  </div>

  <!-- MAIN TOUR CONTENT -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 font-sans">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-semibold mb-3 overflow-x-auto whitespace-nowrap">
      <a href="/en/" class="hover:text-slate-900 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span>Home</span>
      </a>
      <span>›</span>
      <a href="/en/#prochains-departs" class="hover:text-slate-900">Our 15 Expeditions</a>
      <span>›</span>
      <span class="text-slate-900 font-bold truncate">Cultural Immersion & Adventure: Dashain Festival Special</span>
    </nav>

    <!-- Header Title & Badges Row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6">
      <div>
        <h1 class="font-black text-2xl sm:text-4xl lg:text-5xl text-slate-950 tracking-tight leading-tight">
          Cultural Immersion & Adventure in Nepal: Dashain Festival Special
        </h1>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-xs sm:text-sm">
          <span class="inline-flex items-center gap-1.5 font-bold text-slate-700 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">
            <svg class="w-4 h-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
            <span>15 days</span>
          </span>
          <span class="inline-flex items-center gap-1.5 font-bold text-slate-700 bg-slate-100 border border-slate-200 px-3 py-1 rounded-full">
            <svg class="w-4 h-4 text-slate-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
            <span>Sep 30 – Oct 14, 2027</span>
          </span>
          <div class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-900 font-bold px-3 py-1 rounded-full border border-emerald-200">
            <svg class="w-4 h-4 text-amber-400 fill-amber-400 shrink-0" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <span>5.0 (18 verified reviews)</span>
          </div>
          <span class="text-xs font-bold bg-slate-900 text-amber-100 px-3 py-1 rounded-full border border-amber-300/30">
            Intimate group: max 10 travelers
          </span>
        </div>
      </div>

      <!-- SHARE BUTTON -->
      <div class="relative shrink-0">
        <button id="share-btn" onclick="handleShareTour()" class="flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 bg-white text-xs font-extrabold text-slate-800 hover:text-[#0e8354] hover:border-[#0e8354] shadow-sm hover:shadow transition-all group cursor-pointer">
          <svg class="w-4 h-4 text-slate-500 group-hover:text-[#0e8354] transition-colors shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>
          <span>Share this journey</span>
        </button>

        <div id="share-menu" class="absolute right-0 top-full mt-2 w-64 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 z-50">
          <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-2 shadow-[0_20px_50px_rgba(0,0,0,0.8)] space-y-1 text-white">
            <button onclick="copyTourLink()" class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-bold text-white hover:bg-white/10 transition-colors text-left cursor-pointer group/item">
