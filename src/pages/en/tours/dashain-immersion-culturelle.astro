  <script is:inline>
    var baseTourPrice = 2490;
    var isComfortSelected = false;

    window.toggleComfortOption = function toggleComfortOption(extraCost) {
      extraCost = extraCost || 390;
      isComfortSelected = !isComfortSelected;
      window.isComfortSelected = isComfortSelected;
      var total = isComfortSelected ? (baseTourPrice + extraCost) : baseTourPrice;
      var totalFormatted = total.toLocaleString('en-US') + '€';

      // 1. Update Main Sidebar Price Display
      var priceEl = document.getElementById('tour-price-display');
      if (priceEl) {
        priceEl.textContent = totalFormatted;
      }

      // 2. Update Mobile Bottom Price
      var mobilePriceEl = document.getElementById('mobile-bottom-price');
      if (mobilePriceEl) {
        mobilePriceEl.textContent = totalFormatted;
      }

      // 3. Update Sticky Bar Price Display if present
      var stickyEl = document.getElementById('sticky-price-display');
      if (stickyEl) {
        stickyEl.innerHTML = totalFormatted + ' <span class="text-slate-400 font-normal">/ pers.</span>';
      }

      // 4. Toggle Notification Badge under the Price
      var badgeEl = document.getElementById('comfort-included-badge');
      if (badgeEl) {
        if (isComfortSelected) {
          badgeEl.classList.remove('hidden');
        } else {
          badgeEl.classList.add('hidden');
        }
      }

      // 5. Update Sidebar Checkbox
      var sidebarCheckbox = document.getElementById('sidebar-comfort-checkbox');
      if (sidebarCheckbox) {
        sidebarCheckbox.checked = isComfortSelected;
      }

      // 6. Update Button State and Card Styling
      var btn = document.getElementById('toggle-comfort-btn');
      var btnText = document.getElementById('comfort-btn-text');
      var btnIcon = document.getElementById('comfort-btn-icon');
      var card = document.getElementById('comfort-option-card');
      var badgeTag = document.getElementById('comfort-badge-tag');

      if (btn && btnText && btnIcon) {
        if (isComfortSelected) {
          btn.classList.remove('bg-amber-500', 'hover:bg-amber-400', 'text-slate-950');
          btn.classList.add('bg-emerald-600', 'hover:bg-emerald-500', 'text-white', 'shadow-emerald-500/30');
          btnIcon.textContent = '✓';
          btnText.textContent = "Comfort Option Included (Remove)";
          if (card) card.classList.add('ring-2', 'ring-amber-400/80', 'border-amber-400/50');
          if (badgeTag) {
            badgeTag.classList.remove('bg-amber-500/20', 'text-amber-200', 'border-amber-500/30');
            badgeTag.classList.add('bg-emerald-500/20', 'text-emerald-200', 'border-emerald-500/40');
            badgeTag.textContent = '✓ Option Selected (+390€)';
          }
        } else {
          btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-500', 'text-white', 'shadow-emerald-500/30');
          btn.classList.add('bg-amber-500', 'hover:bg-amber-400', 'text-slate-950');
          btnIcon.textContent = '⊕';
          btnText.textContent = "Add Add-on (+390 €)";
          if (card) card.classList.remove('ring-2', 'ring-amber-400/80', 'border-amber-400/50');
          if (badgeTag) {
            badgeTag.classList.remove('bg-emerald-500/20', 'text-emerald-200', 'border-emerald-500/40');
            badgeTag.classList.add('bg-amber-500/20', 'text-amber-200', 'border-amber-500/30');
            badgeTag.textContent = "Comfort Option";
          }
        }
      }
    };
  </script>

