---
import { getLocalizedPath } from '../../../i18n/utils';
import Footer from '../../../components/Footer.astro';
import Layout from '../../../layouts/Layout.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

  <!-- SCHEMA.ORG TOURIST TRIP & FAQ JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Bardia: Walking Safari in Bardia – Full Day in Nepal's Jungle",
  "description": "A full day deep into the heart of Bardia National Park on foot. Track Bengal tigers, one-horned rhinos, and wild Asian elephants with our senior jungle guides and trackers.",
  "image": "https://junglenepal.com/assets/tours_thumbs/safari_pied_guide_jungle_bardia.webp",
  "touristType": [
    "Nature Lovers",
    "Wildlife Photographers",
    "Adventurers",
    "Hikers"
  ],
  "offers": {
    "@type": "Offer",
    "price": "50",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-08-01",
    "url": "https://junglenepal.com/en/tours/bardia-walking-safari"
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Jungle Nepal Adventure",
    "url": "https://junglenepal.com",
    "logo": "https://junglenepal.com/assets/logo_nav_white.png",
    "email": "contact@junglenepal.com",
    "telephone": "+33695413227",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bardia & Katmandou",
      "addressCountry": "NP"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "24",
    "bestRating": "5"
  },
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": 1,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "TouristAttraction",
          "name": "Day 1 – Full Day Walking Safari in Bardia",
          "description": "Departure at 6:30 AM for a full day of foot tracking and wildlife observation in Bardia jungle. Bush lunch included. Return around 6:00 PM."
        }
      }
    ]
  }
}
  </script>


<Layout title="Bardia Walking Safari (50€): Guided Jungle Tracking Tour" lang="en">

