---
import { getLocalizedPath } from '../../../i18n/utils';

import Footer from '../../../components/Footer.astro';
import Layout from '../../../layouts/Layout.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

  <!-- SCHEMA.ORG TOURIST TRIP & FAQ JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": [
    "TouristTrip",
    "Product"
  ],
  "name": "From Pokhara to Chitwan Safari with Kathmandu Drop-off – 3 Days",
  "description": "The hassle-free post-trek connection package: pick-up at your Pokhara hotel, scenic transfer to Chitwan National Park, 3 days of ethical wildlife safaris (canoeing, 4x4 open jeep rhino tracking, and Tharu culture in a riverside eco-lodge), and drop-off directly at your hotel or the international airport in Kathmandu. 100% stress-free travel logistics.",
  "image": "https://junglenepal.com/assets/snow-leopard/pokhara_lake.webp",
  "touristType": [
    "Nature Lovers",
    "Wildlife Photographers",
    "Adventurers"
  ],
  "offers": {
    "@type": "Offer",
    "price": "590",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-08-01",
    "url": "https://junglenepal.com/en/tours/pokhara-to-chitwan-safari-transfer-kathmandu",
    "priceValidUntil": "2027-12-31",
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0",
        "currency": "EUR"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "NP"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 0,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 0,
          "unitCode": "DAY"
        }
      }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "NP",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnFees": "https://schema.org/FreeReturn",
      "merchantReturnLink": "https://junglenepal.com/conditions-generales"
    }
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Jungle Nepal Adventure",
    "url": "https://junglenepal.com",
    "logo": "https://junglenepal.com/assets/logo_nav_white.png",
    "email": "contact@junglenepal.com",
    "telephone": "+33695413227",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bardia & Katmandou",
      "addressCountry": "NP"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "28",
    "bestRating": "5"
  },
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": 3,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "TouristAttraction",
          "name": "Day 1 – Hotel Pick-Up in Pokhara, Transfer to Chitwan & Rapti Sunset Walk",
          "description": "Morning pick-up at your Pokhara hotel and scenic transfer down to Chitwan National Park. Check into your riverside eco-lodge. In the afternoon, explore a traditional Tharu village on foot followed by a sunset drink on the banks of the Rapti River as rhinos emerge to bathe. Traditional dinner and cultural stick dance performance."
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "TouristAttraction",
          "name": "Day 2 – Sunrise Canoe Float & Deep Jungle 4x4 Jeep Safari",
          "description": "Morning traditional wooden canoe drift down the misty Rapti River observing gharials, mugger crocodiles, and kingfishers. Followed by a short guided jungle walk into the buffer zone. In the afternoon, embark on an exhilarating 4-hour open 4x4 jeep safari deep into the core sector of Chitwan National Park tracking Greater One-Horned Rhinos, sloth bears, and wild boars."
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "TouristAttraction",
          "name": "Day 3 – Dawn Birdwatching & Direct Transfer to Kathmandu (Drop-Off Hotel / Airport)",
          "description": "Early morning birdwatching in the riverine forest. Hearty breakfast at the lodge, followed by direct comfortable transfer to Kathmandu with drop-off at your Thamel hotel or Tribhuvan International Airport."
        }
      }
    ]
  },
  "brand": {
    "@type": "Brand",
    "name": "Jungle Nepal Adventure"
  }
}
  </script>

  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I book an expedition?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Once you select your expedition, our team will send your booking confirmation by email. To confirm your reservation, a 30% deposit is required upon registration. The remaining balance is payable upon arrival in Kathmandu."
      }
    },
    {
      "@type": "Question",
      "name": "Can I customize my trip?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely! Our local team crafts bespoke private itineraries tailored to your dates, preferences, and pace. Simply let us know what you envision."
      }
    },
    {
      "@type": "Question",
      "name": "Are there group discounts available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we offer special rates for small private groups and families. Contact us for custom pricing."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need travel insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you must hold personal travel insurance covering safari activities, remote wilderness, and medical evacuation."
      }
    },
    {
      "@type": "Question",
      "name": "What is included in the expedition price?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our expeditions include boutique eco-lodge accommodations, all meals in the field, private transport, certified master trackers, and all official national park permits."
      }
    }
  ]
}
  </script>

