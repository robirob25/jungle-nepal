---
import { getLocalizedPath } from '../../../i18n/utils';
import Footer from '../../../components/Footer.astro';
import Layout from '../../../layouts/Layout.astro';
import DayTourBookingWidget from '../../../components/DayTourBookingWidget.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
import Header from '../../../components/Header.astro';
---

  <!-- SCHEMA.ORG TOURIST TRIP & FAQ JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": [
    "TouristTrip",
    "Product"
  ],
  "name": "Bardia: River Karnali Rafting Safari – Full Day Wilderness Float in Bardia National Park",
  "description": "Full-day peaceful river rafting safari down the Karnali and Geruwa rivers in Bardia. Observe Gangetic river dolphins, gharial crocodiles, swimming wild elephants and tigers with expert skipper, senior naturalist guide and elite tracker.",
  "image": "https://junglenepal.com/assets/tours_thumbs/rafting_karnali_descente_guide_voyageur.webp",
  "touristType": [
    "Nature Lovers",
    "Wildlife Photographers",
    "Adventurers",
    "Families"
  ],
  "offers": {
    "@type": "Offer",
    "price": "190",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-08-01",
    "url": "https://junglenepal.com/en/tours/bardia-rafting-safari",
    "priceValidUntil": "2027-12-31",
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "FR",
      "returnPolicyCountry": "FR",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnFees": "https://schema.org/FreeReturn",
      "merchantReturnLink": "https://junglenepal.com/en/legal-mentions/"
    }
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Jungle Nepal Adventure",
    "url": "https://junglenepal.com",
    "logo": "https://junglenepal.com/assets/logo_nav_white.png",
    "email": "contact@junglenepal.com",
    "telephone": "+33695413227",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bardia & Katmandou",
      "addressCountry": "NP"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "22",
    "bestRating": "5"
  },
  "brand": {
    "@type": "Brand",
    "name": "Jungle Nepal Adventure"
  }
}
  </script>

  <!-- SCHEMA.ORG FAQPAGE (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is the river raft 100% private?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, both the river raft and the 4x4 transfer vehicle are 100% private for your party (whether you are traveling solo, as a couple, or in a small group). You are never mixed with other unknown travelers."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a Rafting Safari, a Jeep Safari, and a Walking Safari?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The river rafting safari lets you drift silently along the Karnali and Geruwa river corridors—the prime habitat of Gangetic river dolphins, gharials, and animals coming to drink along the banks—with short tracking walks on river islands. Combining a rafting day with a walking or jeep safari is ideal if you stay several days."
      }
    },
    {
      "@type": "Question",
      "name": "How does the overnight homestay option at Pawan's (+12 €) work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The option includes one night in a private air-conditioned room with en-suite bathroom and hot shower at Pawan's home in Thakurdwara, a traditional homemade dinner in the evening, and a hearty breakfast the next morning."
      }
    },
    {
      "@type": "Question",
      "name": "Are all national park permits and river fees included?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Unlike many standard operators, our €190 all-inclusive rate covers all official government taxes and permits: your personal Bardia National Park entry permit, the special Karnali river rafting permit, and 4x4 transfer fees."
      }
    }
  ]
}
  </script>

  <!-- SCHEMA.ORG FAQPAGE (RICH SNIPPETS GOOGLE) -->

<Layout 
  title="Bardia Rafting Safari (190€) : Karnali River Wildlife Float"
  description="Full-day silent river rafting & wildlife safari on the Karnali in Bardia (190€). Spot Gangetic dolphins, gharials, elephants, and tigers."
  lang="en"
>

  <!-- TOP BAR PROMO -->
  <aside class="bg-[#05281a] text-white text-[11px] sm:text-xs py-1.5 px-4 relative z-50 text-center border-b border-emerald-800/20" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex-1 flex items-center justify-center gap-2 overflow-hidden whitespace-nowrap text-ellipsis">
        <span><strong class="text-amber-300">Private Rafting Safari</strong> in Bardia • Karnali River Float & Wildlife by the Water</span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/70 hover:text-white text-xs px-1 cursor-pointer">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <Header lang="en" isTransparent={false} currentPath={Astro.url.pathname} />

  <!-- MAIN TOUR CONTENT -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 font-sans">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-semibold mb-3 overflow-x-auto whitespace-nowrap">
      <a href="/en/" class="hover:text-slate-900 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span>Home</span>
      </a>
      <span>›</span>
      <a href="/en/#prochains-departs" class="hover:text-slate-900">Our Expeditions</a>
      <span>›</span>
      <span class="text-slate-900 font-bold truncate">Bardia National Park Rafting Safari</span>
    </nav>

    <!-- Header Title & Badges Row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6">
      <div>
        <h1 class="font-black text-2xl sm:text-4xl lg:text-5xl text-slate-950 tracking-tight leading-tight">
          Bardia National Park Rafting Safari
        </h1>
        <p class="text-base sm:text-xl font-bold text-[#0e8354] mt-1.5">
          Float Down the Karnali River on a Private Rafting Safari in Bardia
        </p>
        <div class="mt-2.5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-slate-600 font-medium">
          <span class="inline-flex items-center gap-1 font-semibold text-slate-900">
            <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>15 days</span>
          </span>
          <span class="text-slate-300">•</span>
          <span class="inline-flex items-center gap-1 text-slate-700">
            <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500 shrink-0" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <span class="font-bold text-slate-900">5.0</span>
            <span class="text-slate-500">(22 verified reviews)</span>
          </span>
          <span class="text-slate-300">•</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 font-semibold text-[11px] border border-slate-200/60">Private Raft + Pro River Skipper</span>
          <span class="text-slate-300">•</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 font-semibold text-[11px] border border-slate-200/60">1 Senior Naturalist + 1 Elite Tracker</span>
        </div>
      </div>

      <!-- BOUTON PARTAGER UNIQUEMENT (SANS FAVORIS) -->
      <div class="relative shrink-0 self-start sm:self-auto">
        <button id="share-btn" onclick="handleShareTour()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-xs font-semibold text-slate-700 shadow-xs transition-all cursor-pointer">
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition-colors shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>
          <span>Share</span>
        </button>

        <div id="share-menu" class="absolute right-0 top-full mt-2 w-64 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 z-50">
          <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-2 shadow-[0_20px_50px_rgba(0,0,0,0.8)] space-y-1 text-white">
            <button onclick="copyTourLink()" class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-bold text-white hover:bg-white/10 transition-colors text-left cursor-pointer group/item">
              <span class="w-7 h-7 rounded-lg bg-white/10 text-slate-200 flex items-center justify-center shrink-0">🔗</span>
              <span class="group-hover/item:text-amber-100 transition-colors">Copier le lien direct</span>
            </button>
            <a id="share-whatsapp" href="#" target="_blank" class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-bold text-white hover:bg-white/10 transition-colors text-left cursor-pointer group/item">
              <div class="w-7 h-7 rounded-lg bg-white/10 text-[#25D366] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <span class="group-hover/item:text-amber-100 transition-colors">Envoyer sur WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- PHOTO MOSAIC GALLERY (5 PHOTOS) -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-2.5 sm:gap-3 rounded-2xl sm:rounded-3xl overflow-hidden h-[280px] sm:h-[380px] md:h-[480px] mb-8 relative shadow-lg">
      <div class="md:col-span-2 h-full overflow-hidden bg-slate-100">
        <img loading="eager" decoding="sync" src="/assets/tours_thumbs/tigre_bengale_berge_riviere_karnali_bardia.webp" alt="Wild Bengal tiger sighted along the riverbanks during Bardia rafting safari" class="w-full h-full object-cover object-center transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(0)"/>
      </div>
      <div class="hidden md:block md:col-span-1 h-full overflow-hidden bg-slate-100">
        <img loading="lazy" decoding="async" src="/assets/tours_thumbs/rafting_karnali_descente_guide_voyageur.webp" alt="Travelers and naturalist guide floating peacefully down Karnali River" class="w-full h-full object-cover object-bottom transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(1)"/>
      </div>
      <div class="hidden md:flex flex-col gap-3 h-full">
        <div class="h-1/2 overflow-hidden rounded-tr-2xl bg-slate-100">
          <img loading="lazy" decoding="async" src="/assets/tours_thumbs/photographe_animalier_teleobjectif_rafting_bardia.webp" alt="Wildlife photographer with telephoto lens aboard the private river raft" class="w-full h-full object-cover object-center transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(2)"/>
        </div>
        <div class="h-1/2 overflow-hidden rounded-br-2xl relative bg-slate-100">
          <img loading="lazy" decoding="async" src="/assets/tours_thumbs/crocodile_gavial_gange_riviere_karnali_bardia.webp" alt="Gharial crocodile sunning on pristine sandy gravel banks" class="w-full h-full object-cover object-center transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(3)"/>
        </div>
      </div>

      <button onclick="openLightbox(0)" class="absolute bottom-4 right-4 bg-white/95 backdrop-blur-md hover:bg-white text-slate-900 font-bold text-xs sm:text-sm px-4 py-2 rounded-xl shadow-lg border border-slate-200 flex items-center gap-2 transition-all hover:scale-105 cursor-pointer">
        <svg class="w-4 h-4 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
        <span>View all 7 photos</span>
      </button>
    </div>

    <!-- STICKY SUB-NAV BAR -->
    <nav class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-md py-2.5 sm:py-3 transition-all -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 mb-8 sm:mb-10" aria-label="Navigation du séjour">
      <div class="flex items-center justify-between gap-4">
        <div class="hidden sm:flex items-center gap-2.5 shrink-0 min-w-0">
          <div class="min-w-0">
            <p class="font-extrabold text-xs text-slate-900 truncate max-w-[240px]">Rafting Safari — Bardia</p>
            <p class="text-[11px] font-bold text-[#0e8354]"><span id="subnav-price-display">190€</span> <span class="text-slate-400 font-normal">/ pers.</span></p>
          </div>
        </div>

        <div class="flex items-center gap-4 sm:gap-6 lg:gap-8 overflow-x-auto no-scrollbar text-xs sm:text-sm font-bold text-slate-600 py-1">
          <a href="#apercu" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Overview</a>
          <a href="#option-nuit" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Night at Pawan's (+12€)</a>
          <a href="#deroulement" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Itinerary</a>
          <a href="#inclusions" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Inclusions</a>
          <a href="#avis-voyageurs" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Reviews</a>
          <a href="#faq" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">FAQ</a>
        </div>

        <button onclick="openTourBookingModal()" class="hidden md:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs shadow transition-all cursor-pointer">
          <span>Book (190€)</span>
          <span>→</span>
        </button>
      </div>
    </nav>

    <!-- 2-COLUMN MAIN CONTENT GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- LEFT COLUMN -->
      <div class="lg:col-span-8 space-y-12 lg:space-y-14">
        
        <!-- SECTION 1: APERÇU -->
        <section id="apercu" class="space-y-6">
          <div class="space-y-4">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
              Float Down the Karnali River on a Private Rafting Safari in Bardia
            </h2>
            <p class="text-base sm:text-lg text-slate-800 leading-relaxed font-normal">
              Available at <strong>€190 per person for a full day</strong>, this <strong>Karnali River rafting safari</strong> (a 35 km silent drift along Bardia National Park) is the quietest and most stealthy way to observe wild Asian wildlife. Guided by a certified whitewater captain, senior naturalist, and elite tracker, the tour includes complete safety equipment, 4x4 transfers, national park permits, and a freshly prepared picnic lunch on an isolated river island.
            </p>
            <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
              Carried by gentle, crystal-clear currents through the Karnali and Geruwa channels, your raft drifts silently alongside forested bluffs and gravel banks. This unique water-level vantage point offers rare views into the habitat of the endangered <strong>Gangetic river dolphin</strong>, as well as two prehistoric crocodilian species: the slender-snouted <strong>gharial</strong> and the marsh mugger.
            </p>
            <p class="text-base text-slate-700 leading-relaxed font-normal">
              Along the shoreline, silent drifting often yields spectacular sightings of wild elephants bathing, greater one-horned rhinos grazing, deer herds, and occasionally a <strong>Bengal tiger</strong> crossing gravel bars in broad daylight. Includes bush stopovers for short tracking walks and an isolated beach lunch.
            </p>
          </div>

          <!-- AVERTISSEMENT ETHIQUE & NATURE SAUVAGE -->
          <div class="p-5 sm:p-6 rounded-2xl bg-amber-50/80 border border-amber-200/90 text-amber-950 text-xs sm:text-sm space-y-2">
            <div class="flex items-center gap-2 font-black text-amber-900 uppercase tracking-wider text-xs">
              <span>⚠️</span>
              <span>100% Wild Nature & Ethical Wildlife Commitment</span>
            </div>
            <p class="leading-relaxed">
              Wildlife moves freely in a fully preserved river ecosystem. River dolphin sightings and big mammal appearances remain unpredictable. Rafting in Bardia is not an extreme white-water sport, but a scenic, gentle wildlife observation drift (Class I-II calm water). Top priority is always given to quiet approach, respectful wildlife distances, and passenger safety.
            </p>
          </div>

          <!-- CARTE D'INFOS CLÉS -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs">
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
              <span class="text-slate-400 font-bold block uppercase text-[10px]">Duration</span>
              <span class="font-black text-slate-900 text-sm mt-0.5 block">Full Day</span>
              <span class="text-slate-500 text-[11px]">07h00 – 17h30</span>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
              <span class="text-slate-400 font-bold block uppercase text-[10px]">Vessel</span>
              <span class="font-black text-slate-900 text-sm mt-0.5 block">Private River Raft</span>
              <span class="text-slate-500 text-[11px]">Karnali & Geruwa Rivers</span>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
              <span class="text-slate-400 font-bold block uppercase text-[10px]">Crew</span>
              <span class="font-black text-slate-900 text-sm mt-0.5 block">Expert Trio</span>
              <span class="text-slate-500 text-[11px]">Skipper + 2 Guides</span>
            </div>
            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80">
              <span class="text-[#0e8354] font-bold block uppercase text-[10px]">Meals & Permits</span>
              <span class="font-black text-[#0e8354] text-sm mt-0.5 block">100% Included</span>
              <span class="text-slate-600 text-[11px]">Riverside lunch + all fees</span>
            </div>
          </div>
        </section>

        <!-- SECTION 2: OPTION NUIT CHEZ PAWAN (+12 €) -->
        <section id="option-nuit" class="scroll-mt-28 pt-8 border-t border-slate-200 space-y-6">
          <div>
            <span class="text-xs font-black uppercase tracking-widest text-[#0e8354]">Local Immersion & Comfort</span>
            <h2 class="font-black text-2xl sm:text-3xl text-slate-950 tracking-tight mt-1">
              Optional Night at Senior Guide Pawan's Homestay (+12 €)
            </h2>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed">
              To extend your experience in a warm and authentic setting, you have the option to stay at the family home of Pawan, senior guide and elite wildlife tracker in Bardia for over 20 years. Pawan regularly guides and supports international film crews, including wildlife documentaries for the <strong>BBC</strong>.
            </p>
          </div>

          <!-- ENCART OPTION AVEC PHOTOS & CARACTÉRISTIQUES -->
          <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-emerald-950 via-[#0a3d28] to-[#041d13] text-white shadow-xl border border-emerald-700/50 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/10">
              <div>
                <span class="text-xs font-bold text-amber-300 uppercase tracking-widest">At Pawan's Home (BBC Documentary Guide • 20 Years Experience)</span>
                <h3 class="text-xl sm:text-2xl font-black mt-1">Private AC Room + Homemade Dinner + Breakfast</h3>
              </div>
              <div class="text-right shrink-0">
                <span class="text-2xl sm:text-3xl font-black text-amber-300 font-mono">+12 €</span>
                <span class="text-xs text-slate-300 block">/ person</span>
              </div>
            </div>

            <!-- Photos Chambre Pawan -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="rounded-2xl overflow-hidden border border-white/15 h-52 relative group">
                <img loading="lazy" decoding="async" src="/assets/tours_thumbs/chambre_pawan_bardia.webp" alt="Chambre privée climatisée chez Pawan à Bardia" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 cursor-pointer" onclick="openRoomLightbox(0)"/>
                <div class="absolute bottom-2 left-2 bg-slate-950/80 px-2.5 py-1 rounded-lg text-[11px] font-bold text-white">Private room with double bed & AC</div>
              </div>
              <div class="rounded-2xl overflow-hidden border border-white/15 h-52 relative group">
                <img loading="lazy" decoding="async" src="/assets/tours_thumbs/salle_de_bain_pawan_bardia.webp" alt="Private en-suite bathroom with hot shower chez Pawan" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 cursor-pointer" onclick="openRoomLightbox(1)"/>
                <div class="absolute bottom-2 left-2 bg-slate-950/80 px-2.5 py-1 rounded-lg text-[11px] font-bold text-white">Private en-suite bathroom with hot shower</div>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
              Stay in a spacious private room equipped with a comfortable double bed, air conditioning, a sofa, and an attached private bathroom with hot shower. In the evening, share a traditional homemade Nepali dinner (Dal Bhat) cooked with the family, and enjoy a hearty breakfast the next morning.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-200 pt-2">
              <div class="flex items-center gap-2">
                <span class="text-amber-400 font-bold">✓</span>
                <span>Private air-conditioned (AC) room with attached en-suite bathroom & shower</span>
              </div>
