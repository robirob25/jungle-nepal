  <script is:inline>
    // Gallery & Lightbox (7 Photos)
    window.mainGalleryImages = [
      "/assets/tours_thumbs/tigre_bengale_berge_riviere_karnali_bardia.webp",
      "/assets/tours_thumbs/rafting_karnali_descente_guide_voyageur.webp",
      "/assets/tours_thumbs/photographe_animalier_teleobjectif_rafting_bardia.webp",
      "/assets/tours_thumbs/crocodile_gavial_gange_riviere_karnali_bardia.webp",
      "/assets/tours_thumbs/tigre_bengale_baignade_riviere_bardia.webp",
      "/assets/tours_thumbs/rafting_bardia_affut_berges_riviere.webp",
      "/assets/tours_thumbs/adrien_bardia_river.webp"
    ];
    window.roomImages = [
      "/assets/tours_thumbs/chambre_pawan_bardia.webp",
      "/assets/tours_thumbs/salle_de_bain_pawan_bardia.webp"
    ];
    window.galleryImages = window.mainGalleryImages;
    window.currentImageIndex = 0;

    window.openLightbox = function(index) {
      window.galleryImages = window.mainGalleryImages;
      window.currentImageIndex = typeof index === 'number' ? index : 0;
      window.updateLightboxContent();
      var modal = document.getElementById('lightbox-modal');
      if (modal) {
        modal.classList.remove('hidden');
        setTimeout(function() {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
        }, 10);
      }
      document.body.style.overflow = 'hidden';
    };

    window.openRoomLightbox = function(index) {
      window.galleryImages = window.roomImages;
      window.currentImageIndex = typeof index === 'number' ? index : 0;
      window.updateLightboxContent();
      var modal = document.getElementById('lightbox-modal');
      if (modal) {
        modal.classList.remove('hidden');
        setTimeout(function() {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
        }, 10);
      }
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function() {
      var modal = document.getElementById('lightbox-modal');
      if (modal) {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        setTimeout(function() {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }
    };

    window.updateLightboxContent = function() {
      var img = document.getElementById('lightbox-image');
      var counter = document.getElementById('lightbox-counter');
      if (img && window.galleryImages && window.galleryImages[window.currentImageIndex]) {
        img.src = window.galleryImages[window.currentImageIndex];
      }
      if (counter && window.galleryImages) {
        counter.textContent = (window.currentImageIndex + 1) + ' / ' + window.galleryImages.length;
      }
    };

    window.prevLightboxImage = function(e) {
      if (e && e.stopPropagation) e.stopPropagation();
      if (!window.galleryImages || !window.galleryImages.length) return;
      window.currentImageIndex = (window.currentImageIndex - 1 + window.galleryImages.length) % window.galleryImages.length;
      window.updateLightboxContent();
    };

    window.nextLightboxImage = function(e) {
      if (e && e.stopPropagation) e.stopPropagation();
      if (!window.galleryImages || !window.galleryImages.length) return;
      window.currentImageIndex = (window.currentImageIndex + 1) % window.galleryImages.length;
      window.updateLightboxContent();
    };

    document.addEventListener('keydown', function(e) {
      var modal = document.getElementById('lightbox-modal');
      if (modal && !modal.classList.contains('hidden')) {
        if (e.key === 'Escape') window.closeLightbox();
        if (e.key === 'ArrowLeft') window.prevLightboxImage();
        if (e.key === 'ArrowRight') window.nextLightboxImage();
      }
    });

    // Mobile Menu
    function toggleMobileMenu() {
      var menu = document.getElementById("mobile-menu");
      if (menu) menu.classList.toggle("hidden");
    }

    window.handleShareTour = function() {
      var shareMenu = document.getElementById('share-menu');
      if (shareMenu) {
        var isHidden = shareMenu.classList.contains('opacity-0');
        if (isHidden) {
          shareMenu.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
          shareMenu.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        } else {
          shareMenu.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
          shareMenu.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        }
      }
    };

    window.copyTourLink = function() {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(window.location.href).then(function() {
          alert('Lien copié dans le presse-papier !');
        });
      }
    };

    // Toggle option nuit chez Pawan (+12€)
    window.hasGuideRoomOption = false;

    window.toggleGuideOption = function(isChecked) {
      window.hasGuideRoomOption = isChecked;
      
      var cb1 = document.getElementById('guide-room-checkbox');
      var cb2 = document.getElementById('sidebar-guide-room-checkbox');
      if (cb1) cb1.checked = isChecked;
      if (cb2) cb2.checked = isChecked;

      var basePrice = 190;
      var optionPrice = 12;
      var finalPrice = isChecked ? (basePrice + optionPrice) : basePrice;

      var priceDisplay = document.getElementById('tour-price-display');
      if (priceDisplay) {
        priceDisplay.textContent = finalPrice + '€';
      }

      var subnavPriceDisplay = document.getElementById('subnav-price-display');
      if (subnavPriceDisplay) {
        subnavPriceDisplay.textContent = finalPrice + '€';
      }

      var mobileBottomPrice = document.getElementById('mobile-bottom-price');
      if (mobileBottomPrice) {
        mobileBottomPrice.textContent = finalPrice + '€';
      }

      var ctaBtn = document.getElementById('cta-button-text');
      if (ctaBtn) {
        ctaBtn.textContent = 'Réserver ce safari (' + finalPrice + ' €) →';
      }

      var waText = isChecked 
        ? "Bonjour Robin, je souhaite réserver le rafting safari à Bardia avec l'option nuit chez Pawan (" + finalPrice + "€)" 
        : "Bonjour Robin, je souhaite réserver le rafting safari à Bardia (" + finalPrice + "€)";

      var sidebarWaBtn = document.getElementById('sidebar-whatsapp-btn');
      if (sidebarWaBtn) {
        sidebarWaBtn.href = "https://wa.me/33695413227?text=" + encodeURIComponent(waText);
      }

      var mobileWaBtn = document.getElementById('mobile-bottom-whatsapp');
      if (mobileWaBtn) {
        mobileWaBtn.href = "https://wa.me/33695413227?text=" + encodeURIComponent(waText);
      }
    };

    window.openTourBookingModal = function() {
      var card = document.getElementById('booking-card-container');
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        var dateInput = card.querySelector('.widget-date-input');
        if (dateInput) dateInput.focus();
        return;
      }
      var finalPrice = window.hasGuideRoomOption ? 202 : 190;
      var tourTitle = "Bardia National Park Rafting Safari" + (window.hasGuideRoomOption ? " + Nuit chez Pawan" : "");
      
      if (typeof window.openBookingModal === 'function') {
        window.openBookingModal(tourTitle, finalPrice + '€');
      } else {
        var msg = "Bonjour Robin, je souhaite réserver : " + tourTitle + " (" + finalPrice + "€/pers).";
        window.open("https://wa.me/33695413227?text=" + encodeURIComponent(msg), '_blank');
      }
    };
  </script>

</Layout>
