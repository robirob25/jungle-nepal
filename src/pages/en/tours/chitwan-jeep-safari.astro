---
import { getLocalizedPath } from '../../../i18n/utils';
import Footer from '../../../components/Footer.astro';
import Layout from '../../../layouts/Layout.astro';
import DayTourBookingWidget from '../../../components/DayTourBookingWidget.astro';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
import Header from '../../../components/Header.astro';
---

<Layout 
  title="Private Chitwan Jeep Safari (190€) : Rhino Tracking 4x4 Tour"
  description="Private full-day 4x4 Jeep safari in Chitwan National Park (190€ for 1 to 6 guests). Observe one-horned rhinos, sloth bears, and tigers."
  lang="en"
>
  <Fragment slot="head">
  <!-- SCHEMA.ORG TOURIST TRIP & FAQ JSON-LD (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": [
    "TouristTrip",
    "Product"
  ],
  "name": "Chitwan: Private Jeep Safari in Chitwan National Park – Full Day 4x4 Exploration",
  "description": "Full-day private 4x4 safari expedition in Chitwan National Park. Track one-horned rhinos, Bengal tigers, wild elephants, and sloth bears with a professional driver, senior naturalist guide, and elite tracker.",
  "image": "https://junglenepal.com/assets/tours_thumbs/safari_jeep_chauffeur_chitwan.webp",
  "touristType": [
    "Nature Lovers",
    "Wildlife Photographers",
    "Adventurers",
    "Families"
  ],
  "offers": {
    "@type": "Offer",
    "price": "190",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-08-01",
    "url": "https://junglenepal.com/en/tours/chitwan-jeep-safari",
    "priceValidUntil": "2027-12-31",
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "FR",
      "returnPolicyCountry": "FR",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnFees": "https://schema.org/FreeReturn",
      "merchantReturnLink": "https://junglenepal.com/en/legal-mentions/"
    }
  },
  "provider": {
    "@type": "TravelAgency",
    "name": "Jungle Nepal Adventure",
    "url": "https://junglenepal.com",
    "logo": "https://junglenepal.com/assets/logo_nav_white.png",
    "email": "contact@junglenepal.com",
    "telephone": "+33695413227",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bardia & Katmandou",
      "addressCountry": "NP"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "25",
    "bestRating": "5"
  },
  "itinerary": {
    "@type": "ItemList",
    "numberOfItems": 1,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "TouristAttraction",
          "name": "Day 1 – Full-Day 4x4 Exploration of Chitwan Grasslands & Sal Forests",
          "description": "Departure at 06:00 AM by private jeep from Sauraha. Rapti river crossing, tracking sandy trails through Sal forest, rhino wetlands, watchtower picnic lunch, and riverside hides. Return around 06:00 PM."
        }
      }
    ]
  },
  "brand": {
    "@type": "Brand",
    "name": "Jungle Nepal Adventure"
  }
}
  </script>

  <!-- SCHEMA.ORG FAQPAGE (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is the vehicle completely private?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, the 4x4 vehicle is entirely private for your party. You never share the vehicle with unknown travelers, giving you complete freedom to pause for animal sightings as long as you wish."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a Jeep safari and a walking safari in Chitwan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The jeep allows you to cover vast distances (60 to 80 km over the day), access remote sectors, and cross rivers without physical strain. Walking safaris offer quiet foot-level immersion. Many travelers combine one day by jeep and one day on foot for a 360° experience."
      }
    },
    {
      "@type": "Question",
      "name": "Are entry permits and park fees included?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! The 190 € rate includes all government fees: your personal official Chitwan National Park entry permit as well as the vehicle's government road tax and entry license."
      }
    },
    {
      "@type": "Question",
      "name": "How to reach Sauraha / Chitwan from Kathmandu or Pokhara?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sauraha is accessible daily via comfortable tourist buses (approx. 5–6 hours from Kathmandu or Pokhara), private car transfers, or a quick 20-minute domestic flight to Bharatpur Airport followed by a 30-minute taxi ride. We can organize all transfers upon request."
      }
    }
  ]
}
  </script>

  <!-- SCHEMA.ORG FAQPAGE (RICH SNIPPETS GOOGLE) -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://junglenepal.com/en/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Nepal Safari",
      "item": "https://junglenepal.com/en/safari-nepal/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Private Jeep Safari in Chitwan National Park",
      "item": "https://junglenepal.com/en/tours/chitwan-jeep-safari/"
    }
  ]
}
  </script>
  </Fragment>


  <!-- TOP BAR PROMO -->
  <aside class="bg-[#05281a] text-white text-[11px] sm:text-xs py-1.5 px-4 relative z-50 text-center border-b border-emerald-800/20" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex-1 flex items-center justify-center gap-2 overflow-hidden whitespace-nowrap text-ellipsis">
        <span><strong class="text-amber-300">Private 4x4 Safari</strong> in Chitwan • Deep sectors access & rhino tracking</span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/70 hover:text-white text-xs px-1 cursor-pointer">✕</button>
    </div>
  </aside>

  <!-- HEADER -->
  <Header lang="en" isTransparent={false} currentPath={Astro.url.pathname} />

  <!-- MAIN TOUR CONTENT -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 font-sans">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-semibold mb-3 overflow-x-auto whitespace-nowrap">
      <a href="/en/" class="hover:text-slate-900 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span>Home</span>
      </a>
      <span>›</span>
      <a href="/en/safari-nepal/" class="hover:text-slate-900">Nepal Safari</a>
      <span>›</span>
      <span class="text-slate-900 font-bold truncate">Private Jeep Safari in Chitwan National Park</span>
    </nav>

    <!-- Header Title & Badges Row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6">
      <div>
        <h1 class="font-black text-2xl sm:text-4xl lg:text-5xl text-slate-950 tracking-tight leading-tight">
          Private Jeep Safari in Chitwan National Park
        </h1>
        <p class="text-base sm:text-xl font-bold text-[#0e8354] mt-1.5">
          Explore the floodplains and wild jungles of Chitwan by private safari 4x4
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-xs sm:text-sm">
          <span class="inline-flex items-center gap-1.5 font-bold text-slate-700 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">
            <svg class="w-4 h-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
            <span>Full Day (06:00 AM – 06:00 PM)</span>
          </span>
          <div class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-900 font-bold px-3 py-1 rounded-full border border-emerald-200">
            <svg class="w-4 h-4 text-amber-400 fill-amber-400 shrink-0" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <span>5.0 (25 verified reviews)</span>
          </div>
          <span class="text-xs font-bold bg-slate-900 text-amber-100 px-3 py-1 rounded-full border border-amber-300/30">
            Private 4x4 Jeep + Driver
          </span>
          <span class="text-xs font-bold bg-emerald-950 text-emerald-300 px-3 py-1 rounded-full border border-emerald-700/40">
            1 Senior Guide + 1 Lead Tracker
          </span>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex items-center gap-2 shrink-0">
        <div class="relative">
          <button 
            type="button" 
            onclick="handleShareTour()" 
            class="flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200/80 transition-all cursor-pointer select-none active:scale-95"
            aria-label="Share this tour"
          >
            <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
            <span>Share this activity</span>
          </button>
          <div id="share-menu" class="absolute right-0 top-full mt-2 w-48 bg-white border border-slate-200 rounded-2xl p-2 shadow-xl space-y-1 text-xs font-semibold text-slate-700 opacity-0 translate-y-2 pointer-events-none transition-all duration-200 z-50">
            <button onclick="copyTourLink()" class="w-full text-left px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors flex items-center gap-2">
              <span>📋</span> <span>Copy link</span>
            </button>
            <a href="https://wa.me/?text=Check%20out%20the%20Private%20Jeep%20Safari%20in%20Chitwan%20on%20Jungle%20Nepal%20Adventure:%20https://junglenepal.com/en/tours/chitwan-jeep-safari" target="_blank" rel="nofollow noopener noreferrer" class="w-full text-left px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors flex items-center gap-2 block">
               <span>Share on WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- PHOTO MOSAIC GALLERY (5 PHOTOS) -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-2.5 sm:gap-3 rounded-2xl sm:rounded-3xl overflow-hidden h-[280px] sm:h-[380px] md:h-[480px] mb-8 relative shadow-lg">
      <div class="md:col-span-2 h-full overflow-hidden">
        <img loading="eager" decoding="sync" src="/assets/tours_thumbs/safari_jeep_chauffeur_chitwan.webp" alt="Driver in open 4x4 safari Jeep in Chitwan National Park" class="w-full h-full object-cover object-center transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(0)"/>
      </div>
      <div class="hidden md:block md:col-span-1 h-full overflow-hidden">
        <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_jeep_rhino_eau_chitwan.webp" alt="One-horned rhino bathing in Chitwan wetland" class="w-full h-full object-cover transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(1)"/>
      </div>
      <div class="hidden md:flex flex-col gap-3 h-full">
        <div class="h-1/2 overflow-hidden rounded-tr-2xl">
          <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_jeep_elephant_foret_chitwan.webp" alt="Asian wild elephant in lush jungle forest" class="w-full h-full object-cover transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(2)"/>
        </div>
        <div class="h-1/2 overflow-hidden rounded-br-2xl relative">
          <img loading="lazy" decoding="async" src="/assets/tours_thumbs/safari_jeep_gavial_riviere_chitwan.webp" alt="Fish-eating Gharial crocodile on the riverbank" class="w-full h-full object-cover object-center transition-opacity duration-300 cursor-pointer hover:scale-105 transition-transform duration-500" onclick="openLightbox(3)"/>
        </div>
      </div>

      <button onclick="openLightbox(0)" class="absolute bottom-4 right-4 bg-white/95 backdrop-blur-md hover:bg-white text-slate-900 font-bold text-xs sm:text-sm px-4 py-2 rounded-xl shadow-lg border border-slate-200 flex items-center gap-2 transition-all hover:scale-105 cursor-pointer">
        <svg class="w-4 h-4 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
        <span>View all 5 photos</span>
      </button>
    </div>

    <!-- STICKY SUB-NAV BAR -->
    <nav class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-md py-2.5 sm:py-3 transition-all -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 mb-8 sm:mb-10" aria-label="Tour navigation">
      <div class="flex items-center justify-between gap-4">
        <div class="hidden sm:flex items-center gap-2.5 shrink-0 min-w-0">
          <div class="min-w-0">
            <p class="font-extrabold text-xs text-slate-900 truncate max-w-[240px]">Jeep Safari — Chitwan</p>
            <p class="text-[11px] font-bold text-[#0e8354]"><span id="subnav-price-display">190€</span> <span class="text-slate-400 font-normal">/ person</span></p>
          </div>
        </div>

        <div class="flex items-center gap-4 sm:gap-6 lg:gap-8 overflow-x-auto no-scrollbar text-xs sm:text-sm font-bold text-slate-600 py-1">
          <a href="#apercu" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Overview</a>
          <a href="#deroulement" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Itinerary</a>
          <a href="#inclusions" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Inclusions</a>
          <a href="#avis-voyageurs" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">Reviews (22)</a>
          <a href="#faq" class="hover:text-[#0e8354] transition-colors pb-1 border-b-2 border-transparent hover:border-[#0e8354] whitespace-nowrap">FAQ</a>
        </div>

        <button 
          onclick="openTourBookingModal()" 
          class="shrink-0 px-4 sm:px-5 py-2 rounded-full bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs shadow-md transition-all cursor-pointer whitespace-nowrap"
        >
          <span>Book Now (190€)</span>
        </button>
      </div>
    </nav>

    <!-- 2-COLUMNS GRID LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- LEFT COLUMN: TOUR DETAILS -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- SECTION 1: OVERVIEW -->
        <section id="apercu" class="scroll-mt-28 space-y-6">
          <div class="prose prose-slate max-w-none text-sm sm:text-base leading-relaxed text-slate-700">
            <h2 class="font-black text-2xl sm:text-3xl text-slate-950 tracking-tight not-prose mb-4">
              Explore the floodplains and wild jungles of Chitwan by private safari 4x4
            </h2>
            <p class="text-base sm:text-lg text-slate-800 leading-relaxed font-normal not-prose">
              Privatized exclusively for your group (up to 6 passengers) at <strong>€190 for a full day</strong>, this open 4x4 expedition penetrates deep into the UNESCO World Heritage core sectors of <strong>Chitwan National Park</strong> (including Kasara and Sukhibhar). Guided by an expert driver and a certified senior naturalist, this all-inclusive tour covers national park permits and a bush lunch to maximize encounters with greater one-horned rhinos, sloth bears, gharials, and Bengal tigers.
            </p>
            <p>
              Immerse yourself into Nepal's oldest and most renowned national park for a full day of motorized exploration in total wilderness. A UNESCO World Heritage site, Chitwan National Park boasts an extraordinary mosaic of habitats: vast Sal tree forests, gigantic elephant-grass floodplains, and meandering river bends fostering remarkable wildlife density.
            </p>
            <p>
              Aboard a private, open-sided 4x4 safari vehicle, you are accompanied by a veteran driver, a senior naturalist guide specialized in the Terai biome, and an elite native tracker. Traveling by jeep allows you to escape standard tourist circuits, venture into the quietest sectors of the park, cross waterways, and watch for predator passages along primary forest corridors.
            </p>
            <p>
              Bush lunch is enjoyed deep in the jungle inside a secured observation watchtower overlooking a river curve or waterhole. Fully turn-key: all park permits, vehicle fees, and guide licenses are completely included.
            </p>
          </div>

          <!-- Ethical & Wild Nature Commitment -->
          <div class="p-5 sm:p-6 rounded-3xl bg-amber-500/10 border border-amber-500/30 text-amber-950 space-y-2">
            <div class="flex items-center gap-2 font-black text-sm text-amber-900 uppercase tracking-wider">
              <span>⚠️</span>
              <span>100% Wild & Ethical Nature Commitment</span>
            </div>
            <p class="text-xs sm:text-sm text-amber-900/90 leading-relaxed">
              Animals roam completely free across an untouched protected sanctuary spanning over 930 km². Their movements are completely wild and unpredictable; sightings can never be staged or guaranteed. The jeep travels at a respectful, gentle pace, with engines turned off near sightings to protect animal welfare and ensure an authentic experience.
            </p>
          </div>

          <!-- Highlights Bento Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200">
                🚙
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm">Exclusively Private 4x4 Jeep</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Open-sided 4x4 vehicle reserved exclusively for your party. Professional driver, fuel, and park permits fully covered.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200">
                🦏
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm">Kingdom of Rhinos & Tigers</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Nepal's densest sanctuary for Asian one-horned rhinos, alongside sloth bears, gharials, and Sal forest apex predators.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200">
                👥
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm">Elite Field Trio</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                1 experienced driver + 1 senior naturalist guide native to Chitwan + 1 elite tracker for maximum observation odds.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0e8354] flex items-center justify-center font-black text-lg border border-emerald-200">
                🥪
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm">Jungle Watchtower Picnic</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Packed lunch shared atop a wild observation tower (Machan) overlooking lakes and floodplain wildlife corridors.
              </p>
            </div>
          </div>
        </section>

        <!-- SECTION 2: ITINERARY -->
        <section id="deroulement" class="scroll-mt-28 pt-8 border-t border-slate-200 space-y-6">
          <div>
            <span class="text-xs font-black uppercase tracking-widest text-[#0e8354]">Schedule & Organisation</span>
            <h2 class="font-black text-2xl sm:text-3xl text-slate-950 tracking-tight mt-1">
              Your Typical Chitwan Jeep Safari Day
            </h2>
          </div>

          <div class="space-y-4">
            <!-- Step 1 -->
            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0e8354] font-black text-sm flex items-center justify-center shrink-0 border border-emerald-200">
                06:00
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-base">Early Morning Departure & 4x4 Boarding</h3>
                <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
                  Direct pickup from your accommodation in Sauraha. Board your private 4x4 vehicle, checkpoint registration (permits pre-arranged), and safety orientation by your guides.
                </p>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0e8354] font-black text-sm flex items-center justify-center shrink-0 border border-emerald-200">
                06:45
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-base">Crossing Rapti River & Entering the Sal Forest</h3>
                <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
                  Enter the heart of the national park at dawn. Gentle progression across cathedral Sal forests, inspecting sand tracks for fresh predator pugmarks, and listening to deer and langur alarm calls.
                </p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0e8354] font-black text-sm flex items-center justify-center shrink-0 border border-emerald-200">
                10:30
              </div>
              <div>
