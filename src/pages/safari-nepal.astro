---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import toursData from '../data/tours.json';

// Core safari tours with verified image fallbacks
const safariTourSlugs = [
  "bardia-explorateur",
  "chitwan-bardia-complete",
  "jungle-extreme",
  "babai-special",
  "bardia-babai-camping",
  "safari-chitwan-3-jours",
  "nepal-sauvage",
  "panthere-des-neiges",
  "rara-lake-bardia"
];

const safariTours = safariTourSlugs
  .map(slug => toursData.find(t => t.slug === slug))
  .filter((t): t is typeof toursData[0] => Boolean(t));

// 1-Day Safari Activities (Excursions courtes à la journée)
const dayActivities = [
  {
    title: "Safari à pied au parc national de Bardia",
    slug: "safari-pied-bardia",
    url: "/tours/safari-pied-bardia/",
    image: "/assets/tours_thumbs/safari_pied_guide_jungle_bardia.webp",
    alt: "Safari à pied dans la jungle du parc national de Bardia",
    tag: "Bardia Sauvage • Pistage à pied",
    badge: "Dès 1 pers.",
    duration: "1 jour",
    price: "50€",
    priceLabel: "Tarif par personne",
    extra: "Option Nuit +12€",
    rating: "5.0 (24)",
    description: "Une journée entière d'immersion au cœur de la jungle de Bardia. Partez à pied avec un guide naturaliste expérimenté et un assistant pisteur natif à la recherche du tigre du Bengale, des rhinocéros et des éléphants sauvages."
  },
  {
    title: "Safari en Jeep au parc national de Bardia",
    slug: "safari-jeep-bardia",
    url: "/tours/safari-jeep-bardia/",
    image: "/assets/tours_thumbs/safari_jeep_groupe_bardia.webp",
    alt: "Safari en Jeep 4x4 privatisé au parc national de Bardia",
    tag: "Bardia Sauvage • 4x4 Privatisé",
    badge: "Jeep privatisée",
    duration: "1 jour",
    price: "190€",
    priceLabel: "Tarif par personne",
    extra: "Option Nuit +12€",
    rating: "5.0 (19)",
    description: "Explorez les secteurs les plus reculés de Bardia en 4x4 privatisé avec chauffeur, guide senior et pisteur d’élite. Franchissez les gués pour maximiser l'observation des tigres du Bengale."
  },
  {
    title: "Safari à pied au parc national de Chitwan",
    slug: "safari-pied-chitwan",
    url: "/tours/safari-pied-chitwan/",
    image: "/assets/tours_thumbs/safari_pied_chitwan_guide_sourire.webp",
    alt: "Safari à pied au parc national de Chitwan",
    tag: "Chitwan Sauvage • Pistage à pied",
    badge: "Dès 1 pers.",
    duration: "1 jour",
    price: "70€",
    priceLabel: "Tarif par personne",
    extra: "Déjeuner inclus",
    rating: "5.0 (21)",
    description: "Découvrez Chitwan autrement : à pied, loin de la foule. Une journée complète d'immersion avec 1 guide jungle et 1 pisteur d'expérience à la recherche des rhinocéros unicornes, tigres et ours lippus."
  },
  {
    title: "Safari en Jeep au parc national de Chitwan",
    slug: "safari-jeep-chitwan",
    url: "/tours/safari-jeep-chitwan/",
    image: "/assets/tours_thumbs/safari_jeep_chauffeur_chitwan.webp",
    alt: "Safari en Jeep privatisée au parc national de Chitwan",
    tag: "Chitwan Sauvage • 4x4 Privatisé",
    badge: "Jeep privatisée",
    duration: "1 jour",
    price: "190€",
    priceLabel: "Tarif par personne",
    extra: "Déjeuner inclus",
    rating: "5.0 (22)",
    description: "Parcourez les plaines alluviales et les forêts de sals de Chitwan en 4x4 privatisé avec chauffeur, guide naturaliste senior et pisteur pour approcher les rhinocéros unicornes et les hardes d'herbivores."
  },
  {
    title: "Rafting safari au parc national de Bardia",
    slug: "rafting-safari-bardia",
    url: "/tours/rafting-safari-bardia/",
    image: "/assets/tours_thumbs/rafting_karnali_descente_guide_voyageur.webp",
    alt: "Rafting safari au fil de l'eau sur la rivière Karnali à Bardia",
    tag: "Bardia Sauvage • Au fil de l'eau",
    badge: "Rafting privatisé",
    duration: "1 jour",
    price: "190€",
    priceLabel: "Tarif par personne",
    extra: "Pique-nique inclus",
    rating: "5.0 (18)",
    description: "Descendez les eaux calmes de la rivière Karnali en raft privatisé avec barreur professionnel, guide naturaliste et pisteur pour observer dauphins du Gange, gavials et prédateurs aux berges."
  }
];

// FAQ Data for Schema.org & visible Accordion
const faqs = [
  {
    question: "Combien coûte un safari au Népal ?",
    answer: "Le tarif d'un safari au Népal varie selon la durée et le niveau de confort. Une journée complète de safari à pied à Bardia avec deux pisteurs natifs coûte environ 50 € par personne (hors permis de parc à 2 000 NPR, env. 14 €). Pour un circuit tout compris de 5 jours en lodge avec transferts, repas, permis et safaris quotidiens (Bardia Explorateur), comptez environ 490 € par personne. Une grande expédition combinant Chitwan et Bardia sur 11 à 12 jours s'élève à 1 990 € par personne en formule tout inclus."
  },
  {
    question: "Le safari à pied est-il dangereux face aux tigres et aux rhinocéros ?",
    answer: "Le Népal est le seul pays d'Asie à autoriser le pistage à pied des grands prédateurs dans ses parcs nationaux. Encadré par nos deux guides naturalistes Tharu nés sur place et armés de lathis (bâtons traditionnels de bambou), le risque est rigoureusement maîtrisé. Les règles d'or sont strictes : marcher en file indienne silencieuse, respecter le sens du vent, ne jamais courir en cas de rencontre fortuite, et suivre instantanément les consignes des pisteurs. Les animaux sauvages évitent l'homme dès lors qu'ils ne sont pas surpris ou acculés."
  },
  {
    question: "Quel parc choisir pour un safari entre Bardia et Chitwan ?",
    answer: "Le choix dépend de vos priorités faune et de votre sensibilité au tourisme. Chitwan est situé à 5 h de route de Katmandou et garantit à 98 % l'observation des rhinocéros unicornes, mais les pistes y sont plus fréquentées par les jeeps. Bardia, situé dans l'extrême ouest sauvage (vol intérieur pour Nepalgunj puis 2 h de route), abrite 125 tigres du Bengale sur 968 km² préservés. C'est le paradis absolu du pistage du tigre à pied et du voyageur en quête de silence et d'authenticité."
  },
  {
    question: "Quelle est la meilleure saison pour voir le tigre du Bengale au Népal ?",
    answer: "La période reine pour maximiser les observations de tigres s'étend de mars à mai (printemps népalais). Avec des températures de 32 à 38 °C, la végétation dense d'herbes à éléphants a été brûlée ou coupée, les rivières baissent et les prédateurs sont contraints de venir s'abreuver quotidiennement aux rares points d'eau permanents. Le taux d'observation y atteint 75 à 85 % sur un séjour de 4 à 5 jours d'affût."
  },
  {
    question: "Faut-il suivre un traitement contre le paludisme pour un safari au Népal ?",
    answer: "Dans le Teraï népalais (plaines de Bardia et Chitwan), le risque de paludisme est considéré comme très faible par l'OMS durant la saison sèche (octobre à mai). La plupart des voyageurs n'utilisent pas de traitement lourd type Malarone, mais privilégient une excellente protection anti-moustiques locale (vêtements longs et répulsif spécial zones tropicales). Consultez votre médecin traitant avant le départ pour un avis médical personnalisé."
  },
  {
    question: "Proposez-vous des safaris à dos d'éléphant ?",
    answer: "Non, Jungle Nepal Adventure refuse formellement toute activité à dos d'éléphant. Le dressage des éléphants de monte (khatti) et le port de nacelles métalliques rigides sont contraires à notre charte d'écotourisme éthique. Nous privilégions le safari à pied, le safari en jeep 4x4 électrique ou thermique légère, et la descente silencieuse des rivières en raft ou pirogue traditionnelle."
  }
];
---

<Layout 
  title="Safari au Népal : Circuits, Parcs (Bardia, Chitwan) & Tigre"
  description="Organisez votre safari au Népal avec notre agence locale : pistage du tigre du Bengale à pied à Bardia, rhinocéros à Chitwan et circuits en micro-groupe."
  image="/assets/drive_wildlife/hero_safari_nepal.webp"
  lang="fr"
  isDarkHeader={true}
>
  <SchemaOrg
    slot="head"
    type="TouristDestination"
    name="Safari au Népal : circuits, parcs nationaux et observation du tigre du Bengale"
    headline="Safari au Népal : circuits, parcs nationaux et observation du tigre du Bengale"
    description="Guide complet et expéditions de safari au Népal avec Jungle Nepal Adventure. Walking safari à pied à Bardia, rhinocéros à Chitwan et observation de la faune en petit groupe."
    image="/assets/drive_wildlife/hero_safari_nepal.webp"
    url="https://junglenepal.com/safari-nepal/"
    lang="fr"
    ratingValue="5.0"
    reviewCount="25"
    about={["Safari au Népal", "Tigre du Bengale", "Parc national de Bardia", "Parc national de Chitwan", "Parc national de Suklaphanta", "Agence locale Népal"]}
    faqs={faqs}
    breadcrumbs={[
      { name: "Accueil", url: "/" },
      { name: "Safari au Népal", url: "/safari-nepal/" }
    ]}
  />

  <!-- TOP PROMO BAR -->
  <aside aria-label="Bannière d'information" class="bg-gradient-to-r from-[#073021] via-[#0e5c3e] to-[#073021] text-white text-xs sm:text-[13px] py-2 px-3 sm:px-4 font-bold relative z-50 text-center border-b border-emerald-800/20 shadow-sm" id="top-bar">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex-1 flex items-center justify-center gap-1.5 text-center text-[11px] sm:text-xs">
        <span><strong class="text-amber-300">-100€</strong> sur votre séjour nov. 2027 avec le code <span class="bg-white/15 px-1.5 py-0.5 rounded text-amber-100 font-extrabold border border-amber-300/30 font-mono tracking-wider ml-1">JUNGLE100</span></span>
      </div>
      <button onclick="document.getElementById('top-bar').style.display='none'" class="text-white/80 hover:text-white text-sm leading-none px-1 cursor-pointer shrink-0" aria-label="Fermer">✕</button>
    </div>
  </aside>

  <!-- HEADER NAVIGATION -->
  <Header lang="fr" currentPath="/safari-nepal/" />

  <!-- 1. HERO SECTION AVEC LA VRAIE PHOTO DRIVE FOURNIE -->
  <section class="relative min-h-[68vh] lg:min-h-[74vh] flex items-center justify-center pt-32 pb-20 px-4 bg-slate-950 text-white overflow-hidden">
    <!-- Hero Background Image (Photo Drive fournie) -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/drive_wildlife/hero_safari_nepal.webp" 
        alt="Safari au Népal dans la jungle sauvage de Bardia avec Jungle Nepal Adventure" 
        class="w-full h-full object-cover opacity-75 scale-105 filter brightness-95 contrast-105"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-black/25"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto text-center space-y-5">
      
      <!-- Breadcrumb navigation -->
      <nav aria-label="Fil d'Ariane" class="flex items-center justify-center gap-2 text-xs text-slate-300 font-medium">
        <a href="/" class="hover:text-white transition-colors">Accueil</a>
        <span>›</span>
        <span class="text-amber-300 font-semibold">Safari au Népal</span>
      </nav>

      <!-- H1 optimisé requêtes exactes (Sentence case) -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.15] max-w-3xl mx-auto drop-shadow-lg">
        Safari au Népal : observer le tigre du Bengale avec notre agence locale
      </h1>

      <!-- Intro Subtitle optimisé SEO & longue traîne client -->
      <p class="text-base sm:text-lg text-slate-200 max-w-3xl mx-auto font-normal leading-relaxed drop-shadow">
        Walking safari dans le parc national de Bardia pour observer le tigre du Bengale, safari jeep et pirogue à Chitwan pour approcher le rhinocéros unicorne, savanes de Suklaphanta et circuits faune sauvage en petit groupe encadrés par nos guides naturalistes locaux Tharu.
      </p>

      <!-- Bouton d'action rapide -->
      <div class="pt-3 flex items-center justify-center">
        <a href="#circuits-safari" class="px-8 py-3.5 rounded-full bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-xs sm:text-sm shadow-lg shadow-emerald-950/40 hover:scale-105 active:scale-95 transition-all duration-300 flex items-center gap-2">
          <span>Découvrir nos séjours safari</span>
          <span>↓</span>
        </a>
      </div>

    </div>
  </section>

  <!-- 2. POURQUOI LE SAFARI AU NÉPAL N'A AUCUN ÉQUIVALENT AU MONDE (FOND BLANC, 3 BLOCS AVEC PHOTOS D'ANIMAUX) -->
  <section class="py-16 sm:py-24 bg-white text-slate-900 border-b border-slate-200 relative overflow-hidden">
    <!-- Subtle Sketch Pattern Background Overlay -->
    <div class="absolute inset-0 bg-[url('/assets/patterns/nepal_sketch_pattern.webp')] bg-repeat bg-[length:420px_auto] opacity-[0.045] pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 relative z-10">
      
      <div class="max-w-3xl">
        <h2 class="text-2xl sm:text-4xl font-black text-slate-950 tracking-tight leading-tight">
          Pourquoi le safari au Népal n'a aucun équivalent au monde
        </h2>
        <p class="mt-3 text-slate-600 text-base sm:text-lg leading-relaxed">
          Loin des jeeps bruyantes et des pistes balisées d'Afrique ou d'Inde, le sud du Népal propose une approche unique de la vie sauvage : ici, la jungle s'explore à pied dans un silence absolu, au rythme de la nature et des populations autochtones.
        </p>
      </div>

      <!-- 3 Blocs avec vraies photos d'animaux au sommet -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Bloc 1: Tigre à pied -->
        <div class="bg-white border border-slate-200/90 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="h-60 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/drive_wildlife/tigre1.webp" 
                alt="Tigre du Bengale dans la végétation de Bardia au Népal" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-lg font-bold text-slate-950 leading-snug">
                Le seul pays au monde où l'on piste le tigre à pied
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Le Népal est le seul territoire de la planète où vous pouvez légalement traquer le tigre du Bengale à pied au cœur d'une réserve nationale. Encadré par deux pisteurs natifs Tharu armés de bâtons de bambou, vous avancez en silence en lisant les empreintes fraîches et en décodant les cris d'alarme des cervidés.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-bold text-[#0e8354]">
            Taux d'observation : 75 à 85 % (mars à mai)
          </div>
        </div>

        <!-- Bloc 2: Rhinocéros unicorne -->
        <div class="bg-white border border-slate-200/90 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="h-60 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/curated_gallery/rhino_unicorne_oiseaux_pique_boeuf.webp" 
                alt="Rhinocéros unicorne d'Asie dans les herbes hautes à Chitwan" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-lg font-bold text-slate-950 leading-snug">
                Le sanctuaire mondial du grand rhinocéros unicorne
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Le Népal abrite la deuxième plus grande population de rhinocéros unicornes d'Asie au monde. À Chitwan et à Bardia, ces mastodontes de deux tonnes vivent en totale liberté. Vous pouvez les observer à courte distance lors de marches guidées ou en glissant paisiblement en pirogue traditionnelle sur les rivières.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-bold text-[#0e8354]">
            Observation garantie à 98 % à Chitwan
          </div>
        </div>

        <!-- Bloc 3: Éléphants, ours et 450+ espèces -->
        <div class="bg-white border border-slate-200/90 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="h-60 overflow-hidden bg-slate-100 relative">
              <img 
                src="/assets/curated_gallery/elephant_asie_male_jungle.webp" 
                alt="Grand éléphant sauvage mâle dans la forêt tropicale de Bardia" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-lg font-bold text-slate-950 leading-snug">
                Une biodiversité colossale et plus de 450 espèces
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Le Teraï concentre des trésors fauniques insoupçonnés : éléphants sauvages solitaires, ours lippus, hardes de cerfs des marais, léopards discrets, dauphins du Gange et gavials préhistoriques. Un paradis préservé à basse altitude (200 m), sans fatigue liée à l'altitude.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 text-xs font-bold text-[#0e8354]">
            Climat tropical doux, accessible à tous
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3. NOS SÉJOURS SAFARI PHARES (FOND LÉGER SLATE-50) -->
  <section id="circuits-safari" class="py-16 sm:py-24 bg-slate-50 text-slate-900 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl sm:text-4xl font-black text-slate-950 tracking-tight">
            Nos expéditions et circuits safari au Népal
          </h2>
          <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-2xl">
            Conçus et guidés en direct par notre équipe locale sans aucun intermédiaire. Départs garantis en micro-groupes de 4 à 10 personnes ou départs privatifs sur mesure.
          </p>
        </div>
        <a href="/#prochains-departs" class="text-xs font-bold text-[#0e8354] hover:underline flex items-center gap-1 shrink-0">
          <span>Voir tous les 18 circuits</span>
          <span>→</span>
        </a>
      </div>

      <!-- Tours Grid avec cartes blanches épurées -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {safariTours.map((tour) => (
          <article class="bg-white border border-slate-200 rounded-3xl overflow-hidden hover:border-[#0e8354] transition-all duration-300 flex flex-col justify-between group shadow-sm hover:shadow-xl">
            <div>
              <div class="relative h-60 overflow-hidden bg-slate-100">
                <img 
                  src={tour.image || '/assets/tours_thumbs/safari_pied_guide_jungle_bardia.webp'} 
                  alt={tour.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy"
                />
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-[#0e5c3e] text-white shadow-sm">
                    {tour.duration}
                  </span>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-white/90 text-slate-800 border border-slate-200">
                    {tour.slug === 'panthere-des-neiges' ? 'Aventurier' : (tour.difficulty || "Aventure")}
                  </span>
                </div>
                <div class="absolute bottom-3 right-3 bg-slate-950/90 text-white font-extrabold text-xs px-3 py-1 rounded-xl shadow-sm">
                  Dès {String(tour.price).replace(/€/g, '').trim()} €
                </div>
              </div>

              <div class="p-6 space-y-3">
                <h3 class="font-bold text-base sm:text-lg text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                  {tour.title}
                </h3>
                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                  {tour.description}
                </p>
                
                {tour.highlights && (
                  <ul class="text-[11px] text-slate-700 space-y-1 pt-2 border-t border-slate-100">
                    {tour.highlights.slice(0, 2).map((h: string) => (
                      <li class="flex items-center gap-2">
                        <span class="text-[#0e8354] font-bold">✓</span>
                        <span class="truncate">{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>

            <div class="p-6 pt-0">
              <a 
                href={`/tours/${tour.slug}/`} 
                class="w-full py-3 px-4 rounded-xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-bold text-xs uppercase tracking-wide flex items-center justify-center gap-2 transition-all shadow-sm"
              >
                <span>Voir le circuit détaillé</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. NOS ACTIVITÉS SAFARI À LA JOURNÉE (EXCURSIONS 1 JOUR) -->
  <section id="activites-safari" class="py-16 sm:py-24 bg-white text-slate-900 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl sm:text-4xl font-black text-slate-950 tracking-tight leading-tight">
            Nos activités safari à la journée
          </h2>
          <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-2xl leading-relaxed">
            Vous êtes déjà sur place à Bardia ou Chitwan, ou en transit au Népal ? Vivez une journée d'immersion intense et authentique guidée par nos pisteurs natifs certifiés.
          </p>
        </div>
      </div>

      <!-- Grille des 5 Activités -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {dayActivities.map((act) => (
          <article class="group bg-white rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-emerald-500/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
            <div>
