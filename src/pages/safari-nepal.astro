          </p>
        </div>

        <!-- Technique 4 -->
        <div class="bg-slate-950 border border-white/10 rounded-3xl p-6 sm:p-8 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-emerald-900/40 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-sm">4</span>
            <h3 class="text-lg font-bold text-white">L'affût fixe aux points d'eau (Machans)</h3>
