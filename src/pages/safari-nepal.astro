          </p>
        </div>

        <!-- Technique 2 -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 space-y-3 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-emerald-100 text-[#0e8354] font-extrabold flex items-center justify-center text-sm">2</span>
