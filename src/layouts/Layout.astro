  <!-- Precision Smooth Scroll & Anchor Hash Stabilization -->
  <script is:inline>
    (function() {
      function getHeaderOffset() {
        var header = document.querySelector('header');
        var topBar = document.getElementById('top-bar');
        var offset = 0;
        if (header) {
          offset += header.offsetHeight;
        }
        if (topBar && window.getComputedStyle(topBar).display !== 'none' && window.getComputedStyle(topBar).position === 'sticky') {
          offset += topBar.offsetHeight;
        }
        return offset > 40 ? offset + 12 : (window.innerWidth < 640 ? 70 : 85);
      }

      function scrollToTarget(targetId) {
        var el = document.getElementById(targetId);
        if (!el) return;
        var headerOffset = getHeaderOffset();
        var elementPosition = el.getBoundingClientRect().top;
        var offsetPosition = elementPosition + window.pageYOffset - headerOffset;
        window.scrollTo({
          top: Math.max(0, offsetPosition),
          behavior: 'smooth'
        });
      }

      // Handle in-page clicks on anchor links (#... or /#...)
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href) return;

        var isCurrentHome = (window.location.pathname === '/' || window.location.pathname === '/index.html' || window.location.pathname === '');
        var isAnchor = href.startsWith('#') || (href.startsWith('/#') && isCurrentHome);
        if (isAnchor) {
          var targetId = href.replace(/^\/?#/, '');
          if (targetId) {
            var targetEl = document.getElementById(targetId);
            if (targetEl) {
              e.preventDefault();
              history.pushState(null, '', '#' + targetId);
              scrollToTarget(targetId);
            }
          }
        }
      });

      // Handle initial page load with hash (e.g. from external/inner pages)
      window.addEventListener('load', function() {
        if (window.location.hash) {
          var targetId = window.location.hash.substring(1);
          setTimeout(function() { scrollToTarget(targetId); }, 150);
          setTimeout(function() { scrollToTarget(targetId); }, 600);
        }
      });
    })();
  </script>

