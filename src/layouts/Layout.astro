  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-VZNY16DX6Y', {
      send_page_view: true
    });
  </script>

  <link rel="canonical" href={canonicalUrl} />

  <!-- Ultra-Fast Self-Hosted Local Fonts (Zero-Latency & Zero-Blocking) -->
