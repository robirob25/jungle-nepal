  <script is:inline>
    // Universal Custom Tour Modal Controls
    window.openCustomTourModal = function() {
      var m = document.getElementById('custom-tour-modal');
      if (m) {
        m.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    };

    window.closeCustomTourModal = function() {
      var m = document.getElementById('custom-tour-modal');
      if (m) {
        m.classList.add('hidden');
        document.body.style.overflow = '';
      }
    };

    // Universal Specific Tour Booking Modal Controls
    window.currentBookingConfig = {
      title: '',
      basePrice: 1990,
      hasCamping: false,
      campingPrice: 350
    };

    window.openTourBookingModal = function(config) {
      var isEn = document.documentElement.lang === 'en';
      
      var title = (config && config.title) || "";
      var basePrice = (config && config.basePrice) || 0;
      var hasCamping = config && typeof config.hasCamping === 'boolean' ? config.hasCamping : false;
      var campingPrice = (config && config.campingPrice) || 350;

      if (!title) {
        var bookingWidget = document.getElementById('booking-widget');
        if (bookingWidget) {
          var h3 = bookingWidget.querySelector('h3');
          if (h3) title = h3.textContent.trim();
        }
        if (!title) {
          var h1 = document.querySelector('h1');
          if (h1) title = h1.textContent.trim();
        }
      }

      if (!basePrice) {
        var priceDisplay = document.getElementById('tour-price-display');
        if (priceDisplay) {
          if (priceDisplay.getAttribute('data-base-price')) {
            basePrice = parseInt(priceDisplay.getAttribute('data-base-price'), 10) || 1990;
          } else {
            var num = priceDisplay.textContent.replace(/[^0-9]/g, '');
            if (num) basePrice = parseInt(num, 10);
          }
        } else {
          var bookingWidget = document.getElementById('booking-widget');
          if (bookingWidget) {
            var priceMatch = bookingWidget.textContent.match(/(?:À partir de|From)\s*([0-9\s,]+)\s*€/i);
            if (priceMatch && priceMatch[1]) {
              basePrice = parseInt(priceMatch[1].replace(/[^0-9]/g, ''), 10);
            }
          }
        }
      }
      if (!basePrice) basePrice = 1990;

      if (!hasCamping) {
        if (document.getElementById('camping-option-card') || document.getElementById('toggle-camping-btn')) {
          hasCamping = true;
        }
      }

      window.currentBookingConfig = {
        title: title || (isEn ? "Nepal Safari & Expedition" : "Séjour Safari Népal"),
        basePrice: basePrice,
        hasCamping: hasCamping,
        campingPrice: campingPrice
      };

      var titleEl = document.getElementById('booking-modal-tour-title');
      if (titleEl) titleEl.textContent = window.currentBookingConfig.title;

      var campingContainer = document.getElementById('booking-modal-option-container');
      var campingCheckbox = document.getElementById('booking-modal-camping-checkbox');
      
      if (campingContainer) {
        if (hasCamping) {
          campingContainer.classList.remove('hidden');
          if (campingCheckbox) {
            campingCheckbox.checked = !!window.isCampingSelected;
          }
        } else {
          campingContainer.classList.add('hidden');
          if (campingCheckbox) campingCheckbox.checked = false;
        }
      }

      window.updateBookingModalCalculations();

      var m = document.getElementById('tour-booking-modal');
      if (m) {
        m.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    };

    window.openBookingForm = window.openTourBookingModal;
    window.openBookingModal = window.openTourBookingModal;

    window.closeTourBookingModal = function() {
      var m = document.getElementById('tour-booking-modal');
      if (m) {
        m.classList.add('hidden');
        document.body.style.overflow = '';
      }
    };

    window.toggleBookingModalCamping = function(isChecked) {
      if (typeof window.isCampingSelected !== 'undefined') {
        if (window.isCampingSelected !== isChecked) {
          if (typeof window.toggleCampingOption === 'function') {
            window.toggleCampingOption(350);
          } else {
            window.isCampingSelected = isChecked;
          }
        }
      } else {
        window.isCampingSelected = isChecked;
      }
      window.updateBookingModalCalculations();
    };

    window.updateBookingModalCalculations = function() {
      var isEn = document.documentElement.lang === 'en';
      var config = window.currentBookingConfig || { basePrice: 1990, hasCamping: false, campingPrice: 350 };
      var travelersSelect = document.getElementById('booking-travelers-select');
      var travelers = travelersSelect ? parseInt(travelersSelect.value, 10) || 2 : 2;

      var campingCheckbox = document.getElementById('booking-modal-camping-checkbox');
      var isCamping = campingCheckbox && campingCheckbox.checked && config.hasCamping;

      var basePrice = config.basePrice || 1990;
      var extraPerPerson = isCamping ? (config.campingPrice || 350) : 0;
      var pricePerPerson = basePrice + extraPerPerson;
      var total = pricePerPerson * travelers;
      var deposit = Math.round(total * 0.3);

      function fmt(n) {
        return isEn ? n.toLocaleString('en-US') + ' €' : n.toLocaleString('fr-FR') + ' €';
      }

      var baseDisplay = document.getElementById('booking-modal-base-display');
