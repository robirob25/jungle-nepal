          });
        }
      }

      function closeModal() {
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
        var dialog = modal.querySelector('div');
        if (dialog) {
          dialog.classList.remove('scale-100');
          dialog.classList.add('scale-95');
        }
        setTimeout(function() {
          modal.classList.remove('flex');
          modal.classList.add('hidden');
        }, 300);
      }

      // Trigger when mouse leaves the top boundary of document (intent to close/switch tab)
      document.addEventListener('mouseleave', function(e) {
        var elapsed = (Date.now() - pageStartTime) / 1000;
        if (e.clientY <= 15 && elapsed >= 6) {
          openModal();
        }
      });

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (dismissBtn) dismissBtn.addEventListener('click', closeModal);

      // Close on backdrop click
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });

      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });

      // Track WhatsApp click from exit modal
      if (whatsappLink) {
        whatsappLink.addEventListener('click', function() {
          if (typeof gtag === 'function') {
            gtag('event', 'click_exit_modal_whatsapp', {
              event_category: 'engagement',
              page_location: window.location.href
            });
          }
          closeModal();
        });
      }

      // Track all WhatsApp clicks across document
      document.addEventListener('click', function(e) {
        var target = e.target && e.target.closest ? e.target.closest('a[href*="wa.me"]') : null;
        if (target && typeof gtag === 'function') {
          gtag('event', 'click_whatsapp', {
            event_category: 'engagement',
            event_label: target.href,
            page_location: window.location.href
          });
        }
      });
    })();
  </script>
</body>
</html>
