---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang?: 'fr' | 'en';
  currentPath?: string;
  isTransparent?: boolean;
}

const { lang, currentPath = '', isTransparent = false } = Astro.props;

const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const homeUrl = currentLang === 'en' ? '/en/' : '/';
const toursUrl = currentLang === 'en' ? '/en/#prochains-departs' : '/#prochains-departs';
const destUrl = currentLang === 'en' ? '/en/destinations.html' : '/destinations.html';
const guidesUrl = currentLang === 'en' ? (homeUrl + '#pisteurs') : '/#pisteurs';
const galleryUrl = currentLang === 'en' ? (homeUrl + '#galerie-faune') : '/#galerie-faune';
const aboutUrl = currentLang === 'en' ? '/en/a-propos.html' : '/a-propos.html';
const blogUrl = currentLang === 'en' ? '/en/blog.html' : '/blog.html';
const contactUrl = currentLang === 'en' ? '/en/contact.html' : '/contact.html';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<header class={`sticky top-0 z-30 transition-all duration-300 ${isTransparent ? 'bg-slate-950/80 backdrop-blur-md text-white border-b border-white/10' : 'bg-white/95 backdrop-blur-md text-slate-900 border-b border-slate-200 shadow-sm'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
    
      <!-- LEFT: LOGO -->
      <div class="flex items-center shrink-0">
        <a href={homeUrl} class="flex items-center gap-3 group">
          <img 
            src={isTransparent ? "/assets/logo_nav_white.png" : "/assets/logo_nav_dark.png"} 
            alt="Jungle Nepal Adventure" 
            class="h-10 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform" 
          />
        </a>
      </div>

      <!-- CENTER: NAVIGATION LINKS -->
      <nav class={`hidden lg:flex items-center gap-6 xl:gap-8 text-[14px] font-semibold ${isTransparent ? 'text-white/90' : 'text-slate-700'}`}>
        <a href={toursUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.tours')}
        </a>

        <!-- Destinations Dropdown -->
        <div class="relative group py-2">
          <a href={destUrl} class={`flex items-center gap-1.5 cursor-pointer whitespace-nowrap transition-colors ${isTransparent ? 'hover:text-amber-100' : 'hover:text-[#0e8354]'}`}>
            <span>{t('nav.destinations')}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 z-50">
            <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-3 shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-1 text-white">
              <a href={currentLang === 'en' ? "/en/destinations/bardia.html" : "/destinations/bardia.html"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Bardia National Park" : "Parc national de Bardia"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Bengal Tigers & Walking Safaris" : "Tigres du Bengale & safaris à pied"}</p>
                </div>
              </a>
              <a href={currentLang === 'en' ? "/en/destinations/chitwan.html" : "/destinations/chitwan.html"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Chitwan National Park" : "Parc national de Chitwan"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "One-Horned Rhinos & River Canoes" : "Rhinocéros & pirogues de la Rapti"}</p>
                </div>
              </a>
              <a href={currentLang === 'en' ? "/en/destinations/suklaphanta.html" : "/destinations/suklaphanta.html"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Suklaphanta National Park" : "Parc national de Suklaphanta"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Swamp Deer & Untamed Wild West" : "Cerfs des marais & ouest sauvage"}</p>
                </div>
              </a>
              <a href={currentLang === 'en' ? "/en/destinations/annapurna.html" : "/destinations/annapurna.html"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Annapurna & Pokhara" : "Les Annapurna & Pokhara"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Sacred Peaks & Alpine Balconies" : "Sommets mythiques & balcons alpins"}</p>
                </div>
              </a>
              <a href={currentLang === 'en' ? "/en/destinations/katmandou.html" : "/destinations/katmandou.html"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Kathmandu Valley" : "Katmandou"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Valley of Gods & Sacred Temples" : "Vallée des rois & temples sacrés"}</p>
                </div>
              </a>
              <div class="pt-2 border-t border-white/10 mt-1">
                <a href={destUrl} class="block w-full text-center py-2 rounded-xl bg-[#0e8354] hover:bg-[#0c6d46] text-white font-black text-xs transition-colors shadow">
                  {currentLang === 'en' ? "View all destinations →" : "Voir toutes les destinations →"}
                </a>
              </div>
            </div>
          </div>
        </div>

        <a href={guidesUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.guides')}
        </a>
        <a href={galleryUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.gallery')}
        </a>
        <a href={aboutUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.about')}
        </a>
        <a href={blogUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.blog')}
        </a>
        <a href={contactUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.contact')}
        </a>
      </nav>

      <!-- RIGHT: ACTIONS -->
      <div class="flex items-center gap-3 sm:gap-4 shrink-0">
        <!-- INTELLIGENT LANGUAGE SWITCHER -->
        <div class="relative group/lang py-1">
          <button onclick="toggleLangMenu(this)" class={`w-9 h-9 sm:w-10 sm:h-10 rounded-full ${isTransparent ? 'bg-white/10 hover:bg-white/20 border-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 border-slate-200 text-slate-700'} border backdrop-blur-md flex items-center justify-center transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer`} aria-label="Changer de langue / Change language">
            <span class="text-xs font-black uppercase tracking-wider">{currentLang.toUpperCase()}</span>
          </button>
          <div class="lang-dropdown-box absolute right-0 top-full mt-1.5 w-44 opacity-0 translate-y-2 pointer-events-none group-hover/lang:opacity-100 group-hover/lang:translate-y-0 group-hover/lang:pointer-events-auto transition-all duration-200 z-50">
            <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-1.5 shadow-[0_20px_50px_rgba(0,0,0,0.8)] space-y-0.5 text-xs font-bold text-white">
              <a href={frTargetUrl} class={`w-full flex items-center justify-between px-3 py-2 rounded-xl ${currentLang === 'fr' ? 'bg-white/20 text-white font-extrabold' : 'text-slate-300 hover:bg-white/10 hover:text-white'} transition-colors text-left cursor-pointer`}>
                <span class="flex items-center gap-2"><span>🇫🇷</span><span>Français</span></span>
                {currentLang === 'fr' && <span class="text-emerald-400">✓</span>}
              </a>
              <a href={enTargetUrl} class={`w-full flex items-center justify-between px-3 py-2 rounded-xl ${currentLang === 'en' ? 'bg-white/20 text-white font-extrabold' : 'text-slate-300 hover:bg-white/10 hover:text-white'} transition-colors text-left cursor-pointer`}>
                <span class="flex items-center gap-2"><span>🇬🇧</span><span>English</span></span>
                {currentLang === 'en' && <span class="text-emerald-400">✓</span>}
              </a>
            </div>
          </div>
        </div>

        <a href="https://wa.me/33695413227" target="_blank" rel="noopener noreferrer" class={`inline-flex items-center gap-2 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full ${isTransparent ? 'bg-white text-slate-950 hover:bg-slate-100' : 'bg-[#0e8354] text-white hover:bg-[#0c6d46]'} font-extrabold text-xs sm:text-[13px] shadow-sm hover:scale-105 active:scale-95 transition-all whitespace-nowrap`}>
          <svg class={`w-4 h-4 ${isTransparent ? 'text-[#25D366]' : 'text-white'} shrink-0`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          <span>WhatsApp</span>
        </a>

        <!-- Mobile Hamburger Button -->
        <button onclick="toggleMobileMenu()" class={`lg:hidden w-10 h-10 rounded-2xl ${isTransparent ? 'bg-white/15 hover:bg-white/25 text-white border-white/30' : 'bg-slate-100 hover:bg-slate-200 text-slate-900 border-slate-300'} border backdrop-blur-md flex flex-col items-center justify-center gap-1.5 transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer shadow-sm p-2`} aria-label="Menu">
          <span class={`w-5 h-[2.5px] ${isTransparent ? 'bg-white' : 'bg-slate-900'} rounded-full block`}></span>
          <span class={`w-5 h-[2.5px] ${isTransparent ? 'bg-white' : 'bg-slate-900'} rounded-full block`}></span>
          <span class={`w-5 h-[2.5px] ${isTransparent ? 'bg-white' : 'bg-slate-900'} rounded-full block`}></span>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- MOBILE NAVIGATION DRAWER -->
<div id="mobile-menu" class="hidden lg:hidden fixed inset-x-3 top-20 z-50 max-h-[85vh] overflow-y-auto bg-slate-950/98 backdrop-blur-2xl border border-white/15 rounded-3xl p-5 text-white shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-4 font-sans">
  
  <div class="flex items-center justify-between pb-3 border-b border-white/10">
    <span class="text-xs font-black uppercase tracking-widest text-slate-200">Navigation</span>
    <button onclick="toggleMobileMenu()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-sm font-bold transition-colors cursor-pointer" aria-label="Fermer le menu">
      ✕
    </button>
  </div>

  <nav class="flex flex-col space-y-1.5 font-bold text-sm">
    <a href={toursUrl} onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl bg-white/5 hover:bg-white/10 flex items-center justify-between text-white transition-colors">
      <span>{t('nav.tours')}</span>
      <span class="bg-[#0e8354] text-white text-[11px] px-2.5 py-0.5 rounded-full font-black">15</span>
    </a>

    <div class="rounded-2xl bg-white/5 overflow-hidden">
      <button onclick="document.getElementById('mobile-dest-sub').classList.toggle('hidden'); document.getElementById('mobile-dest-arrow').classList.toggle('rotate-180');" class="w-full px-3.5 py-2.5 flex items-center justify-between text-white hover:bg-white/10 transition-colors text-left cursor-pointer">
        <span>{t('nav.destinations')}</span>
        <svg id="mobile-dest-arrow" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <div id="mobile-dest-sub" class="hidden px-2 pb-2.5 space-y-1 border-t border-white/5 pt-2">
        <a href={currentLang === 'en' ? "/en/destinations/bardia.html" : "/destinations/bardia.html"} onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
          <div>
            <p class="font-bold text-white">{currentLang === 'en' ? "Bardia National Park" : "Parc national de Bardia"}</p>
            <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Bengal Tigers & Walking Safaris" : "Tigres du Bengale & safaris à pied"}</p>
          </div>
        </a>
        <a href={currentLang === 'en' ? "/en/destinations/chitwan.html" : "/destinations/chitwan.html"} onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
          <div>
            <p class="font-bold text-white">{currentLang === 'en' ? "Chitwan National Park" : "Parc national de Chitwan"}</p>
            <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "One-Horned Rhinos & River Canoes" : "Rhinocéros & pirogues de la Rapti"}</p>
          </div>
        </a>
        <a href={currentLang === 'en' ? "/en/destinations/suklaphanta.html" : "/destinations/suklaphanta.html"} onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
          <div>
            <p class="font-bold text-white">{currentLang === 'en' ? "Suklaphanta National Park" : "Parc national de Suklaphanta"}</p>
            <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Swamp Deer & Untamed Wild West" : "Cerfs des marais & ouest sauvage"}</p>
          </div>
        </a>
        <a href={currentLang === 'en' ? "/en/destinations/annapurna.html" : "/destinations/annapurna.html"} onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
          <div>
            <p class="font-bold text-white">{currentLang === 'en' ? "Annapurna & Pokhara" : "Les Annapurna & Pokhara"}</p>
            <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Sacred Peaks & Alpine Balconies" : "Sommets mythiques & balcons alpins"}</p>
          </div>
        </a>
        <a href={currentLang === 'en' ? "/en/destinations/katmandou.html" : "/destinations/katmandou.html"} onclick="toggleMobileMenu()" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-white/10 text-xs text-slate-300 hover:text-white transition-colors">
          <div>
            <p class="font-bold text-white">{currentLang === 'en' ? "Kathmandu Valley" : "Katmandou"}</p>
            <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Valley of Gods & Sacred Temples" : "Vallée des rois & temples sacrés"}</p>
          </div>
        </a>
        <a href={destUrl} onclick="toggleMobileMenu()" class="block w-full text-center py-2 rounded-xl bg-[#0e8354] hover:bg-[#0c6d46] text-white font-black text-xs transition-colors shadow mt-1">
          {currentLang === 'en' ? "View all destinations →" : "Voir toutes les destinations →"}
        </a>
      </div>
    </div>

    <a href={guidesUrl} onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
      <span>{t('nav.guides')}</span>
    </a>
    <a href={galleryUrl} onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
      <span>{t('nav.gallery')}</span>
    </a>
    <a href={aboutUrl} class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
      <span>{t('nav.about')}</span>
    </a>
    <a href={blogUrl} onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
      <span>{t('nav.blog')}</span>
    </a>
    <a href={contactUrl} class="px-3.5 py-2.5 rounded-2xl hover:bg-white/10 flex items-center text-slate-200 hover:text-white transition-colors">
      <span>{t('nav.contact')}</span>
    </a>
  </nav>

  <div class="pt-4 border-t border-white/10">
    <a href="https://wa.me/33695413227" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center gap-2 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-sm shadow-lg transition-all">
      <svg class="w-4 h-4 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
      <span>Contacter Robin sur WhatsApp</span>
    </a>
  </div>

</div>
