---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang?: 'fr' | 'en';
  currentPath?: string;
  isTransparent?: boolean;
}

const { lang, currentPath = '', isTransparent = false } = Astro.props;

const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const homeUrl = currentLang === 'en' ? '/en/' : '/';
const safariUrl = currentLang === 'en' ? '/en/safari-nepal/' : '/safari-nepal/';
const toursUrl = currentLang === 'en' ? '/en/#prochains-departs' : '/#prochains-departs';
const activitiesUrl = currentLang === 'en' ? '/en/#activites' : '/#activites';
const destUrl = currentLang === 'en' ? '/en/destinations' : '/destinations';
const guidesUrl = currentLang === 'en' ? (homeUrl + '#pisteurs') : '/#pisteurs';
const galleryUrl = currentLang === 'en' ? (homeUrl + '#galerie-faune') : '/#galerie-faune';
const aboutUrl = currentLang === 'en' ? '/en/about' : '/a-propos';
const blogUrl = currentLang === 'en' ? '/en/blog' : '/blog';
const contactUrl = currentLang === 'en' ? '/en/contact' : '/contact';

const frTargetUrl = getLocalizedPath(Astro.url, 'fr');
const enTargetUrl = getLocalizedPath(Astro.url, 'en');
---

<header class={`sticky top-0 z-30 transition-all duration-300 ${isTransparent ? 'bg-slate-950/80 backdrop-blur-md text-white border-b border-white/10' : 'bg-white/95 backdrop-blur-md text-slate-900 border-b border-slate-200 shadow-sm'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
    
      <!-- LEFT: LOGO -->
      <div class="flex items-center shrink-0">
        <a href={homeUrl} class="flex items-center gap-3 group">
          <img 
            src={isTransparent ? "/assets/logo_header_white.png" : "/assets/logo_header_dark.png"} 
            alt="Jungle Nepal Adventure" 
            width="168"
            height="48"
            loading="eager"
            decoding="sync"
            class="h-10 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform" 
          />
        </a>
      </div>

      <!-- CENTER: NAVIGATION LINKS -->
      <nav class={`hidden lg:flex items-center gap-5 xl:gap-7 text-[13.5px] xl:text-[14px] font-semibold ${isTransparent ? 'text-white/90' : 'text-slate-700'}`}>
        <a href={toursUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.tours')}
        </a>

        <a href={activitiesUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.activities')}
        </a>

        <a href={safariUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.safari')}
        </a>

        <!-- Destinations Dropdown -->
        <div class="relative group py-2">
          <a href={destUrl} class={`flex items-center gap-1.5 cursor-pointer whitespace-nowrap transition-colors ${isTransparent ? 'hover:text-amber-100' : 'hover:text-[#0e8354]'}`}>
            <span>{t('nav.destinations')}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 z-50">
            <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-3 shadow-[0_25px_60px_rgba(0,0,0,0.8)] space-y-1 text-white">
              <a href={safariUrl} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Safari in Nepal" : "Safari au Népal"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Bardia, Chitwan & Wildlife Tours" : "Bardia, Chitwan & grands circuits"}</p>
                </div>
              </a>
              <a href={currentLang === 'en' ? "/en/destinations/bardia" : "/destinations/bardia"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Bardia National Park" : "Parc national de Bardia"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Bengal Tigers & Walking Safaris" : "Tigres du Bengale & safaris à pied"}</p>
                </div>
              </a>
              <a href={currentLang === 'en' ? "/en/destinations/chitwan" : "/destinations/chitwan"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Chitwan National Park" : "Parc national de Chitwan"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "One-Horned Rhinos & River Canoes" : "Rhinocéros & pirogues de la Rapti"}</p>
                </div>
              </a>
              <a href={currentLang === 'en' ? "/en/destinations/suklaphanta" : "/destinations/suklaphanta"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Suklaphanta National Park" : "Parc national de Suklaphanta"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Swamp Deer & Untamed Wild West" : "Cerfs des marais & ouest sauvage"}</p>
                </div>
              </a>
              <a href={currentLang === 'en' ? "/en/destinations/annapurna" : "/destinations/annapurna"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Annapurna & Pokhara" : "Les Annapurna & Pokhara"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Sacred Peaks & Alpine Balconies" : "Sommets mythiques & balcons alpins"}</p>
                </div>
              </a>
              <a href={currentLang === 'en' ? "/en/destinations/katmandou" : "/destinations/katmandou"} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors group/item">
                <div class="flex-1">
                  <p class="font-extrabold text-xs text-white group-hover/item:text-amber-100 transition-colors">{currentLang === 'en' ? "Kathmandu Valley" : "Katmandou"}</p>
                  <p class="text-[10px] text-slate-400">{currentLang === 'en' ? "Valley of Gods & Sacred Temples" : "Vallée des rois & temples sacrés"}</p>
                </div>
              </a>
              <div class="pt-2 border-t border-white/10 mt-1">
                <a href={destUrl} class="block w-full text-center py-2 rounded-xl bg-[#0e8354] hover:bg-[#0c6d46] text-white font-black text-xs transition-colors shadow">
                  {currentLang === 'en' ? "View all destinations →" : "Voir toutes les destinations →"}
                </a>
              </div>
            </div>
          </div>
        </div>

        <a href={galleryUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.gallery')}
        </a>
        <a href={aboutUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.about')}
        </a>
        <a href={blogUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.blog')}
        </a>
        <a href={contactUrl} class={isTransparent ? "hover:text-amber-100 transition-colors whitespace-nowrap" : "hover:text-[#0e8354] transition-colors whitespace-nowrap"}>
          {t('nav.contact')}
        </a>
      </nav>

      <!-- RIGHT: ACTIONS -->
      <div class="flex items-center gap-3 sm:gap-4 shrink-0">
        <!-- INTELLIGENT LANGUAGE SWITCHER -->
        <div class="relative group/lang py-1">
          <button onclick="toggleLangMenu(this)" class={`w-9 h-9 sm:w-10 sm:h-10 rounded-full ${isTransparent ? 'bg-white/10 hover:bg-white/20 border-white/20 text-white' : 'bg-slate-100 hover:bg-slate-200 border-slate-200 text-slate-700'} border backdrop-blur-md flex items-center justify-center transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer`} aria-label="Changer de langue / Change language">
            <span class="text-xs font-black uppercase tracking-wider">{currentLang.toUpperCase()}</span>
          </button>
          <div class="lang-dropdown-box absolute right-0 top-full mt-1.5 w-44 opacity-0 translate-y-2 pointer-events-none group-hover/lang:opacity-100 group-hover/lang:translate-y-0 group-hover/lang:pointer-events-auto transition-all duration-200 z-50">
            <div style="background-color: #041d13 !important;" class="border border-white/10 rounded-2xl p-1.5 shadow-[0_20px_50px_rgba(0,0,0,0.8)] space-y-0.5 text-xs font-bold text-white">
              <a href={frTargetUrl} class={`w-full flex items-center justify-between px-3 py-2 rounded-xl ${currentLang === 'fr' ? 'bg-white/20 text-white font-extrabold' : 'text-slate-300 hover:bg-white/10 hover:text-white'} transition-colors text-left cursor-pointer`}>
                <span class="flex items-center gap-2"><span>🇫🇷</span><span>Français</span></span>
                {currentLang === 'fr' && <span class="text-emerald-400">✓</span>}
              </a>
              <a href={enTargetUrl} class={`w-full flex items-center justify-between px-3 py-2 rounded-xl ${currentLang === 'en' ? 'bg-white/20 text-white font-extrabold' : 'text-slate-300 hover:bg-white/10 hover:text-white'} transition-colors text-left cursor-pointer`}>
                <span class="flex items-center gap-2"><span>🇬🇧</span><span>English</span></span>
                {currentLang === 'en' && <span class="text-emerald-400">✓</span>}
              </a>
            </div>
          </div>
        </div>

        <a href="https://wa.me/33695413227" target="_blank" rel="nofollow noopener noreferrer" class={`inline-flex items-center gap-2 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full ${isTransparent ? 'bg-white text-slate-950 hover:bg-slate-100' : 'bg-[#0e8354] text-white hover:bg-[#0c6d46]'} font-extrabold text-xs sm:text-[13px] shadow-sm hover:scale-105 active:scale-95 transition-all whitespace-nowrap`}>
          <svg class={`w-4 h-4 ${isTransparent ? 'text-[#25D366]' : 'text-white'} shrink-0`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          <span>WhatsApp</span>
        </a>

        <!-- Mobile Hamburger Button -->
        <button onclick="toggleMobileMenu()" class={`lg:hidden w-10 h-10 rounded-2xl ${isTransparent ? "bg-white/15 hover:bg-white/25 text-white border-white/30" : "bg-[#041d13] hover:bg-[#073021] text-white border-white/10"} border backdrop-blur-md flex flex-col items-center justify-center gap-1.5 transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer shadow-md p-2`} aria-label="Menu">
          <span class="w-5 h-[2.5px] bg-white rounded-full block"></span>
          <span class="w-5 h-[2.5px] bg-white rounded-full block"></span>
          <span class="w-5 h-[2.5px] bg-white rounded-full block"></span>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- MOBILE NAVIGATION DRAWER -->
<div id="mobile-menu" style="background-color: #041d13 !important;" class="hidden lg:hidden fixed inset-x-3 top-20 z-50 max-h-[85vh] overflow-y-auto bg-[#041d13] border border-white/10 rounded-3xl p-5 text-white shadow-[0_25px_60px_rgba(0,0,0,0.95)] space-y-3 font-sans">
  
  <!-- Top Bar: Clean Minimal Close Button -->
  <div class="flex items-center justify-end pb-1">
    <button onclick="toggleMobileMenu()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 active:scale-90 flex items-center justify-center text-white/80 hover:text-white transition-all cursor-pointer" aria-label="Fermer le menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="flex flex-col space-y-0.5 text-[15px] font-medium tracking-tight">
    <a href={toursUrl} onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-xl hover:bg-white/10 text-white/90 hover:text-white transition-colors">
      <span>{t('nav.tours')}</span>
    </a>

    <a href={activitiesUrl} onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-xl hover:bg-white/10 text-white/90 hover:text-white transition-colors">
      <span>{t('nav.activities')}</span>
    </a>

    <a href={safariUrl} onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-xl hover:bg-white/10 text-white/90 hover:text-white transition-colors">
      <span>{t('nav.safari')}</span>
    </a>

    <div class="rounded-xl overflow-hidden">
      <button onclick="document.getElementById('mobile-dest-sub').classList.toggle('hidden'); document.getElementById('mobile-dest-arrow').classList.toggle('rotate-180');" class="w-full px-3.5 py-2.5 flex items-center justify-between text-white/90 hover:text-white hover:bg-white/10 transition-colors text-left cursor-pointer">
        <span>{t('nav.destinations')}</span>
        <svg id="mobile-dest-arrow" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/60 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <div id="mobile-dest-sub" class="hidden pl-4 pr-2 py-1 space-y-1 text-sm text-white/80">
        <a href={safariUrl} onclick="toggleMobileMenu()" class="block py-1.5 hover:text-white transition-colors">
          {currentLang === 'en' ? "Safari in Nepal" : "Safari au Népal"}
        </a>
        <a href={currentLang === 'en' ? "/en/destinations/bardia" : "/destinations/bardia"} onclick="toggleMobileMenu()" class="block py-1.5 hover:text-white transition-colors">
          {currentLang === 'en' ? "Bardia National Park" : "Parc national de Bardia"}
        </a>
        <a href={currentLang === 'en' ? "/en/destinations/chitwan" : "/destinations/chitwan"} onclick="toggleMobileMenu()" class="block py-1.5 hover:text-white transition-colors">
          {currentLang === 'en' ? "Chitwan National Park" : "Parc national de Chitwan"}
        </a>
        <a href={currentLang === 'en' ? "/en/destinations/suklaphanta" : "/destinations/suklaphanta"} onclick="toggleMobileMenu()" class="block py-1.5 hover:text-white transition-colors">
          {currentLang === 'en' ? "Suklaphanta National Park" : "Parc national de Suklaphanta"}
        </a>
        <a href={currentLang === 'en' ? "/en/destinations/annapurna" : "/destinations/annapurna"} onclick="toggleMobileMenu()" class="block py-1.5 hover:text-white transition-colors">
          {currentLang === 'en' ? "Annapurna & Pokhara" : "Les Annapurna & Pokhara"}
        </a>
        <a href={currentLang === 'en' ? "/en/destinations/katmandou" : "/destinations/katmandou"} onclick="toggleMobileMenu()" class="block py-1.5 hover:text-white transition-colors">
          {currentLang === 'en' ? "Kathmandu Valley" : "Katmandou"}
        </a>
        <a href={destUrl} onclick="toggleMobileMenu()" class="block pt-2 pb-1 text-xs text-emerald-400 hover:text-emerald-300 font-semibold transition-colors">
          {currentLang === 'en' ? "View all destinations →" : "Toutes les destinations →"}
        </a>
      </div>
    </div>

    <a href={galleryUrl} onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-xl hover:bg-white/10 text-white/90 hover:text-white transition-colors">
      <span>{t('nav.gallery')}</span>
    </a>
    <a href={aboutUrl} class="px-3.5 py-2.5 rounded-xl hover:bg-white/10 text-white/90 hover:text-white transition-colors">
      <span>{t('nav.about')}</span>
    </a>
    <a href={blogUrl} onclick="toggleMobileMenu()" class="px-3.5 py-2.5 rounded-xl hover:bg-white/10 text-white/90 hover:text-white transition-colors">
      <span>{t('nav.blog')}</span>
    </a>
    <a href={contactUrl} class="px-3.5 py-2.5 rounded-xl hover:bg-white/10 text-white/90 hover:text-white transition-colors">
      <span>{t('nav.contact')}</span>
    </a>
  </nav>

  <div class="pt-3 border-t border-white/10 flex items-center gap-2.5">
    <a href={toursUrl} onclick="toggleMobileMenu()" class="flex-1 text-center py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] text-white font-bold text-xs uppercase tracking-wide transition-all flex items-center justify-center">
      {currentLang === 'en' ? "Explore Tours & expeditions →" : "Explorer les circuits et départs →"}
    </a>
    <a href="https://wa.me/33695413227" target="_blank" rel="nofollow noopener noreferrer" aria-label="WhatsApp" class="w-12 h-12 rounded-xl bg-[#25D366] hover:bg-[#20ba59] active:scale-95 text-white flex items-center justify-center shrink-0 transition-all">
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
    </a>
  </div>

</div>
