  window.selectQuizOption = function(category, value) {
    quizAnswers[category] = value;
    if (currentStep < totalSteps) {
      currentStep++;
      updateQuizView();
    } else {
      calculateAndShowResults();
    }
  };

  window.prevQuizStep = function() {
    if (currentStep > 1) {
      currentStep--;
      updateQuizView();
    }
  };

  window.resetSafariQuiz = function() {
    quizAnswers.duration = '';
    quizAnswers.group = '';
    quizAnswers.wildlife = '';
    quizAnswers.style = '';
    quizAnswers.pace = '';
    currentStep = 1;
    document.getElementById('quiz-results-container').classList.add('hidden');
    document.getElementById('quiz-steps-container').classList.remove('hidden');
    document.getElementById('quiz-progress-wrapper').classList.remove('hidden');
    document.getElementById('quiz-nav-footer').classList.remove('hidden');
    updateQuizView();
  };

  function updateQuizView() {
    // Show active step
    document.querySelectorAll('.quiz-step').forEach(stepEl => {
      const stepNum = parseInt(stepEl.getAttribute('data-step'));
      if (stepNum === currentStep) {
        stepEl.classList.remove('hidden');
      } else {
        stepEl.classList.add('hidden');
      }
    });

    // Update progress bar
    const percent = Math.round((currentStep / totalSteps) * 100);
    document.getElementById('quiz-step-label').textContent = isEn ? `Question ${currentStep} of ${totalSteps}` : `Question ${currentStep} sur ${totalSteps}`;
    document.getElementById('quiz-step-percent').textContent = `${percent}%`;
    document.getElementById('quiz-progress-bar').style.width = `${percent}%`;

    // Back button visibility
    const backBtn = document.getElementById('quiz-back-btn');
    if (currentStep > 1) {
      backBtn.classList.remove('hidden');
    } else {
      backBtn.classList.add('hidden');
    }
  }

  function calculateAndShowResults() {
    // Score each tour based on user answers
    const scoredTours = toursData.map(tour => {
      let score = 0;
      let totalCriteria = 5;

      if (tour.tags.duration.includes(quizAnswers.duration)) score += 20;
      if (tour.tags.group.includes(quizAnswers.group)) score += 20;
      if (tour.tags.wildlife.includes(quizAnswers.wildlife)) score += 30; // High weight
      if (tour.tags.style.includes(quizAnswers.style)) score += 15;
      if (tour.tags.pace.includes(quizAnswers.pace)) score += 15;

      return {
        ...tour,
        calculatedScore: score
      };
    });

    scoredTours.sort((a, b) => b.calculatedScore - a.calculatedScore);
    const topMatches = scoredTours.slice(0, 2);

    // Render results
    const cardsContainer = document.getElementById('quiz-matched-cards');
    cardsContainer.innerHTML = '';

    topMatches.forEach((match, idx) => {
      const matchPercentage = Math.min(99, Math.max(88, match.calculatedScore + (idx === 0 ? 5 : 0)));
      const isFirst = idx === 0;

      const cardHtml = `
        <div class="rounded-2xl bg-white/5 border ${isFirst ? 'border-emerald-400/60 ring-2 ring-emerald-500/30' : 'border-white/10'} p-5 flex flex-col justify-between space-y-4 shadow-xl">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2">
              <span class="px-2.5 py-0.5 rounded-full ${isFirst ? 'bg-emerald-500 text-slate-950 font-black' : 'bg-white/10 text-white font-bold'} text-[11px] uppercase tracking-wider">
                ${isFirst ? (isEn ? "Top Recommendation" : "Recommandation n°1") : (isEn ? "Tailored Alternative" : "Option Alternative")}
              </span>
              <span class="text-xs font-black text-amber-300">${matchPercentage}% ${isEn ? "match" : "compatible"}</span>
            </div>

            <div class="aspect-video w-full rounded-xl overflow-hidden bg-slate-900 border border-white/10">
              <img src="${match.image}" alt="${match.title}" class="w-full h-full object-cover" loading="lazy" />
            </div>

            <div>
              <h4 class="text-base sm:text-lg font-black text-white leading-tight">${match.title}</h4>
              <div class="flex items-center gap-3 text-xs font-bold text-slate-300 mt-1">
                <span>⏱ ${match.days} ${isEn ? "days" : "jours"}</span>
                <span>•</span>
                <span class="text-emerald-400 font-black">${match.price} / ${isEn ? "pers" : "pers"}</span>
              </div>
            </div>

            <p class="text-xs text-slate-300 leading-relaxed font-normal">${match.matchDesc}</p>
          </div>

          <div class="pt-3 border-t border-white/10 flex items-center gap-2">
            <a href="${match.url}" class="flex-1 py-2.5 px-4 rounded-xl ${isFirst ? 'bg-emerald-600 hover:bg-emerald-500 text-white' : 'bg-white/10 hover:bg-white/20 text-white'} text-center font-bold text-xs transition-colors shadow">
              ${isEn ? "View Itinerary →" : "Voir l'itinéraire →"}
            </a>
          </div>
        </div>
      `;
      cardsContainer.innerHTML += cardHtml;
    });

    // Update WhatsApp link with pre-filled message
    const waText = isEn 
      ? `Hello Robin, I just took the Safari Quiz on your website (Duration: ${quizAnswers.duration}, Focus: ${quizAnswers.wildlife}, Group: ${quizAnswers.group}). I am interested in ${topMatches[0].title}. Could you provide details?`
      : `Bonjour Robin, je viens de faire le quiz safari sur votre site (Durée: ${quizAnswers.duration}, Faune: ${quizAnswers.wildlife}, Groupe: ${quizAnswers.group}). Je suis intéressé par le circuit ${topMatches[0].title}. Pouvez-vous m'en dire plus ?`;
    
    document.getElementById('quiz-whatsapp-btn').href = `https://wa.me/33695413227?text=${encodeURIComponent(waText)}`;

    // Update Summary
    document.getElementById('quiz-results-summary').textContent = isEn 
      ? `Based on your selection for ${quizAnswers.group} and your interest in ${quizAnswers.wildlife}, these itineraries offer the best field success rate.`
      : `Selon votre profil (${quizAnswers.group}) et votre priorité faune, ces itinéraires garantissent les plus hauts taux d'observation sur le terrain.`;

    // Switch views
    document.getElementById('quiz-steps-container').classList.add('hidden');
    document.getElementById('quiz-progress-wrapper').classList.add('hidden');
    document.getElementById('quiz-nav-footer').classList.add('hidden');
    document.getElementById('quiz-results-container').classList.remove('hidden');
  }
</script>
