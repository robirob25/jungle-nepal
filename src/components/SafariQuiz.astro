  window.selectQuizOption = function(category, value) {
    quizAnswers[category] = value;
    if (currentStep < totalSteps) {
      currentStep++;
      updateQuizView();
    } else {
      calculateAndShowResults();
    }
  };

  window.prevQuizStep = function() {
    if (currentStep > 1) {
      currentStep--;
      updateQuizView();
    }
  };

  window.resetSafariQuiz = function() {
    quizAnswers.duration = '';
    quizAnswers.group = '';
    quizAnswers.wildlife = '';
    quizAnswers.style = '';
    quizAnswers.pace = '';
    currentStep = 1;
    document.getElementById('quiz-results-container').classList.add('hidden');
    document.getElementById('quiz-steps-container').classList.remove('hidden');
    document.getElementById('quiz-progress-wrapper').classList.remove('hidden');
    document.getElementById('quiz-nav-footer').classList.remove('hidden');
    updateQuizView();
  };

  function updateQuizView() {
    // Show active step
    document.querySelectorAll('.quiz-step').forEach(stepEl => {
      const stepNum = parseInt(stepEl.getAttribute('data-step'));
      if (stepNum === currentStep) {
        stepEl.classList.remove('hidden');
      } else {
        stepEl.classList.add('hidden');
      }
    });

    // Update progress bar
    const percent = Math.round((currentStep / totalSteps) * 100);
    document.getElementById('quiz-step-label').textContent = isEn ? `Question ${currentStep} of ${totalSteps}` : `Question ${currentStep} sur ${totalSteps}`;
    document.getElementById('quiz-step-percent').textContent = `${percent}%`;
    document.getElementById('quiz-progress-bar').style.width = `${percent}%`;

    // Back button visibility
    const backBtn = document.getElementById('quiz-back-btn');
    if (currentStep > 1) {
      backBtn.classList.remove('hidden');
    } else {
      backBtn.classList.add('hidden');
    }
  }

  function calculateAndShowResults() {
    // Score each tour based on user answers
    const scoredTours = toursData.map(tour => {
      let score = 0;

      if (tour.tags.duration.includes(quizAnswers.duration)) score += 20;
      if (tour.tags.group.includes(quizAnswers.group)) score += 20;
      if (tour.tags.wildlife.includes(quizAnswers.wildlife)) score += 30; // High weight
      if (tour.tags.style.includes(quizAnswers.style)) score += 15;
      if (tour.tags.pace.includes(quizAnswers.pace)) score += 15;

      return {
        ...tour,
        calculatedScore: score
      };
    });

    scoredTours.sort((a, b) => b.calculatedScore - a.calculatedScore);
    const topMatches = scoredTours.slice(0, 2);

    // Render results
    const cardsContainer = document.getElementById('quiz-matched-cards');
    cardsContainer.innerHTML = '';

    topMatches.forEach((match, idx) => {
      const matchPercentage = Math.min(99, Math.max(88, match.calculatedScore + (idx === 0 ? 5 : 0)));
      const isFirst = idx === 0;

      const cardHtml = `
        <div class="rounded-3xl ${isFirst ? 'bg-gradient-to-b from-emerald-50/40 via-white to-white border-2 border-[#0e8354] ring-4 ring-emerald-500/10' : 'bg-white border border-slate-200/90'} p-6 sm:p-7 flex flex-col justify-between space-y-6 shadow-lg hover:shadow-xl transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-2">
              <span class="px-3.5 py-1 rounded-full ${isFirst ? 'bg-[#0e8354] text-white font-black' : 'bg-slate-100 text-slate-700 font-bold border border-slate-200'} text-[11px] uppercase tracking-wider">
                ${isFirst ? (isEn ? "Top Recommendation" : "Recommandation n°1") : (isEn ? "Tailored Alternative" : "Option Alternative")}
              </span>
              <span class="text-xs font-black text-[#0e8354]">${matchPercentage}% ${isEn ? "match" : "compatible"}</span>
            </div>

            <div class="aspect-[16/10] w-full rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/80 shadow-inner">
              <img src="${match.image}" alt="${match.title}" onerror="this.src='/assets/tours_thumbs/tigre_bardia.webp'" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>

            <div class="space-y-1">
              <h4 class="text-lg sm:text-xl font-black text-slate-900 leading-snug">${match.title}</h4>
              <div class="flex items-center gap-3 text-xs sm:text-sm font-bold text-slate-600">
                <span>⏱ ${match.days} ${isEn ? "days" : "jours"}</span>
                <span>•</span>
                <span class="text-[#0e8354] font-black">${match.price} / ${isEn ? "pers" : "pers"}</span>
              </div>
            </div>

            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-normal">${match.matchDesc}</p>
          </div>

          <div class="pt-4 border-t border-slate-200 flex items-center gap-3">
            <a href="${match.url}" class="flex-1 py-3.5 px-5 rounded-xl ${isFirst ? 'bg-[#0e8354] hover:bg-[#0c6d46] text-white shadow-md hover:shadow-lg' : 'bg-slate-900 hover:bg-slate-800 text-white shadow'} text-center font-black text-xs sm:text-sm transition-all hover:scale-[1.01] active:scale-95">
              ${isEn ? "View Itinerary →" : "Voir l'itinéraire →"}
            </a>
          </div>
        </div>
      `;
      cardsContainer.innerHTML += cardHtml;
    });

    // Update WhatsApp link with pre-filled message
    const waText = isEn 
      ? `Hello Robin, I just took the Travel Quiz on your website (Duration: ${quizAnswers.duration}, Focus: ${quizAnswers.wildlife}, Group: ${quizAnswers.group}). I am interested in ${topMatches[0].title}. Could you provide details?`
      : `Bonjour Robin, je viens de faire le quiz sur votre site (Durée: ${quizAnswers.duration}, Objectif: ${quizAnswers.wildlife}, Groupe: ${quizAnswers.group}). Je suis intéressé par le circuit ${topMatches[0].title}. Pouvez-vous m'en dire plus ?`;
    
    document.getElementById('quiz-whatsapp-btn').href = `https://wa.me/33695413227?text=${encodeURIComponent(waText)}`;

    // Update Summary
    document.getElementById('quiz-results-summary').textContent = isEn 
      ? `Based on your selection for ${quizAnswers.group} and your trip priorities, these itineraries offer the best field experience and success rate.`
      : `Selon votre profil (${quizAnswers.group}) et vos priorités de voyage, ces itinéraires garantissent la meilleure expérience et immersion sur le terrain.`;

    // Switch views
    document.getElementById('quiz-steps-container').classList.add('hidden');
    document.getElementById('quiz-progress-wrapper').classList.add('hidden');
    document.getElementById('quiz-nav-footer').classList.add('hidden');
    document.getElementById('quiz-results-container').classList.remove('hidden');
  }
