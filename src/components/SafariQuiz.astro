  window.selectQuizOption = function(category, value) {
    quizAnswers[category] = value;
    if (currentStep < totalSteps) {
      currentStep++;
      updateQuizView();
    } else {
      calculateAndShowResults();
    }
  };

  window.prevQuizStep = function() {
    if (currentStep > 1) {
      currentStep--;
      updateQuizView();
    }
  };

  window.resetSafariQuiz = function() {
    quizAnswers.profile = '';
    quizAnswers.duration = '';
    quizAnswers.group = '';
    quizAnswers.style = '';
    quizAnswers.dream = '';
    currentStep = 1;
    document.getElementById('quiz-results-container').classList.add('hidden');
    document.getElementById('quiz-steps-container').classList.remove('hidden');
    document.getElementById('quiz-progress-wrapper').classList.remove('hidden');
    document.getElementById('quiz-nav-footer').classList.remove('hidden');
    updateQuizView();
  };

  function updateQuizView() {
    // Show active step
    document.querySelectorAll('.quiz-step').forEach(stepEl => {
      const stepNum = parseInt(stepEl.getAttribute('data-step'));
      if (stepNum === currentStep) {
        stepEl.classList.remove('hidden');
      } else {
        stepEl.classList.add('hidden');
      }
    });

    // Update progress bar
    const percent = Math.round((currentStep / totalSteps) * 100);
    document.getElementById('quiz-step-label').textContent = isEn ? `Question ${currentStep} of ${totalSteps}` : `Question ${currentStep} sur ${totalSteps}`;
    document.getElementById('quiz-step-percent').textContent = `${percent}%`;
    document.getElementById('quiz-progress-bar').style.width = `${percent}%`;

    // Back button visibility
    const backBtn = document.getElementById('quiz-back-btn');
    if (currentStep > 1) {
      backBtn.classList.remove('hidden');
    } else {
      backBtn.classList.add('hidden');
    }
  }

  function calculateAndShowResults() {
    // Score each tour based on user answers
    const isPhotoInterested = (quizAnswers.profile === 'photographer' || quizAnswers.group === 'friends_photo');

    const scoredTours = toursData.map(tour => {
      let score = 0;

      // Photographers boost: guarantee Jungle Extreme as the supreme match
      if (isPhotoInterested && tour.slug === 'jungle-extreme') {
        score += 70;
      }

      if (tour.tags.profile && tour.tags.profile.includes(quizAnswers.profile)) score += 30; // Primary intent
      if (tour.tags.dream && tour.tags.dream.includes(quizAnswers.dream)) score += 25; // Dream focus
      if (tour.tags.duration && tour.tags.duration.includes(quizAnswers.duration)) score += 20; // Time constraint
      if (tour.tags.group && tour.tags.group.includes(quizAnswers.group)) score += 15;
      if (tour.tags.style && tour.tags.style.includes(quizAnswers.style)) score += 15;

      return {
        ...tour,
        calculatedScore: score + (tour.scoreWeight || 0)
      };
    });

    scoredTours.sort((a, b) => b.calculatedScore - a.calculatedScore);
    const topMatches = scoredTours.slice(0, 2);

    // Profile label mapping for summary
