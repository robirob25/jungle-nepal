---
interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';
---

<section id="safari-quiz-section" class="relative py-24 sm:py-32 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-slate-50 via-white to-slate-50/80 border-t border-b border-slate-200/80 overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-5xl h-96 bg-gradient-to-br from-emerald-100/40 via-amber-50/20 to-transparent blur-3xl pointer-events-none"></div>

  <div class="relative max-w-4xl mx-auto">
    
    <!-- SECTION HEADER (Airy & elegant) -->
    <div class="text-center space-y-4 mb-12 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-[#0e8354] text-xs font-black uppercase tracking-wider shadow-xs">
        <svg class="w-3.5 h-3.5 text-[#0e8354]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
        </svg>
        <span>{isEn ? "Interactive Journey Finder" : "Guide de Choix Interactif"}</span>
      </div>

      <h2 class="text-2xl sm:text-4xl lg:text-[40px] font-black tracking-tight text-slate-900 leading-tight">
        {isEn ? "Which journey in Nepal is right for you?" : "Quel voyage au Népal est fait pour vous ?"}
      </h2>
      <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
        {isEn 
          ? "Answer 5 quick questions to discover the exact expeditions matching your dates, travel style, and adventure goals."
          : "Répondez à 5 questions précises pour identifier les expéditions correspondant exactement à votre profil, vos dates et vos envies d'aventure."}
      </p>
    </div>

    <!-- QUIZ CONTAINER BOX (Airy luxury card with generous breathing room) -->
    <div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-12 lg:p-14 shadow-[0_25px_70px_rgba(4,29,19,0.06)] relative ring-1 ring-slate-900/5">
      
      <!-- PROGRESS BAR -->
      <div id="quiz-progress-wrapper" class="mb-10 sm:mb-12 space-y-2.5">
        <div class="flex items-center justify-between text-xs font-bold text-slate-500">
          <span id="quiz-step-label">{isEn ? "Question 1 of 5" : "Question 1 sur 5"}</span>
          <span id="quiz-step-percent" class="text-[#0e8354] font-black">20%</span>
        </div>
        <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden p-0.5 border border-slate-200/60">
          <div id="quiz-progress-bar" class="h-full bg-gradient-to-r from-[#0e8354] to-amber-500 rounded-full transition-all duration-300 w-1/5"></div>
        </div>
      </div>

      <!-- QUESTIONS FORM CONTAINER -->
      <div id="quiz-steps-container">

        <!-- STEP 1: DURATION -->
        <div class="quiz-step space-y-5" data-step="1">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "1. How much time do you have for your journey?" : "1. Quelle durée envisagez-vous pour votre voyage ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <button type="button" onclick="selectQuizOption('duration', 'short')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Short stay (2 to 5 days)" : "Court séjour (2 à 5 jours)"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Express escape to Chitwan, Bardia or Babai from Kathmandu / Pokhara" : "Escapade express à Chitwan, Bardia ou Babai depuis Katmandou"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('duration', 'week')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "One week (6 to 9 days)" : "Une semaine (6 à 9 jours)"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Focused wilderness immersion without wasting transit time" : "Immersion complète en jungle et bivouac sans perte de temps"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('duration', 'classic')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Classic circuit (10 to 14 days)" : "Circuit classique (10 à 14 jours)"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "The optimal duration for tracking, multi-parks, and Mustang" : "Le format idéal pour combiner les parcs, vallées secrètes ou le Mustang"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('duration', 'grand')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Grand expedition (15 to 18 days)" : "Grande immersion (15 à 18 jours)"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Rara Lake, Snow Leopard, wild rafting or full Nepal crossing" : "Expéditions intégrales, lac Rara, panthère des neiges ou rafting"}</div>
            </button>
          </div>
        </div>

        <!-- STEP 2: GROUP PROFILE -->
        <div class="quiz-step hidden space-y-5" data-step="2">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "2. Who will be traveling?" : "2. Quelle est la composition de votre groupe ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <button type="button" onclick="selectQuizOption('group', 'solo')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Solo traveler" : "Voyageur solo"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Join a small shared group (4 to 10 pers) with friendly vibes" : "Rejoindre un petit groupe convivial (4 à 10 pers)"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('group', 'couple')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Couple / Duo" : "Couple / Duo"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Wild romance, charming eco-lodges, and shared nature" : "Ambiance sauvage, lodges de charme et nature partagée"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('group', 'family')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Family with kids / teenagers" : "Famille avec enfants / adolescents"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Accessible wildlife, canoes, Tharu culture, high safety" : "Faune accessible (rhinos, éléphants), pirogue et sécurité"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('group', 'friends_photo')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Friends / Photographers" : "Amis / Photographes"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Extended hides, golden hour patience, and specialized guides" : "Affûts prolongés, silence, patience et lumière dorée"}</div>
            </button>
          </div>
        </div>

        <!-- STEP 3: WILDLIFE & TRIP FOCUS -->
        <div class="quiz-step hidden space-y-5" data-step="3">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "3. What is your primary trip & wildlife focus?" : "3. Quel est l'objectif prioritaire de votre voyage ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-2">
            <button type="button" onclick="selectQuizOption('wildlife', 'tiger')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Bengal Tiger on foot" : "Le Tigre du Bengale à pied"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Pure on-foot tracking and riverbank blinds in Bardia" : "Traque sensorielle et affûts en bord de rivière à Bardia"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('wildlife', 'mix_mountain_jungle')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-emerald-50/50 hover:bg-emerald-100/70 border border-emerald-300 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer ring-1 ring-emerald-500/20">
              <div class="font-extrabold text-[15px] sm:text-base text-[#0e8354] group-hover:text-[#0c6d46] transition-colors leading-snug">{isEn ? "Mountain & Jungle Mix (Trek + Safari)" : "Combiné Montagne & Jungle (Trek + Safari)"}</div>
              <div class="text-xs sm:text-[13px] text-slate-600 mt-1.5 leading-relaxed">{isEn ? "Himalayan alpine lakes & summits combined with wild Terai lowlands" : "Lacs d'altitude & sommets himalayens combinés aux safaris du Teraï"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('wildlife', 'rhino_gentle')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "One-horned Rhinos & Elephants" : "Rhinocéros unicornes & Éléphants"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Gentle riparian safaris and wetlands in Chitwan" : "Immersion accessible dans les marécages de Chitwan"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('wildlife', 'snow_leopard')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Snow Leopard (High Himalayas)" : "La Panthère des neiges (Himalaya)"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "High-altitude winter expedition in Mustang and Dolpo crags" : "Expédition d'altitude dans les falaises du Mustang / Dolpo"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('wildlife', 'river_birds')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer sm:col-span-2 lg:col-span-2">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "River safari (Gharials, Birds & Rafting)" : "Safari aquatique (Oiseaux, Gavials & Rafting)"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Dugout canoes, rafting on the Karnali, rare kingfishers" : "Pirogues traditionnelles, descente de rivière et calaos"}</div>
            </button>
          </div>
        </div>

        <!-- STEP 4: ACCOMMODATION & STYLE -->
        <div class="quiz-step hidden space-y-5" data-step="4">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "4. What accommodation style suits you best?" : "4. Quel type d'hébergement préférez-vous ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <button type="button" onclick="selectQuizOption('style', 'lodge')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Comfortable Eco-lodges" : "100% Lodges & Confort"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Private rooms, warm showers, serene garden relaxation" : "Chambres soignées, douches chaudes et confort après la marche"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('style', 'camping')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Wilderness Jungle Bivouac" : "Bivouac sauvage sous tente"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Campfires and nights along remote riverbanks in Babai" : "Nuits sous tente au bord de la rivière Babai, feu de camp"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('style', 'mixed')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Balanced Mix (Lodge + Bivouac / Refuge)" : "Mix équilibré (Lodge + Bivouac / Refuge)"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "The thrill of wilderness nights backed by lodge recovery" : "Le frisson des nuits en nature avec le confort des lodges"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('style', 'culture_spirit')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Cultural & Spiritual Immersion" : "Immersion culturelle & sérénité"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Homestays in Tharu villages, monasteries, and heritage" : "Maisons d'hôtes traditionnelles, ashram et patrimoine"}</div>
            </button>
          </div>
        </div>

        <!-- STEP 5: PHYSICAL PACE -->
        <div class="quiz-step hidden space-y-5" data-step="5">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "5. What walking pace and physical effort do you desire?" : "5. Quel rythme de marche et effort physique souhaitez-vous ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <button type="button" onclick="selectQuizOption('pace', 'easy')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Accessible to all" : "Accessible à tous"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Gentle strolls, hide lookouts, jeep & canoe transfers" : "Petites marches tranquilles, miradors, pirogues et jeeps"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('pace', 'moderate')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Regular walking (4 to 6 hrs/day)" : "Marche régulière (4 à 6h / jour)"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Active tracking along riverbeds and sal forests on flat terrain" : "Pistage actif en forêt et sur les berges, terrain plat"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('pace', 'adventurous')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Adventurous Jungle Exploration" : "Aventure & Jungle Dense"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Deep jungle bushwalking, river wading, and backwoods exploration" : "Progression en jungle dense, traversée de gués et autonomie"}</div>
            </button>
            <button type="button" onclick="selectQuizOption('pace', 'mountain')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">{isEn ? "Mountain Trekking / High Altitude" : "Trekking Montagne / Altitude"}</div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-1.5 leading-relaxed group-hover:text-slate-700">{isEn ? "Alpine hiking trails, panoramic ridges, passes over 3,000-4,000m" : "Sentiers himalayens, crêtes panoramiques et cols d'altitude"}</div>
            </button>
          </div>
        </div>

      </div>

      <!-- RESULTS CONTAINER (Hidden initially) -->
      <div id="quiz-results-container" class="hidden space-y-8 animate-in fade-in zoom-in-95 duration-300">
        <div class="text-center space-y-3 border-b border-slate-200 pb-8">
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-100 text-[#0e8354] text-xs font-black border border-emerald-300">
            <span>✓</span>
            <span>{isEn ? "Analysis complete" : "Analyse terminée"}</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            {isEn ? "Here are your 2 ideal travel matches:" : "Voici vos 2 séjours recommandés sur-mesure :"}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed" id="quiz-results-summary"></p>
        </div>

        <!-- Matched Tours Cards Grid -->
        <div id="quiz-matched-cards" class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-2"></div>

        <!-- Action Footer -->
        <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-5">
          <button type="button" onclick="resetSafariQuiz()" class="text-xs sm:text-sm font-bold text-slate-500 hover:text-slate-900 transition-colors underline cursor-pointer">
            {isEn ? "← Restart the quiz" : "← Recommencer le test"}
          </button>
          
