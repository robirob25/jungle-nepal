---
interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';
---

<section id="safari-quiz-section" class="relative py-24 sm:py-32 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-slate-50 via-white to-slate-50/80 border-t border-b border-slate-200/80 overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-5xl h-96 bg-gradient-to-br from-emerald-100/40 via-amber-50/20 to-transparent blur-3xl pointer-events-none"></div>

  <div class="relative max-w-4xl mx-auto">
    
    <!-- SECTION HEADER -->
    <div class="text-center space-y-4 mb-12 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-[#0e8354] text-xs font-black uppercase tracking-wider shadow-xs">
        <svg class="w-3.5 h-3.5 text-[#0e8354]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
        </svg>
        <span>{isEn ? "Interactive Journey Finder" : "Guide de choix interactif"}</span>
      </div>

      <h2 class="text-2xl sm:text-4xl lg:text-[40px] font-black tracking-tight text-slate-900 leading-tight">
        {isEn ? "Which journey in Nepal is right for you?" : "Quel voyage au Népal est fait pour vous ?"}
      </h2>
      <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
        {isEn 
          ? "Select your traveler profile and preferences to discover the exact expeditions matching your adventure goals."
          : "Définissez votre profil de voyageur et vos envies pour découvrir les expéditions correspondant exactement à vos attentes."}
      </p>
    </div>

    <!-- QUIZ CONTAINER BOX -->
    <div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-12 lg:p-14 shadow-[0_25px_70px_rgba(4,29,19,0.06)] relative ring-1 ring-slate-900/5">
      
      <!-- PROGRESS BAR -->
      <div id="quiz-progress-wrapper" class="mb-10 sm:mb-12 space-y-2.5">
        <div class="flex items-center justify-between text-xs font-bold text-slate-500">
          <span id="quiz-step-label">{isEn ? "Question 1 of 5" : "Question 1 sur 5"}</span>
          <span id="quiz-step-percent" class="text-[#0e8354] font-black">20%</span>
        </div>
        <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden p-0.5 border border-slate-200/60">
          <div id="quiz-progress-bar" class="h-full bg-gradient-to-r from-[#0e8354] to-amber-500 rounded-full transition-all duration-300 w-1/5"></div>
        </div>
      </div>

      <!-- QUESTIONS FORM CONTAINER -->
      <div id="quiz-steps-container">

        <!-- STEP 1: TRAVELER PROFILE -->
        <div class="quiz-step space-y-5" data-step="1">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "1. Which traveler profile describes you best?" : "1. Quel profil de voyageur vous correspond le mieux ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            
            <button type="button" onclick="selectQuizOption('profile', 'photographer')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Wildlife Photographer" : "Photographe animalier"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Extended hides, golden hour patience, quiet tracking and respect for wildlife" : "Affûts prolongés, lumière dorée, patience, silence et respect du vivant"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('profile', 'adventurer')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Wilderness Adventurer" : "Aventurier & explorateur"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Off the beaten path, pure wilderness immersion, river bivouacs and secluded valleys" : "Hors sentiers battus, immersion sauvage totale, bivouac au bord de l'eau et vallées isolées"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('profile', 'nature_lover')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Nature & Wildlife Enthusiast" : "Amoureux de la faune & découverte"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Gentle & rich observation of iconic wildlife: tigers, rhinos, elephants, colorful birds" : "Observation sereine des animaux emblématiques : tigres, rhinos, éléphants et oiseaux"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('profile', 'mountain_jungle')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Trekker & Mountain-Jungle Explorer" : "Randonneur & grands espaces (trek + safari)"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Combining Himalayan alpine peaks or lakes with untamed lowlands of the Terai" : "Relier les panoramas himalayens et lacs d'altitude aux réserves sauvages du Teraï"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('profile', 'cultural_mindful')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer sm:col-span-2">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Cultural & Mindful Traveler" : "Voyageur contemplatif, culture & sérénité"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Sacred monasteries, authentic Tharu village immersion, serenity, sketching and heritage" : "Monastères sacrés, immersion villageoise Tharu, sérénité, carnet de dessin et patrimoine"}
              </div>
            </button>

          </div>
        </div>

        <!-- STEP 2: DURATION -->
        <div class="quiz-step hidden space-y-5" data-step="2">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "2. How much time do you have for your journey?" : "2. Quelle durée envisagez-vous pour votre voyage ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            
            <button type="button" onclick="selectQuizOption('duration', 'short')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Short stay (2 to 5 days)" : "Court séjour express (2 à 5 jours)"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Concentrated getaway to Chitwan, Bardia or Babai from Kathmandu / Pokhara" : "Escapade concentrée à Chitwan, Bardia ou Babai depuis Katmandou"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('duration', 'week')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "One week (6 to 9 days)" : "Une semaine (6 à 9 jours)"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Focused wilderness immersion without wasting transit time" : "Immersion ciblée et intense en pleine nature sans perte de temps"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('duration', 'classic')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Classic circuit (10 to 14 days)" : "Circuit classique (10 à 14 jours)"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "The optimal duration to combine multiple parks, wildlife and culture" : "Le format idéal pour combiner plusieurs parcs, faune et culture"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('duration', 'grand')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Grand expedition (15+ days)" : "Grande immersion (15 jours et +)"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Grand crossings, Rara Lake, snow leopard expeditions or wild river rafting" : "Grandes traversées, lac Rara, panthère des neiges ou descente en rafting"}
              </div>
            </button>

          </div>
        </div>

        <!-- STEP 3: GROUP PROFILE -->
        <div class="quiz-step hidden space-y-5" data-step="3">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "3. Who will be traveling with you?" : "3. Avec qui partez-vous ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            
            <button type="button" onclick="selectQuizOption('group', 'solo')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Solo traveler" : "Voyageur solo"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Join a friendly small group (4 to 10 pers) or tailored private departure" : "Rejoindre un petit groupe convivial (4 à 10 pers) ou départ sur-mesure"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('group', 'couple')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Couple / Duo" : "En couple ou en duo"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Wild atmosphere, charming eco-lodges and shared natural moments" : "Ambiance sauvage, lodges de charme et nature partagée"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('group', 'family')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Family or Friends" : "En famille ou entre amis"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Accessible wildlife, canoes, high safety, comfort and wonder" : "Faune accessible (rhinos, éléphants), pirogues, sécurité et émerveillement"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('group', 'friends_photo')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Dedicated Photo Group / Passionate Friends" : "Amis passionnés ou photographes"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Sharing the same focus: extended hides, field patience and prime photo spots" : "Partager les mêmes exigences : longues heures d'affût, patience et spots photo"}
              </div>
            </button>

          </div>
        </div>

        <!-- STEP 4: ACCOMMODATION & STYLE -->
        <div class="quiz-step hidden space-y-5" data-step="4">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "4. What accommodation & atmosphere suits you best?" : "4. Quel type d'hébergement et d'ambiance recherchez-vous ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            
            <button type="button" onclick="selectQuizOption('style', 'lodge')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Comfortable Eco-lodges" : "100% éco-lodges de charme"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Private rooms, hot showers, peaceful garden and relaxation after the field" : "Chambres soignées, douches chaudes et détente au jardin après la journée"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('style', 'camping')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Wilderness Jungle Bivouac" : "Bivouac sauvage sous tente"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Campfires and nights along remote riverbanks in Babai" : "Nuits sous tente au bord de la rivière Babai, feu de camp et ciel étoilé"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('style', 'mixed')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Balanced Mix (Lodge + Bivouac)" : "Mix équilibré (lodges + bivouac)"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "The thrill of wilderness nights backed by comfortable lodge recovery" : "Le frisson des nuits en nature avec le confort des lodges"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('style', 'culture_spirit')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Traditional Homestays & Heritage" : "Maisons d'hôtes & sérénité"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Authentic Tharu village homestays, ashrams, temples and rich heritage" : "Maisons d'hôtes traditionnelles Tharu, ashrams et patrimoine"}
              </div>
            </button>

          </div>
        </div>

        <!-- STEP 5: DREAM EXPERIENCE -->
        <div class="quiz-step hidden space-y-5" data-step="5">
          <h3 class="text-lg sm:text-2xl font-black text-slate-900 tracking-tight">
            {isEn ? "5. What is your ultimate dream experience in Nepal?" : "5. Quel grand moment ou animal vous fait le plus vibrer ?"}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            
            <button type="button" onclick="selectQuizOption('dream', 'tiger')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Tracking the Bengal Tiger" : "Pister le tigre du Bengale"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Tracking signs, riverbank hides, and big cat encounters in Bardia" : "Indices de présence, affûts en bord de rivière et rencontre avec le grand félin à Bardia"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('dream', 'snow_leopard')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "The Mythic Snow Leopard" : "La mythique panthère des neiges"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "High-altitude winter quest across the cliffs of Mustang and Dolpo" : "Quête d'altitude dans les falaises sauvages du Mustang et du Dolpo"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('dream', 'rhino_birds')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Rhinos, Wild Elephants & Birdlife" : "Rhinocéros, éléphants & oiseaux tropicaux"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "Wetland safaris, dugout canoes, hornbills and rich Terai biodiversity" : "Marécages de Chitwan, pirogues, calaos et biodiversité foisonnante"}
              </div>
            </button>

            <button type="button" onclick="selectQuizOption('dream', 'river_rafting')" class="quiz-opt-btn p-5 sm:p-6 rounded-2xl bg-slate-50/90 hover:bg-emerald-50/80 border border-slate-200 hover:border-[#0e8354] text-left transition-all duration-200 group shadow-xs hover:shadow-md cursor-pointer">
              <div class="font-extrabold text-[15px] sm:text-base text-slate-900 group-hover:text-[#0e8354] transition-colors leading-snug">
                {isEn ? "Wild Rivers & Untamed Waters" : "Rivières sauvages & rafting (Karnali)"}
              </div>
              <div class="text-xs sm:text-[13px] text-slate-500 mt-2 leading-relaxed group-hover:text-slate-700">
                {isEn ? "River descent through wild canyons, pristine beaches, and rare gharials" : "Descente en rafting au fond de gorges vierges, plages de sable et gavials du Gange"}
              </div>
            </button>

          </div>
        </div>

      </div>

      <!-- RESULTS CONTAINER (Hidden initially) -->
      <div id="quiz-results-container" class="hidden space-y-8 animate-in fade-in zoom-in-95 duration-300">
        <div class="text-center space-y-3 border-b border-slate-200 pb-8">
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-100 text-[#0e8354] text-xs font-black border border-emerald-300">
            <span>✓</span>
            <span>{isEn ? "Analysis complete" : "Analyse terminée"}</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            {isEn ? "Here are your 2 ideal travel matches:" : "Voici vos 2 séjours recommandés sur-mesure :"}
          </h3>
