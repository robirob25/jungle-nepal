---
interface FAQItem {
  question: string;
  answer: string;
}

interface ItineraryDay {
  day: number | string;
  title: string;
  desc?: string;
  description?: string;
}

interface TourOffer {
  price?: string | number;
  priceCurrency?: string;
  availability?: string;
  validFrom?: string;
  url?: string;
}

interface AuthorProps {
  name?: string;
  jobTitle?: string;
  url?: string;
}

interface Props {
  type?: 'TouristTrip' | 'TouristDestination' | 'BlogPosting' | 'FAQPage' | 'Organization' | 'BreadcrumbList';
  // Common / WebPage
  name?: string;
  description?: string;
  url?: string;
  image?: string | string[];
  lang?: 'fr' | 'en';
  // TouristTrip & Destination Props
  touristType?: string[];
  offers?: TourOffer;
  itinerary?: ItineraryDay[];
  ratingValue?: string | number;
  reviewCount?: string | number;
  latitude?: number;
  longitude?: number;
  // BlogPosting Props
  headline?: string;
  datePublished?: string;
  dateModified?: string;
  author?: AuthorProps;
  about?: string[];
  // FAQ Props
  faqs?: FAQItem[];
  // Breadcrumb Props
  breadcrumbs?: { name: string; url: string }[];
}

const {
  type,
  name,
  description,
  url,
  image = 'https://junglenepal.com/assets/original_site/tigre_bardia.webp',
  lang = 'fr',
  touristType = lang === 'en'
    ? ['Wildlife Enthusiasts', 'Nature Photographers', 'Ethical Travelers', 'Small Group Adventurers']
    : ['Amoureux de nature', 'Photographes animaliers', 'Voyageurs éthiques', 'Aventuriers en micro-groupe'],
  offers,
  itinerary = [],
  ratingValue,
  reviewCount,
  latitude,
  longitude,
  headline,
  datePublished,
  dateModified,
  author = {
    name: 'Robin Rozier',
    jobTitle: lang === 'en'
      ? 'Co-founder & Expedition Coordinator at Jungle Nepal Adventure'
      : 'Co-fondateur & Coordinateur des expéditions Jungle Nepal Adventure',
    url: lang === 'en' ? 'https://junglenepal.com/en/about/' : 'https://junglenepal.com/a-propos/'
  },
  about = ['Safari au Népal', 'Parc national de Bardia', 'Tigre du Bengale', 'Parc national de Chitwan', 'Safari éthique à pied'],
  faqs = [],
  breadcrumbs = []
} = Astro.props;

const canonicalOrigin = 'https://junglenepal.com';
const ensureTrailingSlash = (u: string) => {
  if (!u) return `${canonicalOrigin}/`;
  const full = u.startsWith('http') ? u : `${canonicalOrigin}${u.startsWith('/') ? '' : '/'}${u}`;
  if (full.includes('#') || full.includes('?') || /\.[a-z0-9]{2,5}$/i.test(full)) return full;
  return full.endsWith('/') ? full : `${full}/`;
};

const currentUrl = ensureTrailingSlash(url || Astro.url.pathname);
const resolvedImage = Array.isArray(image)
  ? image.map(img => img.startsWith('http') ? img : `${canonicalOrigin}${img.startsWith('/') ? '' : '/'}${img}`)
  : (image.startsWith('http') ? image : `${canonicalOrigin}${image.startsWith('/') ? '' : '/'}${image}`);

// Provider Organization block
const providerOrganization = {
  '@type': 'TravelAgency',
  '@id': `${canonicalOrigin}/#organization`,
  'name': 'Jungle Nepal Adventure',
  'url': `${canonicalOrigin}/`,
  'logo': `${canonicalOrigin}/assets/logo_nav_white.png`,
  'email': 'contact@junglenepal.com',
  'telephone': '+33695413227',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Thakurdwara (Bardia) & Katmandou',
    'addressCountry': 'NP'
  }
};

// 1. TOURIST TRIP SCHEMA
let touristTripSchema = null;
if (type === 'TouristTrip') {
  const cleanPrice = offers?.price ? String(offers.price).replace(/[^0-9]/g, '') : null;

  touristTripSchema = {
    '@context': 'https://schema.org',
    '@type': ['TouristTrip', 'Product'],
    'name': name || headline,
    'description': description,
    'image': resolvedImage,
    'touristType': touristType,
    'provider': providerOrganization,
    'brand': {
      '@type': 'Brand',
      'name': 'Jungle Nepal Adventure'
    },
    ...(cleanPrice ? {
      'offers': {
        '@type': 'Offer',
        'price': cleanPrice,
        'priceCurrency': offers?.priceCurrency || 'EUR',
        'availability': offers?.availability || 'https://schema.org/InStock',
        'validFrom': offers?.validFrom || '2026-01-01',
        'priceValidUntil': '2027-12-31',
        'url': ensureTrailingSlash(offers?.url || currentUrl),
        'hasMerchantReturnPolicy': {
          '@type': 'MerchantReturnPolicy',
          'applicableCountry': 'FR',
          'returnPolicyCountry': 'FR',
          'returnPolicyCategory': 'https://schema.org/MerchantReturnFiniteReturnWindow',
          'merchantReturnDays': 30,
          'merchantReturnLink': `${canonicalOrigin}/mentions-legales/`
        }
      }
    } : {}),
    ...(itinerary && itinerary.length > 0 ? {
      'itinerary': {
        '@type': 'ItemList',
        'numberOfItems': itinerary.length,
        'itemListElement': itinerary.map((item, idx) => ({
          '@type': 'ListItem',
          'position': idx + 1,
          'item': {
            '@type': 'TouristAttraction',
            'name': item.title || `Jour ${item.day}`,
            'description': item.desc || item.description || ''
          }
        }))
      }
    } : {}),
    ...(ratingValue ? {
      'aggregateRating': {
        '@type': 'AggregateRating',
        'ratingValue': String(ratingValue),
        'reviewCount': String(reviewCount || '25'),
        'bestRating': '5'
      }
    } : {})
  };
}

// 1B. TOURIST DESTINATION & PILLAR WEBPAGE SCHEMA
let touristDestinationSchema = null;
if (type === 'TouristDestination') {
  touristDestinationSchema = {
    '@context': 'https://schema.org',
    '@type': ['TouristDestination', 'Product'],
    'name': name || headline,
    'description': description,
    'url': currentUrl,
    'image': resolvedImage,
    'touristType': touristType,
    'brand': {
      '@type': 'Brand',
      'name': 'Jungle Nepal Adventure'
    },
    ...(latitude && longitude ? {
      'geo': {
        '@type': 'GeoCoordinates',
        'latitude': latitude,
        'longitude': longitude
      }
    } : {}),
    'offers': {
      '@type': 'AggregateOffer',
      'lowPrice': '50',
      'highPrice': '2490',
      'priceCurrency': 'EUR',
      'offerCount': '18',
      'availability': 'https://schema.org/InStock',
      'url': currentUrl
    },
    'aggregateRating': {
      '@type': 'AggregateRating',
      'ratingValue': String(ratingValue || '5.0'),
      'reviewCount': String(reviewCount || '25'),
      'bestRating': '5'
    },
    'about': about.map(term => ({
      '@type': 'Thing',
      'name': term
    }))
  };
}

// 2. BLOG POSTING SCHEMA
let blogPostingSchema = null;
if (type === 'BlogPosting') {
  blogPostingSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    'headline': headline || name,
    'description': description,
    'image': Array.isArray(resolvedImage) ? resolvedImage : [resolvedImage],
    'datePublished': datePublished,
    'dateModified': dateModified || datePublished,
    'inLanguage': lang === 'en' ? 'en-US' : 'fr-FR',
    'author': {
      '@type': 'Person',
      'name': author.name || 'Robin Rozier',
      'jobTitle': author.jobTitle || (lang === 'en' ? 'Co-founder & Expedition Coordinator at Jungle Nepal Adventure' : 'Co-fondateur & Coordinateur des expéditions Jungle Nepal Adventure'),
      'url': ensureTrailingSlash(author.url || (lang === 'en' ? '/en/about/' : '/a-propos/'))
    },
    'reviewedBy': {
      '@type': 'Person',
      'name': 'Pawan',
      'jobTitle': lang === 'en'
        ? 'Senior Naturalist & Founder of Bardia Nature Guide Association (NAGA), BBC Collaborator'
        : 'Maître pisteur naturaliste senior à Bardia, fondateur de la NAGA & collaborateur BBC',
      'url': ensureTrailingSlash(lang === 'en' ? '/en/conservation/' : '/conservation/')
    },
    'publisher': {
      '@type': 'Organization',
      'name': 'Jungle Nepal Adventure',
      'url': `${canonicalOrigin}/`,
      'logo': {
        '@type': 'ImageObject',
        'url': `${canonicalOrigin}/assets/logo_nav_white.png`
      }
    },
    'mainEntityOfPage': {
      '@type': 'WebPage',
      '@id': currentUrl
    },
    'about': about.map(term => ({
      '@type': 'Thing',
      'name': term
    }))
  };
}

// 3. FAQ PAGE SCHEMA
let faqPageSchema = null;
if (faqs && faqs.length > 0) {
  faqPageSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faqs.map(faq => ({
      '@type': 'Question',
      'name': faq.question,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': faq.answer
      }
    }))
  };
}

// 4. BREADCRUMB SCHEMA
let breadcrumbSchema = null;
if (breadcrumbs && breadcrumbs.length > 0) {
  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': breadcrumbs.map((crumb, idx) => ({
      '@type': 'ListItem',
      'position': idx + 1,
      'name': crumb.name,
      'item': ensureTrailingSlash(crumb.url)
    }))
  };
}
---

{touristTripSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(touristTripSchema)} />
)}

{touristDestinationSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(touristDestinationSchema)} />
)}

{blogPostingSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
)}

{faqPageSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
)}

{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
