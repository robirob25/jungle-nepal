---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const isEn = currentLang === 'en';

const prefix = isEn ? '/en' : '';
---

<footer class="bg-[#040d08] text-slate-300 pt-16 sm:pt-20 pb-12 border-t border-emerald-950/60 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 5 Balanced Columns Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 sm:gap-10 pb-14 border-b border-white/10 text-xs">
      
      <!-- COL 1: Brand & Official Legal Details -->
      <div class="space-y-4 lg:col-span-1">
        <a href={isEn ? "/en/" : "/"} class="inline-block">
          <img decoding="async" src="/assets/logo_nav_white.webp" alt="Jungle Nepal Adventure" class="h-12 w-auto object-contain hover:scale-105 transition-transform duration-300"/>
        </a>
        <p class="text-slate-400 text-xs leading-relaxed">
          {isEn 
            ? "Jungle Nepal Adventure, independent travel advisor, member of Collectif My Way. Immersive wildlife safaris & high-end eco-tourism in Nepal."
            : "Jungle Nepal Adventure, conseiller voyage indépendant, membre du Collectif My Way. Safaris animaliers immersifs & écotourisme d'exception au Népal."}
        </p>
        
        <!-- Official Collectif MyWay Live Verification Badge -->
        <div class="pt-1 pb-1">
          <a href="https://v2.welcome.collectifmyway.com/verification/jungle-nepal-adventure" target="_blank" rel="noopener noreferrer" class="inline-block hover:opacity-95 hover:scale-[1.02] transition-all duration-300 rounded-xl overflow-hidden shadow-lg border border-white/15 focus:outline-none focus:ring-2 focus:ring-amber-400/50" title={isEn ? "Official Collectif MyWay Member Verification" : "Vérification officielle Membre du Collectif MyWay"}>
            <img src="https://api.collectifmyway.com/v1/api/welcome/members/jungle-nepal-adventure/badge.svg" alt={isEn ? "Collectif MyWay Member" : "Membre du Collectif MyWay"} width="240" height="56" loading="lazy" class="w-full max-w-[210px] h-auto object-contain block" />
          </a>
        </div>

        <div class="pt-1 space-y-2">
          <a href="https://wa.me/33695413227" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-emerald-900/30 hover:bg-emerald-800/40 text-emerald-400 font-bold text-xs border border-emerald-700/40 transition-colors whitespace-nowrap">
            <svg class="w-3.5 h-3.5 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            <span>WhatsApp : +33 6 95 41 32 27</span>
          </a>
          <p class="text-slate-400">Email : <strong class="text-white font-medium">junglenepaladventure@gmail.com</strong></p>
        </div>
        <div class="pt-2 text-[11px] text-slate-400 space-y-1 font-medium border-t border-white/10">
          <p class="font-bold text-slate-200">{isEn ? "Local DMC Partner in Nepal:" : "Réceptif local au Népal :"}</p>
          <p class="text-slate-300 font-semibold">Jungle Nepal Adventure Pvt. Ltd.</p>
          <p>{isEn ? "Registration" : "Immatriculation"} : <strong class="text-slate-200 font-mono">N° 384414/82/83</strong></p>
          <p>{isEn ? "Tax ID" : "Numéro fiscal"} : <strong class="text-slate-200 font-mono">623537310</strong></p>
          <p>Thakurdwara-09, Bardia, Népal</p>
        </div>
      </div>

      <!-- COL 2: Circuits & Voyages Immersifs -->
      <div class="space-y-3">
        <h4 class="font-black text-white text-xs uppercase tracking-widest border-b border-white/10 pb-2">
          {isEn ? "Immersive Tours (16)" : "Circuits Immersifs (16)"}
        </h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href={`${prefix}/tours/bardia-explorateur`} class="hover:text-slate-200 transition-colors">{isEn ? "Bardia Explorer (5d)" : "Bardia Explorateur (5j)"}</a></li>
          <li><a href={`${prefix}/tours/chitwan-culture`} class="hover:text-slate-200 transition-colors">{isEn ? "Chitwan & Jungle (4d)" : "Chitwan & Jungle (4j)"}</a></li>
          <li><a href={`${prefix}/tours/nepal-sauvage`} class="hover:text-slate-200 transition-colors">{isEn ? "Wild Nepal 360° (15d)" : "Népal Sauvage 360° (15j)"}</a></li>
          <li><a href={`${prefix}/tours/babai-special`} class="hover:text-slate-200 transition-colors">{isEn ? "Babai Tiger Special (5d)" : "Babai Spécial Tigres (5j)"}</a></li>
          <li><a href={`${prefix}/tours/bardia-babai-camping`} class="hover:text-slate-200 transition-colors">{isEn ? "Bardia Babai Bivouac (8d)" : "Bardia Babai Bivouac (8j)"}</a></li>
          <li><a href={`${prefix}/tours/rafting-safari`} class="hover:text-slate-200 transition-colors">{isEn ? "Karnali Rafting & Safari (18d)" : "Rafting Karnali & Safari (18j)"}</a></li>
          <li><a href={`${prefix}/tours/panthere-des-neiges`} class="hover:text-slate-200 transition-colors">{isEn ? "Snow Leopard (17d)" : "Panthère des neiges (17j)"}</a></li>
          <li class="pt-1.5"><a href={isEn ? "/en/#prochains-departs" : "/#prochains-departs"} class="text-amber-100 font-bold hover:underline flex items-center gap-1"><span>{isEn ? "View 16 tours" : "Voir les 16 circuits"}</span><span>→</span></a></li>
        </ul>

        <!-- Activités 1 jour sous-bloc -->
        <h4 class="font-black text-white text-xs uppercase tracking-widest border-b border-white/10 pb-2 pt-3">
          {isEn ? "Activities (1 Day)" : "Activités (1 Jour)"}
        </h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href={`${prefix}/tours/safari-pied-bardia`} class="hover:text-slate-200 transition-colors">{isEn ? "Walking Safari Bardia" : "Safari à pied Bardia (50€)"}</a></li>
          <li><a href={`${prefix}/tours/safari-jeep-bardia`} class="hover:text-slate-200 transition-colors">{isEn ? "Jeep Safari Bardia" : "Safari Jeep Bardia (190€)"}</a></li>
          <li><a href={`${prefix}/tours/rafting-safari-bardia`} class="hover:text-slate-200 transition-colors">{isEn ? "Rafting Safari Bardia" : "Rafting Safari Bardia (190€)"}</a></li>
          <li><a href={`${prefix}/tours/safari-pied-chitwan`} class="hover:text-slate-200 transition-colors">{isEn ? "Walking Safari Chitwan" : "Safari à pied Chitwan (70€)"}</a></li>
          <li><a href={`${prefix}/tours/safari-jeep-chitwan`} class="hover:text-slate-200 transition-colors">{isEn ? "Jeep Safari Chitwan" : "Safari Jeep Chitwan (190€)"}</a></li>
          <li class="pt-1"><a href={isEn ? "/en/#activites" : "/#activites"} class="text-emerald-400 font-bold hover:underline flex items-center gap-1"><span>{isEn ? "View all activities" : "Voir les 5 activités"}</span><span>→</span></a></li>
        </ul>
      </div>

      <!-- COL 3: Destinations -->
      <div class="space-y-3">
        <h4 class="font-black text-white text-xs uppercase tracking-widest border-b border-white/10 pb-2">
          Destinations
        </h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href={`${prefix}/destinations/bardia`} class="hover:text-slate-200 transition-colors">{isEn ? "Bardia National Park" : "Parc national de Bardia"}</a></li>
          <li><a href={`${prefix}/destinations/chitwan`} class="hover:text-slate-200 transition-colors">{isEn ? "Chitwan National Park" : "Parc national de Chitwan"}</a></li>
          <li><a href={`${prefix}/destinations/suklaphanta`} class="hover:text-slate-200 transition-colors">{isEn ? "Suklaphanta National Park" : "Parc national de Suklaphanta"}</a></li>
          <li><a href={`${prefix}/destinations/annapurna`} class="hover:text-slate-200 transition-colors">{isEn ? "Annapurna & Pokhara" : "Les Annapurna & Pokhara"}</a></li>
          <li><a href={`${prefix}/destinations/katmandou`} class="hover:text-slate-200 transition-colors">{isEn ? "Kathmandu Valley" : "Katmandou"}</a></li>
          <li class="pt-1.5"><a href={`${prefix}/destinations`} class="text-amber-100 font-bold hover:underline flex items-center gap-1"><span>{isEn ? "All Destinations" : "Toutes les destinations"}</span><span>→</span></a></li>
        </ul>
      </div>

      <!-- COL 4: Navigation -->
      <div class="space-y-3">
        <h4 class="font-black text-white text-xs uppercase tracking-widest border-b border-white/10 pb-2">
          Navigation
        </h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href={isEn ? "/en/#pisteurs" : "/#pisteurs"} class="hover:text-slate-200 transition-colors">{isEn ? "Our Guides" : "Nos guides"}</a></li>
          <li><a href={isEn ? "/en/#galerie-faune" : "/#galerie-faune"} class="hover:text-slate-200 transition-colors">{isEn ? "Wildlife Gallery" : "Galerie faune"}</a></li>
          <li><a href={isEn ? "/en/about" : "/a-propos"} class="hover:text-slate-200 transition-colors">{isEn ? "About Us" : "À propos"}</a></li>
          <li><a href={`${prefix}/blog`} class="hover:text-slate-200 transition-colors">Blog</a></li>
          <li><a href={isEn ? "/en/legal-mentions" : "/mentions-legales"} class="hover:text-slate-200 transition-colors">{isEn ? "Legal Mentions" : "Mentions légales"}</a></li>
          <li><a href={`${prefix}/contact`} class="hover:text-slate-200 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- COL 5: Contact & Réservation -->
      <div class="space-y-3">
        <h4 class="font-black text-white text-xs uppercase tracking-widest border-b border-white/10 pb-2">
          {isEn ? "Contact & Booking" : "Contact & Réservation"}
        </h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href={`${prefix}/contact`} class="hover:text-slate-200 transition-colors">{isEn ? "Custom Quote Request" : "Demande de devis sur-mesure"}</a></li>
          <li><a href="https://wa.me/33695413227" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 transition-colors">{isEn ? "Contact Robin on WhatsApp" : "Contacter Robin sur WhatsApp"}</a></li>
        </ul>
        <div class="pt-3 border-t border-white/10 text-slate-400 text-xs space-y-1">
          <p class="text-slate-200 font-bold">{isEn ? "Small groups 4 to 10 max" : "Micro-groupes 4 à 10 pers."}</p>
          <p class="text-slate-400">{isEn ? "100% Native Trackers" : "100% Pisteurs natifs"}</p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar with Official Legal Certifications -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="space-y-1.5 text-center md:text-left max-w-3xl">
        <p class="font-bold text-slate-200">© 2026 Jungle Nepal Adventure. {isEn ? "All rights reserved." : "Tous droits réservés."}</p>
        <p class="text-[11px] text-slate-300 leading-relaxed">
          {isEn 
            ? "Jungle Nepal Adventure, independent travel advisor, member of Collectif My Way. Trips are sold by MYWAY SAS, registered travel operator Atout France IM059190009."
            : "Jungle Nepal Adventure, conseiller voyage indépendant, membre du Collectif My Way. Les séjours sont vendus par MYWAY SAS, opérateur de voyages immatriculé Atout France IM059190009."}
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-3 sm:gap-4 text-xs shrink-0">
        <button onclick="openLegalModal()" class="text-slate-200 hover:text-white font-bold transition-colors cursor-pointer flex items-center gap-1.5 bg-emerald-950/80 hover:bg-emerald-900/60 px-3.5 py-1.5 rounded-xl border border-emerald-700/40">
          <span>{isEn ? "Official Licenses & Accreditations" : "Agréments & Licences officielles"}</span>
        </button>
        <span>•</span>
        <a href={isEn ? "/en/legal-mentions" : "/mentions-legales"} class="hover:text-white transition-colors">{isEn ? "Legal Mentions" : "Mentions légales"}</a>
        <span>•</span>
        <a href={isEn ? "/en/about" : "/a-propos"} class="hover:text-white transition-colors">{isEn ? "About" : "À propos"}</a>
        <span>•</span>
        <a href={`${prefix}/contact`} class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>

  </div>
</footer>

<!-- MODAL AGRÉMENTS LÉGAUX ET LICENCES OFFICIELLES DU NÉPAL & MYWAY -->
<div id="legal-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/85 backdrop-blur-md p-4 transition-opacity duration-300">
  <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl border border-slate-200 text-slate-900 relative max-h-[90vh] overflow-y-auto font-sans">
    <button onclick="closeLegalModal()" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 hover:text-slate-800 font-bold transition-colors cursor-pointer" aria-label="Fermer">✕</button>
    
    <div class="text-center space-y-2 pb-4 border-b border-slate-100">
      <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#0e8354] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
        {isEn ? "Regulatory Framework & Accreditations" : "Cadre Réglementaire & Agréments"}
      </span>
      <h3 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">Jungle Nepal Adventure</h3>
      <p class="text-xs text-slate-500 font-medium">
        {isEn ? "Independent travel advisor & licensed local tour operator partner" : "Conseiller voyage indépendant membre du Collectif My Way & réceptif local au Népal"}
      </p>
    </div>

    <div class="py-5 space-y-3.5 text-xs text-slate-700">
      
      <!-- MyWay SAS Box -->
      <div class="p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200 space-y-1.5 text-slate-800">
        <div class="flex items-center justify-between">
          <span class="font-bold text-slate-600 uppercase text-[10px]">{isEn ? "Official Licensed Tour Operator (Seller)" : "Opérateur de voyages officiel (Vendeur)"}</span>
          <span class="font-black text-[#0e8354] bg-emerald-100 px-2 py-0.5 rounded text-[10px]">Atout France</span>
        </div>
        <p class="text-slate-950 font-black text-sm">MYWAY SAS</p>
        <p class="font-mono text-xs font-bold text-slate-800">{isEn ? "Atout France License: IM059190009 · SIRET 85137544400011" : "Licence Atout France : IM059190009 · SIRET 85137544400011"}</p>
        <p class="text-[11px] text-slate-600">{isEn ? "Financial Guarantee: GROUPAMA ASSURANCE-CRÉDIT & CAUTION · Professional Civil Liability: GENERALI IARD." : "Garantie financière : Groupama Assurance-Crédit & Caution · RCP : Generali IARD."}</p>
        <p class="text-[11px] text-slate-600">{isEn ? "Robin Rozier / Jungle Nepal Adventure operates as an independent travel advisor, member of Collectif My Way, acting as a business introducer for MYWAY SAS." : "Robin Rozier / Jungle Nepal Adventure intervient en qualité de conseiller voyage indépendant et apporteur d'affaires membre du Collectif My Way."}</p>
        <div class="pt-2">
          <a href="https://v2.welcome.collectifmyway.com/verification/jungle-nepal-adventure" target="_blank" rel="noopener noreferrer" class="inline-block hover:opacity-90 hover:scale-[1.02] transition-all rounded-lg overflow-hidden border border-slate-300">
            <img src="https://api.collectifmyway.com/v1/api/welcome/members/jungle-nepal-adventure/badge.svg" alt={isEn ? "Collectif MyWay Member" : "Membre du Collectif MyWay"} width="200" height="47" loading="lazy" class="h-8 w-auto object-contain block" />
          </a>
        </div>
      </div>

      <!-- Local DMC Incorporation -->
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-bold text-slate-500 uppercase text-[10px]">{isEn ? "Local DMC Partner in Nepal" : "Réceptif local au Népal"}</span>
          <span class="font-black text-[#0e8354] bg-emerald-100/60 px-2 py-0.5 rounded text-[10px]">{isEn ? "Official" : "Officiel"}</span>
        </div>
        <p class="text-slate-900 font-black text-sm">Jungle Nepal Adventure Pvt. Ltd.</p>
        <p class="font-mono text-xs font-bold text-slate-700">{isEn ? "Registration No: 384414/82/83 · PAN: 623537310" : "N° d'enregistrement : 384414/82/83 · PAN : 623537310"}</p>
        <p class="text-[11px] text-slate-500">{isEn ? "Registered & licensed by the Ministry of Industry and Nepal Tourism Board. Leadership: Pawan Thapa (Lead Tracker) & Kiran Pokhrel." : "Agréé par le Ministère de l'Industrie et le Conseil du Tourisme du Népal. Direction : Pawan Thapa (Chef pisteur) & Kiran Pokhrel."}</p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
        <span class="font-bold text-slate-500 uppercase text-[10px] block">{isEn ? "Independent Travel Advisor (France)" : "Conseiller Voyage Indépendant France"}</span>
        <p class="font-bold text-slate-900 text-xs">Robin Rozier — Jungle Nepal Adventure ({isEn ? "Sole Proprietorship" : "Autoentreprise"})</p>
        <p class="font-mono text-xs text-slate-700">SIRET 91025797100010 · RCS BESANCON</p>
        <p class="text-[11px] text-slate-500">4 rue guy moquet, 66310 Estagel, France · junglenepaladventure@gmail.com</p>
      </div>

    </div>

    <div class="pt-2">
      <button onclick="closeLegalModal()" class="w-full py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition-colors cursor-pointer">
        {isEn ? "Close Legal Information" : "Fermer les informations légales"}
      </button>
    </div>
  </div>
</div>

<script is:inline>
if (!window.openLegalModal) {
  window.openLegalModal = function() {
    var m = document.getElementById('legal-modal');
    if (m) m.classList.remove('hidden');
  };
}
if (!window.closeLegalModal) {
  window.closeLegalModal = function() {
    var m = document.getElementById('legal-modal');
    if (m) m.classList.add('hidden');
  };
}
</script>
