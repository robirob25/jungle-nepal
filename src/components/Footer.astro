---
interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';

const homeUrl = isEn ? '/en' : '/';
const toursPrefix = isEn ? '/en/tours/' : '/tours/';
const destPrefix = isEn ? '/en/destinations/' : '/destinations/';
const destIndex = isEn ? '/en/destinations' : '/destinations';
const toursIndex = isEn ? '/en#prochains-departs' : '/#prochains-departs';
const aboutUrl = isEn ? '/en/a-propos' : '/a-propos';
const contactUrl = isEn ? '/en/contact' : '/contact';
const conceptUrl = isEn ? '/en#concept' : '/#concept';
const trackersUrl = isEn ? '/en#pisteurs' : '/#pisteurs';
const reviewsUrl = isEn ? '/en#avis' : '/#avis';
const faqUrl = isEn ? '/en#faq' : '/#faq';
---

<footer class="bg-slate-950 text-slate-300 pt-16 sm:pt-20 pb-12 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 sm:gap-10 pb-14 border-b border-white/10 text-xs">
      
      <!-- COL 1: Brand & Contact -->
      <div class="space-y-4 lg:col-span-1">
        <a href={homeUrl} class="inline-block">
          <img src="/assets/logo_nav_white.webp" alt="Jungle Nepal Adventure" class="h-11 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform"/>
        </a>
        <p class="text-slate-400 text-xs leading-relaxed">
          {isEn ? 'Local travel agency specializing in immersive wildlife safaris and ethical nature expeditions in Nepal.' : "Agence locale d'écotourisme d'exception et de safaris immersifs au Népal. Katmandou & Parc National de Bardia."}
        </p>
        <div class="pt-2 space-y-2">
          <a href="https://wa.me/33695413227" target="_blank"  target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/10 text-slate-200 font-bold text-xs hover:bg-emerald-900/30 transition-colors border border-white/10" whitespace-nowrap"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg><span class="whitespace-nowrap">WhatsApp : +33 6 95 41 32 27</span></a>
          <p class="text-slate-400">Email : <strong class="text-white">contact@junglenepal.com</strong></p>
        </div>
          <div class="pt-2.5 text-[11px] text-slate-400 space-y-1 font-medium border-t border-white/10 mt-3">
            <p class="font-bold text-slate-200">Jungle Nepal Adventure Pvt. Ltd.</p>
            <p>Immatriculation d'État : <strong class="text-slate-200 font-mono">N° 384414/82/83</strong></p>
            <p>Numéro fiscal (PAN) : <strong class="text-slate-200 font-mono">623537310</strong></p>
            <p>Thakurdwara-09, Parc National de Bardia, Népal</p>
          </div>
      </div>

      <!-- COL 2: Nos 15 Séjours -->
      <div class="space-y-3">
        <h4 class="font-black text-white text-xs uppercase tracking-widest border-b border-white/10 pb-2">
          {isEn ? 'Expeditions' : 'Nos 15 Séjours'}
        </h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href={`${toursPrefix}bardia-explorateur`} class="hover:text-slate-200 transition-colors">{isEn ? 'Bardia Explorer (5d)' : 'Bardia Explorateur (5j)'}</a></li>
          <li><a href={`${toursPrefix}chitwan-culture`} class="hover:text-slate-200 transition-colors">{isEn ? 'Chitwan & Wildlife (4d)' : 'Chitwan & Jungle (4j)'}</a></li>
          <li><a href={`${toursPrefix}nepal-sauvage`} class="hover:text-slate-200 transition-colors">{isEn ? 'Wild Nepal 360° (15d)' : 'Népal Sauvage 360° (15j)'}</a></li>
          <li><a href={`${toursPrefix}babai-special`} class="hover:text-slate-200 transition-colors">{isEn ? 'Babai Tiger Special (5d)' : 'Babai Spécial Tigres (5j)'}</a></li>
          <li><a href={`${toursPrefix}bardia-babai-camping`} class="hover:text-slate-200 transition-colors">{isEn ? 'Babai Wild Bivouac (8d)' : 'Bardia Babai Bivouac (8j)'}</a></li>
          <li><a href={`${toursPrefix}rafting-safari`} class="hover:text-slate-200 transition-colors">{isEn ? 'Karnali Rafting & safari (18d)' : 'Rafting Karnali & Safari (18j)'}</a></li>
          <li><a href={`${toursPrefix}tiji-mustang`} class="hover:text-slate-200 transition-colors">{isEn ? 'Tiji Festival Mustang (13d)' : 'Tiji Festival Mustang (13j)'}</a></li>
          <li><a href={`${toursPrefix}nepal-immersion-totale`} class="hover:text-slate-200 transition-colors">{isEn ? 'Nepal Total Immersion (14d)' : 'Népal Immersion Totale (14j)'}</a></li>
          <li class="pt-1"><a href={toursIndex} class="text-amber-100 font-bold hover:underline">{isEn ? 'View all 15 trips →' : 'Voir les 15 séjours →'}</a></li>
        </ul>
      </div>

      <!-- COL 3: Destinations -->
      <div class="space-y-3">
        <h4 class="font-black text-white text-xs uppercase tracking-widest border-b border-white/10 pb-2">Destinations</h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href={`${destPrefix}bardia`} class="hover:text-slate-200 transition-colors">{isEn ? 'Bardia National Park' : 'Parc national de Bardia'}</a></li>
          <li><a href={`${destPrefix}chitwan`} class="hover:text-slate-200 transition-colors">{isEn ? 'Chitwan National Park' : 'Parc national de Chitwan'}</a></li>
          <li><a href={`${destPrefix}suklaphanta`} class="hover:text-slate-200 transition-colors">{isEn ? 'Suklaphanta Wildlife' : 'Parc de Suklaphanta'}</a></li>
          <li><a href={`${destPrefix}annapurna`} class="hover:text-slate-200 transition-colors">{isEn ? 'Annapurna Range & Pokhara' : 'Les Annapurna & Pokhara'}</a></li>
          <li><a href={`${destPrefix}katmandou`} class="hover:text-slate-200 transition-colors">{isEn ? 'Kathmandu Valley' : 'Vallée de Katmandou'}</a></li>
          <li class="pt-1"><a href={destIndex} class="text-amber-100 font-bold hover:underline">{isEn ? 'All Destinations →' : 'Toutes les destinations →'}</a></li>
        </ul>
      </div>

      <!-- COL 4: L'Agence & Esprit Safari -->
      <div class="space-y-3">
        <h4 class="font-black text-white text-xs uppercase tracking-widest border-b border-white/10 pb-2">
          {isEn ? 'The Experience' : "L'Expérience"}
        </h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href={conceptUrl} class="hover:text-slate-200 transition-colors">{isEn ? 'Safari Philosophy' : "L'esprit safari (Concept)"}</a></li>
          <li><a href={trackersUrl} class="hover:text-slate-200 transition-colors">{isEn ? 'Master Trackers (Pawan & Kiran)' : 'Maîtres pisteurs (Pawan & Kiran)'}</a></li>
          <li><a href={aboutUrl} class="hover:text-slate-200 transition-colors">{isEn ? 'Our Story & Mission' : 'Notre histoire & Équipe'}</a></li>
          <li><a href={reviewsUrl} class="hover:text-slate-200 transition-colors">{isEn ? 'Traveler Reviews (5.0/5 )' : 'Avis voyageurs (5.0/5 )'}</a></li>
          <li><a href={faqUrl} class="hover:text-slate-200 transition-colors">{isEn ? 'FAQ & Travel Guide' : 'Foire aux questions (FAQ)'}</a></li>
        </ul>
      </div>

      <!-- COL 5: Réservation & Contact -->
      <div class="space-y-3">
        <h4 class="font-black text-white text-xs uppercase tracking-widest border-b border-white/10 pb-2">
          {isEn ? 'Plan Your Trip' : 'Contact & Devis'}
        </h4>
        <ul class="space-y-2 text-slate-400">
          <li><a href={contactUrl} class="hover:text-slate-200 transition-colors">{isEn ? 'Custom Quote Request' : 'Demande de devis sur-mesure'}</a></li>
          <li><a href="https://wa.me/33695413227" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 transition-colors">{isEn ? 'Chat with Robin on WhatsApp' : 'Échanger sur WhatsApp avec Robin'}</a></li>
          <li class="pt-2 text-slate-500 font-medium">
            <span class="block text-slate-200 font-bold">{isEn ? 'Micro-groups 4 to 10' : 'Micro-groupes 4 à 10'}</span>
            <span>{isEn ? '100% Native trackers' : '100% Pisteurs natifs'}</span>
          </li>
        </ul>
      </div>

    </div>

          <!-- Bottom Bar with Official Legal Certifications -->
      <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
        <div class="space-y-1 text-center md:text-left">
          <p>© 2026 Jungle Nepal Adventure Pvt. Ltd. Tous droits réservés.</p>
          <p class="text-[11px] text-slate-400">Agence locale officielle agréée par le Ministère de l'Industrie et du Tourisme du Népal • Reg. 384414/82/83 • PAN 623537310</p>
        </div>
        <div class="flex items-center gap-4 text-xs">
          <button onclick="openLegalModal()" class="text-slate-200 hover:text-slate-200 font-bold transition-colors cursor-pointer flex items-center gap-1.5 bg-emerald-900/10 px-3 py-1.5 rounded-xl border border-emerald-800/20">
            
            <span>Agréments & Licences officielles</span>
          </button>
          <span>•</span>
          <a href="/a-propos.html" class="hover:text-white transition-colors">À propos</a>
          <span>•</span>
          <a href="/contact.html" class="hover:text-white transition-colors">Contact</a>
        </div>
      </div>

    </div>
  </footer>
