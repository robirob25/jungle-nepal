---
interface Props {
  tourId: string;
  tourTitle: string;
  tourBadge?: string;
  duration?: string;
  pricingType: 'per_person' | 'fixed_group';
  basePrice: number;
  allowsPawanRoom?: boolean;
  maxTravelers?: number;
  lang?: 'fr' | 'en';
  locationName?: string;
}

const {
  tourId,
  tourTitle,
  tourBadge = "Activité à la journée",
  duration = "1 jour (6h30 – 18h00)",
  pricingType,
  basePrice,
  allowsPawanRoom = false,
  maxTravelers = 8,
  lang = 'fr',
  locationName = 'Bardia'
} = Astro.props;

const isEn = lang === 'en';
---

<div 
  class="day-tour-booking-widget bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/90 shadow-xl space-y-4 relative overflow-hidden" 
  data-tour-id={tourId}
  data-tour-title={tourTitle}
  data-pricing-type={pricingType}
  data-base-price={basePrice}
  data-allows-pawan={allowsPawanRoom ? "true" : "false"}
  data-max-travelers={maxTravelers}
  data-lang={lang}
  data-location={locationName}
>
  <!-- Ambient background glow -->
  <div class="absolute -top-12 -right-12 w-40 h-40 bg-emerald-500/5 rounded-full blur-2xl pointer-events-none"></div>

  <!-- Header: Title & Duration -->
  <div>
    <h3 class="font-black text-lg sm:text-xl text-slate-950 leading-snug tracking-tight">
      {tourTitle}
    </h3>
    <p class="text-xs text-slate-500 font-semibold mt-1">
      {duration} • {isEn ? "Departure from your hotel" : "Prise en charge à votre hôtel"}
    </p>
  </div>

  <!-- Price Banner -->
  <div class="pt-3 border-t border-slate-100 flex items-baseline justify-between">
    <div>
      <p class="text-[10px] font-extrabold uppercase text-slate-400 tracking-wider">
        {pricingType === 'per_person' ? (isEn ? "Price per traveler" : "Tarif par personne") : (isEn ? "Fixed group price" : "Tarif forfait privatisé")}
      </p>
      <div class="flex items-baseline gap-2">
        <span class="widget-base-price-display font-black text-3xl sm:text-4xl text-slate-950 tracking-tight">
          {basePrice}€
        </span>
        <span class="text-xs text-slate-500 font-medium">
          {pricingType === 'per_person' 
            ? (isEn ? "/ person" : "/ personne") 
            : (isEn ? "/ private group" : "/ véhicule ou raft privatisé")}
        </span>
      </div>
    </div>
  </div>

  <!-- INTERACTIVE BOOKING FORM -->
  <form class="booking-widget-form space-y-4 pt-1" onsubmit="event.preventDefault(); return false;">
    
    <!-- STEP 1: Date Selector with Calendar -->
    <div class="space-y-1.5">
      <label class="block text-xs font-black text-slate-800 tracking-tight flex items-center justify-between">
        <span>{isEn ? "Choose your safari date" : "Choisissez votre date de safari"}</span>
        <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md">
          {isEn ? "Free cancel (48h)" : "Annulation gratuite 48h"}
        </span>
      </label>

      <div class="relative">
        <input 
          type="date" 
          required
          class="widget-date-input w-full px-3.5 py-3 rounded-2xl border border-slate-300 bg-slate-50/50 hover:bg-white text-slate-900 text-sm font-semibold focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0e8354] focus:border-transparent transition-all cursor-pointer"
        />
      </div>

      <!-- Quick shortcut pills -->
      <div class="flex items-center gap-1.5 pt-1 overflow-x-auto no-scrollbar">
        <button type="button" class="quick-date-btn text-[11px] font-bold px-2.5 py-1 rounded-xl bg-slate-100 hover:bg-emerald-50 hover:text-emerald-800 text-slate-600 transition-colors whitespace-nowrap cursor-pointer" data-days="1">
          {isEn ? "Tomorrow" : "Demain"}
        </button>
        <button type="button" class="quick-date-btn text-[11px] font-bold px-2.5 py-1 rounded-xl bg-slate-100 hover:bg-emerald-50 hover:text-emerald-800 text-slate-600 transition-colors whitespace-nowrap cursor-pointer" data-days="2">
          {isEn ? "+2 days" : "Dans 2 jours"}
        </button>
        <button type="button" class="quick-date-btn text-[11px] font-bold px-2.5 py-1 rounded-xl bg-slate-100 hover:bg-emerald-50 hover:text-emerald-800 text-slate-600 transition-colors whitespace-nowrap cursor-pointer" data-days="7">
          {isEn ? "+1 week" : "Dans 1 semaine"}
        </button>
      </div>
    </div>

    <!-- STEP 2: Travelers Counter -->
    <div class="space-y-1.5 pt-1">
      <label class="block text-xs font-black text-slate-800 tracking-tight flex items-center justify-between">
        <span>{isEn ? "Number of travelers" : "Nombre de participants"}</span>
      </label>

      <div class="flex items-center justify-between p-2 rounded-2xl bg-slate-50/80 border border-slate-200">
        <button 
          type="button" 
          class="widget-decrement-btn w-9 h-9 rounded-xl bg-white hover:bg-slate-200 border border-slate-200 text-slate-800 font-black text-base flex items-center justify-center transition-all active:scale-95 cursor-pointer shadow-sm disabled:opacity-40 disabled:cursor-not-allowed"
          aria-label={isEn ? "Decrease travelers" : "Diminuer les voyageurs"}
        >
          −
        </button>

        <div class="text-center px-4">
          <span class="widget-travelers-count font-black text-lg text-slate-950 font-mono">1</span>
          <span class="text-xs text-slate-500 font-medium ml-1">
            {isEn ? "traveler(s)" : "voyageur(s)"}
          </span>
        </div>

        <button 
          type="button" 
          class="widget-increment-btn w-9 h-9 rounded-xl bg-white hover:bg-slate-200 border border-slate-200 text-slate-800 font-black text-base flex items-center justify-center transition-all active:scale-95 cursor-pointer shadow-sm disabled:opacity-40 disabled:cursor-not-allowed"
          aria-label={isEn ? "Increase travelers" : "Augmenter les voyageurs"}
        >
          +
        </button>
      </div>
    </div>

    <!-- STEP 3: Optional Night at Pawan's (Bardia only) -->
    {allowsPawanRoom && (
      <div class="p-3.5 rounded-2xl bg-emerald-50/80 border border-emerald-200/90 space-y-1.5 transition-colors">
        <label class="flex items-start gap-2.5 cursor-pointer select-none">
          <input 
            type="checkbox" 
            class="widget-pawan-checkbox mt-1 w-4 h-4 text-[#0e8354] rounded border-slate-300 focus:ring-[#0e8354] cursor-pointer"
          />
          <div class="flex-1">
            <div class="flex items-center justify-between gap-1">
              <span class="text-xs font-black text-slate-900">
                {isEn ? "Night at guide's place (+12 €/pers)" : "Nuit chez Pawan (+12 €/pers)"}
              </span>
              <span class="text-xs font-black text-[#0e8354] bg-white px-2 py-0.5 rounded-md border border-emerald-200 shadow-xs">
                +12 €
              </span>
            </div>
            <p class="text-[11px] text-slate-600 leading-snug mt-0.5">
              {isEn 
                ? "Private AC room + traditional homemade dinner + breakfast next morning." 
                : "Chambre climatisée privée + dîner traditionnel maison + petit-déjeuner le lendemain."}
            </p>
          </div>
        </label>
      </div>
    )}

    <!-- STEP 4: Client Coordinates Accordion / Fields -->
    <div class="pt-2 border-t border-slate-100 space-y-2.5">
      <div class="flex items-center justify-between text-xs font-black text-slate-800">
        <span>{isEn ? "Your pickup & contact details" : "Vos coordonnées de prise en charge"}</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <div>
          <input 
            type="text" 
            placeholder={isEn ? "Full Name *" : "Prénom et Nom *"}
            required
            class="widget-name-input w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-[#0e8354] focus:outline-none"
          />
        </div>
        <div>
          <input 
            type="email" 
            placeholder={isEn ? "Email address *" : "Adresse email *"}
            required
            class="widget-email-input w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-[#0e8354] focus:outline-none"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <div>
          <input 
            type="tel" 
            placeholder={isEn ? "WhatsApp (+Country code) *" : "WhatsApp (avec indicatif) *"}
            required
            class="widget-whatsapp-input w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-[#0e8354] focus:outline-none"
          />
        </div>
        <div>
          <input 
            type="text" 
            placeholder={isEn ? `Hotel in ${locationName} (optional)` : `Hôtel à ${locationName} (facultatif)`}
            class="widget-hotel-input w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-[#0e8354] focus:outline-none"
          />
        </div>
      </div>
    </div>

    <!-- Live Total Summary Row -->
    <div class="pt-3 border-t border-slate-100 bg-slate-50/70 p-3 rounded-2xl flex items-center justify-between">
      <div>
        <span class="text-[10px] font-extrabold uppercase text-slate-400 tracking-wider block">
          {isEn ? "Total Amount (Taxes included)" : "Montant Total (TTC)"}
        </span>
        <span class="text-xs text-slate-500 font-semibold widget-summary-detail">
          {basePrice} €
        </span>
      </div>
      <div class="text-right">
        <span class="widget-total-display font-black text-2xl sm:text-3xl text-slate-950 font-mono tracking-tight text-[#0e5c3e]">
          {basePrice}€
        </span>
      </div>
    </div>

    <!-- Error Alert Box -->
    <div class="widget-error-box hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold leading-relaxed">
    </div>

    <!-- PRIMARY SUBMIT CTA (Stripe Checkout) -->
    <button 
      type="button" 
      class="widget-submit-btn w-full text-center py-4 px-4 rounded-2xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-sm shadow-xl shadow-emerald-950/20 hover:scale-[1.02] active:scale-95 transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer select-none"
    >
      <svg class="w-4 h-4 text-emerald-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span class="widget-submit-btn-text">
        {isEn ? `Pay ${basePrice}€ via Stripe` : `Payer ${basePrice}€ en ligne`}
      </span>
    </button>

    <!-- Payment Badges Reassurance -->
    <div class="flex items-center justify-center gap-3 pt-1 text-[11px] text-slate-400 font-semibold">
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
        <span>Stripe Checkout</span>
      </span>
      <span>•</span>
      <span>Apple Pay / CB / Visa</span>
      <span>•</span>
      <span>3D Secure</span>
    </div>

    <!-- Secondary WhatsApp Action -->
    <div class="pt-1">
      <a 
        href={`https://wa.me/33695413227?text=${encodeURIComponent(isEn ? `Hello Robin, I have a question regarding: ${tourTitle}` : `Bonjour Robin, j'ai une question concernant : ${tourTitle}`)}`}
        target="_blank" 
        rel="nofollow noopener noreferrer" 
        class="widget-whatsapp-link w-full flex items-center justify-center gap-2 py-2.5 px-3 rounded-2xl bg-emerald-50 hover:bg-emerald-100 text-[#0e8354] font-bold text-xs border border-emerald-200/80 transition-all cursor-pointer select-none"
      >
        <svg class="w-3.5 h-3.5 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span>{isEn ? "Ask Robin on WhatsApp before booking" : "Poser une question à Robin sur WhatsApp"}</span>
      </a>
    </div>

    <!-- Reassurance List -->
    <div class="space-y-1.5 text-xs text-slate-500 pt-3 border-t border-slate-100 font-medium">
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>{isEn ? "Guaranteed departure & licensed native guide" : "Départ garanti avec guide natif certifié"}</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>{isEn ? "Picnic lunch & transfers included" : "Pique-nique en jungle & transports inclus"}</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-[#0e8354] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>{isEn ? "Free date modification up to 48h before" : "Report de date sans frais jusqu'à 48h avant"}</span>
      </div>
    </div>

  </form>
</div>

<script is:inline>
(function() {
  function initDayTourWidgets() {
    var widgets = document.querySelectorAll('.day-tour-booking-widget');
    widgets.forEach(function(widget) {
      if (widget.dataset.initialized) return;
      widget.dataset.initialized = 'true';

      var tourId = widget.getAttribute('data-tour-id');
      var tourTitle = widget.getAttribute('data-tour-title');
      var pricingType = widget.getAttribute('data-pricing-type'); // 'per_person' or 'fixed_group'
      var basePrice = parseInt(widget.getAttribute('data-base-price'), 10) || 50;
      var allowsPawan = widget.getAttribute('data-allows-pawan') === 'true';
      var maxTravelers = parseInt(widget.getAttribute('data-max-travelers'), 10) || 8;
      var lang = widget.getAttribute('data-lang') || 'fr';
      var isEn = lang === 'en';

      var dateInput = widget.querySelector('.widget-date-input');
      var countEl = widget.querySelector('.widget-travelers-count');
      var decBtn = widget.querySelector('.widget-decrement-btn');
      var incBtn = widget.querySelector('.widget-increment-btn');
      var pawanCheckbox = widget.querySelector('.widget-pawan-checkbox');
      var totalDisplay = widget.querySelector('.widget-total-display');
      var summaryDetail = widget.querySelector('.widget-summary-detail');
      var submitBtn = widget.querySelector('.widget-submit-btn');
      var submitBtnText = widget.querySelector('.widget-submit-btn-text');
      var errorBox = widget.querySelector('.widget-error-box');
      var quickBtns = widget.querySelectorAll('.quick-date-btn');

      var nameInput = widget.querySelector('.widget-name-input');
      var emailInput = widget.querySelector('.widget-email-input');
      var whatsappInput = widget.querySelector('.widget-whatsapp-input');
      var hotelInput = widget.querySelector('.widget-hotel-input');
      var waLink = widget.querySelector('.widget-whatsapp-link');

      // Set min date to tomorrow
      var tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      var minDateStr = tomorrow.toISOString().split('T')[0];
      if (dateInput) {
        dateInput.min = minDateStr;
        dateInput.value = minDateStr;
      }

      var currentTravelers = 1;

      function updateCalculations() {
        var pawanPricePerPerson = 12;
        var hasPawan = pawanCheckbox ? pawanCheckbox.checked : false;

        var total = 0;
        var detailText = "";

        if (pricingType === 'per_person') {
          var tourSubtotal = basePrice * currentTravelers;
          var pawanSubtotal = hasPawan ? (pawanPricePerPerson * currentTravelers) : 0;
          total = tourSubtotal + pawanSubtotal;
          
          if (hasPawan) {
            detailText = currentTravelers + " pers. (" + basePrice + "€) + Nuit chez Pawan (" + pawanSubtotal + "€)";
          } else {
            detailText = currentTravelers + " pers. × " + basePrice + "€";
          }
        } else {
          // fixed_group
          var pawanSubtotal = hasPawan ? (pawanPricePerPerson * currentTravelers) : 0;
          total = basePrice + pawanSubtotal;

          if (hasPawan) {
            detailText = "Forfait privé (" + basePrice + "€) + Nuit Pawan (" + pawanSubtotal + "€)";
          } else {
            detailText = "Forfait privatisé (" + currentTravelers + " " + (isEn ? "travelers" : "voyageurs") + ")";
          }
        }

        if (totalDisplay) totalDisplay.textContent = total + "€";
        if (summaryDetail) summaryDetail.textContent = detailText;
        if (submitBtnText) {
          submitBtnText.textContent = isEn 
            ? "Pay " + total + "€ via Stripe" 
            : "Payer " + total + "€ en ligne";
        }

        if (decBtn) decBtn.disabled = (currentTravelers <= 1);
        if (incBtn) incBtn.disabled = false;

        // Update WhatsApp text
        if (waLink) {
          var msg = isEn 
            ? "Hello Robin, I want to book: " + tourTitle + " for " + currentTravelers + " traveler(s) on " + (dateInput ? dateInput.value : "") + " (Total: " + total + "€)."
            : "Bonjour Robin, je souhaite réserver : " + tourTitle + " pour " + currentTravelers + " voyageur(s) le " + (dateInput ? dateInput.value : "") + " (Total : " + total + "€).";
          waLink.href = "https://wa.me/33695413227?text=" + encodeURIComponent(msg);
        }
      }

      // Quick date buttons handler
      quickBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var days = parseInt(btn.getAttribute('data-days'), 10) || 1;
          var targetDate = new Date();
          targetDate.setDate(targetDate.getDate() + days);
          if (dateInput) {
            dateInput.value = targetDate.toISOString().split('T')[0];
            updateCalculations();
          }
        });
      });

      if (dateInput) {
        dateInput.addEventListener('change', updateCalculations);
      }

      if (pawanCheckbox) {
        pawanCheckbox.addEventListener('change', updateCalculations);
      }

      if (decBtn) {
        decBtn.addEventListener('click', function() {
          if (currentTravelers > 1) {
            currentTravelers--;
            if (countEl) countEl.textContent = currentTravelers;
            updateCalculations();
          }
        });
      }

      if (incBtn) {
        incBtn.addEventListener('click', function() {
          if (currentTravelers < 99) {
            currentTravelers++;
            if (countEl) countEl.textContent = currentTravelers;
            updateCalculations();
          }
        });
      }

      // Stripe Checkout Submission
      if (submitBtn) {
        submitBtn.addEventListener('click', async function(e) {
          e.preventDefault();
          if (errorBox) {
            errorBox.classList.add('hidden');
            errorBox.textContent = '';
          }

          var dateVal = dateInput ? dateInput.value : '';
          var nameVal = nameInput ? nameInput.value.trim() : '';
          var emailVal = emailInput ? emailInput.value.trim() : '';
          var waVal = whatsappInput ? whatsappInput.value.trim() : '';
          var hotelVal = hotelInput ? hotelInput.value.trim() : '';

          if (!dateVal) {
            showError(isEn ? "Please select a date on the calendar." : "Veuillez choisir une date sur le calendrier.");
            if (dateInput) dateInput.focus();
            return;
          }

          if (!nameVal) {
            showError(isEn ? "Please enter your full name." : "Veuillez renseigner votre prénom et nom.");
            if (nameInput) nameInput.focus();
            return;
          }

          if (!emailVal || emailVal.indexOf('@') === -1) {
            showError(isEn ? "Please enter a valid email address." : "Veuillez renseigner une adresse email valide.");
            if (emailInput) emailInput.focus();
            return;
          }

          if (!waVal) {
            showError(isEn ? "Please enter your WhatsApp phone number." : "Veuillez renseigner votre numéro WhatsApp.");
            if (whatsappInput) whatsappInput.focus();
            return;
          }

          // UI Loading state
          submitBtn.disabled = true;
          var origBtnText = submitBtnText.textContent;
          submitBtnText.textContent = isEn ? "Redirecting to Stripe..." : "Connexion sécurisée à Stripe...";

          try {
            var payload = {
              tourId: tourId,
              date: dateVal,
              travelers: currentTravelers,
              customerName: nameVal,
              customerEmail: emailVal,
              whatsapp: waVal,
              hotel: hotelVal,
              hasPawanRoom: pawanCheckbox ? pawanCheckbox.checked : false,
              lang: lang,
              cancelUrl: window.location.href
            };

            var response = await fetch('/api/create-checkout-session.php', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            var result = await response.json();

            if (result && result.success && result.url) {
              window.location.href = result.url;
            } else {
              showError(result.error || (isEn ? "An error occurred with Stripe. Please retry or contact us." : "Une erreur est survenue avec Stripe. Veuillez réessayer ou nous contacter."));
              submitBtn.disabled = false;
              submitBtnText.textContent = origBtnText;
            }
          } catch (err) {
            console.error('Checkout error:', err);
            showError(isEn ? "Network error. Please check your connection." : "Erreur réseau. Veuillez vérifier votre connexion.");
            submitBtn.disabled = false;
            submitBtnText.textContent = origBtnText;
          }
        });
      }

      function showError(msg) {
        if (errorBox) {
          errorBox.textContent = msg;
          errorBox.classList.remove('hidden');
        } else {
          alert(msg);
        }
      }

      // Initial calculation
      updateCalculations();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDayTourWidgets);
  } else {
    initDayTourWidgets();
  }
})();
</script>
