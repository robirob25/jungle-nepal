---
interface Props {
  tourId: string;
  tourTitle: string;
  tourBadge?: string;
  duration?: string;
  pricingType: 'per_person' | 'fixed_group';
  basePrice: number;
  allowsPawanRoom?: boolean;
  maxTravelers?: number;
  lang?: 'fr' | 'en';
  locationName?: string;
}

const {
  tourId,
  tourTitle,
  tourBadge = "Activité à la journée",
  duration = "1 jour (6h30 – 18h00)",
  pricingType,
  basePrice,
  allowsPawanRoom = false,
  maxTravelers = 8,
  lang = 'fr',
  locationName = 'Bardia'
} = Astro.props;

const isEn = lang === 'en';
---

<div 
  class="day-tour-booking-widget bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/90 shadow-xl space-y-3 relative overflow-hidden" 
  data-tour-id={tourId}
  data-tour-title={tourTitle}
  data-pricing-type={pricingType}
  data-base-price={basePrice}
  data-allows-pawan={allowsPawanRoom ? "true" : "false"}
  data-max-travelers={maxTravelers}
  data-lang={lang}
  data-location={locationName}
>
  <!-- Ambient background glow -->
  <div class="absolute -top-12 -right-12 w-32 h-32 bg-emerald-500/5 rounded-full blur-2xl pointer-events-none"></div>

  <!-- Header: Compact Price & Highlights -->
  <div class="flex items-center justify-between pb-2.5 border-b border-slate-100">
    <div>
      <span class="text-[10px] font-extrabold uppercase text-slate-400 tracking-wider block">
        {isEn ? "Price per traveler" : "Tarif par personne"}
      </span>
      <div class="flex items-baseline gap-1">
        <span class="widget-base-price-display font-black text-2xl sm:text-3xl text-slate-950 font-mono tracking-tight">
          {basePrice}€
        </span>
        <span class="text-xs text-slate-500 font-medium">
          {isEn ? "/ pers." : "/ pers."}
        </span>
      </div>
    </div>
    <div class="text-right">
      <span class="inline-block text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200/60">
        {isEn ? "Free cancel (48h)" : "Annulation 48h"}
      </span>
      <span class="block text-[11px] text-slate-500 font-medium mt-0.5">
        {duration.split('(')[0].trim()} • {locationName}
      </span>
    </div>
  </div>

  <!-- INTERACTIVE BOOKING FORM -->
  <form class="booking-widget-form space-y-2.5" onsubmit="event.preventDefault(); return false;">
    
    <!-- ROW 1: Date & Travelers side-by-side -->
    <div class="grid grid-cols-2 gap-2">
      <!-- Date Selector -->
      <div class="space-y-1">
        <label class="block text-[11px] font-bold text-slate-700 truncate">
          {isEn ? "Date" : "Date du safari"}
        </label>
        <input 
          type="date" 
          required
          class="widget-date-input w-full px-2.5 py-1.5 rounded-xl border border-slate-300 bg-slate-50/50 hover:bg-white text-slate-900 text-xs font-semibold focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0e8354] transition-all cursor-pointer h-[36px]"
        />
      </div>

      <!-- Travelers Counter -->
      <div class="space-y-1">
        <label class="block text-[11px] font-bold text-slate-700 truncate">
          {isEn ? "Travelers" : "Participants"}
        </label>
        <div class="flex items-center justify-between px-1.5 rounded-xl bg-slate-50 border border-slate-200 h-[36px]">
          <button 
            type="button" 
            class="widget-decrement-btn w-6 h-6 rounded-lg bg-white hover:bg-slate-200 border border-slate-200 text-slate-800 font-bold text-xs flex items-center justify-center transition-all active:scale-95 cursor-pointer shadow-xs disabled:opacity-30 disabled:cursor-not-allowed"
            aria-label={isEn ? "Decrease travelers" : "Diminuer les voyageurs"}
          >
            −
          </button>
          <div class="text-center px-1">
            <span class="widget-travelers-count font-black text-xs sm:text-sm text-slate-950 font-mono">1</span>
            <span class="text-[10px] text-slate-500 font-medium ml-0.5">{isEn ? "pers." : "pers."}</span>
          </div>
          <button 
            type="button" 
            class="widget-increment-btn w-6 h-6 rounded-lg bg-white hover:bg-slate-200 border border-slate-200 text-slate-800 font-bold text-xs flex items-center justify-center transition-all active:scale-95 cursor-pointer shadow-xs"
            aria-label={isEn ? "Increase travelers" : "Augmenter les voyageurs"}
          >
            +
          </button>
        </div>
      </div>
    </div>

    <!-- ROW 2: Optional Night at Pawan's (Bardia only) -->
    {allowsPawanRoom && (
      <label class="flex items-center justify-between p-2 rounded-xl bg-emerald-50/70 border border-emerald-200/80 cursor-pointer select-none text-xs hover:bg-emerald-50 transition-colors">
        <div class="flex items-center gap-2 min-w-0">
          <input 
            type="checkbox" 
            class="widget-pawan-checkbox w-3.5 h-3.5 text-[#0e8354] rounded border-slate-300 focus:ring-[#0e8354] cursor-pointer"
          />
          <span class="font-bold text-slate-800 text-[11px] truncate">
            {isEn ? "Night at guide's (+12€/pers)" : "Nuit chez Pawan (+12€/pers)"}
          </span>
        </div>
        <span class="text-[10px] font-bold text-emerald-800 bg-white px-1.5 py-0.5 rounded border border-emerald-200 shrink-0">
          {isEn ? "Dinner + room" : "Dîner + nuit"}
        </span>
      </label>
    )}

    <!-- ROW 3: Contact Fields in 2x2 grid -->
    <div class="space-y-1.5 pt-0.5">
      <div class="grid grid-cols-2 gap-2">
        <input 
          type="text" 
          placeholder={isEn ? "Name *" : "Prénom & Nom *"}
          required
          class="widget-name-input w-full px-2.5 py-1.5 rounded-xl border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-[#0e8354] focus:outline-none placeholder:text-slate-400 h-[34px]"
        />
        <input 
          type="email" 
          placeholder={isEn ? "Email *" : "Email *"}
          required
          class="widget-email-input w-full px-2.5 py-1.5 rounded-xl border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-[#0e8354] focus:outline-none placeholder:text-slate-400 h-[34px]"
        />
      </div>

      <div class="grid grid-cols-2 gap-2">
        <input 
          type="tel" 
          placeholder={isEn ? "WhatsApp *" : "WhatsApp *"}
          required
          class="widget-whatsapp-input w-full px-2.5 py-1.5 rounded-xl border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-[#0e8354] focus:outline-none placeholder:text-slate-400 h-[34px]"
        />
        <input 
          type="text" 
          placeholder={isEn ? "Hotel (optional)" : "Hôtel (facultatif)"}
          class="widget-hotel-input w-full px-2.5 py-1.5 rounded-xl border border-slate-300 bg-white text-xs font-medium focus:ring-2 focus:ring-[#0e8354] focus:outline-none placeholder:text-slate-400 h-[34px]"
        />
      </div>
    </div>

    <!-- Error Alert Box -->
    <div class="widget-error-box hidden p-2 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold leading-snug">
    </div>

    <!-- PRIMARY SUBMIT CTA (Compact Integrated Button) -->
    <button 
      type="button" 
      class="widget-submit-btn w-full py-3 px-3.5 rounded-xl bg-[#0e5c3e] hover:bg-[#09422b] text-white font-extrabold text-sm shadow-md shadow-emerald-950/20 hover:scale-[1.01] active:scale-98 transition-all flex items-center justify-between cursor-pointer select-none"
    >
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span class="widget-submit-btn-text">
          {isEn ? "Pay Online" : "Payer en ligne"}
        </span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="widget-summary-detail text-[11px] text-emerald-200/90 font-medium">1 pers.</span>
        <span class="widget-total-display font-black text-sm sm:text-base font-mono bg-white/20 px-2 py-0.5 rounded-lg">
          {basePrice}€
        </span>
      </div>
    </button>

    <!-- Sub-button Reassurance & WhatsApp Link in 1 line -->
    <div class="flex items-center justify-between text-[10px] text-slate-400 font-medium px-0.5 pt-0.5">
      <span class="flex items-center gap-1">
        <svg class="w-3 h-3 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
        <span>Stripe • CB, Apple Pay</span>
      </span>
      <a 
        href={`https://wa.me/33695413227?text=${encodeURIComponent(isEn ? `Hello Robin, question regarding: ${tourTitle}` : `Bonjour Robin, question concernant : ${tourTitle}`)}`}
        target="_blank" 
        rel="nofollow noopener noreferrer" 
        class="widget-whatsapp-link text-emerald-700 hover:text-emerald-800 font-bold hover:underline flex items-center gap-0.5"
      >
        <span>Une question ? WhatsApp</span>
      </a>
    </div>

  </form>
</div>

<script is:inline>
(function() {
  function initDayTourWidgets() {
    var widgets = document.querySelectorAll('.day-tour-booking-widget');
    widgets.forEach(function(widget) {
      if (widget.dataset.initialized) return;
      widget.dataset.initialized = 'true';

      var tourId = widget.getAttribute('data-tour-id');
      var tourTitle = widget.getAttribute('data-tour-title');
      var pricingType = widget.getAttribute('data-pricing-type'); // 'per_person' or 'fixed_group'
      var basePrice = parseInt(widget.getAttribute('data-base-price'), 10) || 50;
      var allowsPawan = widget.getAttribute('data-allows-pawan') === 'true';
      var maxTravelers = parseInt(widget.getAttribute('data-max-travelers'), 10) || 8;
      var lang = widget.getAttribute('data-lang') || 'fr';
      var isEn = lang === 'en';

      var dateInput = widget.querySelector('.widget-date-input');
      var countEl = widget.querySelector('.widget-travelers-count');
      var decBtn = widget.querySelector('.widget-decrement-btn');
      var incBtn = widget.querySelector('.widget-increment-btn');
      var pawanCheckbox = widget.querySelector('.widget-pawan-checkbox');
      var totalDisplay = widget.querySelector('.widget-total-display');
      var summaryDetail = widget.querySelector('.widget-summary-detail');
      var submitBtn = widget.querySelector('.widget-submit-btn');
      var submitBtnText = widget.querySelector('.widget-submit-btn-text');
      var errorBox = widget.querySelector('.widget-error-box');
      var quickBtns = widget.querySelectorAll('.quick-date-btn');

      var nameInput = widget.querySelector('.widget-name-input');
      var emailInput = widget.querySelector('.widget-email-input');
      var whatsappInput = widget.querySelector('.widget-whatsapp-input');
      var hotelInput = widget.querySelector('.widget-hotel-input');
      var waLink = widget.querySelector('.widget-whatsapp-link');

      // Set min date to tomorrow
      var tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      var minDateStr = tomorrow.toISOString().split('T')[0];
      if (dateInput) {
        dateInput.min = minDateStr;
        dateInput.value = minDateStr;
      }

      var currentTravelers = 1;

      function updateCalculations() {
        var pawanPricePerPerson = 12;
        var hasPawan = pawanCheckbox ? pawanCheckbox.checked : false;

        // Multiply price by number of travelers
        var tourSubtotal = basePrice * currentTravelers;
        var pawanSubtotal = hasPawan ? (pawanPricePerPerson * currentTravelers) : 0;
        var total = tourSubtotal + pawanSubtotal;
        
        var travelersLabel = isEn 
          ? (currentTravelers > 1 ? "travelers" : "traveler")
          : (currentTravelers > 1 ? "voyageurs" : "voyageur");

        var detailText = "";
        if (hasPawan) {
          detailText = currentTravelers + " " + travelersLabel + " (" + tourSubtotal + "€) + " + (isEn ? "Night at guide's" : "Nuit chez Pawan") + " (" + pawanSubtotal + "€)";
        } else {
          detailText = currentTravelers + " " + travelersLabel + " × " + basePrice + "€";
        }

        if (totalDisplay) totalDisplay.textContent = total + "€";
        var travelersShort = currentTravelers + (isEn ? " pers." : " pers.");
        if (summaryDetail) {
          summaryDetail.textContent = hasPawan ? (travelersShort + " + Pawan") : travelersShort;
        }
        if (submitBtnText) {
          submitBtnText.textContent = isEn ? "Pay Online" : "Payer en ligne";
        }

        if (decBtn) decBtn.disabled = (currentTravelers <= 1);
        if (incBtn) incBtn.disabled = false;

        // Update WhatsApp text
        if (waLink) {
          var msg = isEn 
            ? "Hello Robin, I want to book: " + tourTitle + " for " + currentTravelers + " traveler(s) on " + (dateInput ? dateInput.value : "") + " (Total: " + total + "€)."
            : "Bonjour Robin, je souhaite réserver : " + tourTitle + " pour " + currentTravelers + " voyageur(s) le " + (dateInput ? dateInput.value : "") + " (Total : " + total + "€).";
          waLink.href = "https://wa.me/33695413227?text=" + encodeURIComponent(msg);
        }
      }

      // Quick date buttons handler
      quickBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var days = parseInt(btn.getAttribute('data-days'), 10) || 1;
          var targetDate = new Date();
          targetDate.setDate(targetDate.getDate() + days);
          if (dateInput) {
            dateInput.value = targetDate.toISOString().split('T')[0];
            updateCalculations();
          }
        });
      });

      if (dateInput) {
        dateInput.addEventListener('change', updateCalculations);
      }

      if (pawanCheckbox) {
        pawanCheckbox.addEventListener('change', updateCalculations);
      }

      if (decBtn) {
        decBtn.addEventListener('click', function() {
          if (currentTravelers > 1) {
            currentTravelers--;
            if (countEl) countEl.textContent = currentTravelers;
            updateCalculations();
          }
        });
      }

      if (incBtn) {
        incBtn.addEventListener('click', function() {
          if (currentTravelers < 99) {
            currentTravelers++;
            if (countEl) countEl.textContent = currentTravelers;
            updateCalculations();
          }
        });
      }

      // Stripe Checkout Submission
      if (submitBtn) {
        submitBtn.addEventListener('click', async function(e) {
          e.preventDefault();
          if (errorBox) {
            errorBox.classList.add('hidden');
            errorBox.textContent = '';
          }

          var dateVal = dateInput ? dateInput.value : '';
          var nameVal = nameInput ? nameInput.value.trim() : '';
          var emailVal = emailInput ? emailInput.value.trim() : '';
          var waVal = whatsappInput ? whatsappInput.value.trim() : '';
          var hotelVal = hotelInput ? hotelInput.value.trim() : '';

          if (!dateVal) {
            showError(isEn ? "Please select a date on the calendar." : "Veuillez choisir une date sur le calendrier.");
            if (dateInput) dateInput.focus();
            return;
          }

          if (!nameVal) {
            showError(isEn ? "Please enter your full name." : "Veuillez renseigner votre prénom et nom.");
            if (nameInput) nameInput.focus();
            return;
          }

          if (!emailVal || emailVal.indexOf('@') === -1) {
            showError(isEn ? "Please enter a valid email address." : "Veuillez renseigner une adresse email valide.");
            if (emailInput) emailInput.focus();
            return;
          }

          if (!waVal) {
            showError(isEn ? "Please enter your WhatsApp phone number." : "Veuillez renseigner votre numéro WhatsApp.");
            if (whatsappInput) whatsappInput.focus();
            return;
          }

          // UI Loading state
          submitBtn.disabled = true;
          var origBtnText = submitBtnText.textContent;
          submitBtnText.textContent = isEn ? "Redirecting to Stripe..." : "Connexion sécurisée à Stripe...";

          try {
            var payload = {
              tourId: tourId,
              date: dateVal,
              travelers: currentTravelers,
              customerName: nameVal,
              customerEmail: emailVal,
              whatsapp: waVal,
              hotel: hotelVal,
              hasPawanRoom: pawanCheckbox ? pawanCheckbox.checked : false,
              lang: lang,
              cancelUrl: window.location.href
            };

            var response = await fetch('/api/create-checkout-session.php', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            var result = await response.json();

            if (result && result.success && result.url) {
              window.location.href = result.url;
            } else {
              showError(result.error || (isEn ? "An error occurred with Stripe. Please retry or contact us." : "Une erreur est survenue avec Stripe. Veuillez réessayer ou nous contacter."));
              submitBtn.disabled = false;
              submitBtnText.textContent = origBtnText;
            }
          } catch (err) {
            console.error('Checkout error:', err);
            showError(isEn ? "Network error. Please check your connection." : "Erreur réseau. Veuillez vérifier votre connexion.");
            submitBtn.disabled = false;
            submitBtnText.textContent = origBtnText;
          }
        });
      }

      function showError(msg) {
        if (errorBox) {
          errorBox.textContent = msg;
          errorBox.classList.remove('hidden');
        } else {
          alert(msg);
        }
      }

      // Initial calculation
      updateCalculations();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDayTourWidgets);
  } else {
    initDayTourWidgets();
  }
})();
</script>
