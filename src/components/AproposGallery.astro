    cols: "col-span-6 sm:col-span-3",
    height: "h-[150px] sm:h-[180px] md:h-[210px]"
  },
  {
    id: "img_1420",
    src: "/assets/apropos_gallery/img_1420.webp",
    altFr: "Voyageuse avec collier de fleurs traditionnel et habitante népalaise",
    altEn: "Traveler with traditional marigold garland and local Nepali host",
    cols: "col-span-6 sm:col-span-3",
    height: "h-[150px] sm:h-[180px] md:h-[210px]"
  },
  {
    id: "img_2501",
    src: "/assets/apropos_gallery/img_2501.webp",
    altFr: "Voyageur accueilli à l'aéroport avec collier de fleurs par l'équipe",
    altEn: "Traveler greeted at the airport with a flower garland by our team",
    cols: "col-span-6 sm:col-span-3",
    height: "h-[150px] sm:h-[180px] md:h-[210px]"
  },
  {
    id: "img_2514",
    src: "/assets/apropos_gallery/img_2514.webp",
    altFr: "Couple de voyageurs accueilli à l'aéroport par l'équipe locale",
    altEn: "Couple of travelers welcomed at the airport by our local team",
    cols: "col-span-6 sm:col-span-3",
    height: "h-[150px] sm:h-[180px] md:h-[210px]"
  },
  // Ligne 3 : 4 moments avec l'équipe locale et les pisteurs
  {
    id: "img_2548",
    src: "/assets/apropos_gallery/img_2548.webp",
    altFr: "Voyageur avec les guides de l'agence Jungle Nepal Adventure",
    altEn: "Traveler with Jungle Nepal Adventure guides",
    cols: "col-span-6 sm:col-span-3",
    height: "h-[150px] sm:h-[180px] md:h-[210px]"
  },
  {
    id: "img_2544",
    src: "/assets/apropos_gallery/img_2544.webp",
    altFr: "Voyageur souriant avec les deux pisteurs locaux et le t-shirt de l'expédition",
    altEn: "Smiling traveler with our two local trackers and the expedition shirt",
