---

<section class="py-16 sm:py-24 bg-[#03140d] text-white relative overflow-hidden border-b border-emerald-950/60 font-sans">
  <!-- Subtle ambient radial lighting -->
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- SECTION HEADER -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-bold uppercase tracking-widest">
        <span>{isEn ? "Field snapshots & real smiles" : "Instants volés & rencontres sur le terrain"}</span>
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
        {isEn 
          ? "Trust isn't declared. It's lived together." 
          : "La confiance ne s'invente pas. Elle se vit sur place."}
      </h2>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {isEn 
          ? "No agency models, zero staged sets. Every traveler landing in Kathmandu is met personally by our local family. From flower garland welcomes to riverboat safaris with Robin and our trackers, here is the unfiltered reality of your expeditions."
          : "Zéro mannequin d'agence, zéro mise en scène. Chaque voyageur qui atterrit à Katmandou est accueilli personnellement par notre équipe. Des colliers de fleurs traditionnels aux pirogues de jungle avec Robin et nos maîtres pisteurs, voici la réalité brute de vos aventures."}
      </p>

      <!-- Reassurance Points (Sober, No Weird Dots) -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-2.5 sm:gap-4 text-xs font-semibold text-slate-300">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>{isEn ? "100% Real field photos" : "100% Photos réelles de terrain"}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>{isEn ? "Personal airport pickup" : "Prise en charge personnalisée dès l'aéroport"}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 border border-white/10">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>{isEn ? "Robin & native master trackers by your side" : "Robin & pisteurs natifs à vos côtés"}</span>
        </span>
      </div>
    </div>

    <!-- ASYMMETRIC BENTO COLLAGE GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-3.5 sm:gap-4">
      {photos.map((photo, index) => (
        <div 
          class={`${photo.cols} ${photo.height} relative rounded-2xl sm:rounded-3xl overflow-hidden group border border-white/10 shadow-lg cursor-pointer bg-slate-900 transition-all duration-300 hover:scale-[1.015] hover:border-emerald-400/40 hover:shadow-2xl`}
          onclick={`openAproposLightbox(${index})`}
        >
          <img 
            src={photo.src} 
            alt={isEn ? photo.altEn : photo.altFr} 
            loading="lazy" 
            decoding="async" 
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-300"></div>

          <!-- Top Badge -->
          <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-10">
            <span class="inline-block px-2.5 py-1 rounded-lg bg-slate-950/70 backdrop-blur-md border border-white/15 text-[10px] sm:text-[11px] font-extrabold text-white tracking-wide">
              {isEn ? photo.tagEn : photo.tagFr}
            </span>
          </div>

          <!-- Bottom Caption on Hover / Visible -->
          <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 z-10 space-y-1">
            <p class="text-xs sm:text-sm font-bold text-white leading-snug line-clamp-2 drop-shadow">
              {isEn ? photo.captionEn : photo.captionFr}
            </p>
            <p class="text-[10px] text-emerald-300 font-semibold opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              {isEn ? "Click to view full photo →" : "Cliquer pour agrandir →"}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- FULL-SCREEN LIGHTBOX MODAL -->
<div 
  id="apropos-lightbox" 
  class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/95 backdrop-blur-md p-3 sm:p-6 transition-opacity duration-300"
  onclick="handleAproposBackdropClick(event)"
>
  <div class="relative max-w-5xl w-full max-h-[92vh] flex flex-col items-center">
    <!-- Top Bar Controls -->
    <div class="w-full flex items-center justify-between text-white pb-3 px-2 text-xs sm:text-sm">
      <span id="apropos-counter" class="font-mono font-bold text-slate-300 bg-white/10 px-3 py-1 rounded-full">
        1 / {photos.length}
      </span>
      <button 
        onclick="closeAproposLightbox()" 
        class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 flex items-center justify-center text-white transition-all cursor-pointer font-bold text-sm"
        aria-label={isEn ? "Close lightbox" : "Fermer la vue"}
      >
        ✕
      </button>
    </div>

    <!-- Main Image Display Container -->
    <div class="relative w-full flex items-center justify-center overflow-hidden rounded-2xl bg-black/40 border border-white/10">
      <img 
        id="apropos-lightbox-img" 
        src="" 
        alt="" 
        class="max-h-[72vh] max-w-full object-contain rounded-xl select-none"
      />

      <!-- Previous Button -->
      <button 
        onclick="prevAproposPhoto(event)" 
        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-slate-950/70 hover:bg-slate-950/90 text-white flex items-center justify-center backdrop-blur-md border border-white/15 transition-all hover:scale-105 active:scale-95 cursor-pointer"
        aria-label={isEn ? "Previous photo" : "Photo précédente"}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
      </button>

      <!-- Next Button -->
      <button 
        onclick="nextAproposPhoto(event)" 
        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-slate-950/70 hover:bg-slate-950/90 text-white flex items-center justify-center backdrop-blur-md border border-white/15 transition-all hover:scale-105 active:scale-95 cursor-pointer"
        aria-label={isEn ? "Next photo" : "Photo suivante"}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <!-- Caption Below -->
    <div class="w-full text-center pt-3 px-4">
      <p id="apropos-lightbox-caption" class="text-xs sm:text-sm font-semibold text-slate-200">
      </p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ photos, isEn }}>
  let currentAproposIndex = 0;

  window.openAproposLightbox = function(index) {
    currentAproposIndex = index;
    updateLightboxContent();
    const modal = document.getElementById('apropos-lightbox');
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  };

  window.closeAproposLightbox = function() {
    const modal = document.getElementById('apropos-lightbox');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  };

  window.prevAproposPhoto = function(e) {
    if (e) e.stopPropagation();
    currentAproposIndex = (currentAproposIndex - 1 + photos.length) % photos.length;
    updateLightboxContent();
  };

  window.nextAproposPhoto = function(e) {
    if (e) e.stopPropagation();
    currentAproposIndex = (currentAproposIndex + 1) % photos.length;
    updateLightboxContent();
  };

  window.handleAproposBackdropClick = function(e) {
    if (e.target.id === 'apropos-lightbox') {
      closeAproposLightbox();
    }
  };

  function updateLightboxContent() {
    const photo = photos[currentAproposIndex];
    if (!photo) return;
    const imgEl = document.getElementById('apropos-lightbox-img');
    const capEl = document.getElementById('apropos-lightbox-caption');
    const countEl = document.getElementById('apropos-counter');
    
    if (imgEl) {
      imgEl.src = photo.src;
      imgEl.alt = isEn ? photo.altEn : photo.altFr;
    }
    if (capEl) {
      capEl.textContent = isEn ? photo.captionEn : photo.captionFr;
    }
    if (countEl) {
      countEl.textContent = (currentAproposIndex + 1) + ' / ' + photos.length;
    }
  }

  document.addEventListener('keydown', (e) => {
    const modal = document.getElementById('apropos-lightbox');
    if (!modal || modal.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeAproposLightbox();
    if (e.key === 'ArrowLeft') prevAproposPhoto();
    if (e.key === 'ArrowRight') nextAproposPhoto();
  });
</script>
