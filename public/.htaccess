    # Serve existing files and directories directly (prevents infinite redirect loops)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map extensionless URLs to .html fallback if directory or index file doesn't match
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Universal HTML & dynamic pages: zero caching at browser and edge CDN levels
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    Header always set Pragma "no-cache" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    Header always set Expires "0" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    Header always set CDN-Cache-Control "no-store" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    Header always set Surrogate-Control "no-store" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    
    <FilesMatch "\.(html|htm|php|txt|md)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always set CDN-Cache-Control "no-store"
        Header always set Surrogate-Control "no-store"
    </FilesMatch>

    # Cache immutable assets (CSS, JS, Fonts, Images)
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

