# =========================================================================
# JUNGLE NEPAL ADVENTURE - MILITARY-GRADE CYBERSECURITY & CLEAN URLS
# =========================================================================

Options -Indexes -MultiViews

<FilesMatch "^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|env|git|yaml|yml|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block common SQL Injection & XSS attack vectors in Query Strings
    RewriteCond %{QUERY_STRING} (eval\(|union.*select|benchmark\(|document\.cookie|<script|<iframe) [NC,OR]
    RewriteCond %{QUERY_STRING} (base64_encode|globals|mosconfig|_request) [NC]
    RewriteRule .* - [F,L]

    # Force HTTPS & Strip WWW
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.junglenepal\.com [NC]
    RewriteRule ^(.*)$ https://junglenepal.com/$1 [L,R=301]

    # DirectoryIndex configuration for Astro SSG
    DirectoryIndex index.html

    # Redirect root /index.html to /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
    RewriteRule ^index\.html$ https://junglenepal.com/ [R=301,L]

    # Serve existing files and directories directly (prevents infinite redirect loops)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map extensionless URLs (e.g. /en/about -> /en/about.html)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Universal HTML & dynamic pages: zero caching at browser and edge CDN levels
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    Header always set Pragma "no-cache" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    Header always set Expires "0" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    Header always set CDN-Cache-Control "no-store" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    Header always set Surrogate-Control "no-store" "expr=%{CONTENT_TYPE} =~ m#text/html#"
    
    <FilesMatch "\.(html|htm|php)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always set CDN-Cache-Control "no-store"
        Header always set Surrogate-Control "no-store"
    </FilesMatch>

    # Cache immutable assets (CSS, JS, Fonts, Images)
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 301 REDIRECTS (Legacy WordPress Slugs Preservation)
