
# 301 REDIRECT DOMAIN FUSION: safarinepal.com -> junglenepal.com
RewriteCond %{HTTP_HOST} ^(?:www\.)?safarinepal\.com$ [NC]
RewriteRule ^(.*)$ https://junglenepal.com/ [R=301,L]
# =========================================================================
# JUNGLE NEPAL ADVENTURE - MILITARY-GRADE CYBERSECURITY & CLEAN URLS
# =========================================================================

Options -Indexes -MultiViews

<FilesMatch "^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|env|git|yaml|yml|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block common SQL Injection & XSS attack vectors in Query Strings
    RewriteCond %{QUERY_STRING} (eval\(|union.*select|benchmark\(|document\.cookie|<script|<iframe) [NC,OR]
    RewriteCond %{QUERY_STRING} (base64_encode|globals|mosconfig|_request) [NC]
    RewriteRule .* - [F,L]

    # Force HTTPS & Strip WWW
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.junglenepal\.com [NC]
    RewriteRule ^(.*)$ https://junglenepal.com/$1 [L,R=301]

    # Force fresh delivery of llms.txt and llms-full.txt
    RewriteRule ^llms\.txt$ llms.txt [L]
    RewriteRule ^llms-full\.txt$ llms-full.txt [L]

    # DirectoryIndex configuration for Astro SSG
    DirectoryIndex index.html

    # Redirect external requests ending in .html to clean URLs (e.g. /blog.html -> /blog)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)\.html\ HTTP/ [NC]
    RewriteRule ^(.*)\.html$ https://junglenepal.com/$1 [R=301,L]

    # Redirect root /index.html to /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
    RewriteRule ^index\.html$ https://junglenepal.com/ [R=301,L]

    # ==========================================================================
    # SEO 301 PERMANENT REDIRECTS (ZERO REGRESSION & ZERO 404)
    # ==========================================================================
    RewriteRule ^nos-offres/?$ https://junglenepal.com/#prochains-departs [R=301,L,NE]
    RewriteRule ^offres/?$ https://junglenepal.com/#prochains-departs [R=301,L,NE]
    RewriteRule ^nos-aventures/?$ https://junglenepal.com/#prochains-departs [R=301,L,NE]
    RewriteRule ^nos-tours-a-venir/?$ https://junglenepal.com/#prochains-departs [R=301,L,NE]
    RewriteRule ^nos-recommandations/?$ https://junglenepal.com/#prochains-departs [R=301,L,NE]
    RewriteRule ^voyage-nature-au-nepal-safari-et-aventures-hors-sentiers-battus/?$ https://junglenepal.com/#prochains-departs [R=301,L,NE]
    RewriteRule ^agence-de-safaris-au-nepal/?$ https://junglenepal.com/a-propos [R=301,L,NE]
    RewriteRule ^about-us/?$ https://junglenepal.com/a-propos [R=301,L,NE]
