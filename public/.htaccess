    RewriteRule ^contact-us/?$ https://junglenepal.com/contact [R=301,L,NE]
    RewriteRule ^nos-destinations/?$ https://junglenepal.com/destinations [R=301,L,NE]
    RewriteRule ^parc-national-de-bardia/?$ https://junglenepal.com/destinations/bardia [R=301,L,NE]
    RewriteRule ^parc-national-de-chitwan/?$ https://junglenepal.com/destinations/chitwan [R=301,L,NE]
    RewriteRule ^parc-national-de-suklaphanta/?$ https://junglenepal.com/destinations/suklaphanta [R=301,L,NE]
    RewriteRule ^annapurnas-pokhara/?$ https://junglenepal.com/destinations/annapurna [R=301,L,NE]
    RewriteRule ^annapurna-region/?$ https://junglenepal.com/destinations/annapurna [R=301,L,NE]
    RewriteRule ^katmandou-vallee-des-rois/?$ https://junglenepal.com/destinations/katmandou [R=301,L,NE]
