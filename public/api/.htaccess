# Prevent directory listing
Options -Indexes

# Deny direct access to config files
<FilesMatch "^(stripe-config\.php|\.env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
